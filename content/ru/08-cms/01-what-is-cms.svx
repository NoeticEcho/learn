	export const metadata = {
		id: '08-cms/01-what-is-cms',
		part: 8,
		order: 1,
		title: 'Что такое CMS и зачем она нужна',
		definition: 'CMS (система управления содержимым) — программа, в которой содержание сайта правят без знания HTML: админка, хранилище, шаблоны, роли и публикация.',
		summary: 'Вы объясните, чем сайт на HTML-файлах отличается от сайта на CMS, назовёте три слоя (содержание, шаблон, код) и опишете модель контента своего проекта: какие бывают «сущности» (услуга, статья, человек, отзыв) и какие у них поля. После урока у вас есть таблица типов содержания с редакторами и частотой правок.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'browser-1996',
					label: 'цена: 3000',
					caption: 'Сайт из файлов',
					say: [
						{ text: 'Цена изменилась. Правлю страницу номер… семь из двенадцати.' },
						{ who: 'Сайт', text: 'Остальные пять я не трогал.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'sheet',
					label: 'услуга: цена',
					caption: 'Поле',
					say: 'Услуга это запись с полями. Цена лежит в одном поле, а карточка, страница и список её только показывают.'
				},
				{
					mood: 'cheer',
					prop: 'editor',
					label: 'сохранить',
					caption: 'CMS',
					say: 'Одно поле, одна правка, цена обновилась везде. Редактору не нужен разработчик.'
				}
			]
		},
		minutes: 15,
		teaches: ['cms-what-is-cms', 'cms-content-model'],
		requires: ['server-static-vs-dynamic', 'data-relational-model', 'start-project-brief'],
		practice: {
			id: 'cms-content-model-table',
			title: 'Модель контента вашего проекта',
			task: 'Заполните таблицу типов содержания. Первая строка (услуги или товары из items) почти готова: допишите, кто их правит и как часто. В остальных строках впишите: люди (people), подтверждения (proofs) и страницы-разделы. Для каждого: название типа, поля через запятую, кто правит (владелец, редактор или разработчик) и как часто (например, «раз в месяц»). Если в вашем проекте нет людей или подтверждений, замените строку своим типом (например, «Отзыв», «Событие»). Во второй таблице для каждого раздела вашего сайта впишите, какие типы он выводит. Если у сайта несколько языков, поля с текстами сделайте на каждом языке (например, title_ru и title_en). Все «…» нужно заменить.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="cms-model">
      <h2>Модель контента проекта<\/h2>
      <p>Типы содержания: у каждого свои поля, свой редактор и своя частота правок.<\/p>
      <table id="model">
        <tr><th>Тип<\/th><th>Поля (через запятую)<\/th><th>Кто правит<\/th><th>Как часто<\/th><\/tr>
        <tr class="type items"><td class="name">Услуга или товар (items)<\/td><td class="fields">title, text, price<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type people"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type proofs"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type pages"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
      <\/table>

      <h3>Какие типы выводит каждый раздел сайта<\/h3>
      <table id="sections-map">
        <tr><th>Раздел<\/th><th>Какие типы содержания выводит<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="types">…<\/td><\/tr>
        {{/each}}
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="cms-model">
      <h2>Модель контента проекта<\/h2>
      <p>Типы содержания: у каждого свои поля, свой редактор и своя частота правок.<\/p>
      <table id="model">
        <tr><th>Тип<\/th><th>Поля (через запятую)<\/th><th>Кто правит<\/th><th>Как часто<\/th><\/tr>
        <tr class="type items"><td class="name">Услуга или товар (items)<\/td><td class="fields">title_ru, title_en, text_ru, text_en, price, фото<\/td><td class="owner">владелец<\/td><td class="freq">раз в месяц<\/td><\/tr>
        <tr class="type people"><td class="name">Человек<\/td><td class="fields">name, role, bio_ru, bio_en, фото<\/td><td class="owner">владелец<\/td><td class="freq">раз в полгода<\/td><\/tr>
        <tr class="type proofs"><td class="name">Подтверждение<\/td><td class="fields">title_ru, title_en, номер, дата, скан<\/td><td class="owner">редактор<\/td><td class="freq">раз в год<\/td><\/tr>
        <tr class="type pages"><td class="name">Страница-раздел<\/td><td class="fields">title_ru, title_en, текст_ru, текст_en<\/td><td class="owner">редактор<\/td><td class="freq">раз в неделю<\/td><\/tr>
      <\/table>

      <h3>Какие типы выводит каждый раздел сайта<\/h3>
      <table id="sections-map">
        <tr><th>Раздел<\/th><th>Какие типы содержания выводит<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="types">страница-раздел; услуги и подтверждения, если раздел о них<\/td><\/tr>
        {{/each}}
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

