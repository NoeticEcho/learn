			},
			checks: [
				{ id: 'model-exists', kind: 'exists', selector: '#cms-model' },
				{ id: 'no-blanks', kind: 'text', selector: '#cms-model', matches: '^[^…]*$' },
				{ id: 'types', kind: 'count', selector: '#model tr.type', min: 4 },
				{ id: 'fields-listed', kind: 'text', selector: '#model td.fields', matches: ',' },
				{ id: 'owner-named', kind: 'text', selector: '#model td.owner', matches: 'владел|редактор|разработчик' },
				{ id: 'freq-named', kind: 'text', selector: '#model td.freq', matches: 'раз|ежедн|редк|част|недел|месяц|год|квартал|полгода' },
				{ id: 'section-per-row', kind: 'count', selector: '#sections-map tr.sec', min: { brief: 'sections' } },
				{ id: 'sections-named', kind: 'field', selector: '#sections-map tr.sec', field: 'sections' },
				{
					id: 'multilingual',
					kind: 'text',
					selector: '#model td.fields',
					matches: '_en|_ru|на каждом языке|перевод|\\(en\\)',
					when: { brief: 'languages', contains: 'en' }
				}
			]
		},
		quiz: [
			{
				type: 'match',
				prompt: 'Соедините слой сайта с тем, что в нём лежит',
				pairs: [
					['Содержание', 'тексты, цены, фотографии, названия'],
					['Шаблон', 'общая шапка, подвал и то, как выглядит карточка услуги'],
					['Код', 'работа сайта: показать страницу, принять заявку, проверить доступ']
				]
			},
			{
				type: 'single',
				prompt: 'Чем сайт на CMS удобнее сайта из HTML-файлов для человека, который меняет цены?',
				options: [
					'Он правит содержание в админке, и ему не нужно знать HTML и выкладывать файлы',
					'Сайт на CMS не требует хостинга',
					'У сайта на CMS нет шаблонов'
				],
				answer: 0,
				why: [
					'Да. CMS отделяет содержание от оформления и кода, поэтому редактору нужна только форма в админке.',
					'Нет: CMS нужен сервер и база, как и любой динамический сайт.',
					'Нет: шаблоны у CMS есть, и общая шапка как раз лежит в одном месте.'
				]
			},
			{
				type: 'single',
				prompt: 'Что значит «моделировать содержание, а не страницы»?',
				options: [
					'Описать, какие бывают «вещи» (услуга, человек, отзыв) и какие у них поля, а страницы собирать из них',
					'Нарисовать макет каждой страницы',
					'Написать все тексты заранее'
				],
				answer: 0,
				why: [
					'Да. Услуга описана один раз, а карточка, страница и список показывают её поля. Меняется поле, и меняется всё.',
					'Нет: макет это оформление, а модель описывает содержание.',
					'Нет: модель про устройство данных, а не про готовые тексты.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что обычно входит в CMS?',
				options: [
					'Админка для правки содержания',
					'Хранилище содержания (база или файлы)',
					'Роли: кто что может менять',
					'Готовые тексты для вашего сайта'
				],
				answer: [0, 1, 2],
				why: [
					'Да: именно из-за админки CMS и берут.',
					'Да: содержание где-то лежит, чаще всего в базе.',
					'Да: владелец, редактор и разработчик видят в админке разное.',
					'Нет: тексты вам придётся написать самим.'
				]
			},
			{
				type: 'single',
				prompt: 'Сайт на русском и английском. Как лучше устроить поле «название услуги»?',
