		minutes: 20,
		teaches: ['cms-tilda', 'cms-bitrix'],
		requires: ['cms-what-is-cms', 'cms-content-model', 'html-forms'],
		practice: {
			id: 'cms-tilda-bitrix-pick',
			title: 'Выбор платформы для проекта',
			task: 'Заполните таблицу решения. 1) Для каждой из трёх платформ (Tilda, 1С-Битрикс, WordPress) напишите, подходит ли она вашему проекту (да, нет или условно), и почему. 2) Назовите выбор. 3) Обоснуйте его двумя полями брифа: напишите в обосновании название главного действия (в кавычках, как в брифе) и, если у проекта есть услуги или товары, хотя бы одно название. 4) Скажите, где будут храниться заявки и данные посетителей. 5) Скажите, какая страница нужна рядом с формой из-за персональных данных. 6) В таблице стоимости впишите числа в рублях за год по четырём статьям. 7) Опишите, как вы сможете уйти с платформы и что получится вынести. Все «…» нужно заменить.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="pick">
      <h2>Решение для проекта: Tilda, «Битрикс» или WordPress<\/h2>
      <table id="options">
        <tr><th>Платформа<\/th><th>Подходит? (да, нет, условно)<\/th><th>Почему<\/th><\/tr>
        <tr class="opt"><td>Tilda<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
        <tr class="opt"><td>1С-Битрикс<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
        <tr class="opt"><td>WordPress<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
      <\/table>
      <p>Мой выбор: <span id="choice">…<\/span><\/p>
      <p>Выбор опирается на поля брифа (главное действие «{{mainAction.label}}», услуги или товары, языки): <span id="reason">…<\/span><\/p>
      <p>Где будут храниться заявки и данные посетителей: <span id="pd">…<\/span><\/p>
      <p>Какая страница нужна рядом с формой из-за персональных данных: <span id="consent">…<\/span><\/p>

      <h3>Сколько это стоит за год (оценка, в рублях)<\/h3>
      <table id="cost">
        <tr><th>Статья<\/th><th>Сумма в год<\/th><th>Комментарий<\/th><\/tr>
        <tr class="line"><td>Платформа или лицензия<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Хостинг<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Домен<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Поддержка и доработки<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
      <\/table>
      <p>Как я смогу уйти с платформы, что получится вынести: <span id="exit">…<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
