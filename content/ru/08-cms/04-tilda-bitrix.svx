}
`
			},
			checks: [
				{ id: 'pick-exists', kind: 'exists', selector: '#pick' },
				{ id: 'no-blanks', kind: 'text', selector: '#pick', matches: '^[^…]*$' },
				{ id: 'options', kind: 'count', selector: '#options tr.opt', min: 3 },
				{ id: 'fit-words', kind: 'text', selector: '#options td.fit', matches: '^\\s*(?:[Дд]а|[Нн]ет|[Уу]словно)' },
				{ id: 'choice', kind: 'text', selector: '#choice', matches: 'Tilda|Тильда|Битрикс|WordPress|Вордпресс' },
				{ id: 'reason-action', kind: 'field', selector: '#reason', field: 'mainAction.label' },
				{ id: 'reason-items', kind: 'field', selector: '#reason', field: 'items[].title', min: 1, when: { brief: 'items[].title' } },
				{
					id: 'pd-where',
					kind: 'text',
					selector: '#pd',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:сервер|платформ|хостинг|облак|Росси|почт|CRM))'
				},
				{ id: 'consent-page', kind: 'text', selector: '#consent', matches: 'согласи|политик|персональн' },
				{ id: 'cost-rows', kind: 'count', selector: '#cost tr.line', min: 4 },
				{ id: 'cost-numbers', kind: 'text', selector: '#cost td.sum', matches: '^\\s*\\d[\\d\\s]*\\s*$' },
				{
					id: 'exit-plan',
					kind: 'text',
					selector: '#exit',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:экспорт|выгруз|вынес|код|HTML|перенос|копи|остан))'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Что такое «блочный конструктор» вроде Tilda?',
				options: [
					'Сервис, где сайт собирают из готовых блоков (обложка, текст, форма) в браузере, без программирования',
					'Программа, которую ставят на свой сервер и пишут для неё код',
					'Язык разметки для страниц'
				],
