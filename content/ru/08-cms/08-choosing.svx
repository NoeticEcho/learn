			},
			checks: [
				{ id: 'card-exists', kind: 'exists', selector: '#card' },
				{ id: 'no-blanks', kind: 'text', selector: '#card', matches: '^[^…]*$' },
				{ id: 'editor', kind: 'text', selector: '#editor', matches: 'владел|редактор|разработчик|команд|я сам|мы' },
				{ id: 'frequency', kind: 'text', selector: '#freq', matches: 'раз|недел|месяц|ежед|год|квартал|редк|част' },
				{ id: 'action-by', kind: 'text', selector: '#action-by', matches: '\\S+\\s+\\S+\\s+\\S+' },
				{ id: 'languages-storage', kind: 'text', selector: '#langs', matches: 'поле|перевод|_en|копи|страниц|язык|один' },
				{
					id: 'languages-bilingual',
					kind: 'text',
					selector: '#langs',
					matches: 'поле|перевод|_en|копи|страниц',
					when: { brief: 'languages', contains: 'en' }
				},
				{
					id: 'stack-named',
					kind: 'text',
					selector: '#stack',
					matches: 'Tilda|конструктор|WordPress|Битрикс|генератор|Hugo|Jekyll|Eleventy|Astro|SvelteKit|headless|Strapi|Directus|Sanity|Decap|приложени'
				},
				{
					id: 'stack-why',
					kind: 'text',
					selector: '#why',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:правит|редактор|владел|част|раз в|недел|месяц|бюджет|данн|форм))'
				},
				{ id: 'rejected-two', kind: 'count', selector: '#rejected tr.rejected', min: 2 },
				{ id: 'rejected-reasons', kind: 'text', selector: '#rejected td.reason', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' },
				{ id: 'revisit', kind: 'text', selector: '#revisit', matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:если|когда|при |как только))' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'С каких вопросов начинают выбор CMS или генератора?',
				options: [
					'Кто правит содержание, как часто, что нужно кроме страниц, какой бюджет и сколько языков',
					'Какая система популярнее всех',
					'Какая из них красивее выглядит в каталоге тем'
				],
				answer: 0,
				why: [
					'Да. От ответов зависит всё: удобная админка нужна тем, кто правит часто и не владеет кодом, а редким правкам хватит файлов.',
					'Нет: популярность говорит о том, что нужно многим, а не вам.',
					'Нет: внешний вид можно менять, а вот устройство содержания и обслуживания трудно.'
				]
			},
			{
				type: 'single',
				prompt: 'Лендинг с одной формой, правит владелец раз в месяц, бюджет небольшой. Что вероятнее всего подойдёт?',
				options: ['Конструктор вроде Tilda', 'Headless-CMS и генератор', 'Своя CMS на заказ'],
				answer: 0,
				why: [
					'Да. Задача простая, правит сам владелец, обслуживать нечего. Ограничения конструктора проекту не мешают.',
					'Нет: две системы и сборка ради лендинга это лишняя работа.',
					'Нет: самое дорогое решение для самой простой задачи.'
				]
			},
			{
				type: 'single',
				prompt: 'Документация для разработчиков: страниц много, правят её разработчики, раз в месяц. Что разумно?',
				options: [
					'Генератор статики и Markdown в Git: быстро, безопасно, правки через Git привычны',
					'WordPress с десятком плагинов',
					'Магазин на Битриксе'
				],
