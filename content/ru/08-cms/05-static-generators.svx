<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '08-cms/05-static-generators',
		part: 8,
		order: 5,
		title: 'Генераторы статических сайтов и Markdown',
		definition: 'Генератор статических сайтов — программа, которая при сборке превращает файлы Markdown, данные и общий шаблон в готовые HTML-файлы; на сервер кладут только их.',
		summary: 'Вы напишете страницы в Markdown с front matter, увидите, как генератор превращает их и шаблон в обычный HTML, и сможете выбрать между Jekyll, Hugo, Eleventy, Astro и SvelteKit по задаче. Это эпоха 5 (2019) вашего сайта: страницы по разделам, коллекция из ваших услуг и один общий шаблон.',
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'browser-1996', label: 'шапка × 50 файлов', caption: 'Было', say: 'Поменялся телефон в шапке. Открываю пятьдесят файлов…' },
				{
					mood: 'explain',
					side: 'right',
					prop: 'flowchart',
					label: 'Markdown|шаблон|HTML',
					caption: 'Сборка',
					say: 'Тексты в Markdown, оформление в одном шаблоне. Генератор собирает из них готовые HTML-файлы.'
				},
				{
					mood: 'cheer',
					prop: 'server',
					label: 'готовые файлы',
					caption: 'На сервере',
					say: [
						{ text: 'А на сервере что?' },
						{ who: 'Сервер', text: 'Только готовые файлы. Ломать нечего.' }
					]
				}
			]
		},
		minutes: 25,
		teaches: ['cms-markdown-frontmatter', 'cms-static-site-generator', 'cms-ssg-landscape'],
		requires: ['cms-what-is-cms', 'html-semantic-elements', 'css-responsive', 'net-http-request-response'],
		practice: {
			id: 'cms-ssg-project',
			title: 'Сайт на генераторе: Markdown, коллекция и шаблон',
			task: 'В странице проект маленького генератора: настройки, общий шаблон, по странице Markdown на каждый раздел вашего брифа, страница каталога и коллекция услуг. 1) В site.yml впишите язык сайта (lang: ru) и языки (languages: …, как в брифе). 2) В layout.html: lang возьмите из настроек ({{ site.lang | escape }}), добавьте шапку (header) с меню из списка страниц ({% for p in pages %} … {% endfor %}) и подвал (footer); {{ content | strip }} оставьте. 3) В файле каждого раздела допишите в front matter description и напишите текст. 4) В catalog.md выведите услуги циклом по коллекции: {% for item in items %}- **{{ item.title | escape }}**, {{ item.price | escape }} {% endfor %}. Проверки читают файлы проекта; внизу вы видите собранный HTML. Двойные скобки в шаблоне дополнены фильтрами, потому что редактор курса сам подставляет значения в простые скобки. Все «…» нужно заменить.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="ssg">
      <h2>Проект сайта на генераторе<\/h2>
      <p>Это файлы проекта, как в настоящем генераторе. Правьте их прямо здесь: внизу в «Результате сборки» появится HTML каждой страницы.<\/p>

      <h3>site.yml: настройки сайта<\/h3>
      <textarea id="cfg" rows="4">title: {{name}}
lang: …
languages: …<\/textarea>

      <h3>layout.html: общий шаблон, один на все страницы<\/h3>
      <textarea id="layout" rows="16"><!doctype html>
<html lang="…">
<head>
<meta charset="utf-8">
<title>{{ page.title | escape }}<\/title>
<\/head>
<body>
<main>{{ content | strip }}<\/main>
<\/body>
<\/html><\/textarea>

      <h3>Страницы: по одному файлу Markdown на раздел<\/h3>
      {{#each sections}}<textarea class="md-file" data-collection="pages" data-path="{{.}}.md" rows="7">---
title: {{.}}
description: …
---
# {{.}}

…<\/textarea>
      {{/each}}
      <h3>catalog.md: страница каталога, которая берёт данные из коллекции<\/h3>
      <textarea class="md-file" data-collection="pages" data-path="catalog.md" rows="8">---
title: Каталог
description: …
---
# Каталог

…<\/textarea>

      <h3>Коллекция items: по файлу на услугу или товар (данные из вашего брифа)<\/h3>
      {{#each items}}<textarea class="md-file" data-collection="items" data-path="items/{{title}}.md" rows="5">---
title: {{title}}
price: {{price}}
---
{{text}}<\/textarea>
      {{/each}}
      <h3>Результат сборки<\/h3>
      <div id="built"><\/div>
    <\/section>

    <script type="module" data-scaffold id="ssg-build">
      // Учебный генератор (не Jekyll и не Hugo): собирает страницы из полей выше и показывает результат.
      // Читать этот блок не нужно. Он не входит в ваш сайт.
      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/<\/g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      /** «---\\nключ: значение\\n---\\nтекст» → { data, body }. Значения остаются строками. */
      function frontMatter(text) {
      const m = /^\\s*---\\s*\\n([\\s\\S]*?)\\n---\\s*(?:\\n([\\s\\S]*))?$/.exec(text);
      if (!m) return { data: {}, body: text, ok: false };
      const data = {};
      for (const line of m[1].split('\\n')) {
      const k = /^([A-Za-z_][\\w-]*):\\s*(.*)$/.exec(line.trim());
      if (k) data[k[1]] = k[2].replace(/^["']|["']$/g, '');
      }
      return { data, body: m[2] ?? '', ok: true };
      }
      /** Подстановка: циклы, {{ путь | фильтр }}. */
      function liquid(tpl, ctx) {
      const out = tpl.replace(/\\{%\\s*for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*%\\}([\\s\\S]*?)\\{%\\s*endfor\\s*%\\}/g, (_, v, list, body) =>
      (Array.isArray(ctx[list]) ? ctx[list] : []).map((item) => liquid(body, { ...ctx, [v]: item })).join('')
      );
      return out.replace(/\\{\\{\\s*([\\w.]+)\\s*(?:\\|\\s*(\\w+))?[^}]*\\}\\}/g, (_, path, filter) => {
      let v = path.split('.').reduce((o, k) => (o == null ? o : o[k]), ctx);
      if (v == null) v = '';
      return filter === 'escape' ? esc(v) : String(v).trim();
      });
      }
      const inline = (s) =>
      s
      .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1<\/strong>')
      .replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, '<a href="$2">$1<\/a>');
      /** Markdown в миниатюре: # и ## заголовки, абзацы, списки «- », **жирный**, [ссылка](адрес). */
      function markdown(src) {
      const html = [];
      let para = [];
      let list = false;
      const flush = () => {
      if (para.length) html.push('<p>' + inline(para.join(' ')) + '<\/p>');
      para = [];
      };
      const close = () => {
      if (list) html.push('<\/ul>');
      list = false;
      };
      for (const raw of src.split('\\n')) {
      const line = raw.trim();
      let m;
      if (!line) (flush(), close());
      else if ((m = /^(#{1,3})\\s+(.*)$/.exec(line))) (flush(), close(), html.push(\`<h\${m[1].length}>\${inline(m[2])}<\/h\${m[1].length}>\`));
      else if ((m = /^[-*]\\s+(.*)$/.exec(line))) (flush(), list || html.push('<ul>'), (list = true), html.push('<li>' + inline(m[1]) + '<\/li>'));
      else (close(), para.push(line));
      }
      flush();
      close();
      return html.join('\\n');
      }
      /**
      * Собирает одну страницу: front matter, подстановка данных в текст, Markdown, потом layout.
      * site: настройки (title, lang...), pages: все страницы [{title, path}], collections: { items: [...] }.
      */
      function buildPage(layout, site, file, pages, collections) {
      const fm = frontMatter(file);
      const ctx = { site, pages, ...collections, page: fm.data };
      const content = markdown(liquid(fm.body, ctx));
      return liquid(layout, { ...ctx, content });
      }

      function config() {
        const out = {};
        for (const line of document.getElementById('cfg').value.split('\\n')) {
          const m = /^([A-Za-z_]\\w*):\\s*(.*)$/.exec(line.trim());
          if (m) out[m[1]] = m[2];
        }
        return out;
      }
      function build() {
        const box = document.getElementById('built');
        box.replaceChildren();
        const layout = document.getElementById('layout').value;
        const files = (kind) => [...document.querySelectorAll('textarea.md-file[data-collection="' + kind + '"]')];
        const items = files('items').map((t) => frontMatter(t.value).data);
        const list = files('pages').map((t) => ({ t, title: frontMatter(t.value).data.title || t.dataset.path, path: t.dataset.path.replace(/\\.md$/, '.html') }));
        for (const p of list) {
          const html = buildPage(layout, config(), p.t.value, list.map((x) => ({ title: x.title, path: x.path })), { items });
          const d = document.createElement('details');
          const s = document.createElement('summary');
          s.textContent = p.path + ' (' + html.length + ' символов HTML)';
          const pre = document.createElement('pre');
          pre.textContent = html;
          d.append(s, pre);
          box.append(d);
        }
      }
      for (const t of document.querySelectorAll('#ssg textarea')) t.addEventListener('input', build);
      build();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="ssg">
      <h2>Проект сайта на генераторе<\/h2>
      <p>Это файлы проекта, как в настоящем генераторе. Правьте их прямо здесь: внизу в «Результате сборки» появится HTML каждой страницы.<\/p>

      <h3>site.yml: настройки сайта<\/h3>
      <textarea id="cfg" rows="4">title: {{name}}
lang: ru
languages: {{languages}}<\/textarea>

      <h3>layout.html: общий шаблон, один на все страницы<\/h3>
      <textarea id="layout" rows="16"><!doctype html>
<html lang="{{ site.lang | escape }}">
<head>
<meta charset="utf-8">
<title>{{ page.title | escape }} | {{ site.title | escape }}<\/title>
<\/head>
<body>
<header><strong>{{ site.title | escape }}<\/strong>
<nav>{% for p in pages %}<a href="{{ p.path | escape }}">{{ p.title | escape }}<\/a> {% endfor %}<\/nav><\/header>
<main>{{ content | strip }}<\/main>
<footer>{{ site.title | escape }}, все права защищены<\/footer>
<\/body>
<\/html><\/textarea>

      <h3>Страницы: по одному файлу Markdown на раздел<\/h3>
      {{#each sections}}<textarea class="md-file" data-collection="pages" data-path="{{.}}.md" rows="7">---
title: {{.}}
description: Раздел сайта
---
# {{.}}

Текст раздела пишется здесь обычными словами, а шапка и подвал подставятся из шаблона.<\/textarea>
      {{/each}}
      <h3>catalog.md: страница каталога, которая берёт данные из коллекции<\/h3>
      <textarea class="md-file" data-collection="pages" data-path="catalog.md" rows="8">---
title: Каталог
description: Все позиции из коллекции
---
# Каталог

{% for item in items %}- **{{ item.title | escape }}**, {{ item.price | escape }}
{% endfor %}<\/textarea>

      <h3>Коллекция items: по файлу на услугу или товар (данные из вашего брифа)<\/h3>
      {{#each items}}<textarea class="md-file" data-collection="items" data-path="items/{{title}}.md" rows="5">---
title: {{title}}
price: {{price}}
---
{{text}}<\/textarea>
      {{/each}}
      <h3>Результат сборки<\/h3>
      <div id="built"><\/div>
    <\/section>

    <script type="module" data-scaffold id="ssg-build">
      // Учебный генератор (не Jekyll и не Hugo): собирает страницы из полей выше и показывает результат.
      // Читать этот блок не нужно. Он не входит в ваш сайт.
      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/<\/g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      /** «---\\nключ: значение\\n---\\nтекст» → { data, body }. Значения остаются строками. */
      function frontMatter(text) {
      const m = /^\\s*---\\s*\\n([\\s\\S]*?)\\n---\\s*(?:\\n([\\s\\S]*))?$/.exec(text);
      if (!m) return { data: {}, body: text, ok: false };
      const data = {};
      for (const line of m[1].split('\\n')) {
      const k = /^([A-Za-z_][\\w-]*):\\s*(.*)$/.exec(line.trim());
      if (k) data[k[1]] = k[2].replace(/^["']|["']$/g, '');
      }
      return { data, body: m[2] ?? '', ok: true };
      }
      /** Подстановка: циклы, {{ путь | фильтр }}. */
      function liquid(tpl, ctx) {
      const out = tpl.replace(/\\{%\\s*for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*%\\}([\\s\\S]*?)\\{%\\s*endfor\\s*%\\}/g, (_, v, list, body) =>
      (Array.isArray(ctx[list]) ? ctx[list] : []).map((item) => liquid(body, { ...ctx, [v]: item })).join('')
      );
      return out.replace(/\\{\\{\\s*([\\w.]+)\\s*(?:\\|\\s*(\\w+))?[^}]*\\}\\}/g, (_, path, filter) => {
      let v = path.split('.').reduce((o, k) => (o == null ? o : o[k]), ctx);
      if (v == null) v = '';
      return filter === 'escape' ? esc(v) : String(v).trim();
      });
      }
      const inline = (s) =>
      s
      .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1<\/strong>')
      .replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, '<a href="$2">$1<\/a>');
      /** Markdown в миниатюре: # и ## заголовки, абзацы, списки «- », **жирный**, [ссылка](адрес). */
      function markdown(src) {
      const html = [];
      let para = [];
      let list = false;
      const flush = () => {
      if (para.length) html.push('<p>' + inline(para.join(' ')) + '<\/p>');
      para = [];
      };
      const close = () => {
      if (list) html.push('<\/ul>');
      list = false;
      };
      for (const raw of src.split('\\n')) {
      const line = raw.trim();
      let m;
      if (!line) (flush(), close());
      else if ((m = /^(#{1,3})\\s+(.*)$/.exec(line))) (flush(), close(), html.push(\`<h\${m[1].length}>\${inline(m[2])}<\/h\${m[1].length}>\`));
      else if ((m = /^[-*]\\s+(.*)$/.exec(line))) (flush(), list || html.push('<ul>'), (list = true), html.push('<li>' + inline(m[1]) + '<\/li>'));
      else (close(), para.push(line));
      }
      flush();
      close();
      return html.join('\\n');
      }
      /**
      * Собирает одну страницу: front matter, подстановка данных в текст, Markdown, потом layout.
      * site: настройки (title, lang...), pages: все страницы [{title, path}], collections: { items: [...] }.
      */
      function buildPage(layout, site, file, pages, collections) {
      const fm = frontMatter(file);
      const ctx = { site, pages, ...collections, page: fm.data };
      const content = markdown(liquid(fm.body, ctx));
      return liquid(layout, { ...ctx, content });
      }

      function config() {
        const out = {};
        for (const line of document.getElementById('cfg').value.split('\\n')) {
          const m = /^([A-Za-z_]\\w*):\\s*(.*)$/.exec(line.trim());
          if (m) out[m[1]] = m[2];
        }
        return out;
      }
      function build() {
        const box = document.getElementById('built');
        box.replaceChildren();
        const layout = document.getElementById('layout').value;
        const files = (kind) => [...document.querySelectorAll('textarea.md-file[data-collection="' + kind + '"]')];
        const items = files('items').map((t) => frontMatter(t.value).data);
        const list = files('pages').map((t) => ({ t, title: frontMatter(t.value).data.title || t.dataset.path, path: t.dataset.path.replace(/\\.md$/, '.html') }));
        for (const p of list) {
          const html = buildPage(layout, config(), p.t.value, list.map((x) => ({ title: x.title, path: x.path })), { items });
          const d = document.createElement('details');
          const s = document.createElement('summary');
          s.textContent = p.path + ' (' + html.length + ' символов HTML)';
          const pre = document.createElement('pre');
          pre.textContent = html;
          d.append(s, pre);
          box.append(d);
        }
      }
      for (const t of document.querySelectorAll('#ssg textarea')) t.addEventListener('input', build);
      build();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
