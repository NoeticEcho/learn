`
			},
			checks: [
				{ id: 'plan-exists', kind: 'exists', selector: '#wp-plan' },
				{ id: 'no-blanks', kind: 'text', selector: '#wp-plan', matches: '^[^…]*$' },
				{ id: 'tagline', kind: 'text', selector: '#site-description', matches: '\\S{3,}' },
				{ id: 'menu-sections', kind: 'field', selector: '#menu a', field: 'sections' },
				{ id: 'action-button', kind: 'field', selector: '#content a.button', field: 'mainAction.label' },
				{ id: 'sections-planned', kind: 'count', selector: '#map tr.sec', min: { brief: 'sections' } },
				{ id: 'kind-named', kind: 'text', selector: '#map td.kind', matches: 'страниц|рубрик' },
				{ id: 'in-menu', kind: 'text', selector: '#map td.menu', matches: '^\\s*(?:[Дд]а|[Нн]ет)' },
				{ id: 'plugins-count', kind: 'count', selector: '#plugins li.plugin', min: 2, max: 5 },
				{ id: 'plugins-reasons', kind: 'text', selector: '#plugins li.plugin .why', matches: '\\S+\\s+\\S+\\s+\\S+' },
				{ id: 'action-plugin', kind: 'text', selector: '#action-by', matches: 'плагин|блок|форм|кнопк|виджет' },
				{ id: 'action-where', kind: 'text', selector: '#action-where', matches: 'главн|страниц|боков|подвал|меню|шапк' },
				{ id: 'tone-note', kind: 'text', selector: '#tone-note', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Чем в WordPress страница отличается от записи?',
				options: [
					'Запись привязана ко времени и входит в ленту (новость, статья), а страница это отдельный постоянный раздел («О нас», «Контакты»)',
					'Страница хранится в файле, а запись в базе',
					'Запись нельзя редактировать'
				],
				answer: 0,
				why: [
					'Да. Записи идут лентой по датам и ложатся в рубрики и метки, страницы стоят сами по себе и собираются в иерархию.',
					'Нет: и то и другое хранится в базе.',
					'Нет: правятся они одинаково.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините область страницы с файлом темы, который её рисует',
				pairs: [
					['Шапка и меню', 'header.php'],
					['Цикл записей на главной', 'index.php'],
					['Боковая колонка с виджетами', 'sidebar.php'],
					['Подвал', 'footer.php']
				]
			},
			{
				type: 'single',
				prompt: 'Нужно добавить форму заявки. Это работа темы или плагина?',
				options: [
					'Плагина: форма это возможность, а не оформление, и она должна пережить смену темы',
					'Темы: форму надо вшить в header.php',
					'Ядра WordPress: форма в нём уже есть'
				],
				answer: 0,
				why: [
					'Да. Тема отвечает за вид, плагин за возможности. Если форму вшить в тему, при смене темы она пропадёт.',
					'Нет: тогда форма привязана к теме и не переживёт её замену.',
					'Нет: в ядре WordPress формы заявок нет, но для этого есть плагины.'
				]
			},
			{
				type: 'single',
				prompt: 'Как плагины встраиваются в работу WordPress?',
				options: [
					'Через хуки: в нужных местах ядро и тема говорят «здесь можно что-то добавить или изменить», и плагин цепляется',
					'Плагины заменяют файлы ядра',
					'Плагины запускаются на компьютере редактора'
				],
				answer: 0,
				why: [
					'Да. Хуки бывают двух видов: «действия» (сделай что-то в этом месте) и «фильтры» (измени вот это перед показом).',
					'Нет: правка ядра сломалась бы при первом же обновлении.',
					'Нет: плагины это серверный код.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Почему WordPress стал самой распространённой CMS?',
				options: [
					'Работает на самом дешёвом хостинге с PHP и MySQL',
					'У него огромный выбор тем и плагинов',
					'Он открытый и бесплатный, а умеющих им пользоваться много',
					'Он защищён от взлома лучше всех систем'
				],
				answer: [0, 1, 2],
				why: [
					'Да: простая установка на любой хостинг была его козырем с самого начала.',
