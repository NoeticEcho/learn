  color: #8f1d1d;
}
`
			},
			checks: [
				{ id: 'upkeep-exists', kind: 'exists', selector: '#upkeep' },
				{ id: 'no-blanks', kind: 'text', selector: '#upkeep', matches: '^[^…]*$' },
				{ id: 'owner-named', kind: 'text', selector: '#tasks td.who', matches: 'владел|я |подрядчик|редактор|разработчик|хостинг|агентств|админ|сотрудник' },
				{ id: 'frequency', kind: 'text', selector: '#tasks td.freq', matches: 'раз|недел|месяц|квартал|ежед|год' },
				{ id: 'hours', kind: 'text', selector: '#tasks td.hours', matches: '^\\s*\\d+(?:[.,]\\d+)?\\s*$' },
				{ id: 'hours-total', kind: 'text', selector: '#hours-total', matches: '^\\s*\\d+(?:[.,]\\d+)?' },
				{ id: 'backup-where', kind: 'text', selector: '#backup', matches: '(?=[\\s\\S]*копи)(?=[\\s\\S]*(?:хран|лежат|сервер|облак|диск|отдельн))' },
				{ id: 'risks', kind: 'count', selector: '#risks li.risk', min: 2 },
				{ id: 'risks-plugin', kind: 'text', selector: '#risks', matches: 'плагин' },
				{ id: 'compare-rows', kind: 'count', selector: '#compare tr.cms', min: 3 },
				{
					id: 'verdict',
					kind: 'text',
					selector: '#verdict',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:остав|взять|перей|отказ|без CMS|Drupal|Joomla|WordPress))'
				}
			]
		},
		quiz: [
			{
				type: 'multiple',
				prompt: 'Из чего складывается цена владения сайтом на WordPress?',
				options: [
					'Хостинг и домен',
					'Платные темы и плагины',
					'Время (или оплата специалиста) на обновления, копии и проверки',
					'Плата за каждого посетителя'
				],
				answer: [0, 1, 2],
				why: [
					'Да: платить за них придётся каждый год.',
