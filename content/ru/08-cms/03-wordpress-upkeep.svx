    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="upkeep">
      <h2>План обслуживания сайта на CMS<\/h2>
      <table id="tasks">
        <tr><th>Задача<\/th><th>Кто делает<\/th><th>Как часто<\/th><th>Часов в месяц<\/th><\/tr>
        <tr class="task"><td>Обновление ядра CMS<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Обновление плагинов и темы<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Резервная копия и проверка восстановления<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Проверка работы формы заявки<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
      <\/table>
      <p>Всего часов в месяц: <span id="hours-total">…<\/span><\/p>
      <p>Резервная копия: что копируется, где хранится, как проверяется: <span id="backup">…<\/span><\/p>

      <h3>Риски плагинов для главного действия проекта «{{mainAction.label}}»<\/h3>
      <ul id="risks">
        <li class="risk">…<\/li>
        <li class="risk">…<\/li>
      <\/ul>

      <h3>Сравнение для моего проекта<\/h3>
      <table id="compare">
        <tr><th>Система<\/th><th>Обновления и поддержка<\/th><th>Подходит ли мне<\/th><\/tr>
        <tr class="cms"><td>WordPress<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
        <tr class="cms"><td>Drupal<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
        <tr class="cms"><td>Joomla<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
      <\/table>
      <p>Вывод: <span id="verdict">…<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
