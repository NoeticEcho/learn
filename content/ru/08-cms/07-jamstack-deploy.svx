			},
			checks: [
				{ id: 'scheme-exists', kind: 'exists', selector: '#scheme' },
				{ id: 'no-blanks', kind: 'text', selector: '#scheme', matches: '^[^…]*$' },
				{ id: 'four-steps', kind: 'count', selector: '#steps tr.step', min: 4 },
				{ id: 'steps-described', kind: 'text', selector: '#steps td.what', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' },
				{ id: 'webhook', kind: 'text', selector: '#steps', matches: 'вебхук|webhook|триггер|коммит' },
				{ id: 'serve-cdn', kind: 'text', selector: '#steps tr.serve td.where', matches: 'CDN|раздач|Pages|хостинг|Netlify|Vercel|Cloudflare|сервер' },
				{
					id: 'action-external',
					kind: 'text',
					selector: '#action-by',
					matches: 'сервис|функци|Formspree|Netlify|Tilda|Битрикс|ЮKassa|ЮКасса|CRM|облачн|почт|Telegram|бот|внешн|платформ'
				},
				{
					id: 'pd-where',
					kind: 'text',
					selector: '#action-pd',
					matches: '(?=[\\s\\S]*(?:Росси|РФ))(?=[\\s\\S]*(?:сервер|хран|сервис|платформ|CRM|почт|функци))'
				},
				{
					id: 'rollback-way',
					kind: 'text',
					selector: '#rollback',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:откат|предыдущ|прежн|верси|вернуть|переключ))'
				}
			]
		},
		quiz: [
			{
				type: 'order',
				prompt: 'Расставьте путь правки от редактора до посетителя',
				items: [
					'Редактор нажимает «Опубликовать» в CMS',
					'CMS отправляет сборщику вебхук',
					'Генератор собирает сайт заново по содержанию из API',
					'Готовая папка выкладывается на хостинг',
					'CDN обновляет копии и сбрасывает старый кэш'
				]
			},
			{
				type: 'single',
				prompt: 'Сборка нового сайта упала с ошибкой. Что увидит посетитель?',
				options: [
					'Прежнюю версию: новая включается только после успешной сборки и целиком',
					'Белый экран',
					'Половину страниц новых, половину старых'
				],
				answer: 0,
				why: [
					'Да. Такая выкладка называется атомарной: сайт переключается с одной полной версии на другую, поэтому «полусломанного» состояния нет.',
					'Нет: именно этого предоставляемая схема не допускает, пока вы не включили неудачную сборку руками.',
					'Нет: версии не смешиваются, переключение происходит разом.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что подключают к статическому сайту из внешних сервисов, потому что своего серверного кода у него нет?',
				options: ['Приём заявок из формы', 'Поиск по сайту', 'Оплату', 'Вёрстку страниц'],
				answer: [0, 1, 2],
				why: [
					'Да: сервис форм или функция принимает данные и пересылает на почту.',
					'Да: поиск строят на сервисе или готовом индексе, который собирается вместе с сайтом (урок 6 части 7).',
					'Да: оплату принимает платёжный сервис, сайт только отправляет туда посетителя.',
					'Нет: вёрстка это то, что генератор как раз делает сам.'
				]
			},
			{
				type: 'single',
				prompt: 'Что такое откат публикации в такой схеме?',
				options: [
					'Переключение сайта на прошлую уже собранную версию: заново собирать не нужно, и это занимает секунды',
					'Повторная сборка всего сайта с нуля',
					'Удаление записи в CMS'
				],
