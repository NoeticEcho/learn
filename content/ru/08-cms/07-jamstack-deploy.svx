					mood: 'explain',
					prop: 'flowchart',
					label: 'CMS|вебхук|сборка|CDN',
					caption: 'Путь правки',
					say: 'Редактор нажал «Опубликовать», вебхук разбудил сборку, готовый сайт уехал на CDN.'
