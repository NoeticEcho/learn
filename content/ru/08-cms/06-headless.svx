`
			},
			checks: [
				{ id: 'headless-exists', kind: 'exists', selector: '#headless' },
				{ id: 'no-blanks', kind: 'text', selector: '#headless', matches: '^[^…]*$' },
				{ id: 'schema-type', kind: 'text', selector: '#schema', matches: '"type"\\s*:\\s*"\\w+"' },
				{ id: 'schema-fields', kind: 'text', selector: '#schema', matches: '(?=[\\s\\S]*"title")(?=[\\s\\S]*"text")(?=[\\s\\S]*"price")' },
				{ id: 'schema-languages', kind: 'text', selector: '#schema', matches: '_en|"en"|locale|translations', when: { brief: 'languages', contains: 'en' } },
				{ id: 'entries-names', kind: 'text', selector: '#entries', matches: '(?=[\\s\\S]*"title"\\s*:)(?=[\\s\\S]*"text"\\s*:)(?=[\\s\\S]*"price"\\s*:)' },
				{ id: 'entries-brief', kind: 'field', selector: '#entries', field: 'items[].title', min: 1, when: { brief: 'items[].title' } },
				{ id: 'entries-filled', kind: 'text', selector: '#entries', matches: '"title"\\s*:\\s*"[^"]{2,}"' },
				{ id: 'entries-new', kind: 'text', selector: '#entries', matches: '(?:"title"[\\s\\S]*){2,}', when: { brief: 'items[].title' } },
				{ id: 'entries-languages', kind: 'text', selector: '#entries', matches: '_en|"en"', when: { brief: 'languages', contains: 'en' } },
				{ id: 'code-fetch', kind: 'text', selector: '#headless-code', matches: 'fetch\\(\\s*[\'"`]/api/items[\'"`]' },
				{ id: 'code-json', kind: 'text', selector: '#headless-code', matches: '\\.json\\(\\)' },
				{ id: 'code-render', kind: 'text', selector: '#headless-code', matches: 'createElement|replaceChildren|append' },
				{ id: 'hosting', kind: 'text', selector: '#hosting', matches: 'Git|Decap|свой сервер|своём сервере|Strapi|Directus|облак|Sanity|Contentful' },
				{ id: 'hosting-why', kind: 'text', selector: '#hosting-why', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Что значит «безголовая» (headless) CMS?',
				options: [
					'У неё нет своего сайта-«головы»: она хранит содержание и отдаёт его по API, а сайт строится отдельно',
					'Она работает без администратора',
					'У неё нет базы данных'
				],
				answer: 0,
