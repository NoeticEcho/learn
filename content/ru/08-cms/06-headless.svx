<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '08-cms/06-headless',
		part: 8,
		order: 6,
		title: 'Headless CMS: когда контент отделён от сайта',
		definition: 'Headless CMS — система управления содержимым без собственного сайта: редактор правит записи в админке, а сайт и приложения получают их по API.',
		summary: 'Вы поймёте, почему «безголовая» CMS даёт редактору удобную админку, а разработчику свободу выбрать сайт, и сравните Strapi, Directus, Sanity, Contentful и Decap по месту хранения (Git, свой сервер, облако) и цене. После урока вы описываете тип содержания, вносите записи и получаете их запросом, как это делает настоящий сайт.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'browser',
					label: 'сайт + админка',
					caption: 'Монолит',
					say: [
						{ text: 'Хочу новый сайт на другом движке.' },
						{ who: 'CMS', text: 'Тогда и админку выбрасывай, они у меня вместе.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'network',
					label: 'API',
					caption: 'Без головы',
					say: 'Админка и содержание отдельно, сайт отдельно. Между ними только API: сайт, приложение, всё читают одно и то же.'
				},
				{
					mood: 'cheer',
					prop: 'server',
					label: '/api/items',
					caption: 'Запрос',
					say: [
						{ text: 'GET /api/items' },
						{ who: 'CMS', text: 'Вот JSON. Рисуй, как хочешь.' }
					]
				}
			]
		},
		minutes: 20,
		teaches: ['cms-headless', 'cms-headless-landscape'],
		requires: ['cms-content-model', 'cms-static-site-generator', 'server-rest', 'js-fetch'],
		practice: {
			id: 'cms-headless-api',
			title: 'Тип, записи и запрос к headless-CMS',
			task: 'Страница получает услуги не из HTML, а запросом к «API» (имитация, потому что песочница не пускает в сеть). 1) В поле «Тип содержания» впишите тип поля price и добавьте текстовые поля для второго языка, если у проекта их два (title_en, text_en). 2) В поле «Записи» уже лежат ваши услуги из брифа; добавьте ещё одну запись вместо «…» (для двух языков с полями title_en и text_en). 3) В скрипте headless-code допишите функцию load: запросите fetch(\'/api/items\'), прочитайте ответ как JSON и для каждой записи создайте карточку (article с классом card, внутри h3 и p), положите карточки в .cards. 4) Скажите, где живёт CMS (Git, свой сервер или облако) и почему: привяжите к бюджету и данным проекта. Проверки читают поля и текст скрипта. Все «…» нужно заменить.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards"><\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="headless">
      <h2>Headless-CMS: тип, записи и запрос<\/h2>

      <h3>Тип содержания (так выглядит схема в админке)<\/h3>
      <textarea aria-label="Тип содержания (так выглядит схема в админке)" id="schema" rows="12">{
  "type": "items",
  "fields": {
    "title": "string",
    "text": "text",
    "price": …
  }
}<\/textarea>

      <h3>Записи: ответ API по адресу /api/items<\/h3>
      <textarea aria-label="Записи: ответ API по адресу /api/items" id="entries" rows="14">[
{{#each items}}  { "title": "{{title}}", "text": "{{text}}", "price": "{{price}}" },
{{/each}}  { "title": "…", "text": "…", "price": "…" }
]<\/textarea>

      <p>Где живёт CMS: <span id="hosting">…<\/span>, потому что <span id="hosting-why">…<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fake-api">
      // Имитация API headless-CMS (не настоящий сервер): на запрос /api/items отвечает записями из поля «Записи».
      // Песочница не пускает в сеть, поэтому настоящий запрос здесь невозможен. Читать этот блок не нужно.
      window.fetch = async (url) => {
        if (String(url) !== '/api/items') return new Response('Not Found', { status: 404 });
        await new Promise((r) => setTimeout(r, 250));
        try {
          const data = JSON.parse(document.getElementById('entries').value.replace(/,\\s*\\]/g, ']'));
          return new Response(JSON.stringify(data), { status: 200, headers: { 'Content-Type': 'application/json' } });
        } catch (e) {
          return new Response('Ошибка в JSON записей: ' + e.message, { status: 500 });
        }
      };
    <\/script>

    <script type="module" id="headless-code">
      // Страница получает услуги от «API» и выводит карточки.
      async function load() {
        const cards = document.querySelector('.cards');
        // 1) запросите записи: fetch('/api/items')
        // 2) прочитайте ответ как JSON
        // 3) для каждой записи создайте карточку (article с классом card, внутри h3 и p) и положите в cards
      }
      load();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards"><\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="headless">
      <h2>Headless-CMS: тип, записи и запрос<\/h2>

      <h3>Тип содержания (так выглядит схема в админке)<\/h3>
      <textarea aria-label="Тип содержания (так выглядит схема в админке)" id="schema" rows="12">{
  "type": "items",
  "fields": {
    "title": "string",
    "title_en": "string",
    "text": "text",
    "text_en": "text",
    "price": "string"
  }
}<\/textarea>

      <h3>Записи: ответ API по адресу /api/items<\/h3>
      <textarea aria-label="Записи: ответ API по адресу /api/items" id="entries" rows="14">[
{{#each items}}  { "title": "{{title}}", "text": "{{text}}", "price": "{{price}}" },
{{/each}}  { "title": "Новая услуга", "title_en": "New service", "text": "Описание новой услуги", "text_en": "A short description", "price": "по договорённости" }
]<\/textarea>

      <p>Где живёт CMS: <span id="hosting">файлы в Git (Decap)<\/span>, потому что <span id="hosting-why">бюджет небольшой, содержание правит один человек раз в месяц, а персональных данных в записях нет<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fake-api">
      // Имитация API headless-CMS (не настоящий сервер): на запрос /api/items отвечает записями из поля «Записи».
      // Песочница не пускает в сеть, поэтому настоящий запрос здесь невозможен. Читать этот блок не нужно.
      window.fetch = async (url) => {
        if (String(url) !== '/api/items') return new Response('Not Found', { status: 404 });
        await new Promise((r) => setTimeout(r, 250));
        try {
          const data = JSON.parse(document.getElementById('entries').value.replace(/,\\s*\\]/g, ']'));
          return new Response(JSON.stringify(data), { status: 200, headers: { 'Content-Type': 'application/json' } });
        } catch (e) {
          return new Response('Ошибка в JSON записей: ' + e.message, { status: 500 });
        }
      };
    <\/script>

    <script type="module" id="headless-code">
      // Страница получает услуги от «API» и выводит карточки.
      async function load() {
        const cards = document.querySelector('.cards');
        const response = await fetch('/api/items');
        if (!response.ok) {
          cards.textContent = 'Не удалось загрузить список. Попробуйте позже.';
          return;
        }
        const items = await response.json();
        cards.replaceChildren(
          ...items.map((item) => {
            const card = document.createElement('article');
            card.className = 'card';
            const title = document.createElement('h3');
            title.textContent = item.title;
            const text = document.createElement('p');
            text.textContent = item.text;
            const price = document.createElement('p');
            price.className = 'price';
            price.textContent = item.price || '';
            card.append(title, text, price);
            return card;
          })
        );
      }
      load();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

