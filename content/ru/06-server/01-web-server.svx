			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body bgcolor="#ffffcc" text="#000033" link="#0000cc" vlink="#660099">
    <center>
      <table width="600" border="0" cellpadding="8" cellspacing="0">
        <tr>
          <td colspan="2" bgcolor="#003366">
            <h1><font face="Times New Roman" size="6" color="#ffffff">{{name}}</font></h1>
          </td>
        </tr>
        <tr>
          <td width="150" valign="top" bgcolor="#cccccc">
            <font size="2">
              {{#each sections}}<a href="#">{{.}}</a><br>
              {{/each}}
            </font>
          </td>
          <td valign="top">
            <font face="Times New Roman" size="3">
              <p>{{profession}}</p>
              <p><b>{{mainAction.label}}:</b> <a href="tel:{{phone}}">{{phone}}</a></p>
              <hr>
              {{#each items}}<p><b>{{title}}</b><br>{{text}}</p>
              {{/each}}
              <hr>
              <p>{{city}}, <a href="mailto:{{email}}">{{email}}</a></p>
            </font>
          </td>
        </tr>
      </table>
      <p><font size="1">Вы посетитель номер</font><br>
      <img src="counter.gif" width="72" height="20" alt="Счётчик посетителей: 000123"></p>
    </center>

    <section data-scaffold id="server">
      <h2>Сервер сайта</h2>
      <table>
        <tr><th>Раздел</th><th>Адрес</th><th>Файл</th></tr>
        {{#each sections}}<tr class="route"><td>{{.}}</td><td class="url">/razdel.html</td><td class="file">razdel.html</td></tr>
        {{/each}}
      </table>
      <pre id="conf">server {
    listen 80;
    server_name example.ru;
    root /var/www/site;
    index index.html;

    error_page 404 /404.html;

    location = /staraya-stranica {
        return 301 /razdel.html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}<\/pre>
      <p id="role">Здесь работает nginx: он принимает запросы, отдаёт файлы, показывает свою страницу 404 и перенаправляет старый адрес. Приложения у моего сайта пока нет, поэтому обратный прокси не нужен; когда оно появится, nginx встанет перед ним и будет передавать запросы через proxy_pass.</p>
    </section>
  </body>
</html>
`
