	export const metadata = {
		id: '06-server/08-stack-choice',
		part: 6,
		order: 8,
		title: 'Собираем стек под проект',
		summary: 'Теперь всё из части складывается в один выбор: сервер, язык, API, вход и вебхуки под конкретный проект, с учётом российских реалий (хостинги, закон о хранении данных, зависимость от иностранных сервисов). После урока у вас есть схема серверной части и список рисков.',
		minutes: 20,
		teaches: ['server-stack-choice'],
		requires: ['server-language-niches', 'server-rest', 'server-authentication', 'server-webhooks'],
		practice: {
			id: 'server-stack',
			title: 'Схема серверной части вашего проекта на одной странице',
			task: 'Соберите схему. 1) В абзаце «Главное действие» назовите его словами из брифа и скажите, как оно заканчивается. 2) В списке #flow четыре шага (класс hop) пути данных от посетителя до владельца: назовите посетителя и владельца. 3) В таблице семь блоков (class="block"): страницы, язык и приложение, API, вход, заявки, данные, хостинг. В колонке «Выбор» конкретный инструмент или «не нужен», в «Зачем» причина; в одной из причин назовите пункт из вашего списка. 4) В абзаце про персональные данные скажите, где они физически хранятся и почему это важно (152-ФЗ, граждане РФ). 5) В списке #risks три риска (класс risk), у каждого план на случай отказа блока: резервная копия, запасной канал, ручной обход. Все «…» нужно заменить.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="stack">
      <h2>Серверная часть моего проекта</h2>
      <p id="goal">Главное действие: …</p>
      <ol id="flow">
        <li class="hop">…</li>
        <li class="hop">…</li>
        <li class="hop">…</li>
        <li class="hop">…</li>
      </ol>
      <table>
        <tr><th>Блок</th><th>Выбор</th><th>Зачем</th></tr>
        <tr class="block"><td>Страницы</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Язык и приложение</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>API</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Вход</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Заявки</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Данные</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Хостинг и сервер</td><td class="pick">…</td><td class="why">…</td></tr>
      </table>
      <p id="pd-location">Где хранятся персональные данные: …</p>
      <ol id="risks">
        <li class="risk">…</li>
        <li class="risk">…</li>
        <li class="risk">…</li>
      </ol>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="stack">
      <h2>Серверная часть моего проекта</h2>
      <p id="goal">Главное действие: «{{mainAction.label}}». Посетитель оставляет заявку, а владелец получает её в Telegram и на почту.</p>
      <ol id="flow">
        <li class="hop">Посетитель открывает страницу сайта: её отдаёт nginx как готовый файл.</li>
        <li class="hop">Посетитель заполняет форму и отправляет заявку по HTTPS на адрес API /api/v1/requests.</li>
        <li class="hop">Приложение проверяет данные, сохраняет заявку в базе и отвечает кодом 201.</li>
        <li class="hop">Вебхук отправляет заявку владельцу в Telegram и письмом, и владелец её видит.</li>
      </ol>
      <table>
        <tr><th>Блок</th><th>Выбор</th><th>Зачем</th></tr>
        <tr class="block"><td>Страницы</td><td class="pick">статика, собранная генератором, раздаёт nginx</td><td class="why">Разделы и список «{{items.0.title}}» меняются редко: готовые файлы быстрее и безопаснее.</td></tr>
        <tr class="block"><td>Язык и приложение</td><td class="pick">небольшое приложение на Node.js или PHP только для приёма заявок</td><td class="why">Динамика нужна в одном месте, остальное статика.</td></tr>
        <tr class="block"><td>API</td><td class="pick">REST по описанию OpenAPI</td><td class="why">Один список и одна заявка: GraphQL был бы лишним.</td></tr>
        <tr class="block"><td>Вход</td><td class="pick">не нужен посетителям; владельцу пасскей или ссылка с почты</td><td class="why">Посетителям аккаунт не нужен, а правит сайт один человек.</td></tr>
        <tr class="block"><td>Заявки</td><td class="pick">вебхук в Telegram и письмо на почту</td><td class="why">Владелец узнаёт о заявке сразу, и сбой одного канала не теряет её.</td></tr>
        <tr class="block"><td>Данные</td><td class="pick">небольшая база PostgreSQL</td><td class="why">Заявки надо где-то хранить, а база даёт и порядок, и резервные копии.</td></tr>
        <tr class="block"><td>Хостинг и сервер</td><td class="pick">VPS у российского провайдера (например, Selectel или Timeweb Cloud)</td><td class="why">Одного сервера с nginx хватает, а данные остаются на территории России.</td></tr>
      </table>
      <p id="pd-location">Где хранятся персональные данные: заявки с именами и телефонами записываются в базу на сервере в России (российский провайдер): закон 152-ФЗ требует первично хранить персональные данные граждан РФ на территории России. Копия в Telegram и на почте основное хранилище не заменяет.</p>
      <ol id="risks">
        <li class="risk">Приложение с формой упало: страницы остаются доступны, а на странице указаны телефон и почта для заявок; мониторинг сообщит о сбое.</li>
        <li class="risk">Telegram недоступен: заявка дублируется письмом на почту, поэтому владелец её не потеряет.</li>
        <li class="risk">Сервер потерян: резервная копия базы ежедневно уезжает в другое место, а сайт разворачивается из репозитория за час.</li>
      </ol>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			checks: [
				{
					id: 'stack-section',
					kind: 'exists',
					selector: '#stack'
				},
				{
					id: 'no-blanks',
					kind: 'text',
					selector: '#stack',
					matches: '^[^…]*$'
				},
				{
					id: 'goal-label',
					kind: 'field',
					selector: '#goal',
					field: 'mainAction.label'
				},
				{
					id: 'four-hops',
					kind: 'count',
					selector: '#flow li.hop',
					min: 4
				},
				{
					id: 'flow-ends',
					kind: 'text',
					selector: '#flow',
					matches: '^(?=[\\s\\S]*[Пп]осетител)(?=[\\s\\S]*(?:[Вв]ладел|[Аа]дминистратор|[Мм]енеджер))'
				},
				{
					id: 'seven-blocks',
					kind: 'count',
					selector: '#stack tr.block',
					min: 7
				},
				{
					id: 'concrete-picks',
					kind: 'text',
					selector: '#stack td.pick',
					matches: 'nginx|Caddy|Apache|PHP|Python|Node|Go\\b|Elixir|Ruby|Java|WordPress|Битрикс|Tilda|REST|GraphQL|OpenAPI|PostgreSQL|SQLite|Telegram|почт|не нужен|не нужна|пасскей|Яндекс|VK|Selectel|Timeweb|Reg|Облако|статик'
				},
				{
					id: 'mentions-item',
					kind: 'field',
					selector: '#stack td.why',
					field: 'items[].title',
					min: 1,
					when: {
						brief: 'items[].title'
					}
				},
				{
					id: 'pd-location',
					kind: 'text',
					selector: '#pd-location',
					matches: '^(?=[\\s\\S]*(?:РФ|России|российск))(?=[\\s\\S]*(?:152|локализ|закон))'
				},
				{
					id: 'three-risks',
					kind: 'count',
					selector: '#risks li.risk',
					min: 3
				},
				{
					id: 'risk-plans',
					kind: 'text',
					selector: '#risks',
					matches: 'резерв|копи|запас|план|переключ|вручную|дублир|почт'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'С чего начинать выбор стека для проекта?',
				options: [
					'С главного действия посетителя и пути данных от него до владельца: потом подбирать под это инструменты',
					'С самого модного языка',
					'С самого дорогого хостинга'
				],
				answer: 0,
				why: [
					'Да. Стек служит задаче: если известно, что заявка должна дойти до владельца, видно, какие блоки нужны, а какие лишние.',
					'Нет: мода пройдёт, а проект останется с неподходящим инструментом.',
					'Нет: цена хостинга не связана с тем, что проекту нужно.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что из этого нужно сайту-визитке с формой заявки?',
				options: [
					'Хостинг или сервер для статических страниц',
					'Способ принять заявку: приложение или сервис форм',
					'Уведомление владельцу о заявке',
					'Кластер Kubernetes'
				],
				answer: [0, 1, 2],
				why: [
					'Да: страницам нужен адрес, по которому их отдают.',
					'Да: форме нужен приёмник, пусть самый маленький.',
					'Да: заявка, о которой никто не узнал, потеряна.',
					'Нет: Kubernetes для визитки это сложность, которая себя не окупит. О нём в части про инфраструктуру.'
				]
			},
			{
				type: 'single',
				prompt: 'Заявки с именем и телефоном граждан России лучше хранить...',
				options: [
					'В базе на сервере на территории России: этого требует закон о персональных данных',
					'Только в Telegram: так дешевле',
					'Где угодно: закон про это молчит'
				],
				answer: 0,
				why: [
					'Да. 152-ФЗ требует, чтобы первичная запись и хранение персональных данных граждан РФ шли в базах на территории России. Копии в других местах допустимы, но это нужно честно описать в политике. Детали стоит обсудить с юристом.',
					'Нет: мессенджер не заменяет хранилище, а Telegram к тому же находится за пределами России.',
					'Нет: закон об этом говорит прямо, и штрафы за нарушение существуют.'
				]
			},
			{
				type: 'single',
				prompt: 'Что значит «план на случай отказа блока»?',
				options: [
					'Заранее известно, что сделать, если блок сломался: запасной канал, резервная копия, ручной обход',
					'План по замене всех блоков раз в год',
					'Надежда, что блок не сломается'
				],
				answer: 0,
				why: [
					'Да. Сбоят все, и вопрос не «если», а «когда». Хороший план короткий: «заявку дублируем письмом», «копия лежит в другом месте».',
					'Нет: это план обновлений, а не план реагирования.',
					'Нет: надежда не план.'
				]
			},
			{
				type: 'single',
				prompt: 'Чем опасна опора на один иностранный сервис в важном блоке (например, приём платежей или форм)?',
				options: [
					'Он может стать недоступным или перестать принимать оплату из России: нужен запасной вариант',
					'Иностранные сервисы всегда ненадёжны',
					'Ничем: они лучше российских'
				],
				answer: 0,
				why: [
					'Да. Условия и доступность иностранных сервисов для российских пользователей меняются быстро. Для каждого важного блока продумайте замену, чтобы переезд был днями, а не месяцами.',
					'Нет: дело не в качестве, а в зависимости от условий, которых вы не контролируете.',
					'Нет: утверждение «лучше» не отвечает на вопрос о рисках.'
				]
			},
			{
