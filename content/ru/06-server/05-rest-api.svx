	export const metadata = {
		id: '06-server/05-rest-api',
		part: 6,
		order: 5,
		title: 'API и REST: как программы разговаривают друг с другом',
		definition: 'API — правила, по которым программы обмениваются данными. REST — стиль HTTP API: адрес называет ресурс, метод выражает действие, код сообщает результат.',
		summary: 'Страница и сервер, а часто и две программы разных компаний, общаются по правилам API. После урока вы читаете и проектируете простой HTTP API: ресурсы, методы GET, POST, PUT и DELETE, коды ответа, ошибки и версии, и описываете его файлом OpenAPI.',
		minutes: 30,
		teaches: ['server-rest', 'server-openapi'],
		requires: ['net-http-request-response', 'js-fetch', 'js-json'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'browser', label: 'GET /items/7', caption: 'Существительное', say: 'Адрес называет вещь: /items/7, седьмое предложение. Действие в адресе не пишут, его говорит метод.' },
				{ mood: 'hint', side: 'right', prop: 'server', label: 'DELETE /items/7', caption: 'Дважды', say: 'DELETE идемпотентен: два одинаковых запроса оставят сервер таким же, как один. Если ответа не было, повторить можно.' },
				{ mood: 'hmm', prop: 'browser', label: 'GET /deleteItem?id=1', caption: 'Так нельзя', say: 'GET должен быть безопасным. Адрес, который удаляет, может открыть робот или предзагрузка, и товара нет.' },
				{ mood: 'cheer', side: 'right', prop: 'server', label: '201 Created', say: 'А ответ говорит код: 201 создано, 404 нет такого, 401 нужно войти, 403 войти мало, 500 это сломались мы.' }
			]
		},
		practice: {
			id: 'server-openapi',
			title: 'Описание API вашего проекта по OpenAPI',
			task: 'Песочница не проверяет YAML, поэтому описание вы пишете текстом в блоке pre id="openapi" (вместо «…»), как файл openapi.yaml, и сверяете с примером из урока. Опишите API для ваших предложений и заявок. 1) Версия: openapi: 3.1.0, info, servers с адресом https://…/api/v1. 2) Пути-существительные во множественном числе: /items для списка предложений (get) и /items/{id} для одного, а для заявки из формы /requests (post). Глаголов в путях быть не должно. 3) У GET нет побочных эффектов; заявка создаётся методом POST и отвечает 201 (или 202). 4) Описаны ответы 200, 400 и 404 и общий формат ошибки в components.schemas.Error (поля code и message). 5) У заявки перечислены обязательные поля required и сказано, что персональные данные принимаются только по HTTPS.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="api-spec">
      <h2>Описание API моего проекта</h2>
      <pre id="openapi">…<\/pre>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
