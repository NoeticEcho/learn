}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="api-spec">
      <h2>Описание API моего проекта</h2>
      <pre id="openapi">openapi: 3.1.0
info:
  title: API моего сайта
  version: 1.0.0
servers:
  - url: https://example.ru/api/v1
paths:
  /items:
    get:
      summary: Список предложений
      responses:
        '200':
          description: Массив предложений
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Item'
  /items/{id}:
    get:
      summary: Одно предложение
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Предложение
        '404':
          description: Такого предложения нет
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
  /requests:
    post:
      summary: Создать заявку из формы
      description: Принимает персональные данные посетителя, поэтому работает только по HTTPS.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name, phone]
              properties:
                name:
                  type: string
                phone:
                  type: string
                comment:
                  type: string
      responses:
        '201':
          description: Заявка создана
        '400':
          description: Данные заявки неверны
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
components:
  schemas:
    Item:
      type: object
      properties:
        title:
          type: string
        price:
          type: string
    Error:
      type: object
      properties:
        code:
          type: string
        message:
          type: string<\/pre>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			checks: [
				{
					id: 'spec-section',
					kind: 'exists',
					selector: '#api-spec #openapi'
				},
				{
					id: 'no-blanks',
					kind: 'text',
					selector: '#openapi',
					matches: '^[^…]*$'
				},
				{
					id: 'version',
					kind: 'text',
					selector: '#openapi',
					matches: '(?:^|\\n)\\s*openapi:\\s*3\\.\\d\\.\\d'
				},
				{
					id: 'servers-https',
					kind: 'text',
					selector: '#openapi',
					matches: 'url:\\s*https://\\S+'
				},
				{
					id: 'plural-nouns',
					kind: 'text',
					selector: '#openapi',
					matches: '(?:^|\\n)\\s{2}/[a-z][a-z-]*s:\\s*(?:\\n|$)'
				},
				{
					id: 'no-verbs',
					kind: 'text',
					selector: '#openapi',
					matches: '^(?![\\s\\S]*\\n\\s{2}/(?:get|create|add|delete|update|remove|list|fetch|send|save)[A-Za-z-]*[:/])'
				},
				{
					id: 'one-item-path',
					kind: 'text',
					selector: '#openapi',
					matches: '(?:^|\\n)\\s{2}/[a-z][a-z-]*s/\\{\\w+\\}:'
				},
				{
					id: 'get-operation',
					kind: 'text',
					selector: '#openapi',
					matches: '(?:^|\\n)\\s{4}get:'
				},
				{
					id: 'post-creates',
					kind: 'text',
					selector: '#openapi',
					matches: '(?:^|\\n)\\s{4}post:[\\s\\S]*[\'"]?20[12][\'"]?\\s*:'
				},
				{
					id: 'statuses',
					kind: 'text',
					selector: '#openapi',
					matches: '^(?=[\\s\\S]*[\'"]?200[\'"]?\\s*:)(?=[\\s\\S]*[\'"]?400[\'"]?\\s*:)(?=[\\s\\S]*[\'"]?404[\'"]?\\s*:)'
				},
				{
					id: 'error-schema',
					kind: 'text',
					selector: '#openapi',
					matches: 'Error:[\\s\\S]*code:[\\s\\S]*message:|Error:[\\s\\S]*message:[\\s\\S]*code:'
				},
				{
					id: 'required-fields',
					kind: 'text',
					selector: '#openapi',
					matches: 'required:\\s*\\[[^\\]]+\\]|required:\\s*\\n\\s*-\\s*\\w+'
				},
				{
					id: 'https-personal-data',
					kind: 'text',
					selector: '#openapi',
					matches: '^(?=[\\s\\S]*(?:HTTPS|https))(?=[\\s\\S]*персональн)'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Страница обращается к адресу GET /items?delete=2, и после этого пункт 2 пропадает. Что не так?',
				options: [
					'GET должен быть безопасным и ничего не менять: для удаления нужен DELETE',
					'Всё правильно: адрес вы выбрали сами',
					'Нужно было использовать POST для чтения списка'
				],
				answer: 0,
				why: [
					'Да. GET считается безопасным: его вправе вызывать кто угодно и сколько угодно раз (браузер, поисковый робот, расширение). Если от него что-то удаляется, то один любопытный робот сотрёт ваши данные.',
					'Нет: свободный выбор адреса не отменяет правил методов. От них зависят кэши, роботы и безопасность.',
					'Нет: чтение списка это как раз GET.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините метод HTTP с его обычным смыслом в API',
				pairs: [
					['GET', 'прочитать ресурс, ничего не меняя'],
					['POST', 'создать новый ресурс или выполнить действие'],
					['PUT', 'заменить ресурс целиком'],
					['PATCH', 'изменить часть полей ресурса'],
					['DELETE', 'удалить ресурс']
				]
			},
			{
				type: 'single',
				prompt: 'Какой адрес лучше для списка предложений в REST-стиле?',
				options: ['GET /items', 'GET /getAllItems', 'POST /items/list'],
				answer: 0,
				why: [
					'Да. Адрес называет ресурс (предложения, во множественном числе), а действие выражает метод. Так API получается предсказуемым: /items, /items/7, /requests.',
					'Нет: глагол в адресе дублирует то, что уже сказал метод GET.',
					'Нет: читать нужно GET, а POST означает «создать».'
				]
			},
			{
				type: 'single',
				prompt: 'Заявка принята и создана на сервере. Какой код ответа ожидается?',
				options: ['201 Created, обычно с заголовком Location', '200 OK без пояснений', '404 Not Found'],
				answer: 0,
				why: [
					'Да. 201 сообщает, что ресурс создан, а Location называет его адрес. 202 берут, если заявку приняли, но обрабатывают позже.',
					'Формально можно, но 201 информативнее: он говорит именно о создании.',
					'Нет: 404 означает, что чего-то нет, а не то, что оно создано.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что полезно включить в сообщение об ошибке API?',
				options: [
					'Правильный код состояния (400, 404, 409…)',
					'Короткий машинный код ошибки',
					'Понятный человеку текст без секретов',
					'Подробный стек вызовов и пароль к базе'
				],
				answer: [0, 1, 2],
				why: [
					'Да: код сразу сообщает класс беды.',
					'Да: по нему клиентская программа решает, что делать (повторить, показать поле, выйти).',
					'Да: текст помогает разработчику и посетителю, но не должен раскрывать внутреннее устройство.',
					'Нет: так утекают пароли и устройство сервера. Подробности пишут в журнал, а не в ответ.'
				]
			},
			{
				type: 'single',
				prompt: 'Зачем нужен файл OpenAPI?',
				options: [
					'Это описание API в машиночитаемом виде: по нему строят документацию, проверяют запросы и генерируют клиентов',
					'Он ускоряет работу сервера',
					'Он заменяет базу данных'
				],
				answer: 0,
				why: [
					'Да. Один файл служит договором между теми, кто делает сервер, и теми, кто его использует. Из него автоматически получается интерактивная документация (Swagger UI), заготовки кода и тесты.',
					'Нет: сервер он не ускоряет, он описывает его интерфейс.',
					'Нет: базы он не заменяет.'
				]
			}
		],
		cards: [
			{
				id: 'server-rest-what',
				front: 'Что такое REST?',
				back: 'Стиль проектирования web API из диссертации Роя Филдинга (2000): ресурсы с адресами, методы HTTP как действия, коды состояния, ответы без привязки к прошлым запросам. Чаще всего это JSON по HTTP.'
			},
			{
				id: 'server-rest-methods',
				front: 'Какие методы HTTP и что они значат?',
				back: 'GET: прочитать (безопасный). POST: создать. PUT: заменить целиком. PATCH: изменить часть. DELETE: удалить. GET, PUT и DELETE идемпотентны: повтор даёт тот же результат.'
			},
			{
				id: 'server-rest-codes',
				front: 'Какие коды ответа API нужно знать?',
				back: '200 успех, 201 создано, 204 успех без тела, 400 ошибка в запросе, 401 нет входа, 403 нельзя, 404 нет такого, 409 конфликт, 429 слишком часто, 500 ошибка сервера.'
			},
			{
				id: 'server-api-errors',
				front: 'Как оформить ошибки API?',
				back: 'Одинаково везде: код состояния, короткий код ошибки и понятный текст (поля code и message или формат RFC 9457). Без секретов и стека вызовов.'
			},
