  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="classify">
      <h2>Статика или динамика</h2>
      <table>
        <tr><th>Часть сайта</th><th>Статика или динамика</th><th>Почему</th></tr>
        {{#each sections}}<tr class="part"><td>{{.}}</td><td class="kind">статика</td><td class="why">Текст раздела меняется редко, поэтому его отдают готовым файлом.</td></tr>
        {{/each}}
        <tr class="part items"><td>Список предложений</td><td class="kind">статика</td><td class="why">Список меняется редко: при правке сайт пересобирается заново, и всё лежит готовыми файлами.</td></tr>
        <tr class="part form"><td>Форма заявки</td><td class="kind">динамика</td><td class="why">Заявку надо принять и переслать владельцу, поэтому нужен сервер или сервис-посредник, который это сделает.</td></tr>
        <tr class="part login"><td>Вход для посетителей</td><td class="kind">динамика</td><td class="why">Вход проверяет пароль и запоминает человека, а это работа сервера; пока он не нужен, но с ним сайт стал бы динамическим.</td></tr>
      </table>
      <p id="db">Нужна ли база данных: нужна позже. Сейчас содержание меняется редко и умещается в файлы, поэтому база не нужна; заявки уходят на почту через сервис-посредник. Если появятся вход или заказы, потребуется база, чтобы хранить людей и заявки.</p>
      <p id="cache">Кэширование: страницы статические, поэтому их кэшируют целиком: заголовок Cache-Control и CDN отдают готовый файл без обращения к серверу, а динамическую часть (форму) кэшировать не надо.</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			checks: [
				{
					id: 'classify-section',
					kind: 'exists',
					selector: '#classify'
				},
				{
					id: 'no-blanks',
					kind: 'text',
					selector: '#classify',
					matches: '^[^…]*$'
				},
				{
					id: 'part-per-section',
					kind: 'count',
					selector: '#classify tr.part',
					min: {
						brief: 'sections'
					}
				},
				{
					id: 'sections-named',
					kind: 'field',
					selector: '#classify tr.part',
					field: 'sections'
				},
				{
					id: 'kinds-words',
					kind: 'text',
					selector: '#classify td.kind',
					matches: '^\\s*(?:[Сс]татика|[Дд]инамика)\\s*$'
				},
				{
					id: 'form-dynamic',
					kind: 'text',
					selector: '#classify tr.form td.kind',
					matches: '[Дд]инамика'
				},
				{
					id: 'form-needs-server',
					kind: 'text',
					selector: '#classify tr.form td.why',
					matches: 'сервер|посредник|сервис|функци'
				},
				{
					id: 'login-dynamic',
					kind: 'text',
					selector: '#classify tr.login td.kind',
					matches: '[Дд]инамика'
				},
				{
					id: 'reasons',
					kind: 'text',
					selector: '#classify td.why',
					matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'
				},
				{
					id: 'db-answer',
					kind: 'text',
					selector: '#db',
					matches: '^(?=[\\s\\S]*[Бб]аз)(?=[\\s\\S]*(?:потому|так как|поскольку|чтобы|если|пока))'
				},
				{
					id: 'cache-answer',
					kind: 'text',
					selector: '#cache',
					matches: '[Кк]эш|[Кк]еш|Cache-Control|CDN'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Чем статическая страница отличается от динамической?',
				options: [
					'Статическая лежит на сервере готовым файлом, динамическую сервер собирает заново под каждый запрос',
					'Статическая не содержит картинок',
					'Динамическая страница обязательно с анимацией'
				],
				answer: 0,
				why: [
					'Да. Дело не во внешнем виде, а в том, где и когда страница получает свой окончательный вид: заранее (статика) или в момент запроса (динамика).',
					'Нет: в статической странице картинок сколько угодно. Статика про то, как она получена, а не про то, что в ней есть.',
					'Нет: анимация делается в браузере и к этому делению не относится.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что из этого обычно делается динамически, то есть требует кода на сервере?',
				options: [
					'Корзина с товарами конкретного покупателя',
					'Результаты поиска по сайту',
					'Текст страницы «О компании», который меняется раз в год',
					'Страница после входа в личный кабинет'
				],
				answer: [0, 1, 3],
				why: [
					'Да: у каждого покупателя своя корзина, и хранится она на сервере.',
					'Да: ответ зависит от того, что искали, и собирается в момент запроса.',
					'Нет: такой текст проще отдавать готовым файлом и обновлять при правке.',
					'Да: после входа страница показывает данные именно этого человека.'
				]
			},
			{
				type: 'single',
				prompt: 'Почему статический сайт обычно быстрее, дешевле и безопаснее динамического?',
				options: [
					'Отдать готовый файл проще, чем запускать код и базу, и ломать на сервере почти нечего',
					'Потому что статика всегда красивее',
					'Потому что для статики не нужен сервер вообще'
				],
				answer: 0,
				why: [
					'Да. Ответ готов заранее, его можно положить в кэш и раздавать через CDN. Нет кода, нет базы, нет паролей на сервере: меньше точек, куда злоумышленник мог бы пробраться.',
					'Нет: красота здесь ни при чём.',
					'Нет: сервер нужен, но очень простой: он только отдаёт файлы. Часто за вас это делает хостинг или CDN.'
				]
			},
			{
				type: 'order',
				prompt: 'Расставьте шаги, через которые проходит запрос к динамической странице',
				items: [
					'Сервер получает запрос и находит нужный код',
					'Код обращается к базе данных',
					'База возвращает данные',
					'Код собирает из данных HTML-страницу',
					'Сервер отправляет страницу посетителю'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что ускоряет динамическую страницу?',
				options: [
					'Кэш готовых страниц или их кусков',
					'Индексы в базе данных',
					'Кэш запросов к базе',
					'Больше картинок на странице'
				],
				answer: [0, 1, 2],
				why: [
					'Да: если страница не меняется несколько минут, её можно собрать один раз и отдавать готовую.',
					'Да: индекс позволяет базе не перебирать все записи, а найти нужную сразу.',
					'Да: одинаковые запросы к базе не повторяют, ответ берут из памяти.',
					'Нет: лишние картинки замедляют, а не ускоряют.'
				]
			},
			{
				type: 'single',
				prompt: 'На статическом сайте нужна форма заявки. Как её сделать без своего сервера?',
				options: [
					'Отправлять данные формы сервису-посреднику (форм-бэкенду) или облачной функции, которые перешлют заявку на почту',
					'Никак: форма невозможна без собственного сервера',
					'Сохранять заявки в файл на странице у посетителя'
				],
				answer: 0,
				why: [
					'Да. Приём данных всё равно требует чужого сервера, но не обязательно вашего: форм-бэкенд или функция в облаке берёт эту работу на себя. Такой подход называют Jamstack.',
					'Нет: готовые сервисы закрывают именно эту задачу.',
					'Нет: файл на компьютере посетителя вы никогда не получите.'
				]
			}
		],
		cards: [
			{
				id: 'server-static',
				front: 'Что такое статическая страница?',
				back: 'Готовый файл, который сервер просто отдаёт. Её вид определён заранее. Быстро, дёшево, просто кэшировать и безопасно: на сервере нет кода и базы.'
			},
			{
				id: 'server-dynamic',
				front: 'Что такое динамическая страница?',
				back: 'Страница, которую код на сервере собирает под каждый запрос: по данным из базы, по пользователю, по поиску. Нужна, когда ответ зависит от человека или от свежих данных.'
			},
			{
				id: 'server-tradeoffs',
				front: 'Чем платят за динамику?',
				back: 'Скоростью (код и база на каждый запрос), деньгами (сервер с запасом), безопасностью (больше мест для атаки) и сложностью (надо обновлять, мониторить, делать резервные копии).'
			},
			{
				id: 'server-cache',
				front: 'Как ускорить динамическую страницу?',
				back: 'Кэшировать: готовую страницу целиком, её куски или запросы к базе. Статические части (картинки, стили) отдавать отдельно и через CDN. В базе делать индексы.'
			},
			{
				id: 'server-form-static',
				front: 'Как поставить форму на статический сайт?',
				back: 'Через сервис-посредник (форм-бэкенд) или облачную функцию: форма отправляет данные им, а они пересылают заявку на почту или в мессенджер. Своего сервера не нужно.'
			}
		],
		sources: [
			{
				title: 'MDN: Introduction to the server side',
				url: 'https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Server-side/First_steps/Introduction',
				licence: 'CC-BY-SA',
				kind: 'docs',
				lang: 'en'
			},
