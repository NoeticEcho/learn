      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="classify">
      <h2>Статика или динамика</h2>
      <table>
        <tr><th>Часть сайта</th><th>Статика или динамика</th><th>Почему</th></tr>
        {{#each sections}}<tr class="part"><td>{{.}}</td><td class="kind">…</td><td class="why">…</td></tr>
        {{/each}}
        <tr class="part items"><td>Список предложений</td><td class="kind">…</td><td class="why">…</td></tr>
        <tr class="part form"><td>Форма заявки</td><td class="kind">…</td><td class="why">…</td></tr>
        <tr class="part login"><td>Вход для посетителей</td><td class="kind">…</td><td class="why">…</td></tr>
      </table>
      <p id="db">Нужна ли база данных: …</p>
      <p id="cache">Кэширование: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
