          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="auth-plan">
      <h2>Нужен ли вход на моём сайте</h2>
      <p id="need">Нужен ли вход: …</p>
      <p id="method">Способ входа: …</p>
      <table>
        <tr><th>Роль</th><th>Что можно</th></tr>
        <tr class="role"><td>Посетитель</td><td class="can">…</td></tr>
        <tr class="role"><td>Владелец</td><td class="can">…</td></tr>
        <tr class="role"><td>…</td><td class="can">…</td></tr>
      </table>
      <p id="passwords">Пароли: …</p>
      <p id="pd">Персональные данные при входе: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

