        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
