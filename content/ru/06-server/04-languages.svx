`
			},
			checks: [
				{
					id: 'choice-section',
					kind: 'exists',
					selector: '#language-choice'
				},
				{
					id: 'no-blanks',
					kind: 'text',
					selector: '#language-choice',
					matches: '^[^…]*$'
				},
				{
					id: 'three-languages',
					kind: 'count',
					selector: '#language-choice tr.lang',
					min: 3
				},
				{
					id: 'language-names',
					kind: 'text',
					selector: '#language-choice td.name',
					matches: 'PHP|Python|Ruby|Java|C#|Go|JavaScript|Node|Elixir|Rust|Kotlin'
				},
				{
					id: 'scores',
					kind: 'text',
					selector: '#language-choice td.score',
					matches: '^\\s*[1-5]\\s*$'
				},
				{
					id: 'totals',
					kind: 'text',
					selector: '#language-choice td.total',
					matches: '^\\s*\\d{1,2}\\s*$'
				},
				{
					id: 'choice-reasoned',
					kind: 'text',
					selector: '#choice',
					matches: '^(?=[\\s\\S]*(?:PHP|Python|Ruby|Java|C#|Go|JavaScript|Node|Elixir|Rust|Kotlin))(?=[\\s\\S]*(?:потому|так как|поскольку|ведь|значит))'
				},
				{
					id: 'choice-uses-brief',
					kind: 'field',
					selector: '#choice',
					field: 'sections',
					min: 1
				},
				{
					id: 'hiring',
					kind: 'text',
					selector: '#hiring',
					matches: 'найти|найм|hh\\.ru|[Хх]абр|сообществ|фриланс|студи|вакан'
				},
				{
					id: 'revisit',
					kind: 'text',
					selector: '#revisit',
					matches: '^(?=[\\s\\S]*(?:если|когда|при))(?=[\\s\\S]*\\S{4,})'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Вам нужен сайт-визитка, и вы выбираете WordPress. Какой язык «в комплекте»?',
				options: ['PHP', 'Rust', 'Elixir'],
				answer: 0,
				why: [
					'Да. WordPress написан на PHP, как и Drupal, Joomla и 1С-Битрикс. Выбирая движок, вы выбираете и язык.',
					'Нет: на Rust ни одного из популярных движков для сайтов-визиток нет.',
					'Нет: Elixir выбирают для других задач: чатов, потоков событий.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините язык с его типичной нишей',
				pairs: [
					['PHP', 'сайты на движках и недорогой хостинг'],
					['Python', 'быстрая разработка, данные и нейросети, фреймворк Django'],
					[
						'Go',
						'простые быстрые сервисы с множеством одновременных запросов'
					],
					['Elixir', 'чаты и потоки событий: тысячи соединений на одной машине'],
					['Rust', 'там, где важны предельная скорость и безопасность памяти']
				]
			},
			{
				type: 'multiple',
				prompt: 'Что стоит учесть при выборе языка для проекта?',
				options: [
					'Что проект должен делать (формы, чат, вычисления)',
					'Кого можно нанять и как быстро',
					'Где проект будет жить (какой хостинг умеет этот язык)',
					'Какой язык сейчас на слуху'
				],
				answer: [0, 1, 2],
				why: [
					'Да: задача определяет требования к скорости, параллельности и устройству сервера.',
					'Да: язык, на котором некому писать, обойдётся дороже любого другого.',
					'Да: дешёвый хостинг часто умеет только PHP, а для других языков нужен свой сервер.',
					'Нет: мода быстро проходит, а проект остаётся.'
				]
			},
			{
				type: 'single',
				prompt: 'Rust быстрее PHP. Почему для сайта-визитки его почти никто не берёт?',
				options: [
					'Скорость выполнения не узкое место визитки, а высокий порог входа и мало готовых движков дорого обходятся',
					'Rust не умеет работать по сети',
					'Rust запрещён на хостингах'
				],
				answer: 0,
				why: [
					'Да. Узкое место обычного сайта: сеть, база и разработка, а не скорость языка. Платить сложностью за ненужную скорость невыгодно.',
					'Нет: умеет, и на нём пишут быстрые сетевые сервисы.',
					'Нет: запрета нет, он просто реже предустановлен на дешёвом хостинге.'
				]
			},
			{
				type: 'single',
				prompt: 'Чем объясняют выбор Elixir для чатов и систем уведомлений?',
				options: [
					'Он работает на виртуальной машине Erlang, созданной для телефонных систем: очень много лёгких параллельных процессов и устойчивость к сбоям',
					'Он самый распространённый язык в мире',
					'Он выполняется прямо в браузере'
				],
				answer: 0,
				why: [
					'Да. Erlang придумали в Ericsson для телефонных станций, где миллионы звонков идут одновременно и не должны обрываться. Elixir (2011) даёт современный язык поверх той же машины.',
					'Нет: он нишевый, и специалистов по нему мало, особенно в России.',
					'Нет: в браузере выполняется JavaScript.'
				]
			},
			{
				type: 'single',
				prompt: 'Что означает «порог входа» в таблице, где 5 означает лучшую оценку?',
				options: [
					'5: начать легко, мало знаний и инструментов нужно сразу',
					'5: язык очень сложный',
					'5: язык самый быстрый'
				],
				answer: 0,
				why: [
					'Да. Мы условились, что большее число всегда лучше для проекта. Для порога входа это означает «низкий», то есть легко начать.',
					'Нет: тогда пятёрка была бы плохой оценкой, а в таблице все критерии устроены одинаково.',
					'Нет: скорость выполнения это отдельный столбец.'
				]
			}
		],
		cards: [
			{
				id: 'server-niche-php',
				front: 'Где живёт PHP и почему?',
				back: 'Сайты на движках: WordPress, Битрикс, Drupal, Laravel. Дешёвый хостинг, модель «запрос — процесс», огромная экосистема и множество специалистов. Слабее там, где нужны долгие соединения.'
			},
			{
				id: 'server-niche-python-ruby',
				front: 'Чем известны Python и Ruby на сервере?',
				back: 'Python (Django, Flask, FastAPI): быстрая разработка, данные и нейросети. Ruby (Rails, 2004): скорость создания продуктов, «соглашения вместо настроек». Оба медленнее Go или Java, но для большинства сайтов хватает.'
			},
