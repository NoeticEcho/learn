  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			checks: [
				{
					id: 'path-section',
					kind: 'exists',
					selector: '#request-path'
				},
				{
					id: 'no-blanks',
					kind: 'text',
					selector: '#request-path',
					matches: '^[^…]*$'
				},
				{
					id: 'four-steps',
					kind: 'count',
					selector: '#steps li.step',
					min: 4
				},
				{
					id: 'step-words',
					kind: 'text',
					selector: '#steps',
					matches: '^(?=[\\s\\S]*сервер)(?=[\\s\\S]*(?:обработчик|PHP|приложен|код))(?=[\\s\\S]*баз)(?=[\\s\\S]*ответ)'
				},
				{
					id: 'names-section',
					kind: 'field',
					selector: '#steps',
					field: 'sections',
					min: 1
				},
				{
					id: 'model-chosen',
					kind: 'text',
					selector: '#model',
					matches: '^(?=[\\s\\S]*процесс)(?=[\\s\\S]*прилож)(?=[\\s\\S]*(?:выбра|выбир|подходит))'
				},
				{
					id: 'cache-place',
					kind: 'text',
					selector: '#cache-place',
					matches: '^(?=[\\s\\S]*[Кк]эш)(?=[\\s\\S]*храни)'
				},
				{
					id: 'php-hosting',
					kind: 'text',
					selector: '#php-hosting',
					matches: '^(?=[\\s\\S]*PHP)(?=[\\s\\S]*хостинг)(?=[\\s\\S]*(?:потому|так как|поскольку|минус|плюс))'
				}
			]
		},
		quiz: [
			{
				type: 'match',
				prompt: 'Соедините подход с его устройством',
				pairs: [
					[
						'CGI',
						'на каждый запрос запускается новая программа, которая отвечает и умирает'
					],
					[
						'PHP',
						'код вставлен прямо в страницу, а каждый запрос начинается с чистого листа'
					],
					[
						'PHP-FPM',
						'пул готовых рабочих процессов: не нужно запускать интерпретатор заново'
					],
					[
						'сервер приложений',
						'одна живая программа, которая принимает множество запросов и держит общую память'
					]
				]
			},
			{
				type: 'single',
				prompt: 'Почему CGI не годится для сайтов с большим числом посетителей?',
				options: [
					'Каждый запрос запускает новый процесс, а это дорого: сервер тратит больше времени на старт, чем на ответ',
					'CGI не умеет отдавать HTML',
					'CGI работает только по почте'
				],
				answer: 0,
				why: [
					'Да. Запуск программы на каждый запрос съедает время и память. Поэтому придумали держать готовых работников (FastCGI, PHP-FPM) и вообще не убивать программу (серверы приложений).',
					'Нет: отдавать HTML CGI умеет, это был первый способ сделать динамический сайт.',
					'Нет: он не имеет отношения к почте, это интерфейс между веб-сервером и программой.'
				]
			},
			{
				type: 'single',
				prompt: 'Почему WordPress и 1С-Битрикс написаны на PHP, а не на Python или Go?',
				options: [
					'PHP был на любом дешёвом хостинге, а его модель «запрос — процесс» проста для сайтов, собираемых из базы',
					'Другие языки не умеют работать с базами данных',
					'PHP самый быстрый язык из существующих'
				],
				answer: 0,
				why: [
					'Да. В 2000-е PHP был установлен у любого провайдера, его было легко развернуть, а модель «собрать страницу и забыть» идеально подходила сайтам. Так возникла экосистема, которую уже не заменить.',
					'Нет: умеют все. Причина была в доступности и истории.',
					'Нет: по скорости он ничем не выдающийся, а современный PHP хорошо оптимизирован, но не рекордсмен.'
				]
			},
			{
				type: 'single',
				prompt: 'Для чата или онлайн-игры чаще берут Node.js, Go или Elixir, а не классический PHP. Почему?',
				options: [
					'Им нужны долгие соединения и общее состояние в памяти, а PHP после каждого запроса всё забывает',
					'Чат нельзя написать на PHP',
					'Эти языки не нуждаются в сервере'
				],
				answer: 0,
				why: [
					'Да. Чат держит открытое соединение с каждым посетителем и рассылает сообщения всем сразу: нужна живая программа. Модель PHP для этого неудобна, хотя технически обойти её можно.',
					'Нет: можно, только неудобно: сначала придётся подключать дополнительные инструменты.',
					'Нет: серверный код нужен всегда, вопрос в том, как он устроен.'
				]
			},
			{
				type: 'order',
				prompt: 'Расставьте подходы по порядку появления идей',
				items: [
					'CGI: программа на каждый запрос',
					'PHP: код внутри страницы',
					'FastCGI и PHP-FPM: пул готовых процессов',
					'Серверы приложений: одна живая программа (например, на Node.js)'
				]
			},
			{
				type: 'single',
				prompt: 'Что происходит с переменными PHP-скрипта после того, как страница отдана?',
				options: [
					'Исчезают: следующий запрос начинается с чистого листа, поэтому состояние хранят в базе, сессии или кэше',
					'Остаются в памяти до перезапуска сервера',
					'Передаются следующему посетителю'
				],
				answer: 0,
				why: [
					'Да. Это самое важное свойство модели «запрос — процесс»: никакого общего состояния между запросами, а значит, мало шансов на утечки памяти и странные ошибки. Платой стала необходимость хранить всё нужное снаружи.',
					'Нет: так ведут себя серверы приложений, и именно у них бывают утечки памяти.',
					'Нет: этого не бывает, и хорошо: иначе посетители видели бы друг друга.'
				]
			}
		],
		cards: [
			{
				id: 'server-cgi',
				front: 'Что такое CGI?',
				back: 'Common Gateway Interface (1993): договорённость, как веб-сервер запускает программу и передаёт ей запрос. Новая программа на каждый запрос. Работало, но дорого при большой нагрузке.'
			},
			{
				id: 'server-php-model',
				front: 'Как устроена модель PHP?',
				back: 'Запрос приходит, PHP выполняет скрипт от начала до конца, отдаёт страницу и всё забывает. Следующий запрос начинается с чистого листа. Просто и надёжно, но состояние надо хранить в базе, сессии или кэше.'
			},
			{
				id: 'server-fpm',
				front: 'Что такое PHP-FPM?',
				back: 'Менеджер пула готовых процессов PHP: nginx передаёт запрос свободному, не запуская интерпретатор заново. Скорость лучше CGI, а модель «чистый лист на запрос» сохраняется.'
			},
			{
				id: 'server-app-server',
				front: 'Что такое сервер приложений?',
				back: 'Программа, которая запущена всё время и сама принимает запросы (часто за nginx): Node.js, Python за WSGI/ASGI, Elixir/Phoenix, Java. Общая память, долгие соединения, но надо следить за утечками.'
			},
			{
				id: 'server-why-php',
				front: 'Почему WordPress и Битрикс на PHP?',
				back: 'PHP был на каждом дешёвом хостинге, его легко развернуть, а модель «собрать страницу и забыть» подходит сайтам. Сложившаяся экосистема плагинов и специалистов не позволяет легко сменить язык.'
			}
		],
		sources: [
			{
				title: 'RFC 3875: The Common Gateway Interface (CGI) 1.1',
				url: 'https://www.rfc-editor.org/rfc/rfc3875',
				licence: 'link-only',
				kind: 'spec',
				lang: 'en'
			},
			{
				title: 'PHP: Руководство. Введение',
				url: 'https://www.php.net/manual/ru/introduction.php',
				licence: 'CC-BY',
				kind: 'docs',
				lang: 'ru'
			},
			{
				title: 'PHP-FPM: описание',
				url: 'https://www.php.net/manual/ru/install.fpm.php',
				licence: 'CC-BY',
				kind: 'docs',
				lang: 'ru'
			},
			{
				title: 'W3Techs: Server-side programming languages',
				url: 'https://w3techs.com/technologies/overview/programming_language',
				licence: 'link-only',
				kind: 'article',
				lang: 'en'
			},
			{
