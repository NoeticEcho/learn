	export const metadata = {
		id: '06-server/06-graphql-webhooks',
		part: 6,
		order: 6,
		title: 'GraphQL и вебхуки',
		summary: 'GraphQL отдаёт ровно те поля, которые попросил клиент, а вебхук позволяет сервису самому сообщить вам о событии. После урока вы знаете, чем GraphQL отличается от REST, и настраиваете уведомление о заявке с проверкой подписи и защитой от повторов.',
		minutes: 25,
		teaches: ['server-graphql', 'server-webhooks'],
		requires: ['server-rest'],
		practice: {
			id: 'server-webhook',
			title: 'Заявка с формы доходит до владельца: вебхук и его защита',
			task: 'Настоящий приёмник в песочнице не запустить, поэтому код обработчика вы пишете текстом в блоке pre id="handler" и проверяете подпись на схеме выше. 1) В абзаце «Канал» назовите, куда придёт заявка: Telegram, почта или другой канал. 2) В pre напишите обработчик (на Node.js, по образцу из урока): секрет из process.env, подпись HMAC SHA-256 по сырому телу (crypto.createHmac("sha256", …)), безопасное сравнение (timingSafeEqual), ответ 401 при несовпадении, повтор события с тем же id игнорируется, при успехе быстрый ответ 200. 3) В абзаце «Если приёмник недоступен» опишите, что произойдёт при сбое и почему заявка не потеряется и не придёт дважды. 4) В абзаце про GraphQL сравните с REST для ваших данных: назовите один пункт из брифа и случай, когда удобнее GraphQL. Значение секрета прямо в код не записывайте. Все «…» нужно заменить.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
