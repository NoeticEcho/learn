			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <main id="page">
      <h1>{{title}}</h1>
      <p>{{who}}</p>
      <p><a class="cta" href="#contacts">{{mainAction.label}}</a></p>
      <section class="demo" data-theme="dark">
        <h2>Та же кнопка в тёмной теме</h2>
        <p><a class="cta" href="#contacts">{{mainAction.label}}</a></p>
      </section>

      <script type="application/json" id="tokens" data-scaffold>
{
  "color": {
    "$type": "color",
    "accent": { "600": { "$value": "#0b5cad" } },
    "neutral": { "50": { "$value": "#faf9f7" }, "900": { "$value": "#1c1b19" } }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": "8px" },
    "4": { "$value": "16px" }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": "8px" }
  },
  "semantic": {
    "$type": "color",
    "action": { "$value": "{color.accent.600}" },
    "surface": { "$value": "{color.neutral.50}" },
    "text": { "$value": "{color.neutral.900}" }
  },
  "component": {
    "button": {
      "bg": { "$type": "color", "$value": "{semantic.action}" },
      "fg": { "$type": "color", "$value": "{semantic.surface}" }
    }
  }
}
      <\/script>
    </main>
  </body>
</html>
`,
				'styles.css': `/* styles.css: токены и вид. Слои: базовые, смысловые, компонентные. */
:root {
  /* базовые */
  --color-accent-600: #0b5cad;
  --color-neutral-50: #faf9f7;
  --color-neutral-900: #1c1b19;
  --space-2: 8px;
  --space-4: 16px;
  --radius-md: 8px;
  /* смысловые */
  --action: var(--color-accent-600);
  --surface: var(--color-neutral-50);
  --text: var(--color-neutral-900);
  /* компонентные */
  --button-bg: var(--action);
  --button-fg: var(--surface);
}
[data-theme="dark"] {
  --surface: var(--color-neutral-900);
  --text: var(--color-neutral-50);
}
body {
  font-family: system-ui, sans-serif;
  background: var(--surface);
  color: var(--text);
  margin: 0;
}
#page {
  max-width: 46rem;
  margin: 0 auto;
  padding: 1.5rem;
}
.cta {
  display: inline-block;
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  background-color: var(--button-bg);
  color: var(--button-fg);
  text-decoration: none;
}
.demo {
  padding: 1rem;
  background: var(--surface);
  color: var(--text);
}
`
