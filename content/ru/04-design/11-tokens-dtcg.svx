<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	const colour = '^\\s*(#[0-9a-fA-F]{6}|var\\(--[a-z0-9-]+\\))\\s*$';
	const length = '^\\s*\\d+(\\.\\d+)?(px|rem)\\s*$';
	const aliased = (target) => `^\\s*(var\\(--${target}\\)|#[0-9a-fA-F]{6})\\s*$`;
	const ofRoot = (id, prop, matches) => ({ id, kind: 'style', selector: ':root', prop, matches });
	const dtcg = (id, re) => ({ id, kind: 'text', selector: '#tokens', matches: re });

	export const metadata = {
