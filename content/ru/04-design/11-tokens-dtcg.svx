				{ mood: 'explain', side: 'right', prop: 'sheet', label: 'tokens.json', say: 'Токен не то же, что CSS-переменная. Из одного файла получают CSS для сайта, переменные Figma и значения для телефона.' },
				{ mood: 'hint', prop: 'flowchart', label: 'базовый|смысловой|компонент', say: 'Кнопка ссылается на роль, роль на базовый цвет. Сменили базовый, и перекрасились все кнопки.' },
				{ mood: 'cheer', side: 'right', prop: 'browser', label: 'тёмная тема', say: 'Тему меняют в смысловом слое: surface и text смотрят на другие базовые цвета. Компонентов это не касается.' }
