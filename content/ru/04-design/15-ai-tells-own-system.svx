			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="hero" id="hero">
      <h1>{{title}}</h1>
      <p>{{who}}. Для: {{forWhom}}</p>
      <a class="cta" href="#contacts">{{mainAction.label}}</a>
    </header>
    <section id="features">
      <h2>Что мы делаем</h2>
      <p class="lead">{{profession}}</p>
      <div class="cards">
        {{#each items}}<div class="card"><h3>{{title}}</h3><p>{{text}}</p></div>
        {{/each}}
      </div>
    </section>
    <section id="proof">
      <h2>Подтверждения</h2>
      <ul>{{#each proofs}}<li>{{title}}</li>{{/each}}</ul>
    </section>

    <aside class="note" data-scaffold id="report">
      <h2>Приметы шаблонности, которые я нашёл</h2>
      <ol>
        <li class="tell">Фиолетово-синий градиент в шапке</li>
        <li class="tell">Лозунг вместо названия в заголовке</li>
        <li class="tell">Кнопка на английском «Get Started»</li>
        <li class="tell">Три одинаковые карточки с эмодзи</li>
        <li class="tell">Выдуманные цифры в блоке «Нам доверяют»</li>
      </ol>
    </aside>
  </body>
</html>
`,
				'styles.css': `/* styles.css: вид страницы */
:root {
  --accent: #0b5cad;
  --surface: #faf9f7;
  --text: #1c1b19;
  --font-body: Literata, Georgia, serif;
  --space-4: 16px;
}
body {
  font-family: var(--font-body);
  background: #faf9f7;
  color: #1c1b19;
  margin: 0;
}
.hero {
  padding: calc(var(--space-4) * 3) var(--space-4);
}
.cta {
  display: inline-block;
  padding: 0.6rem 1.4rem;
  border-radius: 6px;
  background-color: #0b5cad;
  color: #ffffff;
  text-decoration: none;
}
.cards {
  display: flex;
  gap: var(--space-4);
}
.card {
  padding: var(--space-4) 0;
  border-top: 2px solid #c9c4ba;
}
section {
  padding: calc(var(--space-4) * 2) var(--space-4);
}
`
