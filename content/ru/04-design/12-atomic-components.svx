`,
				'styles.css': `/* styles.css: токены и компоненты */
:root {
  --accent: #0b5cad;
  --on-accent: #ffffff;
  --space-2: 8px;
  --space-4: 16px;
  --radius: 8px;
}
body {
  font-family: system-ui, sans-serif;
  color: #1c1b19;
  background: #faf9f7;
  margin: 0;
}
#page {
  max-width: 46rem;
  margin: 0 auto;
  padding: 1.5rem;
}
.cards {
  display: grid;
  gap: var(--space-4);
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
}
.card {
  padding: var(--space-4);
  border: 1px solid #d9d5ce;
  border-radius: var(--radius);
  background: #ffffff;
}
.card h3 {
  margin: 0 0 var(--space-2);
}
.btn {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 var(--space-4);
  border: 0;
  border-radius: var(--radius);
  background-color: var(--accent);
  color: var(--on-accent);
  font: inherit;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}
.btn:hover {
  filter: brightness(1.15);
}
.btn:focus-visible {
  outline: 3px solid #ffdd00;
  outline-offset: 2px;
}
.btn:active {
  transform: translateY(1px);
}
.btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}
.btn[aria-busy="true"] {
  opacity: 0.8;
  cursor: progress;
}
`
