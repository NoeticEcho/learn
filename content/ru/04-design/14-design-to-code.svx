        <li class="frame">Телефон, ширина 375</li>
        <li class="frame">Планшет, ширина 768</li>
        <li class="frame">Компьютер, ширина 1280</li>
      </ul>

      <h3>Слои (Блок/Часть)</h3>
      <ul>
        <li class="layer">Hero/Title</li>
        <li class="layer">Hero/Lead</li>
        <li class="layer">Hero/Action</li>
        <li class="layer">Cards/Item</li>
        <li class="layer">Footer/Contacts</li>
      </ul>

      <h3>Токены</h3>
      <ul>
        <li class="token">--space-4: отступы между блоками</li>
        <li class="token">--color-accent-600: фон главного действия</li>
        <li class="token">--fs-3xl: заголовок</li>
        <li class="token">--radius-md: скругление карточек и кнопки</li>
      </ul>

      <h3>Состояния главного действия</h3>
      <ul>
        <li class="state">обычное</li>
        <li class="state">наведение: фон светлее</li>
        <li class="state">фокус: жёлтый контур 3 пикселя</li>
        <li class="state">недоступно: прозрачность 50 %</li>
      </ul>

      <h3>Ресурсы</h3>
      <table>
        <tr><th>Что</th><th>Как отдаётся</th><th>Размер</th></tr>
        <tr class="asset"><td>Значки меню</td><td class="kind">векторами, SVG</td><td>24 на 24</td></tr>
