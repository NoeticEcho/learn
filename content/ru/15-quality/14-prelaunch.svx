		say: { LCP: 'эл-си-пи', INP: 'ай-эн-пи', CLS: 'си-эл-эс', HTTPS: 'эйч-ти-ти-пи-эс', HSTS: 'эйч-эс-ти-эс', UTM: 'ю-ти-эм', CSP: 'си-эс-пи', 'Open Graph': 'оупен граф', URL: 'ю-ар-эл' }
	};
