			},
			{
				id: 'quality-launch-after',
				front: 'Что делать после запуска?',
				back: 'Следить за доступностью и ошибками, смотреть отчёты скорости и счётчика, добавлять сайт в вебмастера, пересматривать политику и таблицу cookie при каждом новом сервисе.'
			}
		],
		sources: [
			{ title: 'Web Vitals (web.dev)', url: 'https://web.dev/articles/vitals', licence: 'CC-BY', kind: 'article', lang: 'en' },
