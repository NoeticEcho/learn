			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
  </head>
  <body>
    <main>
      <h1>{{title}}</h1>

      <section id="a11y-statement">
        <h2>Заявление о доступности</h2>
        <p id="target">Цель: соответствие WCAG 2.2, уровень AA, с ориентиром на ГОСТ Р 52872-2019.</p>
        <p id="status">Статус: проверено частично: автоматической проверкой, клавиатурой и диктором NVDA для главного действия; остальные страницы не проверялись.</p>
        <p id="date">Дата проверки: 28.10.2026.</p>
        <h3>Известные ограничения</h3>
        <ul id="limits"><li>Часть сканов документов не имеет подробного текстового описания.</li><li>Видео без субтитров будет исправлено до конца года.</li></ul>
        <p id="feedback">Сообщить о проблеме: {{email}}, ответим в течение десяти рабочих дней.</p>
      </section>
    </main>

    <aside data-scaffold id="map">
      <h2>Карта аудитории</h2>
      <table id="audience">
        <thead><tr><th>Язык</th><th>Где аудитория</th><th>Какие правила рядом</th><th>Что делаю</th></tr></thead>
        <tbody>
          {{#each languages}}<tr class="aud"><td class="lang">{{.}}</td><td class="where">в основном Россия, часть посетителей из Европы</td><td class="regime">152-ФЗ, закон о рекламе, GDPR и ePrivacy для посетителей из ЕС, WCAG как мерка доступности</td><td class="do">политика и согласие на двух языках, баннер с равным выбором, аналитика после согласия, заявление о доступности</td></tr>
          {{/each}}
        </tbody>
      </table>
    </aside>
  </body>
</html>
`
			},
			checks: [
				{ id: 'aud-count', kind: 'count', selector: 'tr.aud', min: { brief: 'languages' } },
				{ id: 'aud-gaps', kind: 'text', selector: '#audience', matches: '^(?![\\s\\S]*…)' },
				{ id: 'aud-regime', kind: 'text', selector: 'td.regime', matches: '152|GDPR|ePrivacy|EAA|ADA' },
				{ id: 'aud-gdpr', kind: 'text', selector: '#audience', matches: 'GDPR', when: { brief: 'languages', contains: 'en' } },
				{ id: 'target', kind: 'text', selector: '#target', matches: '(?=[\\s\\S]*WCAG\\s*2\\.[12])(?=[\\s\\S]*AA)' },
				{ id: 'status', kind: 'text', selector: '#status', matches: '(?=[\\s\\S]*(частично|не проверял|не проверен|проверен))(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?![\\s\\S]*…)' },
				{ id: 'no-overclaim', kind: 'text', selector: '#a11y-statement', matches: '^(?![\\s\\S]*(полностью соответствует|полное соответствие|гарантируем доступность))' },
				{ id: 'date', kind: 'text', selector: '#date', matches: '\\d{2}\\.\\d{2}\\.\\d{4}' },
				{ id: 'limits', kind: 'count', selector: '#limits li', min: 2 },
				{ id: 'limits-gaps', kind: 'text', selector: '#limits', matches: '^(?![\\s\\S]*…)' },
