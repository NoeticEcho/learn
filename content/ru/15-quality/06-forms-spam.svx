				{ id: 'maxlength', kind: 'count', selector: 'input[maxlength], textarea[maxlength]', min: 3 },
				{ id: 'trap', kind: 'exists', selector: '.hp[aria-hidden="true"] input[tabindex="-1"][autocomplete="off"]' },
				{ id: 'trap-css', kind: 'text', selector: 'style', matches: '\\.hp\\s*\\{[^}]*position:\\s*absolute' },
				{ id: 'trap-not-display', kind: 'text', selector: 'style', matches: '^(?![\\s\\S]*\\.hp\\s*\\{[^}]*display:\\s*none)' },
				{ id: 'timestamp', kind: 'exists', selector: 'input[type="hidden"][name="ts"]' },
				{ id: 'no-captcha', kind: 'count', selector: 'script[src*="recaptcha"], script[src*="hcaptcha"]', max: 0 },
				{ id: 'error-live', kind: 'exists', selector: '#form-error[role="alert"], #form-error[aria-live]' },
				{ id: 'action-label', kind: 'field', selector: 'form button[type="submit"]', field: 'mainAction.label' },
				{ id: 'rules-count', kind: 'count', selector: 'tr.rule', min: 3 },
				{ id: 'rules-gaps', kind: 'text', selector: '#rules', matches: '^(?![\\s\\S]*…)' },
				{ id: 'rules-numbers', kind: 'text', selector: '#rules', matches: '\\d' },
