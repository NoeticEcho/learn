<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p id="final-text">{{name}}: {{profession}}. Работаю с 2012 года, выполнено 480 работ. Первая консультация до 20 минут бесплатна, по вторникам для заявок до 12:00. Цена услуги с 1 по 15 ноября 2026 года: 6 000 ₽ вместо 8 000 ₽. После изучения документов расскажу, какие у вас шансы.</p>

    <aside data-scaffold id="audit">
      <h2>Аудит фраз</h2>
      <table id="claims">
        <thead><tr><th>Фраза</th><th>Что не так</th><th>Честная замена</th><th>Чем подтверждается</th></tr></thead>
        <tbody>
          <tr class="claim"><td class="original">Лучший в городе</td><td class="type">превосходная степень без критерия</td><td class="rewrite">Работаю с 2012 года, выполнено 480 работ</td><td class="basis">документы: {{#each proofs}}{{title}}; {{/each}}реестр работ</td></tr>
          <tr class="claim"><td class="original">Гарантируем положительный результат</td><td class="type">гарантия результата</td><td class="rewrite">После изучения документов расскажу, какие у вас шансы</td><td class="basis">удалено: исход зависит не только от меня</td></tr>
          <tr class="claim"><td class="original">Консультация бесплатно!*</td><td class="type">скрытое условие</td><td class="rewrite">До 20 минут бесплатно, по вторникам для заявок до 12:00</td><td class="basis">условие рядом с обещанием, закон, ст. 5 ч. 7</td></tr>
          <tr class="claim"><td class="original">Скидка 50% только сегодня!</td><td class="type">ложная срочность</td><td class="rewrite">С 1 по 15 ноября 2026 года: 6 000 ₽ вместо 8 000 ₽</td><td class="basis">прайс-лист и приказ о цене, номер 12</td></tr>
          <tr class="claim"><td class="original">Нам доверяют тысячи клиентов</td><td class="type">непроверяемая цифра</td><td class="rewrite">С 2012 года выполнено 480 работ</td><td class="basis">реестр работ, номер записи совпадает</td></tr>
          <tr class="claim"><td class="original">Дешевле, чем у конкурентов</td><td class="type">некорректное сравнение</td><td class="rewrite">Межевание от 8 000 ₽, в цену входят выезд и межевой план</td><td class="basis">удалено сравнение, прайс-лист</td></tr>
        </tbody>
      </table>
