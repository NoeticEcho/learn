	export const metadata = {
		id: '15-quality/08-policy-consent',
		part: 15,
		order: 8,
		title: 'Политика обработки и согласие на сайте',
		definition: 'Политика обработки — публичный документ о том, что делают с данными посетителей. Согласие — отдельное действие человека с собственным текстом.',
		summary:
			'Реестр из прошлого урока превращается в два документа: политику, которую читает любой, и согласие, которое человек даёт сам. После урока вы знаете, из каких разделов состоит политика, как оформить согласие отдельно от других условий, чего в нём не должно быть, и собираете для своей формы политику из десяти разделов и честное согласие с отдельной галочкой на рассылку.',
		minutes: 30,
		comic: {
