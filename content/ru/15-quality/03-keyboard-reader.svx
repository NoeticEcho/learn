<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; color: #1d2430; background: #fff; line-height: 1.5; }
      .header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; padding: 0.75rem 1rem; background: #eef1f6; }
      .menu-btn, .btn { cursor: pointer; padding: 0.6rem 1rem; background: #0b3d91; color: #fff; border: 0; font: inherit; }
      .nav-link { padding: 0.4rem 0; }
      .content { max-width: 40rem; margin: 0 auto; padding: 1rem; }
      .title { font-size: 2rem; font-weight: bold; }
      .footer { padding: 1rem; background: #eef1f6; }
      dialog { padding: 1.5rem; border: 2px solid #1d2430; }
    <\/style>
  </head>
  <body>
    <div class="header">
      <div class="logo">{{name}}</div>
      <div class="menu-btn" id="menu-toggle">Меню</div>
      <div class="nav" id="menu" hidden>
        {{#each sections}}<div class="nav-link">{{.}}</div>
        {{/each}}
      </div>
      <div class="search" onclick="alert('Поиск')"><svg width="20" height="20" viewBox="0 0 20 20"><circle cx="8" cy="8" r="6" fill="none" stroke="#1d2430" stroke-width="2"></circle><path d="M13 13l5 5" stroke="#1d2430" stroke-width="2"></path></svg></div>
    </div>
    <div class="content">
      <div class="title">{{title}}</div>
      <div class="text">{{who}}</div>
      <div class="btn" id="open-d">{{mainAction.label}}</div>
      <div class="modal" id="d" hidden>
        <div class="modal-title">{{mainAction.label}}</div>
        <div class="btn" id="close-d">Закрыть</div>
      </div>
      <div class="status" id="status"></div>
    </div>
    <div class="footer">{{name}}, {{city}}</div>

    <aside data-scaffold id="reader-note">
      <h2>Что скажет диктор</h2>
      <p>На кнопке меню: <span id="say-menu">…</span></p>
      <p>На окне: <span id="say-dialog">…</span></p>
