				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; color: #1d2430; background: #fff; line-height: 1.5; }
      header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; padding: 0.75rem 1rem; background: #eef1f6; }
      button { cursor: pointer; min-height: 44px; padding: 0.6rem 1rem; background: #0b3d91; color: #fff; border: 0; font: inherit; }
      button.search { background: none; color: inherit; min-width: 44px; }
      nav a { display: inline-block; padding: 0.4rem 0.5rem; }
      main { max-width: 40rem; margin: 0 auto; padding: 1rem; }
      footer { padding: 1rem; background: #eef1f6; }
      dialog { padding: 1.5rem; border: 2px solid #1d2430; }
      :focus-visible { outline: 3px solid #0b3d91; outline-offset: 2px; }
    <\/style>
  </head>
  <body>
    <header>
      <p class="logo">{{name}}</p>
      <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu">Меню</button>
      <nav id="menu" aria-label="Разделы сайта" hidden>
        {{#each sections}}<a href="#main">{{.}}</a>
        {{/each}}
        <a href="#main" aria-current="page">Главная</a>
      </nav>
      <button type="button" class="search" aria-label="Поиск"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20"><circle cx="8" cy="8" r="6" fill="none" stroke="#1d2430" stroke-width="2"></circle><path d="M13 13l5 5" stroke="#1d2430" stroke-width="2"></path></svg></button>
    </header>
    <main id="main">
      <h1>{{title}}</h1>
      <p>{{who}}</p>
      <button type="button" id="open-d" aria-haspopup="dialog">{{mainAction.label}}</button>
      <dialog id="d" aria-labelledby="d-title">
        <h2 id="d-title">{{mainAction.label}}</h2>
        <button type="button" id="close-d">Закрыть</button>
      </dialog>
      <p id="status" role="status"></p>
    </main>
    <footer>{{name}}, {{city}}</footer>

    <aside data-scaffold id="reader-note">
      <h2>Что скажет диктор</h2>
      <p>На кнопке меню: <span id="say-menu">«Меню, кнопка, свёрнуто»</span></p>
      <p>На окне: <span id="say-dialog">«Название действия, диалог»</span></p>
    </aside>

    <script type="module" id="ui-js">
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('menu');
      toggle?.addEventListener('click', () => {
        const opening = menu.hidden;
        menu.hidden = !opening;
        toggle.setAttribute('aria-expanded', String(opening));
      });
      const dlg = document.getElementById('d');
      document.getElementById('open-d')?.addEventListener('click', () => dlg.showModal?.());
      document.getElementById('close-d')?.addEventListener('click', () => dlg.close?.());
    <\/script>
  </body>
</html>
`
