<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p>{{who}}</p>

    <aside data-scaffold id="e2e">
      <h2>План сквозных тестов</h2>
      <table id="plan">
        <thead><tr><th>Дано</th><th>Когда</th><th>Тогда</th></tr></thead>
        <tbody>
          <tr class="scenario"><td class="given">Открыта главная страница на экране 375 пикселей</td><td class="when">Нажимаю «{{mainAction.label}}» и заполняю форму</td><td class="then">Вижу сообщение «Спасибо», страница не прокручивается вбок</td></tr>
          <tr class="scenario"><td class="given">Открыта форма</td><td class="when">Отправляю её пустой</td><td class="then">Рядом с полем сообщение словами, фокус на первом ошибочном поле</td></tr>
          <tr class="scenario"><td class="given">Открыта главная страница</td><td class="when">Открываю разделы «{{sections.0}}» и «{{sections.1}}»</td><td class="then">Виден заголовок раздела, ссылка не ведёт на 404</td></tr>
          <tr class="scenario"><td class="given">Страница открыта, мышь не используется</td><td class="when">Прохожу страницу клавишей Tab и отправляю форму Enter</td><td class="then">Фокус всегда виден, форма уходит</td></tr>
          {{#each languages}}<tr class="scenario"><td class="given">Открыта главная страница</td><td class="when">Переключаю язык на {{.}}</td><td class="then">Тексты и адрес страницы на языке {{.}}, атрибут lang совпадает</td></tr>
          {{/each}}
        </tbody>
      </table>

      <h3>Тест главного действия</h3>
      <pre id="test-code">import { test, expect } from '@playwright/test';

test('{{mainAction.label}}: посетитель доходит до результата', async ({ page }) => {
  await page.goto('/');
  await page.getByRole('link', { name: '{{mainAction.label}}' }).click();
  await page.getByLabel('Телефон').fill('+7 000 000-00-00');
  await page.getByRole('button', { name: '{{mainAction.label}}' }).click();
  await expect(page.getByRole('status')).toContainText('Спасибо');
});
<\/pre>

      <p>Данные тестов: <span id="test-data">выдуманные: имя «Тест», телефон +7 000 000-00-00, домен example.com; настоящих людей нет</span></p>
      <p>Когда запускаются: <span id="ci-run">при каждой правке и перед каждой выкладкой (CI)</span></p>
    </aside>
  </body>
</html>
`
