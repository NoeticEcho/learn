<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	import { files } from '../../diagrams/practice-kit.ts';

	const plan = (v) => `<section data-scaffold id="pipeline-plan">
      <h2>Мой конвейер</h2>
      <table id="stages">
        <thead><tr><th>Этап</th><th>Вход</th><th>Что делает модель</th><th>Выход и формат</th><th>Проверка перед следующим этапом</th></tr></thead>
        <tbody>
${['1. Бриф', '2. Структура', '3. Тексты', '4. Код']
	.map((n, i) => `          <tr class="stage"><td>${n}</td><td class="in">${v.rows[i][0]}</td><td class="does">${v.rows[i][1]}</td><td class="out">${v.rows[i][2]}</td><td class="gate">${v.rows[i][3]}</td></tr>`)
	.join('\n')}
        </tbody>
      </table>
      <p>Структура, которую должен вернуть второй этап:</p>
      <pre id="pl-structure">${v.structure}<\/pre>
      <p id="pl-facts">Какие факты разрешены в текстах: ${v.facts}</p>
      <p id="pl-sends">Какие поля брифа уходят модели: ${v.sends}</p>
      <p id="pl-notsend">Какие не уходят: ${v.notsend}</p>
      <p id="pl-key">Где хранится ключ: ${v.key}</p>
      <p id="pl-ru">Когда я возьму российскую модель: ${v.ru}</p>
    </section>`;

	const blankRows = [0, 1, 2, 3].map(() => ['…', '…', '…', '…']);
	const solvedRows = [
		['Бриф проекта: поля из настроек', 'Ничего: только отбор публичных полей', 'JSON из выбранных полей', 'В JSON нет телефона и почты'],
		['JSON из первого этапа', 'Строит структуру страницы', 'JSON со списком разделов и подписью кнопки', 'Схема: названия разделов в точности как в брифе, подпись кнопки совпадает'],
		['Структура со второго этапа и факты брифа', 'Пишет текст каждого раздела по тону из примеров', 'Тексты по разделам', 'Факты: каждое число и имя есть в items и proofs брифа, пустых формул нет'],
		['Структура и тексты из этапов 2 и 3', 'Пишет HTML и CSS', 'Один файл HTML и один CSS', 'Код: один h1, alt у картинок, подписи у полей, lang, нет внешних скриптов']
	];

	const row = (n, col, re) => ({ id: `s${n}-${col}`, kind: 'text', selector: `#stages tbody tr:nth-of-type(${n}) td.${col}`, matches: re });

	export const metadata = {
		id: '16-ai/05-capstone-builder',
		part: 16,
		order: 5,
		title: 'Итоговая работа: мини-конструктор «бриф, структура, тексты, код»',
