<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	import { files } from '../../diagrams/practice-kit.ts';

	const brief = (v) => `<section data-scaffold id="prompt-brief">
      <h2>Структурированный запрос по брифу</h2>
      <textarea id="p-full" rows="20" aria-label="Запрос">${v.full}<\/textarea>
      <p>Чего не делать:</p>
      <ul id="p-donts">
        <li>${v.donts[0]}</li>
        <li>${v.donts[1]}</li>
        <li>${v.donts[2]}</li>
      </ul>
      <p>Как понять, что готово:</p>
      <ul id="p-done">
        <li>${v.done[0]}</li>
        <li>${v.done[1]}</li>
        <li>${v.done[2]}</li>
      </ul>
      <p id="p-private">Что из брифа я не отправлю модели: ${v.priv}</p>
      <p id="p-compare">Сравнение с короткой просьбой: ${v.compare}</p>
    </section>`;

	const starter = `Контекст: …
Цель: …
Аудитория: …
Главное действие посетителя: …
Разделы: …
Что предлагаем: …
Люди: …
Подтверждения (только эти, ничего не выдумывать): …
Языки (коды ru, en): …
Тон, на примерах: …
Формат результата: …`;
	const solved = `Контекст: {{who}}
Цель: сайт, на котором посетитель делает одно действие и понимает, чем мы занимаемся
Аудитория: {{forWhom}}
Главное действие посетителя: «{{mainAction.label}}»
Разделы: {{#each sections}}{{.}}; {{/each}}
Что предлагаем: {{#each items}}{{title}}; {{/each}}
Люди: {{#each people}}{{name}}; {{/each}}
Подтверждения (только эти, ничего не выдумывать): {{#each proofs}}{{title}}; {{/each}}
Языки (коды ru, en): {{#each languages}}{{.}}, {{/each}}
Тон, на примерах: «Сначала разберём документы, потом решим, что делать.» «Ответим на вопросы по порядку, без спешки.»
Формат результата: один файл HTML и один CSS, семантическая разметка, без внешних скриптов, с атрибутом lang`;

	const three = (id, sel, re) => [1, 2, 3].map((n) => ({ id: `${id}-${n}`, kind: 'text', selector: `#${sel} li:nth-child(${n})`, matches: re }));

	export const metadata = {
