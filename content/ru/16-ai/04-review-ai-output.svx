<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	import { files } from '../../diagrams/practice-kit.ts';

	const log = (v) => `<section data-scaffold id="review">
      <h2>Журнал проверки</h2>
      <ol id="review-log">
        <li>${v.log[0]}</li>
        <li>${v.log[1]}</li>
        <li>${v.log[2]}</li>
        <li>${v.log[3]}</li>
        <li>${v.log[4]}</li>
      </ol>
      <p id="review-order">Порядок, в котором я проверяю чужую выдачу: ${v.order}</p>
    </section>`;

	const script = (key) => `      <script type="module" id="app-script">
${key
	? 'const API_KEY = "sk-live-9f2c7a41e5b84d3aa1c0";\nfunction send(data) { return fetch("https://api.example.ru/leads?key=" + API_KEY, { method: "POST", body: data }); }'
	: 'function send(data) { return fetch("/api/leads", { method: "POST", body: data }); }'}
      <\/script>`;

	const generated = `      <h1>{{name}}: инновационные решения для вашего бизнеса</h1>
      <p>{{who}}</p>
      <div class="btn" onclick="go()">Get Started</div>
      <img src="https://images.example-stock.com/team.jpg" width="320" height="200">
      <section id="proofs">
        <h2>Подтверждения</h2>
        <p>Более 15 лет опыта, 1200+ довольных клиентов, 99,9 % успешных дел</p>
        <blockquote>«Лучший специалист, которого я встречал!» Иван, директор</blockquote>
      </section>
      <section id="form">
        <h2>{{mainAction.label}}</h2>
        <form action="http://api.example.ru/leads" method="get">
          <input name="name" placeholder="Имя">
          <input name="phone" placeholder="Телефон">
          <button type="submit">Отправить</button>
        </form>
      </section>
${script(true)}`;

	const reviewed = `      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#form">{{mainAction.label}}</a></p>
      <img src="/images/portrait.jpg" alt="Портрет: {{name}}" width="320" height="240">
      <section id="proofs">
        <h2>Подтверждения</h2>
        <ul>
          {{#each proofs}}<li>{{title}}</li>
          {{/each}}
        </ul>
      </section>
      <section id="form">
        <h2>{{mainAction.label}}</h2>
        <form action="https://api.example.ru/leads" method="post">
          <p><label for="f-name">Имя</label> <input id="f-name" name="name" autocomplete="name" required></p>
          <p><label for="f-phone">Телефон</label> <input id="f-phone" name="phone" type="tel" autocomplete="tel" required></p>
          <p><label><input type="checkbox" name="consent" required> Согласен на обработку персональных данных, <a href="/politika/">политика обработки</a></label></p>
          <button type="submit">{{mainAction.label}}</button>
        </form>
      </section>
${script(false)}`;

	const li = (id, n, re) => ({ id: `${id}-${n}`, kind: 'text', selector: `#review-log li:nth-child(${n})`, matches: re });

	export const metadata = {
		id: '16-ai/04-review-ai-output',
		part: 16,
		order: 4,
		title: 'Проверка результата ИИ: ошибки, которые выглядят правдоподобно',
		definition: 'Проверка результата ИИ — ревью по порядку: факты, работа, безопасность, данные и закон, доступность, приметы шаблона. Ошибки в выдаче выглядят правдоподобно.',
		summary:
			'ИИ пишет уверенно, и ошибки в его выдаче выглядят как правда. После урока вы знаете, какие бывают ошибки (выдуманные факты, ключи в коде, форма без согласия, чужие картинки, недоступные кнопки), проверяете выдачу в нужном порядке и находите и исправляете настоящие ошибки на странице, которую «написал ИИ», с журналом найденного.',
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'browser', label: '15 лет опыта', caption: 'Уверенный тон', say: 'Страница красивая и уверенная. Только пятнадцати лет опыта у вас нет, и клиентов столько тоже.' },
				{ mood: 'explain', side: 'right', prop: 'flowchart', label: 'факты|работа|ключи|закон', say: 'Проверяйте по порядку: факты, работает ли действие, безопасность, данные и закон, доступность, приметы шаблона.' },
				{ mood: 'cheer', prop: 'sheet', label: 'журнал', caption: 'Найдено и исправлено', say: 'Каждую найденную ошибку записывайте: что, где, как исправили. Через неделю вы будете искать их быстрее.' }
			]
		},
		minutes: 30,
		teaches: ['future-review-ai-output', 'future-ai-failure-modes'],
		requires: ['future-vibe-coding', 'future-prompt-as-brief', 'design-ai-tells', 'html-form-validation'],
		practice: {
			id: 'future-review-page',
			title: 'Найдите и исправьте ошибки на странице, которую «написал ИИ»',
			task: 'Страница ниже «написана ИИ» и содержит настоящие ошибки. Исправьте их прямо в коде. 1) Уберите лозунг из заголовка и выдуманные цифры и отзыв, подтверждения возьмите из брифа (списком). 2) У картинки нужен alt, и она не должна идти с чужого сервера. 3) Вместо «кнопки» из div сделайте ссылку с подписью главного действия из брифа. 4) Уберите ключ из скрипта. 5) Форма: адрес по https, метод post, подписи у полей (label) и обязательное согласие со ссылкой на политику. 6) В журнале запишите пять найденных ошибок (что, где, как исправили, не меньше четырёх слов в каждой) и порядок, в котором вы проверяете. Все «…» нужно заменить.',
			era: 7,
			files: files({ main: generated, scaffold: log({ log: ['…', '…', '…', '…', '…'], order: '…' }) }),
			solution: files({
				main: reviewed,
				scaffold: log({
					log: [
						'Выдуманные цифры и отзыв в подтверждениях заменил настоящими данными из брифа',
						'У картинки не было alt и она шла со стороннего сервера, поставил свой файл с описанием',
						'Кнопка из div с английской подписью заменена ссылкой с названием действия проекта',
						'Секретный ключ лежал прямо в коде страницы, удалил и вынес запросы на сервер',
						'Форма отправляла по http методом GET без подписей и согласия, исправил на https и post с согласием'
					],
					order: 'сначала факты и подтверждения, потом работает ли главное действие, затем безопасность (ключи, форма), данные и закон (согласие, политика), доступность (подписи, кнопки) и в конце приметы шаблона и тон.'
				})
			}),
			checks: [
				{ id: 'review', kind: 'exists', selector: '#review' },
				{ id: 'no-blanks', kind: 'text', selector: '#review', matches: '^[^…]*$' },
				{ id: 'h1-no-slogan', kind: 'text', selector: 'h1', matches: '^(?![\\s\\S]*[Ии]нновацион)' },
				{ id: 'h1-name', kind: 'field', selector: 'h1', field: 'name' },
				{ id: 'no-fake-claims', kind: 'text', selector: '#proofs', matches: '^(?![\\s\\S]*(?:15 лет|1200|99[,.]9|Лучший специалист))' },
				{ id: 'proofs-from-brief', kind: 'field', selector: '#proofs', field: 'proofs[].title', when: { brief: 'proofs[].title' } },
				{ id: 'img-alt', kind: 'count', selector: 'img:not([alt])', max: 0 },
				{ id: 'img-own', kind: 'count', selector: '[src*="example-stock"]', max: 0 },
				{ id: 'no-div-button', kind: 'count', selector: 'div[onclick], span[onclick]', max: 0 },
				{ id: 'cta', kind: 'field', selector: 'main a.button', field: 'mainAction.label' },
				{ id: 'no-key', kind: 'text', selector: '#app-script', matches: '^(?![\\s\\S]*(?:sk-live|API_KEY\\s*=|key=))' },
				{ id: 'form-https', kind: 'attr', selector: 'form', name: 'action', matches: '^https://' },
				{ id: 'form-post', kind: 'attr', selector: 'form', name: 'method', matches: '^post$' },
				{ id: 'labels', kind: 'label' },
				{ id: 'consent', kind: 'count', selector: 'form input[type="checkbox"][required]', min: 1 },
				{ id: 'policy-link', kind: 'count', selector: 'form a[href*="politika"], form a[href*="policy"]', min: 1 },
				li('log', 1, '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'),
				li('log', 2, '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'),
				li('log', 3, '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'),
				li('log', 4, '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'),
				li('log', 5, '\\S+\\s+\\S+\\s+\\S+\\s+\\S+'),
				{ id: 'order-facts', kind: 'text', selector: '#review-order', matches: 'факт' },
				{ id: 'order-security', kind: 'text', selector: '#review-order', matches: 'безопас|ключ|форм' },
				{ id: 'order-law', kind: 'text', selector: '#review-order', matches: 'данн|закон|152|соглас' }
			]
