			}
		],
		sources: [
			{ title: 'OWASP: Top 10 for Large Language Model Applications', url: 'https://owasp.org/www-project-top-10-for-large-language-model-applications/', licence: 'CC-BY-SA', kind: 'docs', lang: 'en' },
