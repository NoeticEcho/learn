<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	import { page, baseCss } from '../../diagrams/practice-kit.ts';

	const cats = ['доступность', 'семантика', 'тексты', 'скорость'];
	const log = (v) => `<section data-scaffold id="cap">
      <h2>Журнал итоговой проверки</h2>
      <ol id="cap-log">
${v.log.map((x) => `        <li>${x}</li>`).join('\n')}
      </ol>
      <p id="cap-cat">Что я проверил: ${v.cat}</p>
      <p id="cap-verdict">Готов ли сайт к запуску и что осталось человеку: ${v.verdict}</p>
    </section>`;

	const generated = `      <h1>{{name}}</h1>
      <p class="big">Мы — команда профессионалов, которая всегда рада помочь вам достичь новых высот!!!</p>
      <p><a class="button" href="#form">{{mainAction.label}}</a></p>
      <img class="hero" src="/images/portrait-4000x3000.jpg">
      <img class="below" src="/images/office.jpg" alt="Рабочее место" width="640" height="480">
      {{#each sections}}<div class="title">{{.}}</div>
      <p>Раздел «{{.}}» рассказывает о нашей работе. <a href="#form">Подробнее</a></p>
      {{/each}}
      <h4>Что мы предлагаем</h4>
      <p>{{#each items}}{{title}}<br>{{/each}}</p>
      <p class="note">Данные о ценах актуальны на дату публикации.</p>
      <form id="form" action="https://api.example.ru/leads" method="post">
        <input name="phone" placeholder="Телефон">
        <button>ОТПРАВИТЬ!!!</button>
      </form>
      <link rel="stylesheet" href="https://fonts.example-fonts.com/css?family=Display">
      <script src="https://cdn.example-cdn.com/jquery.js"><\/script>`;

	const reviewed = `      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#form">{{mainAction.label}}</a></p>
      <img class="hero" src="/images/portrait.jpg" alt="Портрет: {{name}}" width="640" height="480">
      <img class="below" src="/images/office.jpg" alt="Рабочее место" width="640" height="480" loading="lazy">
      {{#each sections}}<h2>{{.}}</h2>
      <p>Раздел «{{.}}»: что в нём и зачем он вам.</p>
      {{/each}}
      <h2>Что мы предлагаем</h2>
      <ul>
        {{#each items}}<li>{{title}}</li>
        {{/each}}
      </ul>
      <p class="note">Цены актуальны на дату публикации.</p>
      <form id="form" action="https://api.example.ru/leads" method="post">
        <p><label for="f-phone">Телефон</label> <input id="f-phone" name="phone" type="tel" autocomplete="tel" required></p>
        <button type="submit">{{mainAction.label}}</button>
      </form>`;

	const css = (colour) => baseCss + `\n.note {\n  color: ${colour};\n}\n`;

	const li = (n) => ({ id: `log-${n}`, kind: 'text', selector: `#cap-log li:nth-child(${n})`, matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' });

	export const metadata = {
		id: '16-ai/07-iskin-capstone',
		part: 16,
		order: 7,
		title: 'Итоговая работа с Искином: интервью, сайт и критическая проверка',
		definition: 'Интервью с Искином — разговор, где ИИ задаёт вопросы по полям брифа и по ответам собирает сайт и сервис; результат проверяет человек.',
		summary:
			'Искин не ждёт запроса, а расспрашивает о деле и собирает из ответов сайт и сервис. После урока вы знаете, как устроено такое интервью и что оно решает, а чего не решает за вас, и проверяете «черновик Искина» на своём проекте всем, чему научились: доступностью, смысловой разметкой, текстом и скоростью. Итог работы: найденные и исправленные ошибки и честный ответ, готов ли сайт.',
		comic: {
			panels: [
				{ mood: 'explain', prop: 'sheet', label: 'интервью', caption: 'Искин спрашивает', say: 'Искин не ждёт запроса, он задаёт вопросы по каждому полю брифа. Ответов нет: так и скажите, выдумывать он не станет.' },
				{ mood: 'hmm', side: 'right', prop: 'browser', label: 'черновик', say: 'Первый черновик всегда сырой: заголовки не по порядку, картинка без alt, серый текст на белом. Ваше дело найти.' },
				{ mood: 'cheer', prop: 'cards', label: '4 проверки', caption: 'Ваша роль', say: 'Доступность, смысл разметки, текст, скорость. Что не прошло, исправляете вы. Это ваше понимание на деле.' }
			]
		},
		minutes: 40,
		teaches: ['future-iskin-flow', 'future-capstone-review'],
		requires: ['future-review-ai-output', 'future-agentic-web', 'future-builder-pipeline', 'quality-a11y-audit', 'quality-core-web-vitals'],
		practice: {
			id: 'future-iskin-review',
			title: 'Проверьте «черновик Искина» на своём проекте',
			task: 'Искин собрал черновик страницы по вашему брифу, но в нём есть ошибки четырёх видов. Исправьте их прямо в коде и в стилях. Доступность: у картинки нужен alt, у поля подпись label, а серый текст .note слишком бледный (контраст не ниже 4,5, цвет задаётся в styles.css). Смысловая разметка: один h1, названия разделов должны быть заголовками h2 (сейчас div, а потом h4), список предложений настоящим списком ul вместо строк с br. Тексты: уберите пустые формулы и восклицательные знаки, вместо «Подробнее» напишите что-то понятное без этого слова, на кнопке формы название главного действия из брифа. Скорость: у каждой картинки width и height, нижняя картинка loading="lazy", а главная (hero) не lazy, и никаких чужих скриптов и шрифтов. Запишите в журнал не меньше шести находок и скажите, готов ли сайт к запуску. Все «…» нужно заменить.',
			era: 8,
			files: { 'index.html': page({ main: generated, scaffold: log({ log: ['…', '…', '…', '…', '…', '…'], cat: '…', verdict: '…' }) }), 'styles.css': css('#b0b0b0') },
			solution: {
				'index.html': page({
					main: reviewed,
					scaffold: log({
						log: [
							'Серый текст в примечании был почти не виден, сделал цвет темнее и довёл контраст выше 4,5',
							'У главной картинки не было alt и размеров, добавил описание и ширину с высотой',
							'Названия разделов были div, а потом h4, заменил на нормальные h2 по порядку',
							'Предложения шли через br, сделал настоящий список ul с пунктами li',
							'Убрал пустые формулы и восклицательные знаки и безликое «Подробнее» из текстов',
							'Убрал чужие скрипт и шрифт, нижней картинке поставил отложенную загрузку'
						],
						cat: 'доступность (alt, подписи, контраст), семантика (h1, h2, список), тексты (без формул и восклицаний), скорость (размеры картинок, lazy, без чужих ресурсов).',
						verdict: 'форма и подтверждения ещё на человеке, поэтому к запуску сайт готов не полностью: сначала вычитываю факты, проверяю согласие и политику и прохожу страницу клавишей Tab.'
					})
				}),
				'styles.css': css('#595959')
			},
			checks: [
				{ id: 'cap', kind: 'exists', selector: '#cap' },
				{ id: 'no-blanks', kind: 'text', selector: '#cap', matches: '^[^…]*$' },
				{ id: 'one-h1', kind: 'count', selector: 'h1', min: 1, max: 1 },
				{ id: 'no-h4', kind: 'count', selector: 'h4', max: 0 },
				{ id: 'h2-sections', kind: 'count', selector: 'h2', min: { brief: 'sections' } },
				{ id: 'no-fake-titles', kind: 'count', selector: '.title', max: 0 },
				{ id: 'real-list', kind: 'count', selector: 'main ul li', min: { brief: 'items' } },
				{ id: 'no-br', kind: 'count', selector: 'main p br', max: 0 },
				{ id: 'img-alt', kind: 'count', selector: 'img:not([alt])', max: 0 },
				{ id: 'img-size', kind: 'count', selector: 'img:not([width]), img:not([height])', max: 0 },
				{ id: 'img-lazy', kind: 'attr', selector: 'img.below', name: 'loading', matches: '^lazy$' },
				{ id: 'hero-not-lazy', kind: 'count', selector: 'img.hero[loading="lazy"]', max: 0 },
				{ id: 'labels', kind: 'label' },
				{ id: 'contrast-note', kind: 'contrast', selector: '.note', min: 4.5 },
				{ id: 'button-text', kind: 'field', selector: 'form button', field: 'mainAction.label' },
				{ id: 'no-exclaim', kind: 'text', selector: 'main', matches: '^(?![\\s\\S]*!)' },
				{ id: 'no-fluff', kind: 'text', selector: 'main', matches: '^(?![\\s\\S]*(?:новых высот|рада помочь|профессионалов))' },
				{ id: 'no-more', kind: 'text', selector: 'main', matches: '^(?![\\s\\S]*Подробнее)' },
				{ id: 'no-third-party', kind: 'count', selector: '[src^="http"], link[href^="http"]', max: 0 },
				li(1),
				li(2),
				li(3),
				li(4),
				li(5),
				li(6),
				{ id: 'cat-a11y', kind: 'text', selector: '#cap-cat', matches: 'доступн' },
				{ id: 'cat-semantics', kind: 'text', selector: '#cap-cat', matches: 'семантик|разметк|заголов' },
				{ id: 'cat-text', kind: 'text', selector: '#cap-cat', matches: 'текст|формулиров|копирайт' },
				{ id: 'cat-speed', kind: 'text', selector: '#cap-cat', matches: 'скорост|производительн|вес|картинк|lazy' },
				{ id: 'verdict', kind: 'text', selector: '#cap-verdict', matches: '^\\s*\\S+(?:\\s+\\S+){9,}' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Чем интервью с Искином отличается от запроса конструктору?',
				options: [
					'Он сам задаёт вопросы по полям брифа и ничего не выдумывает: чего вы не знаете, остаётся пустым и помечается для вас',
					'Он угадывает ответы по названию проекта',
					'Он не нуждается в брифе, потому что знает всё сам'
				],
				answer: 0,
				why: [
					'Да. Это приём из урока про запросы, доведённый до конца: вместо того чтобы достраивать пропуски шаблоном, собеседник спрашивает. Качество сайта зависит от качества ответов, а не от красноречия запроса.',
					'Нет: угадывание это и есть шаблон, от которого вы защищались.',
					'Нет: бриф как раз и есть то, что интервью заполняет.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что Искин оставляет решать человеку?',
				options: [
					'Правдивость фактов и подтверждений',
					'Текст политики обработки данных и согласия (вместе с юристом)',
					'Подключение оплаты',
					'Цвет кнопки'
				],
				answer: [0, 1, 2],
				why: [
					'Да: правду о вас знаете только вы.',
					'Да: достаточность текста для закона оценивает человек.',
					'Да: деньги подключают сознательно, через готовый сервис.',
					'Нет: это вопрос оформления, и его можно отдать с проверкой глазами.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините признак из черновика с областью проверки',
				pairs: [
					['серый текст на белом, контраст 2 к 1', 'доступность'],
					['названия разделов в div, а потом h4', 'семантика разметки'],
					['«Мы всегда рады помочь вам достичь новых высот!!!»', 'тексты'],
					['картинка без width и height, чужой скрипт на странице', 'скорость']
				]
			},
			{
				type: 'single',
				prompt: 'Первой, самой большой картинке на странице поставили loading="lazy". Хорошо ли это?',
				options: [
					'Нет: главная картинка видна сразу и определяет скорость показа, откладывать её нельзя; отложенная загрузка для картинок ниже первого экрана',
					'Да: lazy всегда ускоряет',
					'Это ни на что не влияет'
				],
				answer: 0,
				why: [
					'Да. Откладывание нужно для того, что находится за пределами первого экрана. Если отложить главную картинку, самый заметный элемент появится позже, и показатель LCP ухудшится.',
					'Нет: ускоряет не всегда, а только для картинок вне первого экрана.',
					'Нет: влияет, и заметно.'
				]
			},
			{
				type: 'order',
				prompt: 'Расставьте шаги итоговой проверки в разумном порядке',
				items: [
					'Пройти интервью и заполнить бриф без выдуманных ответов',
					'Получить черновик сайта и сервиса',
					'Проверить факты и подтверждения по брифу',
					'Проверить доступность, смысловую разметку и тексты',
					'Проверить скорость и чужие ресурсы',
					'Решить, готов ли сайт, и записать, что осталось человеку'
				]
			}
		],
		cards: [
			{
				id: 'future-iskin-what',
				front: 'Что такое интервью с Искином?',
				back: 'Разговор, где ИИ задаёт вопросы по полям брифа (чем занимаетесь, для кого, главное действие, разделы, предложения, подтверждения, контакты и запреты, тон), записывает ответы в бриф и собирает сайт и сервис. Чего вы не знаете, остаётся пустым.'
			},
			{
				id: 'future-iskin-leaves',
				front: 'Что остаётся человеку после интервью?',
