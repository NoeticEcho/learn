	export const metadata = {
		id: '11-copywriting/10-ladder',
		part: 11,
		order: 10,
		title: 'Лестница ценности и офферы',
		summary:
			'Вы построите для своего проекта последовательность предложений от бесплатного до основного, с допродажей и облегчённым вариантом, и поймёте, где лестница честна, а где превращается в давление. После урока у вас есть пять ступеней с текстом и ценой, форма лид-магнита с отдельными согласиями и список давлений, от которых вы отказались.',
		minutes: 25,
		teaches: ['copy-value-ladder', 'copy-lead-magnet-tripwire', 'copy-core-offer-oto'],
		requires: ['copy-funnel', 'copy-dark-patterns', 'texts-legal-text'],
		practice: {
			id: 'value-ladder',
			title: 'Лестница предложений вашего проекта',
			task: 'Постройте лестницу из пяти ступеней и напишите для каждой название и текст. 1) Лид-магнит решает один узкий вопрос вашей аудитории; форма просит только почту, у неё две отдельные галочки (на обработку данных, слово «обработку», и на рассылку, слова «письма» или «новости»), обе не отмечены заранее, кнопка называет, что человек получит. 2) Недорогое первое предложение с ценой цифрой. 3) Основное предложение: название пункта из брифа и ссылка с главным действием из брифа теми же словами. 4) Дополнение и 5) облегчённый вариант, у обоих названа цена. В тексте нет давления («осталось», «только сегодня», «успейте»). В заметке для каждой ступени впишите цену (число или «бесплатно») и зачем она человеку, а также где могло появиться давление и чем вы это заменили. Для эксперта нет гарантий и превосходных степеней. Все «…» нужно заменить.',
			era: 8,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <main>
      <section id="ladder-page">
        <h2>Предложения</h2>

        <article class="rung" data-rung="lead">
          <h3>Бесплатно</h3>
          <p class="r-title">…</p>
          <p class="r-text">…</p>
          <form class="lead-form">
            <p><label for="lm-email">Почта</label><br><input id="lm-email" name="email" type="email"></p>
            <p><input id="lm-data" name="data" type="checkbox"> <label for="lm-data" class="consent-data">…</label></p>
            <p><input id="lm-news" name="news" type="checkbox"> <label for="lm-news" class="consent-news">…</label></p>
            <button type="submit">…</button>
          </form>
        </article>

        <article class="rung" data-rung="tripwire">
          <h3>Недорогое первое предложение</h3>
          <p class="r-title">…</p>
          <p class="r-text">…</p>
        </article>

        <article class="rung" data-rung="core">
          <h3>Основное предложение</h3>
          <p class="r-title">{{items.0.title}}</p>
          <p class="r-text">…</p>
          <p><a class="cta" href="#contacts">…</a></p>
        </article>

        <article class="rung" data-rung="upsell">
          <h3>Дополнение</h3>
          <p class="r-title">…</p>
          <p class="r-text">…</p>
        </article>

        <article class="rung" data-rung="downsell">
          <h3>Облегчённый вариант</h3>
          <p class="r-title">…</p>
          <p class="r-text">…</p>
        </article>
      </section>
    </main>

    <aside class="note" data-scaffold id="ladder-notes">
      <h2>Лестница: цены и зачем каждая ступень</h2>
      <table id="ladder">
        <tr><th>Ступень</th><th>Цена</th><th>Зачем она человеку</th></tr>
        <tr class="row">
          <td>Бесплатно</td>
          <td class="price">…</td>
          <td class="why">…</td>
        </tr>
        <tr class="row">
          <td>Недорогое первое</td>
          <td class="price">…</td>
          <td class="why">…</td>
        </tr>
        <tr class="row">
          <td>Основное</td>
          <td class="price">…</td>
          <td class="why">…</td>
        </tr>
        <tr class="row">
          <td>Дополнение</td>
          <td class="price">…</td>
          <td class="why">…</td>
        </tr>
        <tr class="row">
          <td>Облегчённый вариант</td>
          <td class="price">…</td>
          <td class="why">…</td>
        </tr>
      </table>
      <p>Где на лестнице могло бы появиться давление и чем я это заменил: <span id="pressure-notes">…</span></p>
    </aside>
  </body>
</html>
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <main>
      <section id="ladder-page">
        <h2>Предложения</h2>

        <article class="rung" data-rung="lead">
          <h3>Бесплатно</h3>
          <p class="r-title">Чек-лист: что подготовить к первому обращению</p>
          <p class="r-text">Один лист с перечнем документов и вопросов; нужна только почта, чтобы прислать.</p>
          <form class="lead-form">
            <p><label for="lm-email">Почта</label><br><input id="lm-email" name="email" type="email"></p>
            <p><input id="lm-data" name="data" type="checkbox"> <label for="lm-data" class="consent-data">Согласен на обработку почты, чтобы мне прислали материал.</label></p>
            <p><input id="lm-news" name="news" type="checkbox"> <label for="lm-news" class="consent-news">Хочу получать письма с новостями. Отписаться можно одним нажатием в любом письме.</label></p>
            <button type="submit">Получить чек-лист</button>
          </form>
        </article>

        <article class="rung" data-rung="tripwire">
          <h3>Недорогое первое предложение</h3>
          <p class="r-title">Разбор ваших документов</p>
          <p class="r-text">Короткая встреча, после которой вы знаете, что делать дальше. Цена 3 000 ₽, названа заранее, продлений нет.</p>
        </article>

        <article class="rung" data-rung="core">
          <h3>Основное предложение</h3>
          <p class="r-title">{{items.0.title}}</p>
          <p class="r-text">Работа от первого шага до результата: порядок действий, срок и цена названы до начала.</p>
          <p><a class="cta" href="#contacts">{{mainAction.label}}</a></p>
        </article>

        <article class="rung" data-rung="upsell">
          <h3>Дополнение</h3>
          <p class="r-title">Сопровождение после результата</p>
          <p class="r-text">Можно добавить к основной работе или заказать позже по той же цене: 1 500 ₽. Отдельный выбор, не отмечено заранее.</p>
        </article>

        <article class="rung" data-rung="downsell">
          <h3>Облегчённый вариант</h3>
          <p class="r-title">Консультация без выезда</p>
          <p class="r-text">Если полный объём сейчас не нужен: письменный разбор по вашим документам, 2 000 ₽.</p>
        </article>
      </section>
    </main>

    <aside class="note" data-scaffold id="ladder-notes">
      <h2>Лестница: цены и зачем каждая ступень</h2>
      <table id="ladder">
        <tr><th>Ступень</th><th>Цена</th><th>Зачем она человеку</th></tr>
        <tr class="row">
          <td>Бесплатно</td>
          <td class="price">бесплатно</td>
          <td class="why">Понять порядок действий, ничего не отдавая, кроме почты</td>
        </tr>
        <tr class="row">
          <td>Недорогое первое</td>
          <td class="price">3 000 ₽</td>
          <td class="why">Проверить, подходит ли проект, с малым риском</td>
        </tr>
        <tr class="row">
          <td>Основное</td>
          <td class="price">от 15 000 ₽</td>
          <td class="why">Решить задачу целиком</td>
        </tr>
        <tr class="row">
          <td>Дополнение</td>
          <td class="price">1 500 ₽</td>
          <td class="why">Закрепить результат, если это нужно</td>
        </tr>
        <tr class="row">
          <td>Облегчённый вариант</td>
          <td class="price">2 000 ₽</td>
          <td class="why">Получить часть пользы, если сейчас нужно меньше</td>
        </tr>
      </table>
      <p>Где на лестнице могло бы появиться давление и чем я это заменил: <span id="pressure-notes">Срок есть только настоящий, дополнение не отмечено заранее, цена и условия видны сразу, рассылка отдельной галочкой.</span></p>
    </aside>
  </body>
</html>
`
			},
			checks: [
				{ id: 'no-blanks', kind: 'text', selector: '#ladder-page', matches: '^[^…]*$' },
				{ id: 'no-blanks-notes', kind: 'text', selector: '#ladder-notes', matches: '^[^…]*$' },
				{ id: 'five-rungs', kind: 'count', selector: '#ladder-page .rung', min: 5 },
				{ id: 'lead-minimal', kind: 'count', selector: '#ladder-page [data-rung="lead"] input:not([type="checkbox"])', max: 1 },
				{ id: 'lead-consents', kind: 'count', selector: '#ladder-page [data-rung="lead"] input[type="checkbox"]', min: 2 },
				{ id: 'consent-unchecked', kind: 'count', selector: '#ladder-page input[checked]', max: 0 },
				{ id: 'consent-data', kind: 'text', selector: '#ladder-page label.consent-data', matches: 'обработк' },
				{ id: 'consent-news', kind: 'text', selector: '#ladder-page label.consent-news', matches: '[Пп]исьм|[Нн]овост|[Рр]ассыл' },
				{ id: 'lead-button', kind: 'text', selector: '#ladder-page [data-rung="lead"] button', matches: '^\\s*(?!Отправить\\s*$)\\S+(?:\\s+\\S+)+' },
				{ id: 'core-action', kind: 'field', selector: '#ladder-page [data-rung="core"] .cta', field: 'mainAction.label' },
				{ id: 'core-item', kind: 'field', selector: '#ladder-page [data-rung="core"]', field: 'items[].title', min: 1, when: { brief: 'items[].title' } },
				{ id: 'prices-in-text', kind: 'text', selector: '#ladder-page [data-rung="tripwire"] .r-text', matches: '\\d' },
				{ id: 'prices-upsell', kind: 'text', selector: '#ladder-page [data-rung="upsell"] .r-text', matches: '\\d' },
				{ id: 'prices-downsell', kind: 'text', selector: '#ladder-page [data-rung="downsell"] .r-text', matches: '\\d' },
				{ id: 'no-pressure', kind: 'text', selector: '#ladder-page', matches: '^(?![\\s\\S]*(?:[Оо]сталось|[Тт]олько сегодня|[Уу]спейте|[Тт]ороп|[Пп]оследний шанс|[Нн]авсегда))[\\s\\S]*\\S' },
				{ id: 'ladder-rows', kind: 'count', selector: '#ladder tr.row', min: 5 },
				{ id: 'ladder-prices', kind: 'text', selector: '#ladder', matches: '^(?:[\\s\\S]*?(?:\\d|[Бб]есплатн|смет)){5}' },
				{ id: 'ladder-why', kind: 'text', selector: '#ladder .why', matches: '^(?:\\s*\\S+){4,}' },
				{ id: 'pressure-notes', kind: 'text', selector: '#pressure-notes', matches: '^(?:\\s*\\S+){8,}' },
				{
					id: 'no-guarantees',
					kind: 'text',
					selector: '#ladder-page',
					matches: '^(?![\\s\\S]*(?:[Гг]арантир|[Лл]учш|№ ?1|100 ?%|[Вв]ыиграем|[Бб]ез риска|[Сс]амый|[Сс]амая|[Сс]амое|[Сс]амые|нет равных))[\\s\\S]*\\S',
					when: { brief: 'kind', equals: 'expert' }
				}
			]
		},
		quiz: [
			{
				type: 'order',
				prompt: 'Расставьте ступени лестницы ценности от самой лёгкой для человека к самой весомой',
				items: [
					'Лид-магнит: полезное бесплатно',
					'Недорогое первое предложение (tripwire)',
					'Основное предложение',
					'Допродажа к основному'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините термин с тем, что это',
				pairs: [
					['Лид-магнит', 'Полезный материал бесплатно в обмен на контакт, решающий один узкий вопрос'],
					['Tripwire', 'Недорогое первое платное предложение, превращающее контакт в покупателя'],
					['Основное предложение', 'То, что решает главную задачу клиента и приносит основную часть дохода'],
					['One-time offer (OTO)', 'Дополнение, показанное в момент покупки'],
					['Upsell', 'Предложение более полной или дорогой версии'],
					['Downsell', 'Облегчённый вариант тем, кому полный пока не нужен']
				]
			},
			{
				type: 'multiple',
				prompt: 'Что делает лид-магнит честным?',
				options: [
					'Решает один конкретный вопрос человека',
					'Просит только те данные, которые нужны, чтобы прислать материал',
					'Согласие на рассылку вшито в получение материала',
					'Материал приходит и без согласия на рассылку',
					'Обещает 30 страниц, а присылает две'
				],
				answer: [0, 1, 3],
				why: [
					'Да: широкий «гайд обо всём» никому не помогает.',
					'Да: лишние данные нарушают принцип соответствия цели.',
					'Нет: согласие на рассылку должно быть отдельным и добровольным.',
					'Да: рассылка отдельный выбор.',
					'Нет: это приманка и подмена: человек обманут с первого шага.'
				]
			},
			{
				type: 'single',
				prompt: 'Какое из условий делает «одноразовое предложение» (OTO) честным?',
				options: [
					'Это настоящее дополнение к только что купленному, цена видна, отказаться можно одним нажатием, а сроки и «только сейчас» правдивы',
					'Предложение исчезает навсегда, хотя завтра вернётся',
					'Дополнение уже добавлено в заказ, и его нужно убрать'
				],
				answer: 0,
				why: [
					'Да. Честный OTO это просто своевременное предложение: человек в момент решения, и ему нужно не больше одного вопроса.',
					'Нет: выдуманная исключительность недостоверное сведение об условиях.',
					'Нет: платное дополнение без согласия нарушает закон о защите прав потребителей.'
				]
			},
			{
				type: 'single',
				prompt: 'Почему слово «tripwire» в русском тексте для клиентов лучше заменить?',
				options: [
					'Оно означает «растяжку-ловушку» и непонятно клиенту; закон о рекламе не любит иностранных слов, искажающих смысл',
					'Потому что оно устарело',
					'Потому что его нельзя произнести'
				],
				answer: 0,
				why: [
					'Да. Для клиента называйте это «недорогое первое предложение» или по сути («разбор документов»). Слово «tripwire» остаётся для вас и коллег.',
					'Нет: термин живой, но для внутреннего пользования.',
					'Нет: произносить его можно.'
				]
			},
			{
				type: 'single',
				prompt: 'Чем честная допродажа отличается от манипулятивной?',
				options: [
					'Честная служит потребности покупателя («посоветовал бы я это знакомому?»), нечестная только вашей выручке',
					'Честная всегда дешевле',
					'Нечестная всегда длиннее'
				],
				answer: 0,
				why: [
					'Да. Проверка простая: порекомендовали бы вы это знакомому в том же положении? Если нет, это давление.',
					'Нет: цена тут ни при чём.',
					'Нет: длина не показатель.'
				]
			},
			{
				type: 'single',
				prompt: 'Лестница ценности честна, когда…',
				options: [
					'Человек выигрывает на каждой ступени, даже если дальше не пойдёт',
					'Каждая ступень строго дороже предыдущей',
					'Есть ровно пять ступеней'
				],
				answer: 0,
				why: [
					'Да. Проверка на каждую ступень: если человек на ней остановится, получит ли он пользу, ради которой пришёл? Если ступень существует только как путь к следующей, это воронка-ловушка.',
					'Нет: цена возрастает обычно, но это не критерий честности.',
					'Нет: число ступеней не причём.'
				]
			}
		],
		cards: [
			{
				id: 'copy-ladder-def',
				front: 'Что такое лестница ценности?',
				back: 'Последовательность предложений от бесплатного к основному: цена и обязательство растут, и на каждой ступени человек получает пользу. Расселл Брансон, «DotCom Secrets», 2015; Райан Дайс описал похожий «путь ценности клиента».'
			},
			{
				id: 'copy-lead-magnet',
				front: 'Каким должен быть честный лид-магнит?',
				back: 'Решает один узкий вопрос, просит только почту, отдельные галочки на обработку данных и на рассылку, материал приходит и без рассылки.'
			},
			{
				id: 'copy-tripwire',
				front: 'Что такое tripwire?',
				back: 'Недорогое первое платное предложение для превращения контакта в покупателя. Для клиента называйте по сути: «разбор документов». Цена и условия названы заранее, продления без согласия нет.'
			},
			{
				id: 'copy-core-oto',
				front: 'Что такое основное предложение и OTO?',
				back: 'Основное решает главную задачу и совпадает с главным действием. OTO это дополнение в момент покупки: настоящее, видное по цене, с простым отказом и правдивым сроком.'
			},
			{
				id: 'copy-upsell-downsell',
				front: 'Чем upsell отличается от downsell?',
				back: 'Upsell более полная версия тем, кто покупает; downsell облегчённый вариант тем, кому полный пока не нужен. Оба честны, если служат человеку и показаны без упрёка.'
			},
			{
				id: 'copy-ladder-honest',
				front: 'Как проверить лестницу на честность?',
				back: 'Если человек остановится на ступени, получит ли он пользу? Нет ли ложной срочности, предвыбора, скрытых условий? Отдельные согласия на данные и рассылку?'
			}
		],
		sources: [
			{ title: 'The Value Ladder (ClickFunnels)', url: 'https://www.clickfunnels.com/blog/value-ladder/', licence: 'proprietary-link', kind: 'article', lang: 'en' },
			{ title: 'Lead generation (Wikipedia)', url: 'https://en.wikipedia.org/wiki/Lead_generation', licence: 'CC-BY-SA', kind: 'article', lang: 'en' },
			{ title: 'Лидогенерация (Википедия)', url: 'https://ru.wikipedia.org/wiki/Лидогенерация', licence: 'CC-BY-SA', kind: 'article', lang: 'ru' },
			{ title: 'Upselling (Wikipedia)', url: 'https://en.wikipedia.org/wiki/Upselling', licence: 'CC-BY-SA', kind: 'article', lang: 'en' },
			{ title: 'Федеральный закон № 38-ФЗ «О рекламе»', url: 'https://www.consultant.ru/document/cons_doc_LAW_58968/', licence: 'proprietary-link', kind: 'spec', lang: 'ru' },
			{ title: 'Закон «О защите прав потребителей» (КонсультантПлюс)', url: 'https://www.consultant.ru/document/cons_doc_LAW_305/', licence: 'proprietary-link', kind: 'spec', lang: 'ru' }
		],
