	export const metadata = {
		id: '11-copywriting/07-marketing',
		part: 11,
		order: 7,
		title: 'STP, 4P/7P и карта пути клиента',
		definition: 'STP — стратегия в три шага: сегментирование, таргетинг, позиционирование. Маркетинг-микс 4P и 7P описывает предложение, а карта пути клиента — дорогу к нему.',
		summary:
			'Вы выберете, кому вы продаёте, как это позиционируете и как складывается маркетинг-микс, и нарисуете путь клиента от первого касания до результата с местами, где он теряется. После урока у вас есть сегменты с основным, положение на карте восприятия, заполненные семь «P» и карта пути к вашему главному действию.',
		minutes: 25,
		teaches: ['copy-stp', 'copy-marketing-mix', 'copy-journey-map'],
		requires: ['copy-value-proposition-canvas'],
		comic: {
			panels: [
				{ mood: 'hmm', caption: 'STP: сегменты', say: 'Сегмент это не «женщины 30–45», а общая потребность: «сосед передвинул забор, хочу понять, где граница».' },
				{ mood: 'explain', side: 'right', prop: 'flowchart', label: 'увидел|ищет|выбирает|заявка', caption: 'Путь клиента', say: 'Путь не заканчивается кнопкой. До неё были поиск и сравнение, после неё будет сама услуга.' },
				{ mood: 'hint', caption: 'Чьими глазами', say: 'Модель 4P смотрит глазами продавца: что мы предлагаем. Карта пути смотрит глазами клиента.' }
			]
		},
		practice: {
			id: 'marketing-map',
			title: 'Сегменты, карта восприятия, 7P и путь клиента',
			task: 'Постройте для проекта четыре вещи. 1) Сегменты: по трём сегментам аудитории из брифа впишите, какую задачу (работу) решает человек в каждом, не возраст и не пол; выберите основной сегмент и объясните выбор. 2) Карта восприятия: впишите две оси, которые клиенты действительно используют при выборе и которые не сводятся к цене и «качеству», и расставьте проект и двух конкурентов по осям числами от 1 до 5. 3) Таблица 7P: продукт уже вписан из брифа, остальные шесть впишите сами, цену числом или диапазоном. 4) Путь клиента: касание на каждом из шести этапов (в этапе «Обращается» главное действие из брифа теми же словами) и «да» или «нет» в колонке «Здесь люди уходят», хотя бы одно «да». Все «…» нужно заменить.',
			era: 8,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p>{{who}}</p>

    <aside class="note" data-scaffold id="marketing">
      <h2>STP: сегменты</h2>
      <p>Для кого проект по брифу: {{forWhom}}</p>
      <table id="segments">
        <tr><th>Сегмент</th><th>Какую задачу решает человек (его «работа»)</th></tr>
        <tr class="segment">
          <td class="seg-name">…</td>
          <td class="seg-job">…</td>
        </tr>
        <tr class="segment">
          <td class="seg-name">…</td>
          <td class="seg-job">…</td>
        </tr>
        <tr class="segment">
          <td class="seg-name">…</td>
          <td class="seg-job">…</td>
        </tr>
      </table>
      <p>Основной сегмент: <span id="main-segment">…</span>, потому что <span id="main-why">…</span></p>

      <h2>Карта восприятия</h2>
      <p>Ось X: <span id="axis-x">…</span>. Ось Y: <span id="axis-y">…</span>.</p>
      <table id="map">
        <tr><th>Кто</th><th>X, от 1 до 5</th><th>Y, от 1 до 5</th></tr>
        <tr class="pt">
          <td>Проект</td>
          <td class="px">…</td>
          <td class="py">…</td>
        </tr>
        <tr class="pt">
          <td>Конкурент А</td>
          <td class="px">…</td>
          <td class="py">…</td>
        </tr>
        <tr class="pt">
          <td>Конкурент Б</td>
          <td class="px">…</td>
          <td class="py">…</td>
        </tr>
      </table>

      <h2>7P</h2>
      <table id="p7">
        <tr><th>Элемент</th><th>Что у проекта</th></tr>
        <tr data-p="product">
          <td>Продукт</td>
          <td class="p-text">{{#each items}}{{title}}; {{/each}}</td>
        </tr>
        <tr data-p="price">
          <td>Цена</td>
          <td class="p-text">…</td>
        </tr>
        <tr data-p="place">
          <td>Место</td>
          <td class="p-text">…</td>
        </tr>
        <tr data-p="promotion">
          <td>Продвижение</td>
          <td class="p-text">…</td>
        </tr>
        <tr data-p="people">
          <td>Люди</td>
          <td class="p-text">…</td>
        </tr>
        <tr data-p="process">
          <td>Процесс</td>
          <td class="p-text">…</td>
        </tr>
        <tr data-p="evidence">
          <td>Окружение</td>
          <td class="p-text">…</td>
        </tr>
      </table>

      <h2>Путь клиента к главному действию</h2>
      <table id="journey">
        <tr><th>Этап</th><th>Касание</th><th>Здесь люди уходят?</th></tr>
        <tr class="stage">
          <td>Заметил проблему</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
        <tr class="stage">
          <td>Ищет</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
        <tr class="stage">
          <td>Сравнивает</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
        <tr class="stage">
          <td>Обращается</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
        <tr class="stage">
          <td>Получает услугу</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
        <tr class="stage">
          <td>После</td>
          <td class="touch">…</td>
          <td class="exit">…</td>
        </tr>
      </table>
    </aside>
  </body>
</html>
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p>{{who}}</p>

    <aside class="note" data-scaffold id="marketing">
      <h2>STP: сегменты</h2>
      <p>Для кого проект по брифу: {{forWhom}}</p>
      <table id="segments">
        <tr><th>Сегмент</th><th>Какую задачу решает человек (его «работа»)</th></tr>
        <tr class="segment">
          <td class="seg-name">Первый сегмент</td>
          <td class="seg-job">когда у человека срочная задача, он хочет быстро понять порядок действий</td>
        </tr>
        <tr class="segment">
          <td class="seg-name">Второй сегмент</td>
          <td class="seg-job">когда человек планирует заранее, он хочет сравнить варианты и выбрать надёжный</td>
        </tr>
        <tr class="segment">
          <td class="seg-name">Третий сегмент</td>
          <td class="seg-job">когда человека направили к специалисту, он хочет убедиться, что ему можно доверять</td>
        </tr>
      </table>
      <p>Основной сегмент: <span id="main-segment">первый сегмент</span>, потому что <span id="main-why">у него самая частая и самая острая задача</span></p>

      <h2>Карта восприятия</h2>
      <p>Ось X: <span id="axis-x">разово или сопровождение</span>. Ось Y: <span id="axis-y">быстро или глубоко</span>.</p>
      <table id="map">
        <tr><th>Кто</th><th>X, от 1 до 5</th><th>Y, от 1 до 5</th></tr>
        <tr class="pt">
          <td>Проект</td>
          <td class="px">4</td>
          <td class="py">3</td>
        </tr>
        <tr class="pt">
          <td>Конкурент А</td>
          <td class="px">2</td>
          <td class="py">2</td>
        </tr>
        <tr class="pt">
          <td>Конкурент Б</td>
          <td class="px">5</td>
          <td class="py">5</td>
        </tr>
      </table>

      <h2>7P</h2>
      <table id="p7">
        <tr><th>Элемент</th><th>Что у проекта</th></tr>
        <tr data-p="product">
          <td>Продукт</td>
          <td class="p-text">{{#each items}}{{title}}; {{/each}}</td>
        </tr>
        <tr data-p="price">
          <td>Цена</td>
          <td class="p-text">цена названа числом или диапазоном до начала работы, например 3 000 ₽ за консультацию</td>
        </tr>
        <tr data-p="place">
          <td>Место</td>
          <td class="p-text">где и как оказывается услуга: у клиента, онлайн или в офисе</td>
        </tr>
        <tr data-p="promotion">
          <td>Продвижение</td>
          <td class="p-text">как о проекте узнают: поиск, рекомендации, профильные сообщества</td>
        </tr>
        <tr data-p="people">
          <td>Люди</td>
          <td class="p-text">кто общается с клиентом и отвечает за результат</td>
        </tr>
        <tr data-p="process">
          <td>Процесс</td>
          <td class="p-text">какие шаги проходит клиент от заявки до результата</td>
        </tr>
        <tr data-p="evidence">
          <td>Окружение</td>
          <td class="p-text">что клиент может увидеть и проверить: документы, отчёты, помещение</td>
        </tr>
      </table>

      <h2>Путь клиента к главному действию</h2>
      <table id="journey">
        <tr><th>Этап</th><th>Касание</th><th>Здесь люди уходят?</th></tr>
        <tr class="stage">
          <td>Заметил проблему</td>
          <td class="touch">задача появилась, человек ищет решение</td>
          <td class="exit">нет</td>
        </tr>
        <tr class="stage">
          <td>Ищет</td>
          <td class="touch">поиск в интернете по названию услуги</td>
          <td class="exit">нет</td>
        </tr>
        <tr class="stage">
          <td>Сравнивает</td>
          <td class="touch">страница с ценами и подтверждениями</td>
          <td class="exit">да</td>
        </tr>
        <tr class="stage">
          <td>Обращается</td>
          <td class="touch">{{mainAction.label}}</td>
          <td class="exit">да</td>
        </tr>
        <tr class="stage">
          <td>Получает услугу</td>
          <td class="touch">первая встреча или выполнение работы</td>
          <td class="exit">нет</td>
        </tr>
        <tr class="stage">
          <td>После</td>
          <td class="touch">письмо или звонок после результата</td>
          <td class="exit">нет</td>
        </tr>
      </table>
    </aside>
  </body>
</html>
`
			},
			checks: [
				{ id: 'no-blanks', kind: 'text', selector: '#marketing', matches: '^[^…]*$' },
				{ id: 'segments', kind: 'count', selector: '#segments .segment', min: 3 },
				{ id: 'segment-jobs', kind: 'text', selector: '#segments .seg-job', matches: '^\\s*\\S+(?:\\s+\\S+){5,}' },
				{ id: 'main-segment', kind: 'text', selector: '#main-segment', matches: '^\\s*\\S+' },
				{ id: 'main-why', kind: 'text', selector: '#main-why', matches: '^\\s*\\S+(?:\\s+\\S+){3,}' },
				{ id: 'axis-x', kind: 'text', selector: '#axis-x', matches: '^(?![\\s\\S]*(?:[Цц]ен|[Кк]ачеств|[Дд]ешев|[Дд]орог))\\s*\\S+(?:\\s+\\S+){1,}' },
				{ id: 'axis-y', kind: 'text', selector: '#axis-y', matches: '^(?![\\s\\S]*(?:[Цц]ен|[Кк]ачеств|[Дд]ешев|[Дд]орог))\\s*\\S+(?:\\s+\\S+){1,}' },
				{ id: 'map-rows', kind: 'count', selector: '#map tr.pt', min: 3 },
				{ id: 'map-numbers', kind: 'text', selector: '#map', matches: '^(?:[\\s\\S]*?(?<![0-9])[1-5](?![0-9])){6}' },
				{ id: 'p7-rows', kind: 'count', selector: '#p7 tr[data-p]', min: 7 },
				{ id: 'p7-price', kind: 'text', selector: '#p7 tr[data-p="price"] .p-text', matches: '\\d' },
				{ id: 'journey-stages', kind: 'count', selector: '#journey tr.stage', min: 6 },
				{ id: 'journey-action', kind: 'field', selector: '#journey .touch', field: 'mainAction.label' },
				{ id: 'journey-exit', kind: 'text', selector: '#journey .exit', matches: '^\\s*да\\s*$' }
			]
		},
		quiz: [
			{
				type: 'order',
				prompt: 'Расставьте шаги STP по порядку',
				items: [
					'Сегментирование: разделить аудиторию по различию в задачах',
					'Таргетинг: выбрать основной сегмент',
					'Позиционирование: занять в сознании сегмента определённое место относительно альтернатив'
				]
			},
			{
				type: 'single',
				prompt: 'По какому признаку полезнее всего делить аудиторию на сегменты (в нашем курсе)?',
				options: [
					'По задаче (работе), которую человек решает, и по ситуации',
					'Только по возрасту и полу',
					'По цвету, который им нравится'
				],
				answer: 0,
				why: [
					'Да. Возраст и пол легко измерить, но они мало говорят о том, зачем человек пришёл. Один и тот же человек в разных ситуациях в разных сегментах.',
					'Нет: возраст и пол бывают полезным дополнением, но не основой.',
					'Нет: цвет к выбору услуги отношения не имеет.'
				]
			},
			{
				type: 'single',
				prompt: 'Почему карта восприятия по осям «цена» и «качество» почти бесполезна?',
				options: [
					'Все хотят «дешевле и лучше», и каждый поместит себя в правый верхний угол: ось не различает',
					'Потому что цену нельзя измерить',
					'Потому что качество запрещено оценивать'
				],
				answer: 0,
				why: [
					'Да. Ось должна отражать то, по чему клиенты выбирают и по чему вы и конкуренты действительно различаетесь, например «разово или сопровождение».',
					'Нет: цену измерить можно, но ось не помогает увидеть различие.',
					'Нет: оценивать качество можно, но каждый скажет про себя «высокое».'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините «P» маркетинг-микса с вопросом, на который оно отвечает',
				pairs: [
					['Product, продукт', 'Что мы предлагаем?'],
					['Price, цена', 'Сколько это стоит и на каких условиях?'],
					['Place, место', 'Где и как клиент это получает?'],
					['Promotion, продвижение', 'Как о нас узнают?'],
					['People, люди', 'Кто общается с клиентом и отвечает за результат?'],
					['Process, процесс', 'Какие шаги проходит клиент?'],
					['Physical evidence, окружение', 'Что клиент видит и может проверить?']
				]
			},
			{
				type: 'single',
				prompt: 'Для чего к четырём P добавили ещё три в 1981 году (Бумс и Битнер)?',
				options: [
					'Для услуг: у них нет товара в руках, и клиенту важны люди, процесс и то, что можно проверить',
					'Для товаров массового спроса',
					'Чтобы получилось семь'
				],
				answer: 0,
				why: [
					'Да. Услугу нельзя пощупать до покупки, поэтому её оценивают по людям, процессу и «вещественным доказательствам»: документам, отчётам, помещению.',
					'Нет: для товаров хватает четырёх P, а три добавили именно для услуг.',
					'Нет: число не цель, а следствие потребностей услуг.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что должно быть на честной карте пути клиента?',
				options: [
					'Касания до и после главного действия',
					'Настроение или чувство клиента на каждом этапе',
					'Места, где люди уходят',
					'Только те этапы, на которых всё хорошо'
				],
				answer: [0, 1, 2],
				why: [
					'Да: путь не заканчивается кнопкой.',
					'Да: настроение показывает, где человеку труднее всего.',
					'Да: именно там нужно улучшать.',
					'Нет: карта, на которой всё хорошо, не нужна. Она нужна, чтобы найти плохое.'
				]
			}
		],
		cards: [
			{
				id: 'copy-stp-def',
				front: 'Что такое STP?',
				back: 'Сегментирование (разделить по различию в задачах), таргетинг (выбрать основной сегмент), позиционирование (место в сознании клиента относительно альтернатив). Сегментирование: Уэнделл Смит, 1956; позиционирование: Рис и Траут.'
			},
			{
				id: 'copy-perception-axes',
				front: 'Какие оси выбирать для карты восприятия?',
				back: 'Те, по которым клиенты выбирают и по которым вы с конкурентами правда различаетесь. «Цена» и «качество» не годятся: все себя ставят в угол.'
			},
			{
				id: 'copy-4p-7p',
				front: 'Что такое 4P и 7P?',
				back: 'Продукт, цена, место, продвижение (Маккарти, 1960). Для услуг ещё люди, процесс, окружение (Бумс и Битнер, 1981). Термин «маркетинг-микс» ввёл Нил Борден.'
			},
			{
				id: 'copy-journey-def',
				front: 'Что такое карта пути клиента?',
				back: 'Схема того, что человек проходит, чтобы достичь цели: этапы, касания, чувства, места ухода. Корни в проектировании услуг, Линн Шостак, 1984.'
			},
			{
				id: 'copy-journey-exits',
				front: 'Что на карте пути главное?',
				back: 'Самая низкая точка настроения и места, где люди уходят. Улучшать нужно там.'
			}
		],
		sources: [
			{ title: 'Market segmentation (Wikipedia)', url: 'https://en.wikipedia.org/wiki/Market_segmentation', licence: 'CC-BY-SA', kind: 'article', lang: 'en' },
			{ title: 'Сегментирование рынка (Википедия)', url: 'https://ru.wikipedia.org/wiki/Сегментирование_рынка', licence: 'CC-BY-SA', kind: 'article', lang: 'ru' },
			{ title: 'Позиционирование (маркетинг) (Википедия)', url: 'https://ru.wikipedia.org/wiki/Позиционирование_(маркетинг)', licence: 'CC-BY-SA', kind: 'article', lang: 'ru' },
			{ title: 'Marketing mix (Wikipedia)', url: 'https://en.wikipedia.org/wiki/Marketing_mix', licence: 'CC-BY-SA', kind: 'article', lang: 'en' },
			{ title: 'Комплекс маркетинга (Википедия)', url: 'https://ru.wikipedia.org/wiki/Комплекс_маркетинга', licence: 'CC-BY-SA', kind: 'article', lang: 'ru' },
			{ title: 'Customer Journey Mapping (Nielsen Norman Group)', url: 'https://www.nngroup.com/articles/customer-journey-mapping/', licence: 'proprietary-link', kind: 'article', lang: 'en' }
		],
		videos: [],
		guide: {
