				{ id: 'guide-proof', kind: 'field', selector: '#sb7 [data-part="guide"]', field: 'proofs[].title', min: 1, when: { brief: 'proofs[].title' } },
				{ id: 'plan-steps', kind: 'count', selector: '#sb7 .plan li', min: 3 },
