      <p id="fn-region">Где работает и почему там: ${v.region}</p>
    </section>`;

	const skeleton = `export default {
  async fetch(request, env) {
    // 1) пропустите только POST
    // 2) прочитайте поля формы и проверьте их
    // 3) отправьте заявку по адресу из настроек (env.WEBHOOK_URL), а не из кода
    // 4) ответьте: 200 при успехе, 400 при плохих данных
    …
  }
};`;

	const solved = `export default {
  async fetch(request, env) {
    if (request.method !== 'POST') {
      return new Response('Только POST', { status: 405 });
    }
    const data = await request.formData();
    const name = String(data.get('name') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    if (!name || !/^[+0-9 ()-]{6,20}$/.test(phone)) {
      return new Response('Проверьте поля', { status: 400 });
    }
    // адрес и ключ лежат в настройках сервиса (env), не в коде страницы
    await fetch(env.WEBHOOK_URL, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ name, phone })
    });
    return new Response('Принято', { status: 200 });
  }
};`;

