	export const metadata = {
		id: '05-javascript/01-values-functions',
		part: 5,
		order: 1,
		title: 'Значения, функции, массивы и объекты',
		definition: 'JavaScript — язык программирования браузера. Он работает со значениями разных типов, хранит данные в массивах и объектах и обрабатывает их функциями.',
		summary: 'HTML и CSS ничего не решают: решает JavaScript. После урока вы читаете и пишете короткие программы: храните пункты вашего списка в массиве объектов, превращаете их функциями в другие данные и знаете, чем отличаются тип, переменная и область видимости.',
		minutes: 25,
		teaches: ['js-values-and-types', 'js-functions', 'js-arrays-and-objects'],
		requires: ['html-document-structure', 'net-rendering-pipeline'],
		practice: {
			id: 'js-first-code',
			title: 'Первая программа на вашем сайте: сводка по списку',
			task: 'Добавьте на страницу первый скрипт. 1) В подвале (footer) поставьте пустой абзац с id="summary". 2) В конец body, перед закрывающим тегом, вставьте тег <script type="module" id="my-code">. Внутри запишите данные вашего списка массивом объектов: const items = [{ title: "…", price: "…" }, …], с вашими пунктами из брифа (не пишите var). 3) Напишите три функции: titlesOf(list) возвращает массив названий через map, withPrice(list) оставляет пункты с указанной ценой через filter, countOf(list) возвращает количество. Исходный массив менять нельзя: никаких push, sort и splice. 4) Составьте строку-сводку и покажите её в двух местах: console.log(summary) и document.querySelector("#summary").textContent = summary. Проверки читают текст вашего скрипта; что он делает, вы видите сами: сводка появится в подвале предпросмотра.',
			era: 4,
			continues: 'responsive-page',
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // Данные брифа: пункты списка. Пока они лежат здесь,
      // в уроке про fetch мы вынесем их в отдельный файл.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Только названия. map делает новый массив, items не меняется.
      const titlesOf = (list) => list.map((item) => item.title);

      // Только пункты, у которых указана цена.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // Сколько пунктов в списке.
      const countOf = (list) => list.length;

      const summary =
        'Всего позиций: ' + countOf(items) +
        ', с ценой: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			checks: [
				{
					id: 'summary-element',
					kind: 'exists',
					selector: 'footer #summary'
				},
				{
					id: 'my-code-exists',
					kind: 'exists',
					selector: 'script#my-code'
				},
				{
					id: 'is-module',
					kind: 'attr',
					selector: '#my-code',
					name: 'type',
					matches: '^module$'
				},
				{
					id: 'items-array',
					kind: 'text',
					selector: '#my-code',
					matches: '(?:const|let)\\s+items\\s*=\\s*\\[\\s*\\{',
					when: {
						brief: 'items[].title'
					}
				},
				{
					id: 'items-own-titles',
					kind: 'field',
					selector: '#my-code',
					field: 'items[].title',
					min: 2,
					when: {
						brief: 'items[].title'
					}
				},
				{
					id: 'no-var',
					kind: 'text',
					selector: '#my-code',
					matches: '^(?![\\s\\S]*\\bvar\\s+[\\w$])[\\s\\S]*\\S'
				},
				{
					id: 'uses-map',
					kind: 'text',
					selector: '#my-code',
					matches: '\\.map\\('
				},
				{
					id: 'uses-filter',
					kind: 'text',
					selector: '#my-code',
					matches: '\\.filter\\('
				},
				{
					id: 'uses-length',
					kind: 'text',
					selector: '#my-code',
					matches: '\\.length\\b'
				},
				{
					id: 'no-mutation',
					kind: 'text',
					selector: '#my-code',
					matches: '^(?![\\s\\S]*\\.(?:push|pop|shift|unshift|splice|sort|reverse)\\s*\\()[\\s\\S]*\\S'
				},
				{
					id: 'three-functions',
					kind: 'text',
					selector: '#my-code',
					matches: '^(?=[\\s\\S]*titlesOf)(?=[\\s\\S]*withPrice)(?=[\\s\\S]*countOf)'
				},
				{
					id: 'console-log',
					kind: 'text',
					selector: '#my-code',
					matches: 'console\\.log\\('
				},
				{
					id: 'writes-summary',
					kind: 'text',
					selector: '#my-code',
					matches: '^(?=[\\s\\S]*[\'"]#?summary[\'"])(?=[\\s\\S]*textContent)'
				}
			]
		},
		quiz: [
			{
				type: 'match',
				prompt: 'Соедините значение с его типом',
				pairs: [
					['42', 'число (number)'],
					['"Скатерть"', 'строка (string)'],
					['true', 'логическое значение: да или нет (boolean)'],
					['undefined', 'значения нет, переменную не заполнили'],
					['[1, 2, 3]', 'массив: пронумерованный список']
				]
			},
			{
				type: 'single',
				prompt: 'Что получится из выражения "5" + 3?',
				options: ['Строка "53": плюс склеил текст', 'Число 8', 'Ошибка'],
				answer: 0,
				why: [
					'Да. Если один из операндов строка, плюс склеивает. А вот "5" - 3 даст число 2: у минуса нет склеивающего смысла. Данные из полей формы всегда приходят строками, поэтому такие сюрпризы случаются на настоящих сайтах.',
					'Нет: JavaScript не станет превращать строку в число, если один из операндов уже строка.',
					'Нет: ошибки не будет, язык молча склеит значения. Именно эта молчаливость и опасна.'
				]
			},
			{
				type: 'single',
				prompt: 'Что случится при const price = 100; price = 200;?',
				options: [
					'Ошибка: const нельзя присвоить заново',
					'Цена станет 200',
					'Цена останется 100, ошибки не будет'
				],
				answer: 0,
				why: [
					'Да. const закрепляет связь имени с значением. Если значение нужно менять, берут let; по умолчанию берут const, чтобы случайно не затереть нужное.',
					'Нет: для этого есть let. С const скрипт остановится с ошибкой TypeError.',
					'Нет: молча игнорировать присваивание JavaScript не станет, он сообщит об ошибке.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Какие методы массива возвращают новый массив и не меняют исходный?',
				options: ['map', 'filter', 'push', 'sort'],
				answer: [0, 1],
				why: [
					'Да: map создаёт новый массив той же длины.',
					'Да: filter создаёт новый массив из подходящих элементов.',
					'Нет: push добавляет элемент прямо в исходный массив.',
					'Нет: sort переставляет элементы в самом исходном массиве. Если нужна отсортированная копия, делают её сначала или берут toSorted.'
				]
			},
			{
				type: 'order',
				prompt: 'Расставьте шаги конвейера «покажи названия пунктов с ценой» в порядке выполнения',
				items: [
					'Исходный массив items',
					'filter: оставить пункты с ценой',
					'map: взять из каждого название',
					'join: склеить названия в одну строку',
					'textContent: показать строку на странице'
				]
			},
			{
				type: 'single',
				prompt: 'Что выведет консоль? function f() { const secret = 1; } f(); console.log(secret);',
				options: ['ReferenceError: secret is not defined', '1', 'undefined'],
				answer: 0,
				why: [
					'Да. Переменная, объявленная внутри функции, живёт только в ней. Снаружи её не существует, и язык говорит, что такого имени нет.',
					'Нет: значение осталось внутри функции, снаружи его не достать.',
					'Нет: undefined был бы у существующей переменной без значения, а здесь имени нет вообще.'
				]
			},
			{
				type: 'code',
				prompt: 'Внутри скрипта запишите стрелочную функцию double, которая возвращает число, умноженное на 2',
				starter: '<script id="q">\n\n<\\/script>',
				checks: [
					{
						id: 'double-arrow',
						kind: 'text',
						selector: '#q',
						matches: '(?:const|let)\\s+double\\s*=\\s*\\(?\\s*\\w+\\s*\\)?\\s*=>[\\s\\S]*\\*\\s*2|(?:const|let)\\s+double\\s*=\\s*\\(?\\s*\\w+\\s*\\)?\\s*=>[\\s\\S]*2\\s*\\*'
					}
				]
			}
		],
		cards: [
			{
				id: 'js-types',
				front: 'Какие бывают типы значений в JavaScript?',
				back: 'Число, строка, логическое значение (true и false), undefined (нет значения), null (нарочно пусто), а ещё объекты, в том числе массивы и функции. Тип показывает typeof.'
			},
			{
				id: 'js-const-let',
				front: 'Чем const отличается от let, и почему не var?',
				back: 'const: имя привязано к значению навсегда. let: значение можно менять. var устарел: у него странная область видимости, в новом коде его нет. По умолчанию берут const.'
			},
			{
				id: 'js-strict-equal',
				front: 'Чем === отличается от ==?',
				back: '=== сравнивает значение и тип. == сначала приводит типы и даёт сюрпризы (0 == "" истинно). Всегда пишите ===.'
			},
			{
				id: 'js-map-filter',
				front: 'Что делают map, filter и reduce?',
				back: 'map: новый массив, где к каждому элементу применили функцию. filter: новый массив из подходящих. reduce: свернуть массив в одно значение. Исходный массив они не меняют.'
			},
			{
				id: 'js-scope',
				front: 'Что такое область видимости?',
				back: 'Место, где имя переменной существует. Переменная из функции или блока снаружи не видна, а внешняя изнутри видна.'
			}
		],
		sources: [
			{
				title: 'Руководство по JavaScript (MDN)',
				url: 'https://developer.mozilla.org/ru/docs/Web/JavaScript/Guide',
				licence: 'CC-BY-SA',
				kind: 'docs',
				lang: 'ru'
			},
			{
				title: 'Основы JavaScript (MDN)',
				url: 'https://developer.mozilla.org/ru/docs/Learn_web_development/Core/Scripting',
				licence: 'CC-BY-SA',
				kind: 'course',
				lang: 'ru'
			},
			{
				title: 'Современный учебник JavaScript (learn.javascript.ru)',
				url: 'https://learn.javascript.ru/',
				licence: 'link-only',
				kind: 'course',
				lang: 'ru'
			},
			{
				title: 'JavaScript (Википедия)',
				url: 'https://ru.wikipedia.org/wiki/JavaScript',
				licence: 'CC-BY-SA',
				kind: 'article',
				lang: 'ru'
			},
			{
				title: 'Eloquent JavaScript (Марейн Хавербеке)',
				url: 'https://eloquentjavascript.net/',
				licence: 'link-only',
				kind: 'book',
				lang: 'en'
			}
		],
		videos: [],
		guide: {
			intro: 'Это ваш первый скрипт. Он берёт список пунктов, считает по нему сводку и показывает её в подвале. Пишите по частям и после каждой смотрите в предпросмотр: сводка должна появиться.',
			hints: [
