<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '05-javascript/04-async-fetch-json',
		part: 5,
		order: 4,
		title: 'Асинхронность, fetch и JSON',
		definition: 'fetch — функция JavaScript, которая отправляет HTTP-запрос и возвращает промис с ответом. Данные обычно приходят в JSON, текстовом формате объектов и массивов.',
		summary: 'Данные с сервера приходят не сразу, а страница при этом не должна зависать. После урока вы запрашиваете данные через fetch, читаете и пишете JSON, понимаете промисы и async/await и показываете посетителю состояния «загрузка» и «ошибка».',
		minutes: 30,
		teaches: ['js-async', 'js-fetch', 'js-json', 'js-error-handling'],
		requires: ['js-events', 'net-http-request-response'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'flowchart', label: 'запрос|ждёт браузер|ответ', caption: 'Пока ответ в пути', say: 'Ждёт браузер, а не скрипт. Страница живая: прокручивается, кнопки нажимаются.' },
				{ mood: 'hmm', side: 'right', prop: 'server', label: '404 Not Found', caption: 'Ответ', say: [{ who: 'Сервер', text: '404. Такой страницы нет.' }, { text: 'Но для fetch это тоже ответ: промис выполнен, сбоя сети не было.' }] },
				{ mood: 'hint', prop: 'editor', label: 'if (!response.ok)', say: 'После каждого fetch проверяйте response.ok. Иначе страницу ошибки вы прочтёте как данные.' }
			]
		},
		practice: {
			id: 'js-fetch-items-form',
			title: 'Список с сервера и заявка без перезагрузки',
			task: 'Подключите страницу к «серверу». 1) Вставьте из урока блок имитации сервера (fieldset и скрипт с пометкой data-scaffold) перед своим скриптом: песочница не пускает настоящие запросы, и этот блок подменяет fetch. 2) В разметку добавьте: в секцию #offer абзац <p id="status" role="status"> и скрытую кнопку <button type="button" id="retry" hidden>Повторить</button>; форме заявки дайте id="request-form", а в конец формы абзац <p id="form-status" role="status">. 3) Четвёртый скрипт <script type="module" id="fetch-code">. Функция loadItems (async) запрашивает fetch("/items.json"), проверяет response.ok, читает response.json(), собирает карточки через createElement и textContent и кладёт их в .cards (replaceChildren). Показывайте «Загружаем…» в #status и убирайте индикатор в любом исходе (finally), при сбое покажите понятное сообщение, оставьте прежние карточки и покажите кнопку «Повторить». 4) На форме заявки: слушатель submit с preventDefault, на время отправки блокируйте кнопку (disabled), отправляйте fetch("/zayavka", { method: "POST", body: new FormData(form) }) и пишите результат в #form-status, а после отправки снова включайте кнопку. Проверки читают разметку и текст скрипта; переключайте «связь» в имитации и смотрите на свою страницу в каждом случае.',
			era: 4,
			continues: 'js-events-menu-search',
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Разделы</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <nav id="quick" aria-label="Быстрый переход по предложениям"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Поиск по предложениям">
          <label for="q">Найти в списке</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // Данные брифа: пункты списка. Пока они лежат здесь,
      // в уроке про fetch мы вынесем их в отдельный файл.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Только названия. map делает новый массив, items не меняется.
      const titlesOf = (list) => list.map((item) => item.title);

      // Только пункты, у которых указана цена.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // Сколько пунктов в списке.
      const countOf = (list) => list.length;

      const summary =
        'Всего позиций: ' + countOf(items) +
        ', с ценой: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // Страница уже разобрана: модуль выполняется после неё.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'Пока в списке нет ни одного предложения.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Предложений: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // Меню: без скрипта список виден всегда, со скриптом он прячется за кнопку.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Поиск: один обработчик на форме ловит ввод в её полях (всплытие).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Карточки ищем в момент события: список мог измениться.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Показано: ' + shown + ' из ' + cards.length;
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

[hidden] {
  display: none !important;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Разделы</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <nav id="quick" aria-label="Быстрый переход по предложениям"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Поиск по предложениям">
          <label for="q">Найти в списке</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Повторить</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // Данные брифа: пункты списка. Пока они лежат здесь,
      // в уроке про fetch мы вынесем их в отдельный файл.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Только названия. map делает новый массив, items не меняется.
      const titlesOf = (list) => list.map((item) => item.title);

      // Только пункты, у которых указана цена.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // Сколько пунктов в списке.
      const countOf = (list) => list.length;

      const summary =
        'Всего позиций: ' + countOf(items) +
        ', с ценой: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // Страница уже разобрана: модуль выполняется после неё.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'Пока в списке нет ни одного предложения.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Предложений: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // Меню: без скрипта список виден всегда, со скриптом он прячется за кнопку.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Поиск: один обработчик на форме ловит ввод в её полях (всплытие).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Карточки ищем в момент события: список мог измениться.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Показано: ' + shown + ' из ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Имитация сервера: какая сейчас связь</legend>
      <label><input type="radio" name="net" value="ok" checked> всё хорошо</label>
      <label><input type="radio" name="net" value="slow"> медленно, три секунды</label>
      <label><input type="radio" name="net" value="offline"> обрыв связи</label>
      <label><input type="radio" name="net" value="error500"> сервер сломался (500)</label>
      <label><input type="radio" name="net" value="missing404"> файла нет (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // ИМИТАЦИЯ СЕРВЕРА. Песочница не пускает настоящие запросы, поэтому fetch
      // на этой странице подменён: он отвечает так, как выбрано выше.
      // На настоящем сайте этого блока нет, а адреса ведут на ваш сервер.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'Сервер сломался' }, 500);
        if (mode === 'missing404') return reply({ error: 'Не найдено' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'Новый пункт с сервера', text: 'Его нет в разметке: он пришёл из items.json.', price: '' }]);
        }
        if (path === '/zayavka' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Не найдено' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Из данных сервера собираем карточки: текст только через textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Предложений: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Загружаем свежий список…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Не удалось обновить список, показан сохранённый. Проверьте связь и повторите.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // Форма: без скрипта она отправляется обычным способом, со скриптом без перезагрузки.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Отправляем…';
        try {
          const response = await fetch('/zayavka', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Заявка принята, её номер ' + result.id + '. Мы свяжемся с вами.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'Заявка не отправилась. Данные остались в форме: попробуйте ещё раз или позвоните.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
