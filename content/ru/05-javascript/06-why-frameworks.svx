<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '05-javascript/06-why-frameworks',
		part: 5,
		order: 6,
		title: 'Зачем нужны фреймворки',
		definition: 'Фреймворк вроде React, Vue, Svelte или Angular собирает интерфейс из компонентов и выводит вид из состояния. Такой подход называют реактивностью.',
		summary: 'Ручной код с DOM работает, пока на странице немного мест, которые надо согласовывать. После урока вы видите, где он начинает ломаться, понимаете, что решают React, Vue, Svelte и Angular и чего это стоит посетителю, и можете спокойно ответить «а нужен ли мне фреймворк вообще».',
		minutes: 25,
		teaches: ['js-why-frameworks', 'js-reactivity'],
		requires: ['js-dom', 'js-events', 'js-modules'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'browser', label: '3 пункта', caption: 'Забыли одно место', say: 'Список обновился, счётчик забыли. На странице «3 пункта» и пять карточек.' },
				{ mood: 'explain', side: 'right', prop: 'editor', label: 'addItem(item)', say: 'Вручную надо помнить каждое место: список, счётчик, значок, быстрый переход. Забудешь, и ничто не напомнит.' },
				{ mood: 'cheer', prop: 'flowchart', label: 'состояние|вид', caption: 'Реактивность', say: 'Фреймворк переворачивает задачу: состояние одно, а вид из него выводится. Счётчик равен длине списка.' },
				{ mood: 'hint', caption: 'Когда он нужен', say: 'Мест согласования три-четыре, как у визитки? Хватит чистого JavaScript. Десятое? Тогда фреймворк окупится.' }
			]
		},
		practice: {
			id: 'js-framework-notes',
			title: 'Нужен ли фреймворку вашему проекту: разбор своей страницы',
			task: 'Найдите на странице три места, где вид и состояние приходится согласовывать вручную (в скриптах выше они есть: счётчик, быстрый переход, меню, поиск), и заполните таблицу «Где страница согласуется вручную»: что с чем согласуется, как это сделано сейчас и как было бы при реактивном подходе. Каждая клетка это живая фраза, а не «…». Затем напишите вывод для вашего проекта (абзац «Вывод»): нужен ли ему фреймворк или не нужен, с учётом числа разделов и пунктов из брифа (запишите эти числа). И в последнем абзаце назовите вес ваших скриптов в килобайтах (приблизительно, по вкладке «Сеть» или по размеру файла) и то, как он влияет на первую загрузку.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Разделы</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <nav id="quick" aria-label="Быстрый переход по предложениям"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Поиск по предложениям">
          <label for="q">Найти в списке</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Повторить</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="framework-notes">
      <h2>Где страница согласуется вручную</h2>
      <table>
        <tr><th>Что с чем надо согласовать</th><th>Как это сделано сейчас</th><th>Как проще при реактивном подходе</th></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
      </table>
      <h3>Вывод для моего проекта</h3>
      <p id="verdict">…</p>
      <p id="js-weight">…</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // Данные брифа: пункты списка. Пока они лежат здесь,
      // в уроке про fetch мы вынесем их в отдельный файл.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Только названия. map делает новый массив, items не меняется.
      const titlesOf = (list) => list.map((item) => item.title);

      // Только пункты, у которых указана цена.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // Сколько пунктов в списке.
      const countOf = (list) => list.length;

      const summary =
        'Всего позиций: ' + countOf(items) +
        ', с ценой: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // Страница уже разобрана: модуль выполняется после неё.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'Пока в списке нет ни одного предложения.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Предложений: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // Меню: без скрипта список виден всегда, со скриптом он прячется за кнопку.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Поиск: один обработчик на форме ловит ввод в её полях (всплытие).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Карточки ищем в момент события: список мог измениться.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Показано: ' + shown + ' из ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Имитация сервера: какая сейчас связь</legend>
      <label><input type="radio" name="net" value="ok" checked> всё хорошо</label>
      <label><input type="radio" name="net" value="slow"> медленно, три секунды</label>
      <label><input type="radio" name="net" value="offline"> обрыв связи</label>
      <label><input type="radio" name="net" value="error500"> сервер сломался (500)</label>
      <label><input type="radio" name="net" value="missing404"> файла нет (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // ИМИТАЦИЯ СЕРВЕРА. Песочница не пускает настоящие запросы, поэтому fetch
      // на этой странице подменён: он отвечает так, как выбрано выше.
      // На настоящем сайте этого блока нет, а адреса ведут на ваш сервер.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'Сервер сломался' }, 500);
        if (mode === 'missing404') return reply({ error: 'Не найдено' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'Новый пункт с сервера', text: 'Его нет в разметке: он пришёл из items.json.', price: '' }]);
        }
        if (path === '/zayavka' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Не найдено' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Из данных сервера собираем карточки: текст только через textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Предложений: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Загружаем свежий список…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Не удалось обновить список, показан сохранённый. Проверьте связь и повторите.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // Форма: без скрипта она отправляется обычным способом, со скриптом без перезагрузки.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Отправляем…';
        try {
          const response = await fetch('/zayavka', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Заявка принята, её номер ' + result.id + '. Мы свяжемся с вами.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'Заявка не отправилась. Данные остались в форме: попробуйте ещё раз или позвоните.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Разделы сайта">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Разделы</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>Пара предложений о разделе.</p>
      </section>

      <section id="offer">
        <h2>Что мы предлагаем</h2>
        <nav id="quick" aria-label="Быстрый переход по предложениям"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Поиск по предложениям">
          <label for="q">Найти в списке</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Повторить</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="zayavka">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Телефон</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="framework-notes">
      <h2>Где страница согласуется вручную</h2>
      <table>
        <tr><th>Что с чем надо согласовать</th><th>Как это сделано сейчас</th><th>Как проще при реактивном подходе</th></tr>
        <tr class="sync"><td>Список карточек и счётчик «Показано: N из M»</td><td>В обработчике поиска я сам пересчитываю shown и записываю текст счётчика, и ещё раз записываю его после загрузки с сервера: два места, которые легко рассинхронизировать.</td><td>Счётчик объявлен как значение, вычисляемое из списка и запроса, поэтому он обновляется сам, где бы ни менялся список.</td></tr>
        <tr class="sync"><td>Список карточек и быстрый переход</td><td>Быстрый переход построен один раз при открытии страницы, и после загрузки списка с сервера в нём нет нового пункта.</td><td>Карточки и ссылки рисуются из одного массива, а значит разойтись не могут.</td></tr>
        <tr class="sync"><td>Кнопка меню и список разделов</td><td>Атрибут aria-expanded и свойство hidden меняются двумя командами в setMenu. Забуду одну, и диктор сообщит посетителю неправду.</td><td>Есть одно состояние open, а aria-expanded и hidden выводятся из него и меняются вместе.</td></tr>
      </table>
      <h3>Вывод для моего проекта</h3>
      <p id="verdict">Для моего проекта (5 разделов и 4 пункта) фреймворк пока не нужен: согласовывать вручную приходится 3 места, и они укладываются в сотню строк. Пересмотрю, если пунктов станет заметно больше или появится личный кабинет с общим состоянием.</p>
      <p id="js-weight">Мои скрипты весят около 6 кБ, поэтому первая загрузка почти не замедлена. Фреймворк добавил бы к ним ещё десятки килобайт, которые телефону пришлось бы скачать и разобрать до первого показа.</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // Данные брифа: пункты списка. Пока они лежат здесь,
      // в уроке про fetch мы вынесем их в отдельный файл.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Только названия. map делает новый массив, items не меняется.
      const titlesOf = (list) => list.map((item) => item.title);

      // Только пункты, у которых указана цена.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // Сколько пунктов в списке.
      const countOf = (list) => list.length;

      const summary =
        'Всего позиций: ' + countOf(items) +
        ', с ценой: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // Страница уже разобрана: модуль выполняется после неё.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'Пока в списке нет ни одного предложения.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Предложений: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // Меню: без скрипта список виден всегда, со скриптом он прячется за кнопку.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Поиск: один обработчик на форме ловит ввод в её полях (всплытие).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Карточки ищем в момент события: список мог измениться.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Показано: ' + shown + ' из ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Имитация сервера: какая сейчас связь</legend>
      <label><input type="radio" name="net" value="ok" checked> всё хорошо</label>
      <label><input type="radio" name="net" value="slow"> медленно, три секунды</label>
      <label><input type="radio" name="net" value="offline"> обрыв связи</label>
      <label><input type="radio" name="net" value="error500"> сервер сломался (500)</label>
      <label><input type="radio" name="net" value="missing404"> файла нет (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // ИМИТАЦИЯ СЕРВЕРА. Песочница не пускает настоящие запросы, поэтому fetch
      // на этой странице подменён: он отвечает так, как выбрано выше.
      // На настоящем сайте этого блока нет, а адреса ведут на ваш сервер.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'Сервер сломался' }, 500);
        if (mode === 'missing404') return reply({ error: 'Не найдено' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'Новый пункт с сервера', text: 'Его нет в разметке: он пришёл из items.json.', price: '' }]);
        }
        if (path === '/zayavka' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Не найдено' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Из данных сервера собираем карточки: текст только через textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Предложений: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Загружаем свежий список…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Не удалось обновить список, показан сохранённый. Проверьте связь и повторите.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // Форма: без скрипта она отправляется обычным способом, со скриптом без перезагрузки.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Отправляем…';
        try {
          const response = await fetch('/zayavka', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('Сервер ответил кодом ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Заявка принята, её номер ' + result.id + '. Мы свяжемся с вами.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'Заявка не отправилась. Данные остались в форме: попробуйте ещё раз или позвоните.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
