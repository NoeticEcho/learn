		cards: [
			{
				id: 'js-svelte-runes',
				front: 'Какие руны есть в Svelte 5 и что они делают?',
				back: '$state: реактивное значение. $derived: значение, вычисляемое из других. $props: данные от родителя. $effect: побочное действие после изменения. Это слова, которые понимает компилятор.'
