					kind: 'text',
					selector: '#enhance-code',
					matches: 'if\\s*\\(\\s*\\w+\\s*&&\\s*\\w+|if\\s*\\(\\s*\\w+\\s*\\)'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Что такое прогрессивное улучшение?',
				options: [
					'Страница сначала строится так, чтобы главное работало на чистом HTML, а JavaScript добавляет удобства поверх',
