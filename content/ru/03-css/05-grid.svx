`,
				'styles.css': `/* styles.css: база сайта 2014 года (сброс и типографика). Раскладку вы пишете сами. */

html {
  box-sizing: border-box;
  font-size: 100%;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

img {
  max-width: 100%;
  height: auto;
}

a {
  color: #1a4d8f;
}

nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.skip {
  position: absolute;
  left: -999px;
}

.skip:focus {
  left: 0.5rem;
  top: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: #ffffff;
  color: #1d2430;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* ===== Раскладка: ваша работа начинается здесь ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
  grid-template-areas: "main aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

`
			},
			checks: [
				{ id: 'layout-grid', kind: 'style', selector: '.layout', prop: 'display', equals: 'grid' },
				{ id: 'layout-columns', kind: 'style', selector: '.layout', prop: 'grid-template-columns', matches: '^(?!none$).+' },
				{ id: 'layout-areas', kind: 'style', selector: '.layout', prop: 'grid-template-areas', matches: '^(?!none$).+' },
				{ id: 'main-area', kind: 'style', selector: 'main', prop: 'grid-area', matches: '^(?!auto).+' },
				{ id: 'cards-grid', kind: 'style', selector: '.cards', prop: 'display', equals: 'grid', when: { brief: 'items[].title' } },
				{ id: 'cards-columns', kind: 'style', selector: '.cards', prop: 'grid-template-columns', matches: '^(?!none$).+', when: { brief: 'items[].title' } },
				{ id: 'cards-gap', kind: 'style', selector: '.cards', prop: 'gap', matches: '^(?!normal$|0px$|0$).+', when: { brief: 'items[].title' } }
			]
		},
		quiz: [
			{
				type: 'match',
				prompt: 'Соедините задачу с инструментом, который для неё лучше',
				pairs: [
					['Меню из пяти ссылок в ряд', 'flexbox: одна линия'],
					['Макет страницы: шапка, основное, боковое, подвал', 'grid: макет по областям'],
					['Сетка карточек, которая сама подбирает число столбцов', 'grid: auto-fit и minmax'],
					['Выровнять значок и подпись внутри кнопки', 'flexbox: выравнивание по оси']
				]
			},
			{
				type: 'single',
				prompt: 'Что значит grid-template-columns: 2fr 1fr?',
				options: [
					'Две колонки: первая вдвое шире второй, делят всё свободное место',
					'Две колонки шириной 2 и 1 пиксель',
					'Три колонки'
				],
				answer: 0,
				why: [
					'Да: fr (fraction) это доля свободного места. Всего три доли, две из них первой колонке.',
					'Нет: fr не пиксели, а доли оставшегося пространства.',
					'Нет: в записи две колонки.'
				]
			},
			{
				type: 'single',
				prompt: 'Что делает grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))?',
				options: [
					'Ставит столько колонок, сколько помещается при минимуме 14rem, и растягивает их на свободное место',
					'Всегда ставит ровно 14 колонок',
					'Делает каждую колонку ровно 14rem, остальное пусто'
				],
				answer: 0,
				why: [
					'Да. Широкий экран даёт несколько колонок, узкий одну: ни одного медиазапроса и ни одного ручного числа.',
					'Нет: 14rem это ширина, а не число колонок.',
					'Нет: из-за 1fr колонки растягиваются, а не остаются 14rem.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что верно про grid-template-areas?',
				options: [
					'Макет рисуется словами в кавычках, по строке на ряд',
					'Элементы встают в области через grid-area',
					'Для узкого экрана области можно переписать, не трогая HTML',
					'Порядок элементов в HTML обязан совпадать с видом на экране, иначе ничего не работает'
				],
				answer: [0, 1, 2],
				why: [
					'Да: «header header» и «main aside» нарисуют макет в две колонки.',
					'Да: grid-area: main ставит элемент в область с таким именем.',
					'Да: достаточно новых areas в медиазапросе, это сила метода.',
					'Нет: grid-area позволяет поставить элемент куда угодно. Но порядок с клавиатуры идёт по HTML, поэтому расходиться с видом сильно не стоит.'
				]
			},
			{
				type: 'single',
				prompt: 'Как задать промежуток между колонками и рядами grid?',
				options: ['gap', 'margin у каждого элемента', 'padding у контейнера'],
				answer: 0,
				why: [
					'Да: gap работает в grid с самого начала, и в flexbox тоже.',
