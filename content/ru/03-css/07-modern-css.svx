<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '03-css/07-modern-css',
		part: 3,
		order: 7,
		title: 'Современный CSS: переменные, вложенность, :has() и слои',
		definition: 'Современный CSS — переменные, вложенные правила, селектор :has() и каскадные слои @layer: то, ради чего раньше подключали препроцессоры и скрипты.',
		summary:
			'Сегодняшний CSS умеет то, ради чего раньше брали препроцессоры и скрипты. После урока вы собираете значения в переменные, пишете вложенные правила, подсвечиваете блок по его содержимому через :has() и упорядочиваете стили слоями.',
		minutes: 30,
		teaches: ['css-custom-properties', 'css-nesting', 'css-has-selector', 'css-cascade-layers'],
		requires: ['css-specificity', 'css-color', 'css-container-queries'],
		practice: {
			id: 'modern-css',
			title: 'Ваш сайт, переписанный на современный CSS',
			task: 'Это та же страница, что вы закончили в прошлый раз, но стили лежат с «зашитыми» значениями. Перепишите их по-современному. 1) На :root объявите переменные --color-text, --color-bg, --color-surface, --color-accent и --space и используйте их через var() вместо повторяющихся значений. 2) Тёмная тема: в @media (prefers-color-scheme: dark) поменяйте только значения переменных; в head добавьте <meta name="color-scheme" content="light dark">. 3) Объявите порядок слоёв в начале файла: @layer reset, base, components, utilities; и разложите правила по слоям. 4) Вложите правила .site-header и .card с помощью &. 5) Правило section:has(.cards) с внутренним отступом поставьте вне слоёв: так оно выигрывает у любого слоя.',
			era: 7,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://zarechye.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://zarechye.example/og.png">
    <meta property="og:locale" content="ru_RU">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://zarechye.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://zarechye.example/">
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Язык сайта">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>Пара предложений о разделе.</p>
          <img src="foto.jpg" width="160" height="160" alt="Фотография: {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="offer">
          <h2>Что мы предлагаем</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Условия и цены</h2>
          <table>
            <caption>Что входит и сколько это стоит</caption>
            <thead>
              <tr>
                <th scope="col">Позиция</th>
                <th scope="col">Что входит</th>
                <th scope="col">Цена</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="zayavka">
          <h2>{{mainAction.label}}</h2>
          <form action="/zayavka" method="post">
            <p>
              <label for="f-name">Как к вам обращаться</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Телефон</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">Например, +7 000 000-00-00. Позвоним в рабочее время.</small>
            </p>
            <fieldset>
              <legend>Когда удобно позвонить</legend>
              <label><input type="radio" name="when" value="morning" checked> Утром</label>
              <label><input type="radio" name="when" value="day"> Днём</label>
              <label><input type="radio" name="when" value="evening"> Вечером</label>
            </fieldset>
            <p>
              <label for="f-comment">Коротко о задаче</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> Я согласен на обработку персональных данных, <a href="privacy.html">политика обработки</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Подтверждения</h2>
          {{#each proofs}}<figure>
            <img src="skan.jpg" width="120" height="160" alt="Скан документа">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Связаться</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Политика обработки персональных данных</a> · <a href="#top">Наверх</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: база сайта 2014 года (сброс и типографика). Раскладку вы пишете сами. */

html {
  box-sizing: border-box;
  font-size: 100%;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

img {
  max-width: 100%;
  height: auto;
}

a {
  color: #1a4d8f;
}

nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.skip {
  position: absolute;
  left: -999px;
}

.skip:focus {
  left: 0.5rem;
  top: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: #ffffff;
  color: #1d2430;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* ===== Раскладка: ваша работа начинается здесь ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-areas:
    "main"
    "aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}


/* Широкий экран: добавляем, а не отнимаем (mobile first). */
@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    grid-template-areas: "main aside";
  }
}

/* Карточка смотрит на ширину своего места, а не окна. */
@container (min-width: 40rem) {
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1rem;
  }
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://zarechye.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
