    {{/each}}<link rel="alternate" hreflang="x-default" href="https://zarechye.example/">
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Язык сайта">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>Пара предложений о разделе.</p>
          <img src="foto.jpg" width="160" height="160" alt="Фотография: {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="offer">
          <h2>Что мы предлагаем</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Условия и цены</h2>
          <table>
            <caption>Что входит и сколько это стоит</caption>
            <thead>
              <tr>
                <th scope="col">Позиция</th>
                <th scope="col">Что входит</th>
                <th scope="col">Цена</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="zayavka">
          <h2>{{mainAction.label}}</h2>
          <form action="/zayavka" method="post">
            <p>
              <label for="f-name">Как к вам обращаться</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Телефон</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">Например, +7 000 000-00-00. Позвоним в рабочее время.</small>
            </p>
            <fieldset>
              <legend>Когда удобно позвонить</legend>
              <label><input type="radio" name="when" value="morning" checked> Утром</label>
              <label><input type="radio" name="when" value="day"> Днём</label>
              <label><input type="radio" name="when" value="evening"> Вечером</label>
            </fieldset>
            <p>
              <label for="f-comment">Коротко о задаче</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> Я согласен на обработку персональных данных, <a href="privacy.html">политика обработки</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Подтверждения</h2>
          {{#each proofs}}<figure>
            <img src="skan.jpg" width="120" height="160" alt="Скан документа">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Связаться</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Политика обработки персональных данных</a> · <a href="#top">Наверх</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* Слои: порядок объявлен один раз, в начале. Поздний слой сильнее раннего,
   а то, что вне слоёв, сильнее любого слоя. */
@layer reset, base, components, utilities;

/* Токены: все значения решений в одном месте. */
:root {
  --color-text: #1d2430;
  --color-bg: #ffffff;
  --color-surface: #f3f5f8;
  --color-accent: #1a4d8f;
  --color-on-accent: #ffffff;
  --space: 1rem;
  --radius: 0.5rem;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

/* Тёмная тема: меняем только значения токенов. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #e8ecf2;
    --color-bg: #11161d;
    --color-surface: #1b2330;
    --color-accent: #8fb8f0;
    --color-on-accent: #0b1a2e;
  }
}

@layer reset {
  html {
    box-sizing: border-box;
    font-size: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

@layer base {
  body {
    font: 1.0625rem/1.6 var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
  }
}

@layer components {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: var(--space);
    color: var(--color-on-accent);
    background-color: var(--color-accent);

    & a {
      color: inherit;
    }

    & .brand {
      margin: 0;
      font-size: 1.5rem;
    }

    & nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .layout {
    display: grid;
    grid-template-areas:
      "main"
      "aside";
    gap: 2rem;
    max-width: 62.5rem;
    margin: 0 auto;
    padding: 1.5rem var(--space);

    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
      grid-template-areas: "main aside";
    }

    & main {
      grid-area: main;
    }

    & aside {
      grid-area: aside;
    }
  }

  .cards {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space);
  }

  .card {
    padding: var(--space);
    background-color: var(--color-surface);
    border-radius: var(--radius);

    & h3 {
      margin-top: 0;
    }

    @container (min-width: 40rem) {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space);
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .site-footer {
    padding: var(--space);
    background-color: var(--color-surface);
  }
}

@layer utilities {
  .skip {
    position: absolute;
    left: -999px;

    &:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background-color: var(--color-bg);
    }
  }
}

/* :has(): стиль по содержимому. Вне слоёв, поэтому выигрывает у любого слоя. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}
`
			},
			checks: [
				{ id: 'var-text', kind: 'style', selector: ':root', prop: '--color-text', matches: '\\S' },
				{ id: 'var-bg', kind: 'style', selector: ':root', prop: '--color-bg', matches: '\\S' },
				{ id: 'var-surface', kind: 'style', selector: ':root', prop: '--color-surface', matches: '\\S' },
				{ id: 'var-accent', kind: 'style', selector: ':root', prop: '--color-accent', matches: '\\S' },
				{ id: 'var-space', kind: 'style', selector: ':root', prop: '--space', matches: '\\S' },
				{ id: 'color-scheme', kind: 'attr', selector: 'meta[name="color-scheme"]', name: 'content', matches: 'light dark' },
				{ id: 'has', kind: 'style', selector: 'section:has(.cards)', prop: 'padding-top', matches: '^(?!0px$|0$).+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Что делает запись color: var(--color-accent)?',
				options: [
					'Берёт значение переменной --color-accent: поменяйте переменную, и цвет изменится везде, где она использована',
					'Копирует цвет один раз при загрузке страницы',
					'Объявляет новую переменную'
				],
				answer: 0,
				why: [
					'Да. Переменные CSS живые: они вычисляются в браузере и наследуются, поэтому тему можно сменить подменой нескольких значений.',
