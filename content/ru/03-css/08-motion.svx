}

/* :has(): стиль по содержимому. Вне слоёв, поэтому выигрывает у любого слоя. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}

/* Движение: короткий отклик на кнопке и появление карточек. */
.button {
  transition-property: transform, background-color;
  transition-duration: 0.2s;
  transition-timing-function: ease-out;
}

.button:hover {
  transform: translateY(-2px);
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(0.75rem);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.card {
  animation-name: rise;
  animation-duration: 0.5s;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

/* «Уменьшить движение»: убираем перемещение, оставляем плавное появление. */
@media (prefers-reduced-motion: reduce) {
  .button:hover {
    transform: none;
  }

  .card {
    animation-name: appear;
  }
}
`
