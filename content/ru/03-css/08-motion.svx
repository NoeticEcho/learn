<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '03-css/08-motion',
		part: 3,
		order: 8,
		title: 'Анимация и движение с уважением к людям',
		definition: 'CSS-анимация — плавные переходы transition и ключевые кадры @keyframes. Медиазапрос prefers-reduced-motion позволяет уменьшить движение тем, кому оно вредит.',
		summary:
			'Небольшое движение показывает, что произошло, а лишнее мешает и даже вредит людям с вестибулярными нарушениями. После урока вы делаете плавные переходы и анимацию появления и учитываете настройку «уменьшить движение».',
		minutes: 20,
		teaches: ['css-transitions-animations', 'css-reduced-motion'],
		requires: ['css-custom-properties', 'html-a11y-basics'],
		comic: {
			panels: [
				{ mood: 'cheer', prop: 'browser', label: 'кнопка поднялась', caption: '200 миллисекунд', say: 'Хорошее движение как жест: кнопка чуть приподнялась, значит на неё можно нажать.' },
				{ mood: 'hmm', side: 'right', prop: 'phone', label: 'уменьшить движение', say: 'У некоторых от сдвигов и параллакса кружится голова. Для них в системе есть «уменьшить движение».' },
				{ mood: 'hint', prop: 'editor', label: 'prefers-reduced-motion', say: 'Сайт читает настройку: сдвиг и масштаб убрать, появление и смену цвета оставить. Движение принадлежит читателю.' }
			]
		},
		practice: {
			id: 'motion',
			title: 'Движение на вашем сайте: вишенка эпохи 2025',
			task: 'Добавьте движение, которое помогает. 1) Кнопке .button дайте плавный переход: transition-property только из transform и цвета (не all и не размеры), transition-duration около 0.2s; на :hover пусть кнопка чуть приподнимается (transform). 2) Карточкам .card дайте анимацию появления: @keyframes rise (из прозрачного и чуть ниже в видимое), animation-name, animation-duration не дольше секунды. 3) Напишите блок @media (prefers-reduced-motion: reduce): уберите перемещение (hover без transform), а у карточек замените анимацию на плавное появление без сдвига. Проверьте блок в инструментах разработчика сами: проверки его не видят.',
			era: 7,
			continues: 'modern-css',
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://zarechye.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://zarechye.example/og.png">
    <meta property="og:locale" content="ru_RU">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://zarechye.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://zarechye.example/">
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Язык сайта">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#zayavka">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>Пара предложений о разделе.</p>
          <img src="foto.jpg" width="160" height="160" alt="Фотография: {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>Пара предложений о разделе.</p>
        </section>

        <section id="offer">
          <h2>Что мы предлагаем</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Условия и цены</h2>
          <table>
            <caption>Что входит и сколько это стоит</caption>
            <thead>
              <tr>
                <th scope="col">Позиция</th>
                <th scope="col">Что входит</th>
                <th scope="col">Цена</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="zayavka">
          <h2>{{mainAction.label}}</h2>
          <form action="/zayavka" method="post">
            <p>
              <label for="f-name">Как к вам обращаться</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Телефон</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">Например, +7 000 000-00-00. Позвоним в рабочее время.</small>
            </p>
            <fieldset>
              <legend>Когда удобно позвонить</legend>
              <label><input type="radio" name="when" value="morning" checked> Утром</label>
              <label><input type="radio" name="when" value="day"> Днём</label>
              <label><input type="radio" name="when" value="evening"> Вечером</label>
            </fieldset>
            <p>
              <label for="f-comment">Коротко о задаче</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> Я согласен на обработку персональных данных, <a href="privacy.html">политика обработки</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Подтверждения</h2>
          {{#each proofs}}<figure>
            <img src="skan.jpg" width="120" height="160" alt="Скан документа">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Связаться</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Политика обработки персональных данных</a> · <a href="#top">Наверх</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* Слои: порядок объявлен один раз, в начале. Поздний слой сильнее раннего,
   а то, что вне слоёв, сильнее любого слоя. */
@layer reset, base, components, utilities;

/* Токены: все значения решений в одном месте. */
:root {
  --color-text: #1d2430;
  --color-bg: #ffffff;
  --color-surface: #f3f5f8;
  --color-accent: #1a4d8f;
  --color-on-accent: #ffffff;
  --space: 1rem;
  --radius: 0.5rem;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

/* Тёмная тема: меняем только значения токенов. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #e8ecf2;
    --color-bg: #11161d;
    --color-surface: #1b2330;
    --color-accent: #8fb8f0;
    --color-on-accent: #0b1a2e;
  }
}

@layer reset {
  html {
    box-sizing: border-box;
    font-size: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

@layer base {
  body {
    font: 1.0625rem/1.6 var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
  }
}

@layer components {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: var(--space);
    color: var(--color-on-accent);
    background-color: var(--color-accent);

    & a {
      color: inherit;
    }

    & .brand {
      margin: 0;
      font-size: 1.5rem;
    }

    & nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .layout {
    display: grid;
    grid-template-areas:
      "main"
      "aside";
    gap: 2rem;
    max-width: 62.5rem;
    margin: 0 auto;
    padding: 1.5rem var(--space);

    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
      grid-template-areas: "main aside";
    }

    & main {
      grid-area: main;
    }

    & aside {
      grid-area: aside;
    }
  }

  .cards {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space);
  }

  .card {
    padding: var(--space);
    background-color: var(--color-surface);
    border-radius: var(--radius);

    & h3 {
      margin-top: 0;
    }

    @container (min-width: 40rem) {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space);
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .site-footer {
    padding: var(--space);
    background-color: var(--color-surface);
  }
}

@layer utilities {
  .skip {
    position: absolute;
    left: -999px;

    &:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background-color: var(--color-bg);
    }
  }
}

/* :has(): стиль по содержимому. Вне слоёв, поэтому выигрывает у любого слоя. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}
`
			},
			solution: {
