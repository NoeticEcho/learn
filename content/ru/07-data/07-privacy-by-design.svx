				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="register">
      <h2>Реестр данных проекта<\/h2>
      <p>Для каждой группы данных: что это, зачем, где лежит, сколько хранить и при каком условии удалять, кто имеет доступ, персональные ли это данные.<\/p>
      <table>
        <tr><th>Данные<\/th><th>Зачем<\/th><th>Где хранятся<\/th><th>Срок и удаление<\/th><th>Кто имеет доступ<\/th><th>Персональные?<\/th><\/tr>
        <tr class="field visitor"><td class="what">Имя посетителя из формы заявки<\/td><td class="why">чтобы знать, как обращаться при ответе на заявку<\/td><td class="where">таблица requests в PostgreSQL на сервере в России<\/td><td class="keep">3 года после заявки, затем удаляется скриптом<\/td><td class="access">владелец через админку и сервер сайта<\/td><td class="pd">да<\/td><\/tr>
        <tr class="field visitor"><td class="what">Телефон посетителя<\/td><td class="why">чтобы связаться по заявке, больше ни для чего<\/td><td class="where">таблица requests в PostgreSQL на сервере в России<\/td><td class="keep">3 года после заявки, затем удаляется скриптом<\/td><td class="access">владелец через админку и сервер сайта<\/td><td class="pd">да<\/td><\/tr>
        <tr class="field visitor"><td class="what">Комментарий к заявке (свободный текст)<\/td><td class="why">чтобы понять задачу до звонка<\/td><td class="where">таблица requests в PostgreSQL на сервере в России<\/td><td class="keep">1 год после заявки, затем удаляется<\/td><td class="access">владелец через админку<\/td><td class="pd">да, если человек напишет о себе<\/td><\/tr>
        <tr class="field people"><td class="what">Данные людей, которых вы показываете на сайте (people)<\/td><td class="why">чтобы посетитель знал, с кем будет работать<\/td><td class="where">таблица people и страница сайта, сервер в России<\/td><td class="keep">пока человек работает в проекте, затем удаляются по его просьбе<\/td><td class="access">владелец и сам человек<\/td><td class="pd">да: имя и фото, публикуются с согласия человека<\/td><\/tr>
      <\/table>
      <p>Какое поле я не стал собирать, хотя хотелось, и почему: <span id="removed">дату рождения: для записи на консультацию она не нужна, а персональных данных стало бы больше<\/span><\/p>
      <p>Где первичная запись данных посетителей и что с зарубежными копиями: <span id="localisation">первичная запись заявок идёт в базу на сервере в России; зарубежных копий нет, а если появятся, это отдельный порядок передачи за границу, который я заранее согласую с юристом<\/span><\/p>
      <p>Как в схеме отделены персональные данные от остальных: <span id="separate">заявки лежат в отдельной таблице requests, а в логах и в аналитике хранится только номер заявки, без имени и телефона<\/span><\/p>

      <h3>Согласие как запись в базе<\/h3>
      <textarea id="q-consent" rows="9">CREATE TABLE consents (
  id serial PRIMARY KEY,
  request_id integer REFERENCES requests(id),
  given_at timestamp NOT NULL,
  text_version text NOT NULL,
  purpose text NOT NULL
);<\/textarea>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
