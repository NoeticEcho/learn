`
			},
			checks: [
				{ id: 'register-exists', kind: 'exists', selector: '#register' },
				{ id: 'no-blanks', kind: 'text', selector: '#register', matches: '^[^…]*$' },
				{ id: 'rows', kind: 'count', selector: '#register tr.field', min: 4 },
				{ id: 'purpose', kind: 'text', selector: '#register td.why', matches: 'чтобы|для |связ|ответ|запис|показ|понять' },
				{ id: 'term-numbers', kind: 'text', selector: '#register td.keep', matches: '\\d+\\s*(?:дн|мес|год|лет)|пока' },
				{ id: 'delete-condition', kind: 'text', selector: '#register td.keep', matches: 'удал|обезлич|стира|уничтож' },
				{ id: 'access-named', kind: 'text', selector: '#register td.access', matches: 'владел|админ|сервер|только|бухгалтер|я ' },
				{ id: 'pd-marked', kind: 'text', selector: '#register td.pd', matches: '^\\s*[Дд]а' },
				{
					id: 'removed-field',
					kind: 'text',
					selector: '#removed',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:не нужн|лишн|не собира|не стал|без неё|без него|не хотел))'
				},
				{ id: 'localisation', kind: 'text', selector: '#localisation', matches: '(?=[\\s\\S]*(?:Росси|РФ))(?=[\\s\\S]*(?:сервер|базе|базу|баз))' },
				{
					id: 'separation',
					kind: 'text',
					selector: '#separate',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:отдельн|таблиц|requests|заявк|обезлич|номер))'
				},
				{
					id: 'consent-table',
					kind: 'text',
					selector: '#q-consent',
