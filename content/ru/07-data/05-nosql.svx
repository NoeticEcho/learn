`
			},
			checks: [
				{ id: 'choose-exists', kind: 'exists', selector: '#choose' },
				{ id: 'no-blanks', kind: 'text', selector: '#choose', matches: '^[^…]*$' },
				{ id: 'functions', kind: 'count', selector: '#choose tr.fn', min: 5 },
				{
					id: 'store-named',
					kind: 'text',
					selector: '#choose td.store',
					matches: 'реляц|SQL|Postgres|SQLite|MySQL|документ|Mongo|ключ|Redis|граф|Neo4j|файл'
				},
				{ id: 'relational-used', kind: 'text', selector: '#choose td.store', matches: 'реляц|SQL|Postgres|SQLite|MySQL' },
				{ id: 'reasons', kind: 'text', selector: '#choose td.why', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' },
				{
					id: 'cost-named',
					kind: 'text',
					selector: '#choose td.cost',
					matches: 'связ|транзакц|JOIN|сервер|памят|ничем|ограничен|инструмент|отчёт|обслужив|сложн|запрос'
				},
				{ id: 'where-readers', kind: 'text', selector: '#where', matches: 'сервер|облак|хостинг|Росси|читать|доступ|админ|парол' },
				{ id: 'boring-choice', kind: 'text', selector: '#boring', matches: '(?=[\\s\\S]*(?:реляц|PostgreSQL|SQL))(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)' }
			]
		},
		quiz: [
			{
				type: 'match',
				prompt: 'Соедините вид базы с задачей, для которой он подходит лучше всего',
				pairs: [
					['Реляционная (PostgreSQL)', 'каталог, заявки, заказы: связанные данные с отчётами и транзакциями'],
					['Документная (MongoDB)', 'записи с разными полями, которые читают целиком одним куском'],
					['Ключ-значение (Redis)', 'сессии, кэш и счётчики: быстро по ключу, часто со сроком жизни'],
					['Графовая (Neo4j)', 'связи на несколько шагов: друзья друзей, рекомендации, поиск мошенничества']
				]
			},
			{
				type: 'single',
				prompt: 'Где лучше хранить сессии вошедших посетителей: токен из cookie и срок жизни в полчаса?',
				options: [
					'В хранилище ключ-значение: по токену запись находится мгновенно, а срок жизни настраивается',
					'В графовой базе: сессия это связь между человеком и сайтом',
					'В отдельном документе внутри таблицы заявок'
				],
				answer: 0,
				why: [
					'Да. Ключ это токен, значение это сессия. Redis делает это за доли миллисекунды и сам удаляет протухшее. Но для небольшого сайта сессии вполне можно хранить и в обычной таблице.',
