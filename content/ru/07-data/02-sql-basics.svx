				'group-by': 'В четвёртом поле нет GROUP BY. Он собирает строки по категории.',
				'group-count': 'Нужно что-то посчитать: добавьте в SELECT функцию COUNT(*).',
				'update-where': 'UPDATE должен выглядеть так: UPDATE items SET price = 3500 WHERE id = 2. Без WHERE изменятся все строки.',
				'delete-where': 'DELETE должен выглядеть так: DELETE FROM items WHERE id = 5. Без WHERE удалятся все строки.',
