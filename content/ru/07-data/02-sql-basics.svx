      for (const o of Object.values(db.tables))
      for (const c of o.columns)
      if (c.ref && c.ref.table === t.name && o.rows.some((x) => x[c.name] !== null && x[c.name] === r[c.ref.col])) throw new SqlError(\`нельзя удалить: на эту строку ссылается таблица «\${o.name}» (столбец \${c.name}). Сначала уберите ссылки\`);
      t.rows = t.rows.filter((r) => !gone.includes(r));
      return { kind: 'msg', message: \`DELETE: удалено строк \${gone.length}\${where ? '' : '. Условия WHERE не было, поэтому удалены ВСЕ строки таблицы'}\`, changed: gone.length };
      }
      throw new SqlError('эта песочница знает команды SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, CREATE INDEX, BEGIN, COMMIT, ROLLBACK и EXPLAIN SELECT');
      }
      function createIndex(db, p, unique) {
      let name = null;
      if (!p.isKw('on')) name = p.name();
      p.expectKw('on');
      const tn = p.name();
      const t = table(db, tn);
      p.expectOp('(');
      const cols = [];
      do cols.push(p.name());
      while (p.eatOp(','));
      p.expectOp(')');
      for (const c of cols) if (!t.columns.some((x) => x.name === c)) throw new SqlError(\`в таблице «\${tn}» нет столбца «\${c}»\`);
      name = name || \`\${tn}_\${cols.join('_')}_idx\`;
      if (db.indexes.some((i) => i.name === name)) throw new SqlError(\`индекс «\${name}» уже есть\`);
      db.indexes.push({ name, table: tn, cols, unique });
      return { kind: 'msg', message: \`CREATE INDEX: индекс «\${name}» по \${tn}(\${cols.join(', ')}) построен. Теперь каждая запись в «\${tn}» обновляет и его\` };
      }
      /**
      * Runs a script: statements split by «;», executed in order, stopping at the first error.
      * Returns { results, error }. After an error inside BEGIN the transaction is «aborted»
      * and every command is refused until ROLLBACK, as in PostgreSQL.
      */
      function run(db, sql) {
      const results = [];
      for (const s of splitStatements(sql)) {
      try {
      if (db.aborted && !/^\\s*rollback\\b/i.test(s)) throw new SqlError('транзакция прервана после ошибки: все команды игнорируются, пока не будет ROLLBACK');
      const r = execOne(db, s);
      if (r) results.push({ ...r, sql: s });
      } catch (e) {
      if (!(e instanceof SqlError)) throw e;
      if (db.txn) db.aborted = true;
      return { results, error: { message: e.message, sql: s } };
      }
      }
      return { results, error: null };
      }
      /** Puts ready rows into an existing table (for seeding a page from the person's brief). */
      function load(db, name, rows) {
      const t = table(db, name);
      for (const r of rows) {
      const row = {};
      for (const c of t.columns) {
      row[c.name] = r[c.name] === undefined ? null : r[c.name];
      if (c.type === 'serial') (row[c.name] === null && (row[c.name] = ++t.seq), (t.seq = Math.max(t.seq, row[c.name])));
      }
      t.rows.push(row);
      }
      }
      /** A value as the person reads it in a result table. */
      function show(v) {
      return v === null ? 'NULL' : v === true ? 'true' : v === false ? 'false' : String(v);
      }

      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');

      function draw(box, r) {
        box.replaceChildren();
        for (const res of r.results) {
          const p = document.createElement('p');
          if (res.kind === 'select') {
            const t = document.createElement('table');
            const head = t.insertRow();
            for (const c of res.columns) head.appendChild(Object.assign(document.createElement('th'), { textContent: c }));
            for (const row of res.rows) {
              const tr = t.insertRow();
              for (const v of row) tr.insertCell().textContent = show(v);
            }
            box.appendChild(t);
            p.textContent = 'Строк: ' + res.rows.length + '. Прочитано из таблиц: ' + res.scanned + '.';
          } else if (res.kind === 'plan') {
            p.textContent = 'План (упрощённая модель): ' + res.lines.join('; ');
          } else p.textContent = res.message;
          box.appendChild(p);
        }
        if (r.error) {
          const e = document.createElement('p');
          e.className = 'err';
          e.textContent = 'Ошибка: ' + r.error.message;
          box.appendChild(e);
        }
      }

      function runAll() {
        const db = createDb();
        for (const area of document.querySelectorAll('#sql-work textarea.sql')) {
          const box = document.getElementById(area.id + '-out');
          const r = run(db, area.value);
          if (box) draw(box, r);
        }
      }
      for (const area of document.querySelectorAll('#sql-work textarea.sql')) area.addEventListener('input', runAll);
      runAll();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			checks: [
				{ id: 'work-exists', kind: 'exists', selector: '#sql-work' },
				{ id: 'no-blanks', kind: 'text', selector: '#sql-work', matches: '^[^…]*$' },
				{ id: 'create-table', kind: 'text', selector: '#q-create', matches: '[Cc][Rr][Ee][Aa][Tt][Ee]\\s+[Tt][Aa][Bb][Ll][Ee]\\s+[Ii][Tt][Ee][Mm][Ss]' },
				{ id: 'primary-key', kind: 'text', selector: '#q-create', matches: '[Pp][Rr][Ii][Mm][Aa][Rr][Yy]\\s+[Kk][Ee][Yy]' },
				{
					id: 'column-types',
					kind: 'text',
					selector: '#q-create',
					matches: '(?:[Ii][Nn][Tt][Ee][Gg][Ee][Rr]|[Ii][Nn][Tt]|[Ss][Ee][Rr][Ii][Aa][Ll])[\\s\\S]*(?:[Tt][Ee][Xx][Tt]|[Vv][Aa][Rr][Cc][Hh][Aa][Rr])[\\s\\S]*(?:[Ii][Nn][Tt][Ee][Gg][Ee][Rr]|[Nn][Uu][Mm][Ee][Rr][Ii][Cc]|[Ii][Nn][Tt])'
				},
				{ id: 'five-rows', kind: 'text', selector: '#q-insert', matches: '[Vv][Aa][Ll][Uu][Ee][Ss](?:\\n[ \\t]*\\([^\\n]*){5}' },
				{ id: 'rows-from-brief', kind: 'field', selector: '#q-insert', field: 'items[].title', min: 1, when: { brief: 'items[].title' } },
				{ id: 'select-where', kind: 'text', selector: '#q-select', matches: '[Ss][Ee][Ll][Ee][Cc][Tt][\\s\\S]*[Ww][Hh][Ee][Rr][Ee]' },
				{ id: 'select-order', kind: 'text', selector: '#q-select', matches: '[Oo][Rr][Dd][Ee][Rr]\\s+[Bb][Yy]' },
				{ id: 'select-limit', kind: 'text', selector: '#q-select', matches: '[Ll][Ii][Mm][Ii][Tt]\\s+\\d+' },
				{ id: 'group-by', kind: 'text', selector: '#q-group', matches: '[Gg][Rr][Oo][Uu][Pp]\\s+[Bb][Yy]' },
				{ id: 'group-count', kind: 'text', selector: '#q-group', matches: '[Cc][Oo][Uu][Nn][Tt]\\(' },
				{ id: 'update-where', kind: 'text', selector: '#q-update', matches: '[Uu][Pp][Dd][Aa][Tt][Ee]\\s+\\w+\\s+[Ss][Ee][Tt][\\s\\S]*[Ww][Hh][Ee][Rr][Ee]' },
				{
					id: 'delete-where',
					kind: 'text',
					selector: '#q-delete',
					matches: '[Dd][Ee][Ll][Ee][Tt][Ee]\\s+[Ff][Rr][Oo][Mm]\\s+\\w+[\\s\\S]*[Ww][Hh][Ee][Rr][Ee]'
				},
				{ id: 'danger-named', kind: 'text', selector: '#danger', matches: '[Ww][Hh][Ee][Rr][Ee]|услови|все строки|всей таблиц|все записи' }
			]
		},
		quiz: [
			{
				type: 'order',
				prompt: 'В каком порядке база на самом деле выполняет части запроса SELECT?',
				items: [
					'FROM: взять таблицу',
					'WHERE: оставить подходящие строки',
					'GROUP BY: собрать строки в группы',
					'SELECT: выбрать нужные столбцы',
					'ORDER BY: упорядочить',
					'LIMIT: обрезать до нужного числа'
				]
			},
			{
				type: 'single',
				prompt: 'Что сделает запрос UPDATE items SET price = 0; (без WHERE)?',
				options: [
					'Обнулит цену у всех строк таблицы',
					'Ничего: без WHERE запрос не выполняется',
					'Обнулит цену только у первой строки'
				],
				answer: 0,
				why: [
					'Да. WHERE это единственное, что ограничивает изменение. Без него затронуты все строки, и база не станет переспрашивать.',
					'Нет: запрос без WHERE совершенно законный, поэтому и опасный.',
					'Нет: «первой строки» в таблице нет, порядок строк не гарантирован.'
				]
			},
			{
				type: 'single',
				prompt: 'Вы хотите найти услуги, у которых цена не указана (NULL). Какое условие верное?',
				options: ['WHERE price IS NULL', 'WHERE price = NULL', 'WHERE price = 0'],
				answer: 0,
				why: [
					'Да. NULL значит «неизвестно», и сравнивать с ним можно только словами IS NULL.',
					'Нет: любое сравнение с NULL даёт «неизвестно», и такой запрос не вернёт ни одной строки.',
					'Нет: ноль это известная цена, а не отсутствие цены.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините функцию с тем, что она считает',
				pairs: [
					['COUNT(*)', 'сколько строк в группе'],
					['SUM(price)', 'сумма цен'],
					['AVG(price)', 'средняя цена'],
					['MIN(price)', 'самая низкая цена'],
					['MAX(price)', 'самая высокая цена']
				]
			},
			{
				type: 'single',
				prompt: 'Что вернёт SELECT category, COUNT(*) FROM items GROUP BY category?',
				options: [
					'Одну строку на каждую категорию: название и сколько в ней услуг',
					'Все услуги, отсортированные по категории',
					'Одно число: сколько всего услуг'
				],
				answer: 0,
				why: [
					'Да. GROUP BY собирает строки с одинаковой категорией в группы, а COUNT считает размер каждой.',
					'Нет: сортировку делает ORDER BY, а GROUP BY сворачивает строки в группы.',
					'Нет: одно число вышло бы без GROUP BY.'
				]
			},
			{
				type: 'single',
				prompt: 'Как правильно передать в запрос слово, которое ввёл посетитель, чтобы его не смогли превратить в команду?',
				options: [
					'Через параметры запроса: база получает команду и значение раздельно',
					'Склеить строку запроса со словом посетителя, обрамив его кавычками',
					'Запретить посетителям вводить кавычки'
				],
				answer: 0,
				why: [
					'Да. Когда команда и значение приходят раздельно, значение никогда не станет частью команды, что бы в нём ни было.',
					'Нет: именно такая склейка и называется SQL-инъекцией: кавычка в слове закроет кавычки запроса, а дальше текст станет командой.',
					'Нет: список «опасных символов» всегда неполон, а настоящие данные, например фамилия О’Брайен, содержат кавычки.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Что делает WHERE?',
				options: [
					'Отбирает строки до группировки',
					'Может сравнивать числа, текст и NULL',
					'Не может содержать COUNT или SUM (для них есть HAVING)',
					'Выбирает, какие столбцы показать'
				],
				answer: [0, 1, 2],
				why: [
					'Да: WHERE работает второй после FROM, ещё до GROUP BY.',
					'Да: условия строятся из сравнений, AND, OR, LIKE, IN и IS NULL.',
					'Да: когда WHERE выполняется, группы ещё не собраны, и считать нечего. Условие по счёту пишут в HAVING.',
					'Нет: столбцы выбирает SELECT.'
				]
			}
