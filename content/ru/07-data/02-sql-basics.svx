<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '07-data/02-sql-basics',
		part: 7,
		order: 2,
		title: 'SQL: читаем и пишем данные',
		definition: 'SQL — декларативный язык запросов к реляционной базе: SELECT читает данные, INSERT добавляет строки, UPDATE и DELETE меняют и удаляют их.',
		summary: 'Вы пишете запросы SELECT, INSERT, UPDATE и DELETE и понимаете, что делает каждое слово. После урока вы создаёте таблицу своих услуг, добавляете в неё строки и получаете нужные данные: отобранные, упорядоченные и посчитанные.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'editor',
					label: 'DELETE FROM items;',
					caption: 'Без WHERE',
					say: [
						{ text: 'Хотел удалить одну услугу.' },
						{ who: 'База', text: 'Удалила все. Ты не сказал, какую.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'flowchart',
					label: 'FROM|WHERE|GROUP BY|SELECT',
					caption: 'Порядок',
					say: 'Пишут сверху вниз, а выполняется иначе: сначала таблица, потом отбор строк, потом подсчёт.'
				},
				{
					mood: 'cheer',
					prop: 'lock',
					label: 'параметр $1',
					caption: 'Инъекция',
					say: 'Команду и слова посетителя отправляй раздельно, и слово не станет командой.'
				}
			]
		},
		minutes: 35,
		teaches: ['data-sql-select', 'data-sql-write'],
		requires: ['data-relational-model'],
		practice: {
			id: 'data-sql-items',
			title: 'Таблица услуг и запросы к ней',
			task: 'В странице шесть полей для запросов. 1) Создайте таблицу items: у каждого «…» впишите тип столбца (для id подойдёт serial с PRIMARY KEY, для названия text NOT NULL, для цены integer). 2) Добавьте не меньше пяти строк, каждую в скобках на отдельной строке; названия возьмите из своих услуг. 3) Напишите SELECT с WHERE, ORDER BY и LIMIT. 4) Напишите запрос с GROUP BY и COUNT, который считает пункты по категориям. 5) Измените цену одной записи через UPDATE и 6) удалите другую через DELETE, оба с WHERE. 7) В последней строке напишите, какой запрос без WHERE опасен. Проверки читают текст запросов; результаты выполнения вы видите под полями в предпросмотре. Все «…» нужно заменить.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="sql-work">
      <h2>Мои запросы к таблице items<\/h2>
      <p>Запросы пишите прямо здесь, внутри полей. Под каждым полем в предпросмотре появится результат (это учебная песочница, а не настоящий PostgreSQL). Запросы выполняются по порядку, сверху вниз.<\/p>

      <h3>1. Таблица<\/h3>
      <textarea class="sql" id="q-create" rows="7">CREATE TABLE items (
  id …,
  title …,
  price …,
  category text
);<\/textarea>
      <div class="out" id="q-create-out"><\/div>

      <h3>2. Данные: не меньше пяти строк, каждая в скобках на отдельной строке<\/h3>
      <textarea class="sql" id="q-insert" rows="9">INSERT INTO items (title, price, category) VALUES
  ('{{items.0.title}}', 3000, 'основная');<\/textarea>
      <div class="out" id="q-insert-out"><\/div>

      <h3>3. Отобрать, упорядочить, ограничить<\/h3>
      <textarea class="sql" id="q-select" rows="4">SELECT * FROM items;<\/textarea>
      <div class="out" id="q-select-out"><\/div>

      <h3>4. Посчитать по категориям<\/h3>
      <textarea class="sql" id="q-group" rows="4">-- напишите запрос: сколько пунктов в каждой категории
SELECT …<\/textarea>
      <div class="out" id="q-group-out"><\/div>

      <h3>5. Изменить одну запись<\/h3>
      <textarea class="sql" id="q-update" rows="3">-- измените цену одного пункта
UPDATE …<\/textarea>
      <div class="out" id="q-update-out"><\/div>

      <h3>6. Удалить одну запись<\/h3>
      <textarea class="sql" id="q-delete" rows="3">-- удалите один пункт
DELETE …<\/textarea>
      <div class="out" id="q-delete-out"><\/div>

      <p>Какой из запросов был бы опасен без WHERE и почему: <span id="danger">…<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="sql-runner">
      // Учебный SQL (не настоящий PostgreSQL): запросы из полей выше выполняются здесь, в памяти страницы.
      // Читать этот блок не нужно. Он не входит в ваш сайт.
      class SqlError extends Error {}
      const KEYWORDS = new Set(
      'select from where group by having order limit offset asc desc distinct as join inner left right outer on and or not null is in like between true false insert into values update set delete create table index unique primary key references default begin commit rollback explain integer int serial text varchar numeric boolean date timestamp real if exists'.split(
      ' '
      )
      );
      function tokenize(src) {
      const out = [];
      const re = /\\s+|--[^\\n]*|('(?:[^']|'')*')|("(?:[^"]*)")|(\\d+(?:\\.\\d+)?)|([A-Za-z_\\u0400-\\u04FF][A-Za-z0-9_\\u0400-\\u04FF]*)|(<=|>=|<>|!=|\\|\\||[(),.*+\\-\\/=<>;])/gy;
      let pos = 0;
      while (pos < src.length) {
      re.lastIndex = pos;
      const m = re.exec(src);
      if (!m) throw new SqlError(\`синтаксическая ошибка: не понимаю символ «\${src[pos]}»\`);
      pos = re.lastIndex;
      if (m[1] !== undefined) out.push({ t: 'str', v: m[1].slice(1, -1).replace(/''/g, "'") });
      else if (m[2] !== undefined) out.push({ t: 'id', v: m[2].slice(1, -1).toLowerCase(), quoted: true });
      else if (m[3] !== undefined) out.push({ t: 'num', v: Number(m[3]) });
      else if (m[4] !== undefined) {
      const low = m[4].toLowerCase();
      out.push(KEYWORDS.has(low) ? { t: 'kw', v: low, raw: m[4] } : { t: 'id', v: low });
      } else if (m[5] !== undefined) out.push({ t: 'op', v: m[5] });
      }
      return out;
      }
      /** The text of a script, split into statements by «;» outside quotes. */
      function splitStatements(sql) {
      const parts = [];
      let cur = '';
      let q = false;
      for (let i = 0; i < sql.length; i++) {
      const c = sql[i];
      if (c === "'") q = !q;
      if (c === ';' && !q) {
      parts.push(cur);
      cur = '';
      } else cur += c;
      }
      parts.push(cur);
      return parts.map((s) => s.replace(/--[^\\n]*/g, '').trim()).filter(Boolean);
      }
      class Parser {
      constructor(tokens) {
      this.k = tokens;
      this.i = 0;
      }
      peek(o = 0) {
      return this.k[this.i + o];
      }
      isKw(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'kw' && t.v === v;
      }
      isOp(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'op' && t.v === v;
      }
      eatKw(v) {
      if (this.isKw(v)) return this.i++, true;
      return false;
      }
      eatOp(v) {
      if (this.isOp(v)) return this.i++, true;
      return false;
      }
      expectKw(v) {
      if (!this.eatKw(v)) this.fail(\`ожидалось слово \${v.toUpperCase()}\`);
      }
      expectOp(v) {
      if (!this.eatOp(v)) this.fail(\`ожидался символ «\${v}»\`);
      }
      fail(msg) {
      const t = this.peek();
      const near = t ? \` около «\${t.t === 'str' ? "'" + t.v + "'" : (t.raw ?? t.v)}»\` : ' в конце запроса';
      throw new SqlError(\`синтаксическая ошибка\${near}: \${msg}\`);
      }
      name() {
      const t = this.peek();
      if (t && (t.t === 'id' || (t.t === 'kw' && ['key', 'text', 'date', 'index'].includes(t.v)))) return this.i++, t.v;
      this.fail('ожидалось имя');
      }
      done() {
      return this.i >= this.k.length;
      }
      /* expressions */
      expr() {
      return this.or();
      }
      or() {
      let l = this.and();
      while (this.eatKw('or')) l = { op: 'or', l, r: this.and() };
      return l;
      }
      and() {
      let l = this.not();
      while (this.eatKw('and')) l = { op: 'and', l, r: this.not() };
      return l;
      }
      not() {
      if (this.eatKw('not')) return { op: 'not', e: this.not() };
      return this.cmp();
      }
      cmp() {
      const l = this.add();
      const t = this.peek();
      if (t && t.t === 'op' && ['=', '<>', '!=', '<', '>', '<=', '>='].includes(t.v)) {
      this.i++;
      return { op: t.v === '!=' ? '<>' : t.v, l, r: this.add() };
      }
      if (this.isKw('is')) {
      this.i++;
      const neg = this.eatKw('not');
      this.expectKw('null');
      return { op: 'isnull', e: l, neg };
      }
      const neg = this.isKw('not') && (this.isKw('like', 1) || this.isKw('in', 1) || this.isKw('between', 1));
      if (neg) this.i++;
      if (this.eatKw('like')) return { op: 'like', l, r: this.add(), neg };
      if (this.eatKw('in')) {
      this.expectOp('(');
      const list = [this.expr()];
      while (this.eatOp(',')) list.push(this.expr());
      this.expectOp(')');
      return { op: 'in', l, list, neg };
      }
      if (this.eatKw('between')) {
      const lo = this.add();
      this.expectKw('and');
      const hi = this.add();
      return { op: 'between', e: l, lo, hi, neg };
      }
      return l;
      }
      add() {
      let l = this.mul();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['+', '-', '||'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.mul() };
      } else return l;
      }
      }
      mul() {
      let l = this.unary();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['*', '/'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.unary() };
      } else return l;
      }
      }
      unary() {
      if (this.eatOp('-')) return { op: 'neg', e: this.unary() };
      return this.primary();
      }
      primary() {
      const t = this.peek();
      if (!t) this.fail('ожидалось значение');
      if (t.t === 'num') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'str') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'kw' && t.v === 'null') return this.i++, { op: 'lit', v: null };
      if (t.t === 'kw' && t.v === 'true') return this.i++, { op: 'lit', v: true };
      if (t.t === 'kw' && t.v === 'false') return this.i++, { op: 'lit', v: false };
      if (this.eatOp('(')) {
      const e = this.expr();
      this.expectOp(')');
      return e;
      }
      if (t.t === 'id' && this.isOp('(', 1)) {
      this.i += 2;
      const fn = t.v;
      if (!['count', 'sum', 'avg', 'min', 'max', 'lower', 'upper', 'length', 'coalesce'].includes(fn)) throw new SqlError(\`функция \${fn}() здесь не поддерживается\`);
      if (fn === 'count' && this.eatOp('*')) {
      this.expectOp(')');
      return { op: 'agg', fn, star: true };
      }
      const args = [this.expr()];
      while (this.eatOp(',')) args.push(this.expr());
      this.expectOp(')');
      return ['count', 'sum', 'avg', 'min', 'max'].includes(fn) ? { op: 'agg', fn, e: args[0] } : { op: 'fn', fn, args };
      }
      if (t.t === 'id' || (t.t === 'kw' && ['text', 'date', 'key', 'index'].includes(t.v))) {
      this.i++;
      if (this.isOp('.') && this.peek(1) && (this.peek(1).t === 'id' || this.peek(1).t === 'kw')) {
      this.i++;
      const c = this.peek();
      this.i++;
      return { op: 'col', table: t.v, name: c.v };
      }
      return { op: 'col', name: t.v };
      }
      this.fail('ожидалось значение или имя столбца');
      }
      }
      const text = (e) => {
      switch (e.op) {
      case 'col':
      return e.table ? \`\${e.table}.\${e.name}\` : e.name;
      case 'lit':
      return e.v === null ? 'NULL' : typeof e.v === 'string' ? \`'\${e.v}'\` : String(e.v);
      case 'agg':
      return \`\${e.fn}(\${e.star ? '*' : text(e.e)})\`;
      case 'fn':
      return \`\${e.fn}(\${e.args.map(text).join(', ')})\`;
      default:
      return e.op;
      }
      };
      const hasAgg = (e) => !!e && (e.op === 'agg' || [e.l, e.r, e.e, e.lo, e.hi].some(hasAgg) || (e.args || e.list || []).some(hasAgg));
      function createDb() {
      return { tables: {}, indexes: [], txn: null, aborted: false };
      }
      const clone = (x) => JSON.parse(JSON.stringify(x));
      const isNum = (v) => typeof v === 'number';
      function table(db, name) {
      const t = db.tables[name];
      if (!t) throw new SqlError(\`таблицы «\${name}» нет. Есть: \${Object.keys(db.tables).join(', ') || 'ни одной'}\`);
      return t;
      }
      function coerce(col, v) {
      if (v === null || v === undefined) return null;
      const ty = col.type;
      if (['integer', 'int', 'serial'].includes(ty)) {
      if (isNum(v) && Number.isInteger(v)) return v;
      if (typeof v === 'string' && /^-?\\d+$/.test(v.trim())) return Number(v);
      throw new SqlError(\`значение \${typeof v === 'string' ? \`«\${v}»\` : v} не подходит к типу integer (столбец \${col.name})\`);
      }
      if (['numeric', 'real'].includes(ty)) {
      if (isNum(v)) return v;
      if (typeof v === 'string' && v.trim() !== '' && !isNaN(Number(v))) return Number(v);
      throw new SqlError(\`значение «\${v}» не подходит к типу \${ty} (столбец \${col.name})\`);
      }
      if (ty === 'boolean') {
      if (typeof v === 'boolean') return v;
      throw new SqlError(\`значение «\${v}» не подходит к типу boolean (столбец \${col.name})\`);
      }
      return typeof v === 'string' ? v : String(v);
      }
      /* ---------- evaluation ---------- */
      function resolve(ctx, e) {
      const found = [];
      for (const c of ctx) {
      if (e.table && c.alias !== e.table) continue;
      if (c.cols.includes(e.name)) found.push(c);
      }
      if (!found.length) {
      const all = ctx.flatMap((c) => c.cols.map((n) => \`\${c.alias}.\${n}\`));
      throw new SqlError(\`столбца «\${e.table ? e.table + '.' : ''}\${e.name}» нет. Доступны: \${all.join(', ')}\`);
      }
      if (found.length > 1) throw new SqlError(\`столбец «\${e.name}» неоднозначен: он есть в таблицах \${found.map((f) => f.alias).join(' и ')}. Напишите \${found[0].alias}.\${e.name}\`);
      return found[0].row ? found[0].row[e.name] : null;
      }
      function cmpVals(a, b) {
      if (a === null || b === null) return null;
      if (typeof a === 'string' && typeof b === 'string') return a < b ? -1 : a > b ? 1 : 0;
      if (typeof a !== typeof b) throw new SqlError(\`нельзя сравнить \${typeof a === 'number' ? 'число' : 'текст'} и \${typeof b === 'number' ? 'число' : 'текст'}\`);
      return a < b ? -1 : a > b ? 1 : 0;
      }
      function like(s, p) {
      const re = new RegExp('^' + p.replace(/[.*+?^\${}()|[\\]\\\\]/g, '\\\\$&').replace(/%/g, '.*').replace(/_/g, '.') + '$', 'is');
      return re.test(s);
      }
      function ev(e, ctx, grp) {
      switch (e.op) {
      case 'lit':
      return e.v;
      case 'col':
      return resolve(ctx, e);
      case 'neg': {
      const v = ev(e.e, ctx, grp);
      return v === null ? null : -v;
      }
      case 'not': {
      const v = ev(e.e, ctx, grp);
      return v === null ? null : !v;
      }
      case 'and': {
      const l = ev(e.l, ctx, grp);
      if (l === false) return false;
      const r = ev(e.r, ctx, grp);
      if (r === false) return false;
      return l === null || r === null ? null : true;
      }
      case 'or': {
      const l = ev(e.l, ctx, grp);
      if (l === true) return true;
      const r = ev(e.r, ctx, grp);
      if (r === true) return true;
      return l === null || r === null ? null : false;
      }
      case '=':
      case '<>':
      case '<':
      case '>':
      case '<=':
      case '>=': {
      const c = cmpVals(ev(e.l, ctx, grp), ev(e.r, ctx, grp));
      if (c === null) return null;
      return { '=': c === 0, '<>': c !== 0, '<': c < 0, '>': c > 0, '<=': c <= 0, '>=': c >= 0 }[e.op];
      }
      case 'isnull': {
      const v = ev(e.e, ctx, grp);
      return e.neg ? v !== null : v === null;
      }
      case 'like': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      if (l === null || r === null) return null;
      const m = like(String(l), String(r));
      return e.neg ? !m : m;
      }
      case 'in': {
      const l = ev(e.l, ctx, grp);
      if (l === null) return null;
      const m = e.list.some((x) => cmpVals(l, ev(x, ctx, grp)) === 0);
      return e.neg ? !m : m;
      }
      case 'between': {
      const v = ev(e.e, ctx, grp);
      const lo = cmpVals(v, ev(e.lo, ctx, grp)),
      hi = cmpVals(v, ev(e.hi, ctx, grp));
      if (lo === null || hi === null) return null;
      const m = lo >= 0 && hi <= 0;
      return e.neg ? !m : m;
      }
      case '+':
      case '-':
      case '*':
      case '/': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      if (l === null || r === null) return null;
      if (!isNum(l) || !isNum(r)) throw new SqlError(\`арифметика (\${e.op}) работает с числами, а здесь текст\`);
      if (e.op === '/' && r === 0) throw new SqlError('деление на ноль');
      return e.op === '+' ? l + r : e.op === '-' ? l - r : e.op === '*' ? l * r : l / r;
      }
      case '||': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      return l === null || r === null ? null : String(l) + String(r);
      }
      case 'fn': {
      const a = e.args.map((x) => ev(x, ctx, grp));
      if (e.fn === 'coalesce') return a.find((x) => x !== null) ?? null;
      if (a[0] === null) return null;
      if (e.fn === 'lower') return String(a[0]).toLowerCase();
      if (e.fn === 'upper') return String(a[0]).toUpperCase();
      return String(a[0]).length;
      }
      case 'agg': {
