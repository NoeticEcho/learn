  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
