<script module>
	/** Licence of this lesson's text: CC BY-SA 4.0. */
	export const metadata = {
		id: '07-data/06-vector-search',
		part: 7,
		order: 6,
		title: 'Поиск: полнотекстовый и векторный',
		summary: 'Вы понимаете, как сайт ищет по словам и по смыслу: токены, указатель, ранжирование, эмбеддинги и ближайшие соседи. После урока вы выберете между поиском внутри Postgres, отдельным движком и векторной базой и поймёте, как ИИ-ответы используют ваши тексты.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'editor',
					label: 'LIKE \'%услуга%\'',
					caption: 'Поиск в лоб',
					say: [
						{ text: 'Ищу «услуга».' },
						{ who: 'LIKE', text: 'А «услуги»? Это другое слово. Не нашёл.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'cards',
					label: 'услуг → 1, 3, 7',
					caption: 'Указатель',
					say: 'Слова сводят к основе и строят указатель: основа → в каких текстах она есть.'
				},
				{
					mood: 'cheer',
					prop: 'network',
					label: 'близко по смыслу',
					caption: 'Эмбеддинг',
					say: [
						{ text: 'Сколько это стоит?' },
						{ who: 'Поиск', text: 'Слов общих нет, но «Цены и оплата» рядом по смыслу.' }
					]
				}
			]
		},
		minutes: 30,
		teaches: ['data-full-text-search', 'data-vector-db'],
		requires: ['data-index', 'data-choose-database'],
		practice: {
			id: 'data-search-items',
			title: 'Поиск по услугам: слова, основа, запрос',
			task: 'В странице работает демо поиска по вашим услугам. 1) Попробуйте в нём запрос в разных формах слова. 2) В таблице выпишите три формы одного слова из своих услуг и их основу (основа общая). 3) В поле запроса напишите для PostgreSQL выборку услуг с русской полнотекстовой конфигурацией: to_tsvector(\'russian\', …) @@ plainto_tsquery(\'russian\', …), ts_rank и ORDER BY … DESC. 4) В поле индекса создайте GIN-индекс по to_tsvector. 5) Ответьте тремя фразами: когда вам хватит поиска по словам; когда понадобился бы поиск по смыслу и какие тексты в него пошли бы; какие тексты ушли бы стороннему сервису и нужно ли согласие. Все «…» нужно заменить.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="search-work">
      <h2>Поиск по услугам<\/h2>
      <p>Демо ниже ищет по вашим услугам с учётом форм слов. Введите, например, одно из слов названия в другой форме: основа та же, результат тот же.<\/p>
      <p><label for="fts-q">Запрос<\/label> <input id="fts-q" type="search" value="услуги" autocomplete="off"><\/p>
      <ol id="fts-results"><\/ol>

      <h3>Три формы одного слова из ваших услуг и их основа<\/h3>
      <table id="lemma">
        <tr><th>Форма слова<\/th><th>Основа<\/th><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
      <\/table>

      <h3>Запрос для PostgreSQL: найти и упорядочить по релевантности<\/h3>
      <p>Таблица items(id, title, text). Используйте русскую конфигурацию. Здесь запрос только проверяется по тексту; настоящий PostgreSQL в браузере есть на pglite.dev.<\/p>
      <textarea id="q-fts" rows="8">SELECT …
FROM items
WHERE …
ORDER BY …;<\/textarea>

      <h3>Индекс под этот поиск<\/h3>
      <textarea id="q-gin" rows="3">CREATE INDEX …<\/textarea>

      <p>Когда полнотекстового поиска мне хватит: <span id="enough">…<\/span><\/p>
      <p>Когда понадобился бы поиск по смыслу и какие тексты в него пошли бы: <span id="vector-when">…<\/span><\/p>
      <p>Какие тексты ушли бы стороннему сервису и нужно ли согласие: <span id="vector-send">…<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fts-demo">
      // Демо поиска (упрощённая модель, не PostgreSQL): ваши услуги из брифа и срезание русских окончаний.
      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
      const own = [{{#each items}}{ title: '{{title}}', text: '{{text}}' }, {{/each}}].map((d) => ({ title: unesc(d.title), text: unesc(d.text) }));
      const docs = own.length ? own : [{ title: 'Первая услуга', text: 'Описание услуги.' }, { title: 'Вторая услуга', text: 'Ещё одна услуга и её цена.' }];
      const STOP = new Set('и в во на с по к о от до за из для не что как а но или это'.split(' '));
      const ENDINGS = 'ыми ими ого его ому ему ией иям иях ами ями ов ев ей ий ый ой ом ем ам ям ах ях ия ие ые ых их ая яя ое ее ую юю ью ию а я о е у ю ы и ь й'.split(' ').sort((a, b) => b.length - a.length);
      const stem = (w) => { for (const e of ENDINGS) if (w.length - e.length >= 3 && w.endsWith(e)) return w.slice(0, -e.length); return w; };
      const tokens = (s) => (s.toLowerCase().match(/[а-яёa-z0-9]+/g) || []).filter((t) => !STOP.has(t)).map(stem);
      const input = document.getElementById('fts-q');
      const list = document.getElementById('fts-results');
      function draw() {
        const q = tokens(input.value);
        const rows = docs.map((d, i) => ({ d, i, s: q.reduce((n, w) => n + 2 * tokens(d.title).filter((x) => x === w).length + tokens(d.text).filter((x) => x === w).length, 0) }))
          .filter((r) => r.s > 0).sort((a, b) => b.s - a.s || a.i - b.i);
        list.replaceChildren(...(rows.length ? rows.map((r) => Object.assign(document.createElement('li'), { textContent: r.d.title + ' (вес ' + r.s + ')' })) : [Object.assign(document.createElement('li'), { textContent: 'Ничего не нашлось' })]));
      }
      input.addEventListener('input', draw);
      draw();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="search-work">
      <h2>Поиск по услугам<\/h2>
      <p>Демо ниже ищет по вашим услугам с учётом форм слов. Введите, например, одно из слов названия в другой форме: основа та же, результат тот же.<\/p>
      <p><label for="fts-q">Запрос<\/label> <input id="fts-q" type="search" value="услуги" autocomplete="off"><\/p>
      <ol id="fts-results"><\/ol>

      <h3>Три формы одного слова из ваших услуг и их основа<\/h3>
      <table id="lemma">
        <tr><th>Форма слова<\/th><th>Основа<\/th><\/tr>
        <tr class="form"><td class="word">услуга<\/td><td class="stem">услуг<\/td><\/tr>
        <tr class="form"><td class="word">услуги<\/td><td class="stem">услуг<\/td><\/tr>
        <tr class="form"><td class="word">услугу<\/td><td class="stem">услуг<\/td><\/tr>
      <\/table>

      <h3>Запрос для PostgreSQL: найти и упорядочить по релевантности<\/h3>
      <p>Таблица items(id, title, text). Используйте русскую конфигурацию. Здесь запрос только проверяется по тексту; настоящий PostgreSQL в браузере есть на pglite.dev.<\/p>
      <textarea id="q-fts" rows="8">SELECT title,
       ts_rank(to_tsvector('russian', title || ' ' || text), plainto_tsquery('russian', 'услуга')) AS rank
FROM items
WHERE to_tsvector('russian', title || ' ' || text) @@ plainto_tsquery('russian', 'услуга')
ORDER BY rank DESC;<\/textarea>

      <h3>Индекс под этот поиск<\/h3>
      <textarea id="q-gin" rows="3">CREATE INDEX items_fts_idx ON items USING GIN (to_tsvector('russian', title || ' ' || text));<\/textarea>

      <p>Когда полнотекстового поиска мне хватит: <span id="enough">когда услуг десятки, посетители пишут слова из названий, и нужны разные формы слова и ранжирование: тогда хватает поиска внутри PostgreSQL<\/span><\/p>
      <p>Когда понадобился бы поиск по смыслу и какие тексты в него пошли бы: <span id="vector-when">если посетители задают вопросы своими словами и слова не совпадают с текстом (синонимы), тогда в него пошли бы тексты услуг и ответы на частые вопросы<\/span><\/p>
      <p>Какие тексты ушли бы стороннему сервису и нужно ли согласие: <span id="vector-send">тексты услуг и вопросов ушли бы стороннему сервису для эмбеддингов; без персональных данных согласие не нужно, а с ними нужны основание и согласие, либо локальная модель на своём сервере<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fts-demo">
      // Демо поиска (упрощённая модель, не PostgreSQL): ваши услуги из брифа и срезание русских окончаний.
      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
      const own = [{{#each items}}{ title: '{{title}}', text: '{{text}}' }, {{/each}}].map((d) => ({ title: unesc(d.title), text: unesc(d.text) }));
      const docs = own.length ? own : [{ title: 'Первая услуга', text: 'Описание услуги.' }, { title: 'Вторая услуга', text: 'Ещё одна услуга и её цена.' }];
      const STOP = new Set('и в во на с по к о от до за из для не что как а но или это'.split(' '));
      const ENDINGS = 'ыми ими ого его ому ему ией иям иях ами ями ов ев ей ий ый ой ом ем ам ям ах ях ия ие ые ых их ая яя ое ее ую юю ью ию а я о е у ю ы и ь й'.split(' ').sort((a, b) => b.length - a.length);
      const stem = (w) => { for (const e of ENDINGS) if (w.length - e.length >= 3 && w.endsWith(e)) return w.slice(0, -e.length); return w; };
      const tokens = (s) => (s.toLowerCase().match(/[а-яёa-z0-9]+/g) || []).filter((t) => !STOP.has(t)).map(stem);
      const input = document.getElementById('fts-q');
      const list = document.getElementById('fts-results');
      function draw() {
        const q = tokens(input.value);
        const rows = docs.map((d, i) => ({ d, i, s: q.reduce((n, w) => n + 2 * tokens(d.title).filter((x) => x === w).length + tokens(d.text).filter((x) => x === w).length, 0) }))
          .filter((r) => r.s > 0).sort((a, b) => b.s - a.s || a.i - b.i);
        list.replaceChildren(...(rows.length ? rows.map((r) => Object.assign(document.createElement('li'), { textContent: r.d.title + ' (вес ' + r.s + ')' })) : [Object.assign(document.createElement('li'), { textContent: 'Ничего не нашлось' })]));
      }
      input.addEventListener('input', draw);
      draw();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

