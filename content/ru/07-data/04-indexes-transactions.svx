      if (!t.columns.some((x) => x.name === c)) throw new SqlError(\`в таблице «\${t.name}» нет столбца «\${c}»\`);
      p.expectOp('=');
      sets.push([c, p.expr()]);
      } while (p.eatOp(','));
      const where = p.eatKw('where') ? p.expr() : null;
      if (!p.done()) p.fail('лишнее после конца запроса');
      const cols = t.columns.map((c) => c.name);
      const hit = t.rows.filter((r) => !where || ev(where, [{ alias: t.name, cols, row: r }], null) === true);
      const next = hit.map((r) => {
      const n = { ...r };
      for (const [c, e] of sets) n[c] = coerce(t.columns.find((x) => x.name === c), ev(e, [{ alias: t.name, cols, row: r }], null));
      return [r, n];
      });
      for (const [r, n] of next) {
      checkRow(db, t, n, r);
      Object.assign(r, n);
      }
      return { kind: 'msg', message: \`UPDATE: изменено строк \${hit.length}\${where ? '' : '. Условия WHERE не было, поэтому изменены ВСЕ строки таблицы'}\`, changed: hit.length };
      }
      if (p.eatKw('delete')) {
      p.expectKw('from');
      const t = table(db, p.name());
      const where = p.eatKw('where') ? p.expr() : null;
      if (!p.done()) p.fail('лишнее после конца запроса');
      const cols = t.columns.map((c) => c.name);
      const gone = t.rows.filter((r) => !where || ev(where, [{ alias: t.name, cols, row: r }], null) === true);
      for (const r of gone)
      for (const o of Object.values(db.tables))
      for (const c of o.columns)
      if (c.ref && c.ref.table === t.name && o.rows.some((x) => x[c.name] !== null && x[c.name] === r[c.ref.col])) throw new SqlError(\`нельзя удалить: на эту строку ссылается таблица «\${o.name}» (столбец \${c.name}). Сначала уберите ссылки\`);
      t.rows = t.rows.filter((r) => !gone.includes(r));
      return { kind: 'msg', message: \`DELETE: удалено строк \${gone.length}\${where ? '' : '. Условия WHERE не было, поэтому удалены ВСЕ строки таблицы'}\`, changed: gone.length };
      }
      throw new SqlError('эта песочница знает команды SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, CREATE INDEX, BEGIN, COMMIT, ROLLBACK и EXPLAIN SELECT');
      }
      function createIndex(db, p, unique) {
      let name = null;
      if (!p.isKw('on')) name = p.name();
      p.expectKw('on');
      const tn = p.name();
      const t = table(db, tn);
      p.expectOp('(');
      const cols = [];
      do cols.push(p.name());
      while (p.eatOp(','));
      p.expectOp(')');
      for (const c of cols) if (!t.columns.some((x) => x.name === c)) throw new SqlError(\`в таблице «\${tn}» нет столбца «\${c}»\`);
      name = name || \`\${tn}_\${cols.join('_')}_idx\`;
      if (db.indexes.some((i) => i.name === name)) throw new SqlError(\`индекс «\${name}» уже есть\`);
      db.indexes.push({ name, table: tn, cols, unique });
      return { kind: 'msg', message: \`CREATE INDEX: индекс «\${name}» по \${tn}(\${cols.join(', ')}) построен. Теперь каждая запись в «\${tn}» обновляет и его\` };
      }
      /**
      * Runs a script: statements split by «;», executed in order, stopping at the first error.
      * Returns { results, error }. After an error inside BEGIN the transaction is «aborted»
      * and every command is refused until ROLLBACK, as in PostgreSQL.
      */
      function run(db, sql) {
      const results = [];
      for (const s of splitStatements(sql)) {
      try {
      if (db.aborted && !/^\\s*rollback\\b/i.test(s)) throw new SqlError('транзакция прервана после ошибки: все команды игнорируются, пока не будет ROLLBACK');
      const r = execOne(db, s);
      if (r) results.push({ ...r, sql: s });
      } catch (e) {
      if (!(e instanceof SqlError)) throw e;
      if (db.txn) db.aborted = true;
      return { results, error: { message: e.message, sql: s } };
      }
      }
      return { results, error: null };
      }
      /** Puts ready rows into an existing table (for seeding a page from the person's brief). */
      function load(db, name, rows) {
      const t = table(db, name);
      for (const r of rows) {
      const row = {};
      for (const c of t.columns) {
      row[c.name] = r[c.name] === undefined ? null : r[c.name];
      if (c.type === 'serial') (row[c.name] === null && (row[c.name] = ++t.seq), (t.seq = Math.max(t.seq, row[c.name])));
      }
      t.rows.push(row);
      }
      }
      /** A value as the person reads it in a result table. */
      function show(v) {
      return v === null ? 'NULL' : v === true ? 'true' : v === false ? 'false' : String(v);
      }

      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
      // Учебная таблица на 2000 строк. Названия берутся из вашего брифа, остальное придумано.
      const names = [{{#each items}}'{{title}}', {{/each}}].map(unesc);
      function afterSetup(db) {
        const rows = [];
        for (let i = 1; i <= 2000; i++) rows.push({ title: (names.length ? names[i % names.length] : 'Позиция') + ' №' + i, category_id: ((i * 7) % 20) + 1, day: ((i * 13) % 365) + 1 });
        load(db, 'items', rows);
      }

      function draw(box, r) {
        box.replaceChildren();
        for (const res of r.results) {
          const p = document.createElement('p');
          if (res.kind === 'select') {
            const t = document.createElement('table');
            const head = t.insertRow();
            for (const c of res.columns) head.appendChild(Object.assign(document.createElement('th'), { textContent: c }));
            for (const row of res.rows) {
              const tr = t.insertRow();
              for (const v of row) tr.insertCell().textContent = show(v);
            }
            box.appendChild(t);
            p.textContent = 'Строк: ' + res.rows.length + '. Прочитано из таблиц: ' + res.scanned + '.';
          } else if (res.kind === 'plan') {
            p.textContent = 'План (упрощённая модель): ' + res.lines.join('; ');
          } else p.textContent = res.message;
          box.appendChild(p);
        }
        if (r.error) {
          const e = document.createElement('p');
          e.className = 'err';
          e.textContent = 'Ошибка: ' + r.error.message;
          box.appendChild(e);
        }
      }

      function runAll() {
        const db = createDb();
        const base = run(db, "CREATE TABLE items (id serial PRIMARY KEY, title text NOT NULL, category_id integer, day integer);\\nCREATE TABLE requests (id serial PRIMARY KEY, name text NOT NULL, phone text NOT NULL, item_id integer REFERENCES items(id));\\nCREATE TABLE notifications (id serial PRIMARY KEY, request_id integer REFERENCES requests(id), text text NOT NULL);");
        if (base.error) console.error(base.error.message);
        afterSetup(db);
        for (const area of document.querySelectorAll('#sql-work textarea.sql')) {
          const box = document.getElementById(area.id + '-out');
          const r = run(db, area.value);
          if (box) draw(box, r);
        }
      }
      for (const area of document.querySelectorAll('#sql-work textarea.sql')) area.addEventListener('input', runAll);
      runAll();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			checks: [
				{ id: 'work-exists', kind: 'exists', selector: '#sql-work' },
				{ id: 'no-blanks', kind: 'text', selector: '#sql-work', matches: '^[^…]*$' },
				{
					id: 'explain-before',
					kind: 'text',
					selector: '#q-before',
					matches: '[Ee][Xx][Pp][Ll][Aa][Ii][Nn]\\s+[Ss][Ee][Ll][Ee][Cc][Tt][\\s\\S]*[Ww][Hh][Ee][Rr][Ee][\\s\\S]*category_id'
				},
				{
					id: 'create-index',
					kind: 'text',
					selector: '#q-index',
					matches: '[Cc][Rr][Ee][Aa][Tt][Ee]\\s+[Ii][Nn][Dd][Ee][Xx][\\s\\S]*[Oo][Nn]\\s+items\\s*\\(\\s*category_id'
				},
				{
					id: 'explain-after',
					kind: 'text',
					selector: '#q-index',
					matches: '[Cc][Rr][Ee][Aa][Tt][Ee]\\s+[Ii][Nn][Dd][Ee][Xx][\\s\\S]*[Ee][Xx][Pp][Ll][Aa][Ii][Nn]\\s+[Ss][Ee][Ll][Ee][Cc][Tt]'
				},
				{ id: 'rows-before', kind: 'text', selector: '#rows-before', matches: '^\\s*\\d+\\s*$' },
				{ id: 'rows-after', kind: 'text', selector: '#rows-after', matches: '^\\s*\\d+\\s*$' },
				{
					id: 'tx-ok',
					kind: 'text',
					selector: '#q-tx-ok',
					matches: '[Bb][Ee][Gg][Ii][Nn][\\s\\S]*[Ii][Nn][Ss][Ee][Rr][Tt]\\s+[Ii][Nn][Tt][Oo]\\s+[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ss][\\s\\S]*[Ii][Nn][Ss][Ee][Rr][Tt]\\s+[Ii][Nn][Tt][Oo]\\s+[Nn][Oo][Tt][Ii][Ff][Ii][Cc][Aa][Tt][Ii][Oo][Nn][Ss][\\s\\S]*[Cc][Oo][Mm][Mm][Ii][Tt]'
				},
				{
					id: 'tx-fail-open',
					kind: 'text',
					selector: '#q-tx-fail',
					matches: '^(?![\\s\\S]*[Cc][Oo][Mm][Mm][Ii][Tt])[\\s\\S]*[Bb][Ee][Gg][Ii][Nn][\\s\\S]*[Ii][Nn][Ss][Ee][Rr][Tt]\\s+[Ii][Nn][Tt][Oo]\\s+[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ss][\\s\\S]*[Ii][Nn][Ss][Ee][Rr][Tt]\\s+[Ii][Nn][Tt][Oo]\\s+[Nn][Oo][Tt][Ii][Ff][Ii][Cc][Aa][Tt][Ii][Oo][Nn][Ss]'
				},
				{
					id: 'tx-rollback',
					kind: 'text',
					selector: '#q-tx-after',
					matches: '[Rr][Oo][Ll][Ll][Bb][Aa][Cc][Kk][\\s\\S]*[Ss][Ee][Ll][Ee][Cc][Tt]\\s+[Cc][Oo][Uu][Nn][Tt]\\('
				},
				{ id: 'index-cost', kind: 'text', selector: '#index-cost', matches: 'запис|встав|медленн|место|обновл' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Почему поиск по индексу быстрее просмотра всей таблицы?',
				options: [
					'Индекс это упорядоченная структура: каждый шаг по ней отбрасывает почти всю таблицу, как поиск слова по указателю в конце книги',
					'Индекс хранит копию всей таблицы в оперативной памяти',
					'Индекс заставляет базу читать строки в обратном порядке'
				],
				answer: 0,
				why: [
					'Да. В дереве индекса несколько уровней, и миллионы строк находятся за три-четыре шага вместо чтения всех страниц.',
					'Нет: индекс не копия всей таблицы, а компактная структура из ключей и ссылок на строки.',
					'Нет: порядок чтения тут ни при чём, дело в том, что читать приходится в сотни раз меньше.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Какую цену платят за каждый лишний индекс?',
				options: [
					'Каждая вставка и изменение обновляют и индекс, поэтому запись медленнее',
					'Индекс занимает место на диске',
					'Запросы на чтение становятся медленнее',
					'Индекс надо поддерживать в согласии с таблицей, и этим занимается сама база'
				],
				answer: [0, 1],
				why: [
					'Да: пять индексов это пять дополнительных записей при каждой вставке.',
					'Да: большие индексы вполне сравнимы по размеру с таблицей.',
					'Нет: чтение от индекса обычно ускоряется. Бывает, что индекс просто не нужен, но замедлять чтение он не будет.',
					'Это правда, но это не цена, а забота, которую база берёт на себя. Платой за неё и становится замедление записи.'
				]
			},
			{
				type: 'single',
				prompt: 'В таблице пациентов миллион строк, и вы построили индекс по столбцу «пол» (два значения, примерно пополам). Поможет ли он запросу WHERE пол = \'ж\'?',
				options: [
					'Почти нет: подходит половина таблицы, и проще прочитать её целиком, чем ходить по индексу за каждой строкой',
					'Да, в два раза: индекс всегда ускоряет любой запрос с WHERE',
					'Нет, потому что индекс нельзя строить по текстовым столбцам'
				],
				answer: 0,
				why: [
					'Да. Индекс выигрывает, когда подходит мало строк. Когда их половина, планировщик возьмёт обычный просмотр таблицы.',
					'Нет: «всегда» тут не бывает, и индекс по столбцу с двумя значениями почти бесполезен.',
					'Нет: индексы строят и по тексту, и по числам, и по датам.'
