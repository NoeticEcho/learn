			},
			checks: [
				{ id: 'schema-exists', kind: 'exists', selector: '#schema' },
				{ id: 'no-blanks', kind: 'text', selector: '#schema', matches: '^[^…]*$' },
				{ id: 'entities', kind: 'count', selector: '#schema tr.entity', min: 4 },
				{ id: 'keys', kind: 'count', selector: '#schema td.key', min: 4 },
				{ id: 'key-is-id', kind: 'text', selector: '#schema td.key', matches: '\\b(?:id|ID)\\b|идентификатор|номер' },
				{ id: 'request-separate', kind: 'text', selector: '#schema tr.entity.request td.fields', matches: 'телефон|phone|имя|name|почт|email|контакт' },
				{ id: 'relations', kind: 'text', selector: '#schema td.rel', matches: '_id|ссылается|относится|принадлежит|связан|связь|→' },
				{ id: 'pd-marked', kind: 'text', selector: '#schema tr.entity.request td.pd', matches: '^\\s*[Дд]а' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'Два редактора одновременно открыли один JSON-файл со счётчиком заявок, оба прочитали 10 и записали 9. Что произошло?',
				options: [
					'Файл ничего не знает о двух авторах, поэтому одна правка потерялась: должно было стать 8',
					'Файл сам сложил обе правки и записал 8',
					'Файл выдал ошибку второму редактору'
				],
				answer: 0,
				why: [
					'Да. Файл хранит только последнюю запись, и не следит, кто её сделал и от какого значения. Это «потерянное обновление».',
					'Нет: файл не умеет складывать правки, он принимает то, что записали последним.',
					'Нет: файл не знает, что открыт кем-то ещё, поэтому ошибки не будет. Её не будет и самой правки.'
				]
			},
			{
				type: 'match',
				prompt: 'Соедините термин с тем, что он значит',
				pairs: [
					['Таблица', 'набор однотипных записей: например, все услуги'],
					['Строка', 'одна запись: одна услуга со всеми её значениями'],
					['Столбец', 'одно поле каждой записи: например, цена, с заданным типом'],
					['Первичный ключ', 'поле, которое однозначно называет строку и не повторяется'],
					['Внешний ключ', 'поле, которое указывает на строку другой таблицы']
				]
			},
			{
				type: 'multiple',
				prompt: 'Что база данных делает за вас, а простой файл не делает?',
				options: [
					'Следит, чтобы две одновременные правки не затёрли друг друга',
					'Не даёт записать ссылку на строку, которой нет',
					'Быстро находит нужные записи, не читая всё подряд',
					'Сама придумывает, какие данные нужны вашему сайту'
				],
				answer: [0, 1, 2],
				why: [
					'Да: для этого есть блокировки и транзакции.',
					'Да: внешний ключ отказывает в записи, если ссылаться не на что.',
					'Да: для этого есть индексы, о них в четвёртом уроке этой части.',
					'Нет: что хранить, решаете вы. Для этого и нужна схема данных.'
				]
			},
			{
				type: 'single',
				prompt: 'Что лучше всего подходит на роль первичного ключа в таблице услуг?',
				options: ['Автоматический числовой номер (id), который никогда не меняется', 'Название услуги', 'Цена услуги'],
				answer: 0,
				why: [
					'Да. Номер ничего не значит сам по себе, потому и не меняется: название можно исправить, а ссылки на строку останутся целы.',
					'Нет: название могут переименовать, и две услуги могут называться одинаково. Ключ должен быть уникальным и постоянным.',
					'Нет: цены повторяются и меняются.'
				]
			},
			{
				type: 'single',
				prompt: 'Посетитель отправил заявку. Где её хранить?',
				options: [
					'В отдельной таблице заявок, со ссылкой на услугу',
					'В поле «заявки» внутри строки услуги',
					'В названии услуги, через запятую'
				],
				answer: 0,
				why: [
					'Да. Заявок у одной услуги много, у каждой своя дата и свои контакты, а ещё это персональные данные, которые хранят и удаляют по своим правилам.',
					'Нет: в одно поле не уместить много заявок с датами и контактами, и каждую править отдельно будет нельзя.',
					'Нет: так данные смешиваются, и искать в них придётся глазами.'
				]
			},
