      for (const c of t.columns) {
      row[c.name] = r[c.name] === undefined ? null : r[c.name];
      if (c.type === 'serial') (row[c.name] === null && (row[c.name] = ++t.seq), (t.seq = Math.max(t.seq, row[c.name])));
      }
      t.rows.push(row);
      }
      }
      /** A value as the person reads it in a result table. */
      function show(v) {
      return v === null ? 'NULL' : v === true ? 'true' : v === false ? 'false' : String(v);
      }

      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');

      function draw(box, r) {
        box.replaceChildren();
        for (const res of r.results) {
          const p = document.createElement('p');
          if (res.kind === 'select') {
            const t = document.createElement('table');
            const head = t.insertRow();
            for (const c of res.columns) head.appendChild(Object.assign(document.createElement('th'), { textContent: c }));
            for (const row of res.rows) {
              const tr = t.insertRow();
              for (const v of row) tr.insertCell().textContent = show(v);
            }
            box.appendChild(t);
            p.textContent = 'Строк: ' + res.rows.length + '. Прочитано из таблиц: ' + res.scanned + '.';
          } else if (res.kind === 'plan') {
            p.textContent = 'План (упрощённая модель): ' + res.lines.join('; ');
          } else p.textContent = res.message;
          box.appendChild(p);
        }
        if (r.error) {
          const e = document.createElement('p');
          e.className = 'err';
          e.textContent = 'Ошибка: ' + r.error.message;
          box.appendChild(e);
        }
      }

      function runAll() {
        const db = createDb();
        for (const area of document.querySelectorAll('#sql-work textarea.sql')) {
          const box = document.getElementById(area.id + '-out');
          const r = run(db, area.value);
          if (box) draw(box, r);
        }
      }
      for (const area of document.querySelectorAll('#sql-work textarea.sql')) area.addEventListener('input', runAll);
      runAll();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: страница после части про CSS, в сокращённом виде */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Оформление упражнения (блоки с data-scaffold). В сайт оно не попадает. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  overflow-x: auto;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Разделы сайта">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#zayavka">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>Пара предложений о разделе.<\/p>
      <\/section>

      <section id="offer">
        <h2>Что мы предлагаем<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="zayavka">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/zayavka" method="post">
          <p>
            <label for="f-name">Как к вам обращаться<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Телефон<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="sql-work">
      <h2>Мои таблицы и запросы<\/h2>
      <p>Запросы пишите прямо в полях. Результат появится под каждым из них в предпросмотре (это учебная песочница, а не настоящий PostgreSQL). Поля выполняются по порядку, сверху вниз.<\/p>

      <h3>1. Таблицы: categories, people и items со ссылками на них<\/h3>
      <textarea class="sql" id="q-tables" rows="22">CREATE TABLE categories (
  id serial PRIMARY KEY,
  name text NOT NULL
);

CREATE TABLE people (
  id serial PRIMARY KEY,
  name text NOT NULL
);

-- items: добавьте столбцы category_id и person_id
-- и свяжите их с таблицами через REFERENCES (см. урок)
CREATE TABLE items (
  id serial PRIMARY KEY,
  title text NOT NULL,
  category_id integer REFERENCES categories(id),
  person_id integer REFERENCES people(id)
);<\/textarea>
      <div class="out" id="q-tables-out"><\/div>

      <h3>2. Данные: одна услуга должна остаться без категории (NULL)<\/h3>
      <textarea class="sql" id="q-data" rows="11">INSERT INTO categories (name) VALUES ('Основное'), ('Дополнительное');
INSERT INTO people (name) VALUES ('Ответственный по умолчанию'){{#each people}}, ('{{name}}'){{/each}};
INSERT INTO items (title, category_id, person_id) VALUES
{{#each items}}  ('{{title}}', 1, 1),
{{/each}}  ('Услуга без категории', NULL, 1);<\/textarea>
      <div class="out" id="q-data-out"><\/div>

      <h3>3. Услуги вместе с названием категории и именем ответственного<\/h3>
      <textarea class="sql" id="q-join" rows="6">SELECT items.title, categories.name AS category, people.name AS person
FROM items
JOIN categories ON items.category_id = categories.id
JOIN people ON items.person_id = people.id;<\/textarea>
      <div class="out" id="q-join-out"><\/div>

      <h3>4. Услуги без категории<\/h3>
      <textarea class="sql" id="q-left" rows="6">SELECT items.title
FROM items
LEFT JOIN categories ON items.category_id = categories.id
WHERE categories.id IS NULL;<\/textarea>
      <div class="out" id="q-left-out"><\/div>

      <p>Где в моём проекте данные намеренно продублированы и зачем: <span id="denorm">в таблице заказов я бы хранил цену на момент заказа: если цена услуги потом изменится, в старых заказах должна остаться прежняя<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="sql-runner">
      // Учебный SQL (не настоящий PostgreSQL): запросы из полей выше выполняются здесь, в памяти страницы.
      // Читать этот блок не нужно. Он не входит в ваш сайт.
      class SqlError extends Error {}
      const KEYWORDS = new Set(
      'select from where group by having order limit offset asc desc distinct as join inner left right outer on and or not null is in like between true false insert into values update set delete create table index unique primary key references default begin commit rollback explain integer int serial text varchar numeric boolean date timestamp real if exists'.split(
      ' '
      )
      );
      function tokenize(src) {
      const out = [];
      const re = /\\s+|--[^\\n]*|('(?:[^']|'')*')|("(?:[^"]*)")|(\\d+(?:\\.\\d+)?)|([A-Za-z_\\u0400-\\u04FF][A-Za-z0-9_\\u0400-\\u04FF]*)|(<=|>=|<>|!=|\\|\\||[(),.*+\\-\\/=<>;])/gy;
      let pos = 0;
      while (pos < src.length) {
      re.lastIndex = pos;
      const m = re.exec(src);
      if (!m) throw new SqlError(\`синтаксическая ошибка: не понимаю символ «\${src[pos]}»\`);
      pos = re.lastIndex;
      if (m[1] !== undefined) out.push({ t: 'str', v: m[1].slice(1, -1).replace(/''/g, "'") });
      else if (m[2] !== undefined) out.push({ t: 'id', v: m[2].slice(1, -1).toLowerCase(), quoted: true });
      else if (m[3] !== undefined) out.push({ t: 'num', v: Number(m[3]) });
      else if (m[4] !== undefined) {
      const low = m[4].toLowerCase();
      out.push(KEYWORDS.has(low) ? { t: 'kw', v: low, raw: m[4] } : { t: 'id', v: low });
      } else if (m[5] !== undefined) out.push({ t: 'op', v: m[5] });
      }
      return out;
      }
      /** The text of a script, split into statements by «;» outside quotes. */
      function splitStatements(sql) {
      const parts = [];
      let cur = '';
      let q = false;
      for (let i = 0; i < sql.length; i++) {
      const c = sql[i];
      if (c === "'") q = !q;
      if (c === ';' && !q) {
      parts.push(cur);
      cur = '';
      } else cur += c;
      }
      parts.push(cur);
      return parts.map((s) => s.replace(/--[^\\n]*/g, '').trim()).filter(Boolean);
      }
      class Parser {
      constructor(tokens) {
      this.k = tokens;
      this.i = 0;
      }
      peek(o = 0) {
      return this.k[this.i + o];
      }
      isKw(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'kw' && t.v === v;
      }
      isOp(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'op' && t.v === v;
      }
      eatKw(v) {
      if (this.isKw(v)) return this.i++, true;
      return false;
      }
      eatOp(v) {
      if (this.isOp(v)) return this.i++, true;
      return false;
      }
      expectKw(v) {
      if (!this.eatKw(v)) this.fail(\`ожидалось слово \${v.toUpperCase()}\`);
      }
      expectOp(v) {
      if (!this.eatOp(v)) this.fail(\`ожидался символ «\${v}»\`);
      }
      fail(msg) {
      const t = this.peek();
      const near = t ? \` около «\${t.t === 'str' ? "'" + t.v + "'" : (t.raw ?? t.v)}»\` : ' в конце запроса';
      throw new SqlError(\`синтаксическая ошибка\${near}: \${msg}\`);
      }
      name() {
      const t = this.peek();
      if (t && (t.t === 'id' || (t.t === 'kw' && ['key', 'text', 'date', 'index'].includes(t.v)))) return this.i++, t.v;
      this.fail('ожидалось имя');
      }
      done() {
      return this.i >= this.k.length;
      }
      /* expressions */
      expr() {
      return this.or();
      }
      or() {
      let l = this.and();
      while (this.eatKw('or')) l = { op: 'or', l, r: this.and() };
      return l;
      }
      and() {
      let l = this.not();
      while (this.eatKw('and')) l = { op: 'and', l, r: this.not() };
      return l;
      }
      not() {
      if (this.eatKw('not')) return { op: 'not', e: this.not() };
      return this.cmp();
      }
      cmp() {
      const l = this.add();
      const t = this.peek();
      if (t && t.t === 'op' && ['=', '<>', '!=', '<', '>', '<=', '>='].includes(t.v)) {
      this.i++;
      return { op: t.v === '!=' ? '<>' : t.v, l, r: this.add() };
      }
      if (this.isKw('is')) {
      this.i++;
      const neg = this.eatKw('not');
      this.expectKw('null');
      return { op: 'isnull', e: l, neg };
      }
      const neg = this.isKw('not') && (this.isKw('like', 1) || this.isKw('in', 1) || this.isKw('between', 1));
      if (neg) this.i++;
      if (this.eatKw('like')) return { op: 'like', l, r: this.add(), neg };
      if (this.eatKw('in')) {
      this.expectOp('(');
      const list = [this.expr()];
      while (this.eatOp(',')) list.push(this.expr());
      this.expectOp(')');
      return { op: 'in', l, list, neg };
      }
      if (this.eatKw('between')) {
      const lo = this.add();
      this.expectKw('and');
      const hi = this.add();
      return { op: 'between', e: l, lo, hi, neg };
      }
      return l;
      }
      add() {
      let l = this.mul();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['+', '-', '||'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.mul() };
      } else return l;
      }
      }
      mul() {
      let l = this.unary();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['*', '/'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.unary() };
      } else return l;
      }
      }
      unary() {
      if (this.eatOp('-')) return { op: 'neg', e: this.unary() };
      return this.primary();
      }
      primary() {
      const t = this.peek();
      if (!t) this.fail('ожидалось значение');
      if (t.t === 'num') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'str') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'kw' && t.v === 'null') return this.i++, { op: 'lit', v: null };
      if (t.t === 'kw' && t.v === 'true') return this.i++, { op: 'lit', v: true };
      if (t.t === 'kw' && t.v === 'false') return this.i++, { op: 'lit', v: false };
      if (this.eatOp('(')) {
      const e = this.expr();
      this.expectOp(')');
      return e;
      }
      if (t.t === 'id' && this.isOp('(', 1)) {
      this.i += 2;
      const fn = t.v;
      if (!['count', 'sum', 'avg', 'min', 'max', 'lower', 'upper', 'length', 'coalesce'].includes(fn)) throw new SqlError(\`функция \${fn}() здесь не поддерживается\`);
      if (fn === 'count' && this.eatOp('*')) {
      this.expectOp(')');
      return { op: 'agg', fn, star: true };
      }
      const args = [this.expr()];
      while (this.eatOp(',')) args.push(this.expr());
      this.expectOp(')');
      return ['count', 'sum', 'avg', 'min', 'max'].includes(fn) ? { op: 'agg', fn, e: args[0] } : { op: 'fn', fn, args };
      }
      if (t.t === 'id' || (t.t === 'kw' && ['text', 'date', 'key', 'index'].includes(t.v))) {
      this.i++;
      if (this.isOp('.') && this.peek(1) && (this.peek(1).t === 'id' || this.peek(1).t === 'kw')) {
      this.i++;
      const c = this.peek();
      this.i++;
      return { op: 'col', table: t.v, name: c.v };
      }
      return { op: 'col', name: t.v };
      }
      this.fail('ожидалось значение или имя столбца');
      }
      }
      const text = (e) => {
      switch (e.op) {
      case 'col':
      return e.table ? \`\${e.table}.\${e.name}\` : e.name;
      case 'lit':
      return e.v === null ? 'NULL' : typeof e.v === 'string' ? \`'\${e.v}'\` : String(e.v);
      case 'agg':
      return \`\${e.fn}(\${e.star ? '*' : text(e.e)})\`;
      case 'fn':
      return \`\${e.fn}(\${e.args.map(text).join(', ')})\`;
      default:
      return e.op;
      }
      };
      const hasAgg = (e) => !!e && (e.op === 'agg' || [e.l, e.r, e.e, e.lo, e.hi].some(hasAgg) || (e.args || e.list || []).some(hasAgg));
      function createDb() {
      return { tables: {}, indexes: [], txn: null, aborted: false };
      }
      const clone = (x) => JSON.parse(JSON.stringify(x));
      const isNum = (v) => typeof v === 'number';
      function table(db, name) {
      const t = db.tables[name];
      if (!t) throw new SqlError(\`таблицы «\${name}» нет. Есть: \${Object.keys(db.tables).join(', ') || 'ни одной'}\`);
      return t;
      }
      function coerce(col, v) {
      if (v === null || v === undefined) return null;
      const ty = col.type;
      if (['integer', 'int', 'serial'].includes(ty)) {
      if (isNum(v) && Number.isInteger(v)) return v;
      if (typeof v === 'string' && /^-?\\d+$/.test(v.trim())) return Number(v);
      throw new SqlError(\`значение \${typeof v === 'string' ? \`«\${v}»\` : v} не подходит к типу integer (столбец \${col.name})\`);
      }
      if (['numeric', 'real'].includes(ty)) {
      if (isNum(v)) return v;
      if (typeof v === 'string' && v.trim() !== '' && !isNaN(Number(v))) return Number(v);
      throw new SqlError(\`значение «\${v}» не подходит к типу \${ty} (столбец \${col.name})\`);
      }
      if (ty === 'boolean') {
      if (typeof v === 'boolean') return v;
      throw new SqlError(\`значение «\${v}» не подходит к типу boolean (столбец \${col.name})\`);
      }
      return typeof v === 'string' ? v : String(v);
      }
      /* ---------- evaluation ---------- */
      function resolve(ctx, e) {
      const found = [];
      for (const c of ctx) {
      if (e.table && c.alias !== e.table) continue;
      if (c.cols.includes(e.name)) found.push(c);
      }
      if (!found.length) {
      const all = ctx.flatMap((c) => c.cols.map((n) => \`\${c.alias}.\${n}\`));
      throw new SqlError(\`столбца «\${e.table ? e.table + '.' : ''}\${e.name}» нет. Доступны: \${all.join(', ')}\`);
      }
      if (found.length > 1) throw new SqlError(\`столбец «\${e.name}» неоднозначен: он есть в таблицах \${found.map((f) => f.alias).join(' и ')}. Напишите \${found[0].alias}.\${e.name}\`);
      return found[0].row ? found[0].row[e.name] : null;
      }
      function cmpVals(a, b) {
      if (a === null || b === null) return null;
      if (typeof a === 'string' && typeof b === 'string') return a < b ? -1 : a > b ? 1 : 0;
      if (typeof a !== typeof b) throw new SqlError(\`нельзя сравнить \${typeof a === 'number' ? 'число' : 'текст'} и \${typeof b === 'number' ? 'число' : 'текст'}\`);
      return a < b ? -1 : a > b ? 1 : 0;
      }
      function like(s, p) {
      const re = new RegExp('^' + p.replace(/[.*+?^\${}()|[\\]\\\\]/g, '\\\\$&').replace(/%/g, '.*').replace(/_/g, '.') + '$', 'is');
      return re.test(s);
      }
      function ev(e, ctx, grp) {
      switch (e.op) {
      case 'lit':
      return e.v;
      case 'col':
      return resolve(ctx, e);
      case 'neg': {
      const v = ev(e.e, ctx, grp);
      return v === null ? null : -v;
      }
      case 'not': {
