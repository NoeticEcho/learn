<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/07-data/07-privacy-by-design.svx. This lesson is general information, not legal advice. */
	export const metadata = {
		id: '07-data/07-privacy-by-design',
		part: 7,
		order: 7,
		title: 'Privacy by design: what to store and where',
		definition: 'Privacy by design builds data protection into the schema in advance: minimal fields, each with a purpose and a retention period. GDPR Article 25 requires it.',
		summary:
			'You’ll build data protection into a database schema instead of bolting it on: collect the minimum, set retention periods, keep personal data apart and record consent as a fact. Afterwards you know the core of GDPR Article 25 and of the US state privacy laws, how Russia’s 152-FZ differs, and you can list which data of your project they touch.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'sheet',
					label: 'passport, birth date',
					caption: 'Booking form',
					say: [
						{ text: 'Why does a booking form ask for a passport number?' },
						{ who: 'Form', text: 'Just in case.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'lock',
					label: 'keep: 3 years',
					caption: 'Retention',
					say: 'What you never collect cannot leak. What you do collect is kept with the date it will be deleted.'
				},
				{
					mood: 'cheer',
					prop: 'certificate',
					label: 'text, version 2',
					caption: 'Consent',
					say: 'Consent is a record: when, to which text, and for what. A checkbox alone is not enough.'
				}
			]
		},
		minutes: 30,
		teaches: ['data-privacy-by-design', 'data-data-localisation'],
		requires: ['data-transaction', 'data-sql-write', 'server-authentication'],
		practice: {
			id: 'data-privacy-register',
			title: 'A data register, and consent as a record',
			task: 'The page has a data register table and a box for SQL. 1) For each of the four rows (name, phone, comment, the people shown on the site), fill in the seven cells: the purpose; where it is stored; the retention period and the condition for deleting (for example “3 years after the request, then deleted”); who has access; the lawful basis; and whether it is personal data (“yes” or “no”, with a note). 2) Name a field you decided not to collect although you were tempted (date of birth, a passport or Social Security number, an email address) and say why. 3) Say where the main record of your visitors’ data sits (which country or region), and what happens to copies or transfers to another country. 4) Say how personal data is kept apart from the rest (for example, a separate table of requests). 5) In the SQL box, create a consents table: a consent is stored with a date, the version of the text and a purpose, and it refers to a request. Every “…” has to be replaced. This is a teaching draft, not a legal document.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="register">
      <h2>The project’s data register<\/h2>
      <p>For each group of data: what it is, why you hold it, where it sits, how long it is kept and on what condition it is deleted, who has access, the lawful basis, and whether it is personal data.<\/p>
      <table>
        <tr><th>Data<\/th><th>Purpose<\/th><th>Where it is stored<\/th><th>Retention and deletion<\/th><th>Who has access<\/th><th>Lawful basis<\/th><th>Personal data?<\/th><\/tr>
        <tr class="field visitor"><td class="what">Visitor’s name from the request form<\/td><td class="why">…<\/td><td class="where">…<\/td><td class="keep">…<\/td><td class="access">…<\/td><td class="basis">…<\/td><td class="pd">…<\/td><\/tr>
        <tr class="field visitor"><td class="what">Visitor’s phone number<\/td><td class="why">…<\/td><td class="where">…<\/td><td class="keep">…<\/td><td class="access">…<\/td><td class="basis">…<\/td><td class="pd">…<\/td><\/tr>
        <tr class="field visitor"><td class="what">Comment on the request (free text)<\/td><td class="why">…<\/td><td class="where">…<\/td><td class="keep">…<\/td><td class="access">…<\/td><td class="basis">…<\/td><td class="pd">…<\/td><\/tr>
        <tr class="field people"><td class="what">Data of the people you show on the site (people)<\/td><td class="why">…<\/td><td class="where">…<\/td><td class="keep">…<\/td><td class="access">…<\/td><td class="basis">…<\/td><td class="pd">…<\/td><\/tr>
      <\/table>
      <p>A field I decided not to collect although I was tempted, and why: <span id="removed">…<\/span><\/p>
      <p>Where the main record of visitors’ data sits, and what happens to copies or transfers to another country: <span id="localisation">…<\/span><\/p>
      <p>How personal data is kept apart from the rest in the schema: <span id="separate">…<\/span><\/p>

      <h3>Consent as a record in the database<\/h3>
      <textarea aria-label="Consent as a record in the database" id="q-consent" rows="9">CREATE TABLE consents (
  id serial PRIMARY KEY,
  …
);<\/textarea>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
