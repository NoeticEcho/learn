`
			},
			checks: [
				{ id: 'register-exists', kind: 'exists', selector: '#register' },
				{ id: 'no-blanks', kind: 'text', selector: '#register', matches: '^[^…]*$' },
				{ id: 'rows', kind: 'count', selector: '#register tr.field', min: 4 },
				{ id: 'purpose', kind: 'text', selector: '#register td.why', matches: '[Tt]o |[Ff]or |[Ss]o |[Cc]ontact|[Rr]eply|[Aa]nswer|[Bb]ook|[Ss]how|[Uu]nderstand' },
				{ id: 'term-numbers', kind: 'text', selector: '#register td.keep', matches: '\\d+\\s*(?:day|week|month|year)|[Uu]ntil|[Ww]hile|[Aa]s long as' },
				{ id: 'delete-condition', kind: 'text', selector: '#register td.keep', matches: '[Dd]elet|[Aa]nonymi[sz]|[Ee]rase|[Rr]emov|[Dd]estroy|[Pp]urge|[Ww]ipe' },
				{ id: 'access-named', kind: 'text', selector: '#register td.access', matches: '[Oo]wner|[Aa]dmin|[Ss]erver|[Oo]nly|[Aa]ccountant|[Ee]ditor|[Ss]taff|\\bI\\b' },
				{ id: 'pd-marked', kind: 'text', selector: '#register td.pd', matches: '^\\s*[Yy]es' },
				{
					id: 'removed-field',
					kind: 'text',
					selector: '#removed',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:[Nn]ot need|[Uu]nnecessar|[Ee]xtra|[Nn]ot collect|[Dd]id not|[Dd]idn[’\']t|[Ww]ithout|[Nn]o need|[Dd]on[’\']t need|[Dd]on[’\']t collect))'
				},
				{
					id: 'localisation',
					kind: 'text',
					selector: '#localisation',
					matches: '(?=[\\s\\S]*(?:\\bEU\\b|EEA|Europe|\\bUK\\b|\\bUS\\b|U\\.S\\.|[Uu]nited|[Cc]ountr|[Rr]egion|Russia|[Aa]broad|[Oo]utside|[Oo]verseas|[Tt]ransfer|[Cc]lauses|[Aa]dequacy))(?=[\\s\\S]*(?:[Ss]erver|[Dd]atabase|[Hh]ost|[Cc]loud|[Dd]ata cent|[Ss]tored|[Tt]able))'
				},
				{
					id: 'separation',
					kind: 'text',
					selector: '#separate',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:[Ss]eparate|[Tt]able|requests|[Rr]equest|[Aa]nonym|[Nn]umber|[Pp]seudonym))'
				},
				{
					id: 'consent-table',
					kind: 'text',
					selector: '#q-consent',
					matches: '[Cc][Rr][Ee][Aa][Tt][Ee]\\s+[Tt][Aa][Bb][Ll][Ee]\\s+[Cc][Oo][Nn][Ss][Ee][Nn][Tt][Ss]'
				},
				{
					id: 'consent-date',
					kind: 'text',
					selector: '#q-consent',
					matches: '(?:given_at|accepted_at|created_at|consent_date|[Tt][Ii][Mm][Ee][Ss][Tt][Aa][Mm][Pp]|[Dd][Aa][Tt][Ee])'
				},
				{ id: 'consent-version', kind: 'text', selector: '#q-consent', matches: 'version' },
				{ id: 'consent-purpose', kind: 'text', selector: '#q-consent', matches: 'purpose' },
				{ id: 'consent-link', kind: 'text', selector: '#q-consent', matches: '[Rr][Ee][Ff][Ee][Rr][Ee][Nn][Cc][Ee][Ss]\\s+\\w+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'A booking form for consultations asks for a name, a phone number, a date of birth and a passport number. What goes, by the rule of minimum?',
				options: [
					'The date of birth and the passport number: a booking does not need them',
					'The phone number: it is personal data',
					'Nothing: the more data, the better'
				],
				answer: 0,
