      for (const cols of uniq) {
      const dup = t.rows.some((r) => r !== skipPk && cols.every((c) => r[c] === row[c]));
      if (dup) throw new SqlError(\`unique constraint violated: a row with \${cols.map((c) => \`\${c} = \${row[c]}\`).join(', ')} already exists in table “\${t.name}”\`);
