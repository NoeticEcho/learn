      // A practice table of 2000 rows. The names come from your brief, the rest is made up.
      const names = [{{#each items}}'{{title}}', {{/each}}].map(unesc);
      function afterSetup(db) {
        const rows = [];
        for (let i = 1; i <= 2000; i++) rows.push({ title: (names.length ? names[i % names.length] : 'Item') + ' #' + i, category_id: ((i * 7) % 20) + 1, day: ((i * 13) % 365) + 1 });
        load(db, 'items', rows);
      }

      function draw(box, r) {
        box.replaceChildren();
        for (const res of r.results) {
          const p = document.createElement('p');
          if (res.kind === 'select') {
            const t = document.createElement('table');
            const head = t.insertRow();
            for (const c of res.columns) head.appendChild(Object.assign(document.createElement('th'), { textContent: c }));
            for (const row of res.rows) {
              const tr = t.insertRow();
              for (const v of row) tr.insertCell().textContent = show(v);
            }
            box.appendChild(t);
            p.textContent = 'Rows: ' + res.rows.length + '. Read from tables: ' + res.scanned + '.';
          } else if (res.kind === 'plan') {
            p.textContent = 'Plan (a simplified model): ' + res.lines.join('; ');
          } else p.textContent = res.message;
          box.appendChild(p);
        }
        if (r.error) {
          const e = document.createElement('p');
          e.className = 'err';
          e.textContent = 'Error: ' + r.error.message;
          box.appendChild(e);
        }
      }

      function runAll() {
        const db = createDb();
        const base = run(db, "CREATE TABLE items (id serial PRIMARY KEY, title text NOT NULL, category_id integer, day integer);\\nCREATE TABLE requests (id serial PRIMARY KEY, name text NOT NULL, phone text NOT NULL, item_id integer REFERENCES items(id));\\nCREATE TABLE notifications (id serial PRIMARY KEY, request_id integer REFERENCES requests(id), text text NOT NULL);");
        if (base.error) console.error(base.error.message);
        afterSetup(db);
        for (const area of document.querySelectorAll('#sql-work textarea.sql')) {
          const box = document.getElementById(area.id + '-out');
          const r = run(db, area.value);
          if (box) draw(box, r);
        }
      }
      for (const area of document.querySelectorAll('#sql-work textarea.sql')) area.addEventListener('input', runAll);
      runAll();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (blocks with data-scaffold). It is not part of your site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="sql-work">
      <h2>An index and a transaction on your table<\/h2>
      <p>Three tables are already created. Write the queries right in the boxes; the result appears under each one (this is a practice sandbox, not real PostgreSQL). The boxes run in order, top to bottom.<\/p>
      <pre>items(id, title, category_id, day)  -- 2000 rows, category_id from 1 to 20, day from 1 to 365
requests(id, name, phone, item_id)  -- enquiries: item_id points to the service
notifications(id, request_id, text) -- notifications: request_id points to the enquiry<\/pre>

      <h3>1. Ask for the query plan before the index<\/h3>
      <textarea aria-label="1. Ask for the query plan before the index" class="sql" id="q-before" rows="3">EXPLAIN SELECT * FROM items WHERE category_id = 7 ORDER BY day DESC LIMIT 10;<\/textarea>
      <div class="out" id="q-before-out"><\/div>

      <h3>2. Create an index and ask for the plan again<\/h3>
      <textarea aria-label="2. Create an index and ask for the plan again" class="sql" id="q-index" rows="4">CREATE INDEX items_category_idx ON items (category_id);
EXPLAIN SELECT * FROM items WHERE category_id = 7 ORDER BY day DESC LIMIT 10;<\/textarea>
      <div class="out" id="q-index-out"><\/div>
      <p>Rows read before the index: <span id="rows-before">2000<\/span>, after: <span id="rows-after">100<\/span><\/p>

      <h3>3. An enquiry and a notification in one transaction<\/h3>
      <textarea aria-label="3. An enquiry and a notification in one transaction" class="sql" id="q-tx-ok" rows="7">BEGIN;
INSERT INTO requests (name, phone, item_id) VALUES ('Test visitor', '+1 000 000 0000', 1);
INSERT INTO notifications (request_id, text) VALUES (1, 'New enquiry');
COMMIT;
SELECT COUNT(*) FROM requests;<\/textarea>
      <div class="out" id="q-tx-ok-out"><\/div>

      <h3>4. A crash in the middle of a transaction: the second step fails, and we don’t write COMMIT<\/h3>
      <textarea aria-label="4. A crash in the middle of a transaction: the second step fails, and we don’t write COMMIT" class="sql" id="q-tx-fail" rows="6">BEGIN;
INSERT INTO requests (name, phone, item_id) VALUES ('Second visitor', '+1 000 000 0001', 1);
INSERT INTO notifications (request_id, text) VALUES (2, NULL);<\/textarea>
      <div class="out" id="q-tx-fail-out"><\/div>

      <h3>5. Roll back and check that nothing is left of the failed enquiry<\/h3>
      <textarea aria-label="5. Roll back and check that nothing is left of the failed enquiry" class="sql" id="q-tx-after" rows="3">ROLLBACK;
SELECT COUNT(*) FROM requests;<\/textarea>
      <div class="out" id="q-tx-after-out"><\/div>

      <p>The price a write pays for every extra index: <span id="index-cost">every index has to be updated on every write, so inserts and updates get slower, and the index takes up space on disk<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="sql-runner">
      // Teaching SQL (not real PostgreSQL): the queries in the boxes above run here, in the page’s memory.
      // You don’t need to read this block. It is not part of your site.
      class SqlError extends Error {}
      const KEYWORDS = new Set(
      'select from where group by having order limit offset asc desc distinct as join inner left right outer on and or not null is in like between true false insert into values update set delete create table index unique primary key references default begin commit rollback explain integer int serial text varchar numeric boolean date timestamp real if exists'.split(
      ' '
      )
      );
      function tokenize(src) {
      const out = [];
      const re = /\\s+|--[^\\n]*|('(?:[^']|'')*')|("(?:[^"]*)")|(\\d+(?:\\.\\d+)?)|([A-Za-z_\\u0400-\\u04FF][A-Za-z0-9_\\u0400-\\u04FF]*)|(<=|>=|<>|!=|\\|\\||[(),.*+\\-\\/=<>;])/gy;
      let pos = 0;
      while (pos < src.length) {
      re.lastIndex = pos;
      const m = re.exec(src);
      if (!m) throw new SqlError(\`syntax error: unexpected character “\${src[pos]}”\`);
      pos = re.lastIndex;
      if (m[1] !== undefined) out.push({ t: 'str', v: m[1].slice(1, -1).replace(/''/g, "'") });
      else if (m[2] !== undefined) out.push({ t: 'id', v: m[2].slice(1, -1).toLowerCase(), quoted: true });
      else if (m[3] !== undefined) out.push({ t: 'num', v: Number(m[3]) });
      else if (m[4] !== undefined) {
      const low = m[4].toLowerCase();
      out.push(KEYWORDS.has(low) ? { t: 'kw', v: low, raw: m[4] } : { t: 'id', v: low });
      } else if (m[5] !== undefined) out.push({ t: 'op', v: m[5] });
      }
      return out;
      }
      /** The text of a script, split into statements by “;” outside quotes. */
      function splitStatements(sql) {
      const parts = [];
      let cur = '';
      let q = false;
      for (let i = 0; i < sql.length; i++) {
      const c = sql[i];
      if (c === "'") q = !q;
      if (c === ';' && !q) {
      parts.push(cur);
      cur = '';
      } else cur += c;
      }
      parts.push(cur);
      return parts.map((s) => s.replace(/--[^\\n]*/g, '').trim()).filter(Boolean);
      }
      class Parser {
      constructor(tokens) {
      this.k = tokens;
      this.i = 0;
      }
      peek(o = 0) {
      return this.k[this.i + o];
      }
      isKw(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'kw' && t.v === v;
      }
      isOp(v, o = 0) {
      const t = this.peek(o);
      return !!t && t.t === 'op' && t.v === v;
      }
      eatKw(v) {
      if (this.isKw(v)) return this.i++, true;
      return false;
      }
      eatOp(v) {
      if (this.isOp(v)) return this.i++, true;
      return false;
      }
      expectKw(v) {
      if (!this.eatKw(v)) this.fail(\`expected the word \${v.toUpperCase()}\`);
      }
      expectOp(v) {
      if (!this.eatOp(v)) this.fail(\`expected the symbol “\${v}”\`);
      }
      fail(msg) {
      const t = this.peek();
      const near = t ? \` near “\${t.t === 'str' ? "'" + t.v + "'" : (t.raw ?? t.v)}”\` : ' at the end of the query';
      throw new SqlError(\`syntax error\${near}: \${msg}\`);
      }
      name() {
      const t = this.peek();
      if (t && (t.t === 'id' || (t.t === 'kw' && ['key', 'text', 'date', 'index'].includes(t.v)))) return this.i++, t.v;
      this.fail('expected a name');
      }
      done() {
      return this.i >= this.k.length;
      }
      /* expressions */
      expr() {
      return this.or();
      }
      or() {
      let l = this.and();
      while (this.eatKw('or')) l = { op: 'or', l, r: this.and() };
      return l;
      }
      and() {
      let l = this.not();
      while (this.eatKw('and')) l = { op: 'and', l, r: this.not() };
      return l;
      }
      not() {
      if (this.eatKw('not')) return { op: 'not', e: this.not() };
      return this.cmp();
      }
      cmp() {
      const l = this.add();
      const t = this.peek();
      if (t && t.t === 'op' && ['=', '<>', '!=', '<', '>', '<=', '>='].includes(t.v)) {
      this.i++;
      return { op: t.v === '!=' ? '<>' : t.v, l, r: this.add() };
      }
      if (this.isKw('is')) {
      this.i++;
      const neg = this.eatKw('not');
      this.expectKw('null');
      return { op: 'isnull', e: l, neg };
      }
      const neg = this.isKw('not') && (this.isKw('like', 1) || this.isKw('in', 1) || this.isKw('between', 1));
      if (neg) this.i++;
      if (this.eatKw('like')) return { op: 'like', l, r: this.add(), neg };
      if (this.eatKw('in')) {
      this.expectOp('(');
      const list = [this.expr()];
      while (this.eatOp(',')) list.push(this.expr());
      this.expectOp(')');
      return { op: 'in', l, list, neg };
      }
      if (this.eatKw('between')) {
      const lo = this.add();
      this.expectKw('and');
      const hi = this.add();
      return { op: 'between', e: l, lo, hi, neg };
      }
      return l;
      }
      add() {
      let l = this.mul();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['+', '-', '||'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.mul() };
      } else return l;
      }
      }
      mul() {
      let l = this.unary();
      for (;;) {
      const t = this.peek();
      if (t && t.t === 'op' && ['*', '/'].includes(t.v)) {
      this.i++;
      l = { op: t.v, l, r: this.unary() };
      } else return l;
      }
      }
      unary() {
      if (this.eatOp('-')) return { op: 'neg', e: this.unary() };
      return this.primary();
      }
      primary() {
      const t = this.peek();
      if (!t) this.fail('expected a value');
      if (t.t === 'num') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'str') return this.i++, { op: 'lit', v: t.v };
      if (t.t === 'kw' && t.v === 'null') return this.i++, { op: 'lit', v: null };
      if (t.t === 'kw' && t.v === 'true') return this.i++, { op: 'lit', v: true };
      if (t.t === 'kw' && t.v === 'false') return this.i++, { op: 'lit', v: false };
      if (this.eatOp('(')) {
      const e = this.expr();
      this.expectOp(')');
      return e;
      }
      if (t.t === 'id' && this.isOp('(', 1)) {
      this.i += 2;
      const fn = t.v;
      if (!['count', 'sum', 'avg', 'min', 'max', 'lower', 'upper', 'length', 'coalesce'].includes(fn)) throw new SqlError(\`the function \${fn}() is not supported here\`);
      if (fn === 'count' && this.eatOp('*')) {
      this.expectOp(')');
      return { op: 'agg', fn, star: true };
      }
      const args = [this.expr()];
      while (this.eatOp(',')) args.push(this.expr());
      this.expectOp(')');
      return ['count', 'sum', 'avg', 'min', 'max'].includes(fn) ? { op: 'agg', fn, e: args[0] } : { op: 'fn', fn, args };
      }
      if (t.t === 'id' || (t.t === 'kw' && ['text', 'date', 'key', 'index'].includes(t.v))) {
      this.i++;
      if (this.isOp('.') && this.peek(1) && (this.peek(1).t === 'id' || this.peek(1).t === 'kw')) {
      this.i++;
      const c = this.peek();
      this.i++;
      return { op: 'col', table: t.v, name: c.v };
      }
      return { op: 'col', name: t.v };
      }
      this.fail('expected a value or a column name');
      }
      }
      const text = (e) => {
      switch (e.op) {
      case 'col':
      return e.table ? \`\${e.table}.\${e.name}\` : e.name;
      case 'lit':
      return e.v === null ? 'NULL' : typeof e.v === 'string' ? \`'\${e.v}'\` : String(e.v);
      case 'agg':
      return \`\${e.fn}(\${e.star ? '*' : text(e.e)})\`;
      case 'fn':
      return \`\${e.fn}(\${e.args.map(text).join(', ')})\`;
      default:
      return e.op;
      }
      };
      const hasAgg = (e) => !!e && (e.op === 'agg' || [e.l, e.r, e.e, e.lo, e.hi].some(hasAgg) || (e.args || e.list || []).some(hasAgg));
      function createDb() {
      return { tables: {}, indexes: [], txn: null, aborted: false };
      }
      const clone = (x) => JSON.parse(JSON.stringify(x));
      const isNum = (v) => typeof v === 'number';
      function table(db, name) {
      const t = db.tables[name];
      if (!t) throw new SqlError(\`table “\${name}” does not exist. Tables: \${Object.keys(db.tables).join(', ') || 'none'}\`);
      return t;
      }
      function coerce(col, v) {
      if (v === null || v === undefined) return null;
      const ty = col.type;
      if (['integer', 'int', 'serial'].includes(ty)) {
      if (isNum(v) && Number.isInteger(v)) return v;
      if (typeof v === 'string' && /^-?\\d+$/.test(v.trim())) return Number(v);
      throw new SqlError(\`the value \${typeof v === 'string' ? \`“\${v}”\` : v} does not fit the type integer (column \${col.name})\`);
      }
      if (['numeric', 'real'].includes(ty)) {
      if (isNum(v)) return v;
      if (typeof v === 'string' && v.trim() !== '' && !isNaN(Number(v))) return Number(v);
      throw new SqlError(\`the value “\${v}” does not fit the type \${ty} (column \${col.name})\`);
      }
      if (ty === 'boolean') {
      if (typeof v === 'boolean') return v;
      throw new SqlError(\`the value “\${v}” does not fit the type boolean (column \${col.name})\`);
      }
      return typeof v === 'string' ? v : String(v);
      }
      /* ---------- evaluation ---------- */
      function resolve(ctx, e) {
      const found = [];
      for (const c of ctx) {
      if (e.table && c.alias !== e.table) continue;
      if (c.cols.includes(e.name)) found.push(c);
      }
      if (!found.length) {
      const all = ctx.flatMap((c) => c.cols.map((n) => \`\${c.alias}.\${n}\`));
      throw new SqlError(\`column “\${e.table ? e.table + '.' : ''}\${e.name}” does not exist. Available: \${all.join(', ')}\`);
      }
      if (found.length > 1) throw new SqlError(\`column “\${e.name}” is ambiguous: it exists in tables \${found.map((f) => f.alias).join(' and ')}. Write \${found[0].alias}.\${e.name}\`);
      return found[0].row ? found[0].row[e.name] : null;
      }
      function cmpVals(a, b) {
      if (a === null || b === null) return null;
      if (typeof a === 'string' && typeof b === 'string') return a < b ? -1 : a > b ? 1 : 0;
      if (typeof a !== typeof b) throw new SqlError(\`cannot compare \${typeof a === 'number' ? 'a number' : 'text'} with \${typeof b === 'number' ? 'a number' : 'text'}\`);
      return a < b ? -1 : a > b ? 1 : 0;
      }
      function like(s, p) {
      const re = new RegExp('^' + p.replace(/[.*+?^\${}()|[\\]\\\\]/g, '\\\\$&').replace(/%/g, '.*').replace(/_/g, '.') + '$', 'is');
      return re.test(s);
      }
      function ev(e, ctx, grp) {
      switch (e.op) {
      case 'lit':
      return e.v;
      case 'col':
      return resolve(ctx, e);
      case 'neg': {
      const v = ev(e.e, ctx, grp);
      return v === null ? null : -v;
      }
      case 'not': {
      const v = ev(e.e, ctx, grp);
      return v === null ? null : !v;
      }
      case 'and': {
      const l = ev(e.l, ctx, grp);
      if (l === false) return false;
      const r = ev(e.r, ctx, grp);
      if (r === false) return false;
      return l === null || r === null ? null : true;
      }
      case 'or': {
      const l = ev(e.l, ctx, grp);
      if (l === true) return true;
      const r = ev(e.r, ctx, grp);
      if (r === true) return true;
      return l === null || r === null ? null : false;
      }
      case '=':
      case '<>':
      case '<':
      case '>':
      case '<=':
      case '>=': {
      const c = cmpVals(ev(e.l, ctx, grp), ev(e.r, ctx, grp));
      if (c === null) return null;
      return { '=': c === 0, '<>': c !== 0, '<': c < 0, '>': c > 0, '<=': c <= 0, '>=': c >= 0 }[e.op];
      }
      case 'isnull': {
      const v = ev(e.e, ctx, grp);
      return e.neg ? v !== null : v === null;
      }
      case 'like': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      if (l === null || r === null) return null;
      const m = like(String(l), String(r));
      return e.neg ? !m : m;
      }
      case 'in': {
      const l = ev(e.l, ctx, grp);
      if (l === null) return null;
      const m = e.list.some((x) => cmpVals(l, ev(x, ctx, grp)) === 0);
      return e.neg ? !m : m;
      }
      case 'between': {
      const v = ev(e.e, ctx, grp);
      const lo = cmpVals(v, ev(e.lo, ctx, grp)),
      hi = cmpVals(v, ev(e.hi, ctx, grp));
      if (lo === null || hi === null) return null;
      const m = lo >= 0 && hi <= 0;
      return e.neg ? !m : m;
      }
      case '+':
      case '-':
      case '*':
      case '/': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      if (l === null || r === null) return null;
      if (!isNum(l) || !isNum(r)) throw new SqlError(\`arithmetic (\${e.op}) works on numbers, and this is text\`);
      if (e.op === '/' && r === 0) throw new SqlError('division by zero');
      return e.op === '+' ? l + r : e.op === '-' ? l - r : e.op === '*' ? l * r : l / r;
      }
      case '||': {
      const l = ev(e.l, ctx, grp),
      r = ev(e.r, ctx, grp);
      return l === null || r === null ? null : String(l) + String(r);
      }
      case 'fn': {
      const a = e.args.map((x) => ev(x, ctx, grp));
