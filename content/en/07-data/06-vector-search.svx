  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling of the exercise (the data-scaffold blocks). It does not reach the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="search-work">
      <h2>Search your services<\/h2>
      <p>The demo below searches your services and understands word forms. Type, for example, a word from a title in another form: the stem is the same, so the result is the same.<\/p>
      <p><label for="fts-q">Query<\/label> <input id="fts-q" type="search" value="{{services.0}}" autocomplete="off"><\/p>
      <ol id="fts-results"><\/ol>

      <h3>Three forms of one word from your services, and their stem<\/h3>
      <table id="lemma">
        <tr><th>Form of the word<\/th><th>Stem<\/th><\/tr>
        <tr class="form"><td class="word">survey<\/td><td class="stem">survey<\/td><\/tr>
        <tr class="form"><td class="word">surveys<\/td><td class="stem">survey<\/td><\/tr>
        <tr class="form"><td class="word">surveyed<\/td><td class="stem">survey<\/td><\/tr>
      <\/table>

      <h3>A PostgreSQL query: find and order by relevance<\/h3>
      <p>The table is items(id, title, text). Use the English configuration. Here the query is only checked as text; the real PostgreSQL in a browser is at pglite.dev.<\/p>
      <textarea aria-label="The q-fts field" id="q-fts" rows="8">SELECT title,
       ts_rank(to_tsvector('english', title || ' ' || text), plainto_tsquery('english', 'survey')) AS rank
FROM items
WHERE to_tsvector('english', title || ' ' || text) @@ plainto_tsquery('english', 'survey')
ORDER BY rank DESC;<\/textarea>

      <h3>An index for this search<\/h3>
      <textarea aria-label="An index for this search" id="q-gin" rows="3">CREATE INDEX items_fts_idx ON items USING GIN (to_tsvector('english', title || ' ' || text));<\/textarea>

      <p>When word search is enough for me: <span id="enough">when there are dozens of services, visitors type words from the titles, and I need word forms and ranking: then search inside PostgreSQL is enough<\/span><\/p>
      <p>When I would need search by meaning, and which texts would go into it: <span id="vector-when">if visitors ask questions in their own words and the words differ from the text (synonyms), I would need search by meaning, and the service texts and the answers to frequent questions would go into it<\/span><\/p>
      <p>Which texts would go to an outside service, and whether I would need a legal basis or consent: <span id="vector-send">the texts of services and questions would go to a third-party service for embeddings; without personal data no consent is needed, but with it I would need a lawful basis and a processor contract, or a local model on my own server<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fts-demo">
      // A search demo (a simplified model, not PostgreSQL): your services from the brief, with English endings cut off.
      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
      const own = [{{#each items}}{ title: '{{title}}', text: '{{text}}' }, {{/each}}].map((d) => ({ title: unesc(d.title), text: unesc(d.text) }));
      const docs = own.length ? own : [{ title: 'First service', text: 'A description of the service.' }, { title: 'Second service', text: 'Another service and its price.' }];
      const STOP = new Set('a an and the of to in on at for from by with is are was be do you your it or but not as how what'.split(' '));
      const ENDINGS = 'ingly edly ings ing ies ied ers er ed es ly s'.split(' ').sort((a, b) => b.length - a.length);
      const stem = (w) => { for (const e of ENDINGS) if (w.length - e.length >= 3 && w.endsWith(e) && !(e === 's' && w.endsWith('ss'))) { w = w.slice(0, -e.length) + (e === 'ies' || e === 'ied' ? 'y' : ''); break; } return w.replace(/y$/, 'i').replace(/e$/, ''); };
      const tokens = (s) => (s.toLowerCase().match(/[a-z0-9]+/g) || []).filter((t) => !STOP.has(t)).map(stem);
      const input = document.getElementById('fts-q');
      const list = document.getElementById('fts-results');
      function draw() {
        const q = tokens(input.value);
        const rows = docs.map((d, i) => ({ d, i, s: q.reduce((n, w) => n + 2 * tokens(d.title).filter((x) => x === w).length + tokens(d.text).filter((x) => x === w).length, 0) }))
          .filter((r) => r.s > 0).sort((a, b) => b.s - a.s || a.i - b.i);
        list.replaceChildren(...(rows.length ? rows.map((r) => Object.assign(document.createElement('li'), { textContent: r.d.title + ' (score ' + r.s + ')' })) : [Object.assign(document.createElement('li'), { textContent: 'Nothing found' })]));
      }
      input.addEventListener('input', draw);
      draw();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
