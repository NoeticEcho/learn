<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/07-data/06-vector-search.svx. */
	export const metadata = {
		id: '07-data/06-vector-search',
		part: 7,
		order: 6,
		title: 'Search: full-text and vector',
		definition: 'Full-text search finds texts by their words, via an inverted index and stems. Vector search finds them by meaning, via embeddings and nearest neighbors.',
		summary:
			'You’ll see how a site searches by words and by meaning: tokens, an index, ranking, embeddings and nearest neighbors. Afterwards you can choose between search inside Postgres, a separate engine and a vector database, and you know how AI answers use your texts.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'editor',
					label: 'LIKE %boundary%',
					caption: 'Brute-force search',
					say: [
						{ text: 'Searching for “boundary”.' },
						{ who: 'LIKE', text: '“Boundaries”? Different letters. Found nothing.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'cards',
					label: 'boundar → 1, 3, 7',
					caption: 'The index',
					say: 'Words are cut down to a stem, and an index records which texts contain each stem.'
				},
				{
					mood: 'cheer',
					prop: 'network',
					label: 'close in meaning',
					caption: 'Embedding',
					say: [
						{ text: 'How much is it?' },
						{ who: 'Search', text: 'No words in common, but “Prices and billing” sits close in meaning.' }
					]
				}
			]
		},
		minutes: 30,
		teaches: ['data-full-text-search', 'data-vector-db'],
		requires: ['data-index', 'data-choose-database'],
		practice: {
			id: 'data-search-items',
			title: 'Search your services: words, stems, a query',
			task: 'The page has a working search demo over your services. 1) Try a query in different forms of a word. 2) In the table, write three forms of one word from your services and their stem (the stem is shared). 3) In the query box, write a PostgreSQL query that selects services with the English text search configuration: to_tsvector and plainto_tsquery, both with the english configuration, joined by the @@ operator, then ts_rank and ORDER BY … DESC. 4) In the index box, create a GIN index on to_tsvector. 5) Answer in three phrases: when word search is enough for you; when you would need search by meaning and which texts would go into it; which texts would go to an outside service, and whether you would need a legal basis or consent. Every “…” has to be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="search-work">
      <h2>Search your services<\/h2>
      <p>The demo below searches your services and understands word forms. Type, for example, a word from a title in another form: the stem is the same, so the result is the same.<\/p>
      <p><label for="fts-q">Query<\/label> <input id="fts-q" type="search" value="{{services.0}}" autocomplete="off"><\/p>
      <ol id="fts-results"><\/ol>

      <h3>Three forms of one word from your services, and their stem<\/h3>
      <table id="lemma">
        <tr><th>Form of the word<\/th><th>Stem<\/th><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
        <tr class="form"><td class="word">…<\/td><td class="stem">…<\/td><\/tr>
      <\/table>

      <h3>A PostgreSQL query: find and order by relevance<\/h3>
      <p>The table is items(id, title, text). Use the English configuration. Here the query is only checked as text; the real PostgreSQL in a browser is at pglite.dev.<\/p>
      <textarea aria-label="The q-fts field" id="q-fts" rows="8">SELECT …
FROM items
WHERE …
ORDER BY …;<\/textarea>

      <h3>An index for this search<\/h3>
      <textarea aria-label="An index for this search" id="q-gin" rows="3">CREATE INDEX …<\/textarea>

      <p>When word search is enough for me: <span id="enough">…<\/span><\/p>
      <p>When I would need search by meaning, and which texts would go into it: <span id="vector-when">…<\/span><\/p>
      <p>Which texts would go to an outside service, and whether I would need a legal basis or consent: <span id="vector-send">…<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fts-demo">
      // A search demo (a simplified model, not PostgreSQL): your services from the brief, with English endings cut off.
      const unesc = (s) => String(s).replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
      const own = [{{#each items}}{ title: '{{title}}', text: '{{text}}' }, {{/each}}].map((d) => ({ title: unesc(d.title), text: unesc(d.text) }));
      const docs = own.length ? own : [{ title: 'First service', text: 'A description of the service.' }, { title: 'Second service', text: 'Another service and its price.' }];
      const STOP = new Set('a an and the of to in on at for from by with is are was be do you your it or but not as how what'.split(' '));
      const ENDINGS = 'ingly edly ings ing ies ied ers er ed es ly s'.split(' ').sort((a, b) => b.length - a.length);
      const stem = (w) => { for (const e of ENDINGS) if (w.length - e.length >= 3 && w.endsWith(e) && !(e === 's' && w.endsWith('ss'))) { w = w.slice(0, -e.length) + (e === 'ies' || e === 'ied' ? 'y' : ''); break; } return w.replace(/y$/, 'i').replace(/e$/, ''); };
      const tokens = (s) => (s.toLowerCase().match(/[a-z0-9]+/g) || []).filter((t) => !STOP.has(t)).map(stem);
      const input = document.getElementById('fts-q');
      const list = document.getElementById('fts-results');
      function draw() {
        const q = tokens(input.value);
        const rows = docs.map((d, i) => ({ d, i, s: q.reduce((n, w) => n + 2 * tokens(d.title).filter((x) => x === w).length + tokens(d.text).filter((x) => x === w).length, 0) }))
          .filter((r) => r.s > 0).sort((a, b) => b.s - a.s || a.i - b.i);
        list.replaceChildren(...(rows.length ? rows.map((r) => Object.assign(document.createElement('li'), { textContent: r.d.title + ' (score ' + r.s + ')' })) : [Object.assign(document.createElement('li'), { textContent: 'Nothing found' })]));
      }
      input.addEventListener('input', draw);
      draw();
    <\/script>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
