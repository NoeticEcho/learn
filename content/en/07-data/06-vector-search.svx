  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			checks: [
				{ id: 'search-exists', kind: 'exists', selector: '#search-work' },
				{ id: 'no-blanks', kind: 'text', selector: '#search-work', matches: '^[^…]*$' },
				{ id: 'forms', kind: 'count', selector: '#lemma tr.form', min: 3 },
				{ id: 'fts-vector', kind: 'text', selector: '#q-fts', matches: '[Tt][Oo]_[Tt][Ss][Vv][Ee][Cc][Tt][Oo][Rr]\\(\\s*\'english\'' },
				{
					id: 'fts-match',
					kind: 'text',
					selector: '#q-fts',
					matches: '@@\\s*(?:[Pp][Ll][Aa][Ii][Nn][Tt][Oo]_[Tt][Ss][Qq][Uu][Ee][Rr][Yy]|[Ww][Ee][Bb][Ss][Ee][Aa][Rr][Cc][Hh]_[Tt][Oo]_[Tt][Ss][Qq][Uu][Ee][Rr][Yy]|[Tt][Oo]_[Tt][Ss][Qq][Uu][Ee][Rr][Yy])\\(\\s*\'english\''
				},
				{ id: 'fts-rank', kind: 'text', selector: '#q-fts', matches: '[Tt][Ss]_[Rr][Aa][Nn][Kk]' },
				{ id: 'fts-order', kind: 'text', selector: '#q-fts', matches: '[Oo][Rr][Dd][Ee][Rr]\\s+[Bb][Yy][\\s\\S]*[Dd][Ee][Ss][Cc]' },
				{
					id: 'gin-index',
					kind: 'text',
