<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/07-data/03-joins-normalization.svx. */
	export const metadata = {
		id: '07-data/03-joins-normalization',
		part: 7,
		order: 3,
		title: 'Links between tables: JOIN and normalization',
		definition: 'Normalization is spreading data across tables so that each fact is stored once. A JOIN rebuilds the whole by gluing rows whose keys match.',
		summary: 'You’ll spread data across tables so that every fact is stored once, and put it back together with joins. Afterwards you can read a query with a JOIN, you know how INNER differs from LEFT, and you know where normalization is broken on purpose.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'sheet',
					label: 'one table',
					caption: 'A price in three rows',
					say: 'The price changed. Fix one, fix two… forgot the third. Now the database holds two prices.'
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'cards',
					label: 'key → row',
					caption: 'Once',
					say: 'Every fact is stored once, and every other place points to it by key.'
				},
				{
					mood: 'cheer',
					prop: 'network',
					label: 'LEFT JOIN',
					caption: 'No match',
					say: [
						{ text: 'Where are the services without a category?' },
						{ who: 'LEFT JOIN', text: 'Right here. They have NULL on the right.' }
					]
				}
			]
		},
		minutes: 30,
		teaches: ['data-sql-join', 'data-normalization'],
		requires: ['data-sql-select'],
		practice: {
			id: 'data-sql-joins',
			title: 'Categories, people and joins',
			task: 'The page has four boxes for SQL and one line for an answer. 1) In the first box, finish the tables: give the name column of people a type, and add the columns category_id and person_id to items, each pointing to its own table with REFERENCES. There must be no column in items that holds the category’s name as text: the name lives only in categories. 2) In the second box, add your own services (and the people from your brief); one service must be left without a category (NULL). 3) Write a query with two JOINs: the service, the name of its category and the name of the person in charge. 4) Write a query with a LEFT JOIN that finds the services without a category. 5) On the last line, say where in your project the data is duplicated on purpose, and why. Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
