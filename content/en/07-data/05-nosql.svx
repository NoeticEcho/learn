	export const metadata = {
		id: '07-data/05-nosql',
		part: 7,
		order: 5,
		title: 'Document, key-value and graph databases: when, and when not',
		definition: 'NoSQL means databases not built on tables: document (MongoDB), key-value (Redis) and graph (Neo4j). Each has its own job, and a relational one is the default.',
		summary: 'You’ll see what job each “non-relational” database does (MongoDB, Redis, Neo4j) and when a relational one is enough. Afterwards you can pick a store for each feature of your project, without chasing fashion.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'network',
					label: 'MongoDB|Redis|Neo4j|Postgres',
					caption: 'Choosing a database',
					say: 'A different database for every feature? Four servers, four backups, four passwords.'
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'server',
					label: 'PostgreSQL',
					caption: 'The default',
					say: 'Start with one relational database. It does tables, documents (JSON) and transactions.'
				},
				{
					mood: 'cheer',
					prop: 'lock',
					label: 'password',
					caption: 'Who can read it?',
					say: [
						{ text: 'I added Redis for sessions.' },
						{ who: 'Admin', text: 'Close its port to the internet. Thousands of databases sit open with no password.' }
					]
				}
			]
		},
		minutes: 25,
		teaches: ['data-document-db', 'data-key-value', 'data-graph-db', 'data-choose-database'],
		requires: ['data-relational-model', 'data-index'],
		practice: {
			id: 'data-choose-store',
			title: 'A store for each feature of the project',
			task: 'The table lists five features of your project. For each one, fill three cells: the kind of store (relational database, document, key-value, graph or file), why, and what you pay for it (for example: no links, no transactions, one more server, data in memory). If one relational database is enough for a feature, say so, and don’t look for another. Below, answer where the data lives and who can read it, and where you chose a relational database although you were tempted by another. Every “…” has to be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="choose">
      <h2>Which store for which feature<\/h2>
      <p>Kinds of store: relational database, document, key-value, graph or a plain file. If one relational database is enough, say so.<\/p>
      <table>
        <tr><th>Project feature<\/th><th>Kind of store<\/th><th>Why<\/th><th>What we pay<\/th><\/tr>
        <tr class="fn catalog"><td>Catalog of services or products (items)<\/td><td class="store">…<\/td><td class="why">…<\/td><td class="cost">…<\/td><\/tr>
        <tr class="fn requests"><td>Visitors’ enquiries: {{mainAction.label}}<\/td><td class="store">…<\/td><td class="why">…<\/td><td class="cost">…<\/td><\/tr>
        <tr class="fn sessions"><td>Sessions of signed-in visitors<\/td><td class="store">…<\/td><td class="why">…<\/td><td class="cost">…<\/td><\/tr>
        <tr class="fn links"><td>Links between the project’s people (people)<\/td><td class="store">…<\/td><td class="why">…<\/td><td class="cost">…<\/td><\/tr>
        <tr class="fn counter"><td>A fast visitor counter for today<\/td><td class="store">…<\/td><td class="why">…<\/td><td class="cost">…<\/td><\/tr>
      <\/table>
      <p>Where the data lives and who can read it: <span id="where">…<\/span><\/p>
      <p>Where I chose a relational database although I was tempted by another, and why: <span id="boring">…<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
