<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/07-data/01-what-is-a-database.svx. */
	export const metadata = {
		id: '07-data/01-what-is-a-database',
		part: 7,
		order: 1,
		title: 'What a database is and why a site needs one',
		definition: 'A database is an organized store watched over by a guard program, the DBMS. A relational database keeps its data in tables linked by keys.',
		summary: 'You’ll see why a database beats a file or a spreadsheet, and break your project’s data into entities and links. Afterwards you have a data schema for your brief: what to store, under which key, and which fields count as personal data.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'sheet',
					label: 'bookings.json',
					caption: 'A file',
					say: [
						{ text: 'Two people opened the file. Both read: 10 seats.' },
						{ who: 'File', text: 'I just sit here. Write whenever you like.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'sheet',
					label: 'seats: 9',
					caption: 'Lost',
					say: 'Both wrote 9. One booking vanished, and nobody got an error.'
				},
				{
					mood: 'cheer',
					prop: 'server',
					label: 'DBMS',
					caption: 'A database',
					say: [
						{ who: 'DBMS', text: 'The second one waits until the first is done.' },
						{ text: 'That is the whole difference: a database has a guard.' }
					]
				}
			]
		},
		minutes: 20,
		teaches: ['data-what-is-database', 'data-relational-model'],
		requires: ['server-static-vs-dynamic', 'js-json'],
		practice: {
			id: 'data-schema-sketch',
			title: 'The data schema of your project',
			task: 'Fill in the data schema table. The first row (the services from items) is already done as a model. Add the other three: people, proofs and requests (what a visitor sends through the form). In each row give the entity’s name, its key (a unique field, usually id), its fields separated by commas, its link to another entity (for example “refers to a service”) and whether it holds personal data (“yes” or “no”, with a short reason). Make the request a separate entity, not a field of another one. If your project has no people or no proofs, write in the row that the entity isn’t needed and say why. Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="schema">
      <h2>The project’s data schema<\/h2>
      <p>Each row is one entity: a kind of “thing” the site has to remember.<\/p>
      <table>
        <tr><th>Entity<\/th><th>Key<\/th><th>Fields<\/th><th>Links<\/th><th>Personal data?<\/th><\/tr>
        <tr class="entity items"><td class="name">Service<\/td><td class="key">id<\/td><td class="fields">title, text, price<\/td><td class="rel">belongs to a category (category_id)<\/td><td class="pd">no<\/td><\/tr>
        <tr class="entity people"><td class="name">…<\/td><td class="key">…<\/td><td class="fields">…<\/td><td class="rel">…<\/td><td class="pd">…<\/td><\/tr>
        <tr class="entity proofs"><td class="name">…<\/td><td class="key">…<\/td><td class="fields">…<\/td><td class="rel">…<\/td><td class="pd">…<\/td><\/tr>
        <tr class="entity request"><td class="name">…<\/td><td class="key">…<\/td><td class="fields">…<\/td><td class="rel">…<\/td><td class="pd">…<\/td><\/tr>
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (data-scaffold blocks). It does not go into the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="schema">
      <h2>The project’s data schema<\/h2>
      <p>Each row is one entity: a kind of “thing” the site has to remember.<\/p>
      <table>
        <tr><th>Entity<\/th><th>Key<\/th><th>Fields<\/th><th>Links<\/th><th>Personal data?<\/th><\/tr>
        <tr class="entity items"><td class="name">Service<\/td><td class="key">id<\/td><td class="fields">title, text, price<\/td><td class="rel">belongs to a category (category_id)<\/td><td class="pd">no<\/td><\/tr>
        <tr class="entity people"><td class="name">Person<\/td><td class="key">id<\/td><td class="fields">name, role, bio<\/td><td class="rel">runs services (person_id on the service)<\/td><td class="pd">yes, if it is a real person: name and photo<\/td><\/tr>
        <tr class="entity proofs"><td class="name">Proof<\/td><td class="key">id<\/td><td class="fields">title, text, image<\/td><td class="rel">belongs to a person (person_id)<\/td><td class="pd">no<\/td><\/tr>
        <tr class="entity request"><td class="name">Request<\/td><td class="key">id<\/td><td class="fields">visitor_name, phone, created_at<\/td><td class="rel">refers to a service (item_id)<\/td><td class="pd">yes: the visitor’s name and phone<\/td><\/tr>
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
