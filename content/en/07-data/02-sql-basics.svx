<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/07-data/02-sql-basics.svx. */
	export const metadata = {
		id: '07-data/02-sql-basics',
		part: 7,
		order: 2,
		title: 'SQL: reading and writing data',
		definition: 'SQL is a declarative query language for relational databases: SELECT reads data, INSERT adds rows, and UPDATE and DELETE change and remove them.',
		summary: 'You’ll write SELECT, INSERT, UPDATE and DELETE queries and understand what each word does. Afterwards you can create a table of your own services, add rows to it and get the data you need: filtered, sorted and counted.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'editor',
					label: 'DELETE FROM items;',
					caption: 'No WHERE',
