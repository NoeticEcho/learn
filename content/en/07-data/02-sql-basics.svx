      const row = {};
      for (const c of t.columns) {
      row[c.name] = r[c.name] === undefined ? null : r[c.name];
      if (c.type === 'serial') (row[c.name] === null && (row[c.name] = ++t.seq), (t.seq = Math.max(t.seq, row[c.name])));
