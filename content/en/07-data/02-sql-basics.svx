      for (const c of conj) {
      if (c.op !== '=') continue;
      const [a, b] = c.l.op === 'col' ? [c.l, c.r] : [c.r, c.l];
      if (a.op !== 'col' || b.op !== 'lit' || (a.table && a.table !== alias)) continue;
