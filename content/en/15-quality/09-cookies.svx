<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <style>
      body { font-family: system-ui, sans-serif; line-height: 1.5; color: #1d2430; background: #fff; }
      main, footer { max-width: 44rem; margin: 0 auto; padding: 1rem; }
      .btn { font: inherit; padding: 0.6rem 1rem; background: #fff; color: #1d2430; border: 2px solid #1d2430; cursor: pointer; }
      #cookie-banner { position: static; border: 2px solid #1d2430; padding: 1rem; margin: 1rem 0; }
      table { border-collapse: collapse; }
      td, th { border: 1px solid #888; padding: 0.3rem 0.6rem; }
    <\/style>
  </head>
  <body>
    <main>
      <h1>{{title}}</h1>
      <p>{{who}}</p>

      <section id="cookies">
        <h2>Cookies on this site</h2>
        <table>
          <thead><tr><th>Name</th><th>Why</th><th>How long</th><th>Set by</th><th>Consent needed</th></tr></thead>
          <tbody>
            <tr class="cookie" data-cat="necessary" data-consent="no"><td>session</td><td>Remembers the progress of “{{mainAction.label}}”</td><td>until the browser closes</td><td>our site</td><td>no</td></tr>
            <tr class="cookie" data-cat="necessary" data-consent="no"><td>csrf</td><td>Protects the form from request forgery</td><td>until the browser closes</td><td>our site</td><td>no</td></tr>
            <tr class="cookie" data-cat="necessary" data-consent="no"><td>cookie_consent</td><td>Remembers your choice in this banner</td><td>6 months</td><td>our site</td><td>no</td></tr>
            <tr class="cookie" data-cat="prefs" data-consent="yes"><td>lang</td><td>Remembers the language you chose</td><td>1 year</td><td>our site</td><td>yes</td></tr>
            <tr class="cookie" data-cat="analytics" data-consent="yes"><td>_ga</td><td>Tells a new visitor from a returning one</td><td>as stated in the service’s help</td><td>the analytics service</td><td>yes</td></tr>
          </tbody>
        </table>
      </section>

      <div id="cookie-banner" role="dialog" aria-label="Cookie settings">
        <p>Necessary cookies always work. The others switch on only when you choose. <a href="#privacy">Privacy notice</a></p>
        <button class="btn" id="accept">Accept all</button>
        <button class="btn" id="reject">Reject all</button>
        <button class="btn" id="settings">Settings</button>
      </div>

      <script type="text/plain" data-consent="analytics">
        (function () { /* the counter, starts after consent */ })();
      <\/script>

      <aside data-scaffold id="eu-box">
        <p>Visitors from the EU and UK: <span id="eu-note">for the English version and an audience in Europe, analytics starts only after consent, with an equal choice and a way back through the footer link</span></p>
      </aside>
    </main>
    <footer><p>{{name}} · <a href="#" data-cookie-settings>Cookie settings</a> · <a href="#privacy">Privacy notice</a></p></footer>
  </body>
</html>
`
