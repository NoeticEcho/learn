        <p><label for="f-phone">Phone</label><br><input id="f-phone" type="tel" name="phone" autocomplete="tel"></p>
        <p><label for="f-pw">Password for your account</label><br><input id="f-pw" type="password" name="pw" autocomplete="current-password"></p>
        <p id="err" class="muted" role="status"></p>
        <button class="btn" type="submit">{{mainAction.label}}</button>
