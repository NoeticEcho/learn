<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; color: #1d2430; background: #fff; line-height: 1.5; }
