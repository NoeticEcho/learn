      <h1>{{title}}</h1>
      <p>{{who}}</p>
      <button type="button" id="open-d" aria-haspopup="dialog">{{mainAction.label}}</button>
      <dialog id="d" aria-labelledby="d-title">
        <h2 id="d-title">{{mainAction.label}}</h2>
        <button type="button" id="close-d">Close</button>
      </dialog>
      <p id="status" role="status"></p>
    </main>
    <footer>{{name}}, {{city}}</footer>

    <aside data-scaffold id="reader-note">
      <h2>What the screen reader will say</h2>
      <p>On the menu button: <span id="say-menu">“Menu, button, collapsed”</span></p>
      <p>On the dialog: <span id="say-dialog">“Name of the action, dialog”</span></p>
