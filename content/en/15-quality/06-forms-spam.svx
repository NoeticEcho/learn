				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <style>
      body { font-family: system-ui, sans-serif; line-height: 1.5; color: #1d2430; background: #fff; }
      main { max-width: 40rem; margin: 0 auto; padding: 1rem; }
      .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    <\/style>
  </head>
  <body>
    <main>
      <h1>{{title}}</h1>
      <form id="request-form" action="/request" method="post">
        <h2>{{mainAction.label}}</h2>
        <p><label for="f-name">Name</label><br><input id="f-name" name="name" autocomplete="name" required maxlength="80"></p>
        <p><label for="f-phone">Phone</label><br><input id="f-phone" name="phone" type="tel" autocomplete="tel" required maxlength="20"></p>
        <p><label for="f-msg">Briefly, what you need</label><br><textarea id="f-msg" name="message" rows="4" maxlength="1000"></textarea></p>
        <div class="hp" aria-hidden="true"><label for="f-site">Website</label><input id="f-site" name="website" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="ts" value="">
        <p id="form-error" role="alert"></p>
        <button type="submit">{{mainAction.label}}</button>
      </form>
    </main>

    <aside data-scaffold id="server">
      <h2>What the server does</h2>
      <table id="rules">
        <thead><tr><th>Field</th><th>Rule</th><th>Error message</th></tr></thead>
        <tbody>
          <tr class="rule"><td>Name</td><td>required, 2 to 80 characters, no line breaks</td><td>Please enter your name</td></tr>
          <tr class="rule"><td>Phone</td><td>required, 10 to 20 characters: digits, plus, spaces, parentheses and hyphens</td><td>Please check the phone number</td></tr>
          <tr class="rule"><td>Message</td><td>at most 1000 characters, at most two links</td><td>Please shorten the message or remove extra links</td></tr>
        </tbody>
      </table>
      <p>Message on an internal error: <span id="error-text">We couldn’t send this. Please try again later or call us</span></p>
      <p>Rate limit: <span id="rate">no more than 5 inquiries an hour from one address, after that a 429 response</span></p>
    </aside>
  </body>
</html>
`
