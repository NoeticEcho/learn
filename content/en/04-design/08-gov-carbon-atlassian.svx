<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
  </head>
  <body>
    <main id="page">
      <h1>{{title}}</h1>
      <p>{{who}}</p>
      <form id="contact" action="#" method="post" novalidate>
        <div class="error-summary" data-scaffold role="alert" tabindex="-1">
          <h2>There is a problem</h2>
          <ul>
            <li><a href="#name">Enter your name</a></li>
            <li><a href="#email">Enter an email address in the correct format, like name@example.com</a></li>
          </ul>
        </div>
        <div class="field">
          <label for="name">What should we call you</label>
          <p id="name-hint" class="hint">A first name is enough</p>
          <p id="name-error" class="field-error" data-scaffold>Error: enter your name</p>
          <input id="name" name="name" autocomplete="name" aria-describedby="name-hint name-error">
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email">
        </div>
        <div class="field">
          <label for="msg">Message</label>
          <textarea id="msg" name="msg"></textarea>
        </div>
        <button type="submit">Send message</button>
      </form>
    </main>
  </body>
</html>
`
