	const skeleton = `export default {
  async fetch(request, env) {
    // 1) let only POST through
    // 2) read the form fields and check them
    // 3) forward the request to the address in the settings (env.WEBHOOK_URL), not in the code
    // 4) reply: 200 on success, 400 on bad data
    …
  }
};`;

	const solved = `export default {
  async fetch(request, env) {
    if (request.method !== 'POST') {
      return new Response('POST only', { status: 405 });
    }
    const data = await request.formData();
    const name = String(data.get('name') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    if (!name || !/^[+0-9 ()-]{6,20}$/.test(phone)) {
      return new Response('Check the fields', { status: 400 });
    }
    // the address and the key live in the service's settings (env), not in the page's code
    await fetch(env.WEBHOOK_URL, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ name, phone })
    });
    return new Response('Received', { status: 200 });
  }
};`;

