<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <script type="text/plain" data-consent="analytics">
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXX');
    <\/script>
  </head>
  <body>
    <main>
      <h1>{{name}}</h1>
      <p>{{who}}</p>

      <section id="action">
        <h2>{{mainAction.label}}</h2>
        <form action="/request" method="post">
          <p>
            <label for="f-name">What should we call you</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" data-clarity-mask="True">
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" data-clarity-mask="True">
          </p>
          <p>
            <label for="f-comment">Tell us briefly about the task</label><br>
            <textarea id="f-comment" name="comment" rows="3" data-clarity-mask="True"></textarea>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>

    <div id="consent" role="dialog" aria-label="Cookie choices">
      <p>We use Google Analytics cookies to understand how the site is used. <a href="cookies.html">Cookie policy</a></p>
      <p><label><input type="checkbox" name="analytics"> Allow analytics</label></p>
      <p><button type="button" class="btn" id="consent-accept">Accept</button> <button type="button" class="btn" id="consent-reject">Reject</button></p>
    </div>

    <script>
      function allowAnalytics() {
        document.querySelectorAll('script[data-consent="analytics"]').forEach(function (s) {
          var n = document.createElement('script');
          n.text = s.text;
          document.head.appendChild(n);
        });
      }
      function choose(answer) {
        try { localStorage.setItem('consent', answer); } catch (e) {}
        document.getElementById('consent').hidden = true;
        if (answer === 'yes') { allowAnalytics(); }
      }
      try { if (localStorage.getItem('consent') === 'yes') { allowAnalytics(); } } catch (e) {}
      document.getElementById('consent-accept').addEventListener('click', function () { choose('yes'); });
      document.getElementById('consent-reject').addEventListener('click', function () { choose('no'); });
    <\/script>

    <aside class="note" data-scaffold id="rules">
      <h2>Session recording rules</h2>
      <p>On which pages: <span class="r-pages">{{sections.0}} and {{sections.1}}: pages with no data entry</span></p>
      <p>What is hidden: <span class="r-masked">all form fields (the data-clarity-mask attribute) and blocks with contact details</span></p>
      <p>What is excluded: <span class="r-excluded">pages where a person describes their case, and the customer account, are not recorded</span></p>
      <p>Retention, days: <span class="r-keep">30</span></p>
      <p>Who sees them: <span class="r-who">only the project owner and one assistant</span></p>
      <p>What the policy says: <span class="r-policy">We record visitors’ actions on the site (clicks and scrolling), without the contents of forms, to improve the pages. Recordings are kept for 30 days and can be seen by two staff members.</span></p>
      <p>The same in Russian: <span class="r-policy-ru">Мы записываем действия посетителей на сайте, такие как клики и прокрутка, без содержимого форм, чтобы улучшать страницы. Записи хранятся 30 дней.</span></p>
    </aside>
  </body>
</html>
`
