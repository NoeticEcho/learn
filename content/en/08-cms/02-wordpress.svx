<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/08-cms/02-wordpress.svx. */
	export const metadata = {
		id: '08-cms/02-wordpress',
		part: 8,
		order: 2,
		title: 'WordPress: themes, plugins and the era of 2010',
		definition: 'WordPress is an open-source CMS in PHP and MySQL. A theme decides how a site looks, plugins what it can do; since version 3.0 (2010) it can build any site.',
		summary:
			'You’ll see how WordPress is put together: posts and pages, a theme, plugins and menus. And you’ll plan a 2010-era site for your own project, knowing what a theme decides and what a plugin does.',
		comic: {
			panels: [
				{
					mood: 'explain',
					prop: 'browser',
					label: 'header.php',
					caption: 'The theme',
					say: 'The theme decides how everything looks: the header, the menu, the loop of posts, the sidebar, the footer.'
				},
				{
					mood: 'hmm',
					side: 'right',
					prop: 'network',
					label: 'plugins: 23',
					caption: 'A year later',
					say: [
						{ text: 'The site is slow.' },
						{ who: 'Plugins', text: 'But we are all useful!' }
					]
				},
				{
					mood: 'cheer',
					prop: 'cards',
					label: '4 plugins',
					caption: 'The rule',
					say: 'As few plugins as possible, each with a reason. Every one is someone else’s code that has to be kept up to date.'
				}
			]
		},
		minutes: 20,
		teaches: ['cms-wordpress-themes-plugins'],
		requires: ['cms-what-is-cms', 'cms-content-model', 'html-semantic-elements', 'css-box-model'],
		practice: {
			id: 'cms-wordpress-plan',
			title: 'A WordPress site for your project',
			task: 'In front of you is a theme in the spirit of WordPress in 2010. 1) The site’s tagline (in the header) is “…” for now: write it. 2) Build the menu: the menu list holds only “Home”; add one item for each section of your brief. 3) On the home page, above the list of posts, add a button for the main action: a link with the class button and the text from the brief. 4) In the plan under the page, say for each section whether it will be a page or a category and whether it is in the menu. 5) List the plugins: at least two and at most five, each with a name and a reason. 6) Say which plugin serves the main action and where it is shown. 7) Say how the project’s tone shows in the name and the tagline. Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <div id="page">
      <header id="branding">
        <h1 id="site-title"><a href="#">{{name}}<\/a><\/h1>
        <p id="site-description">…<\/p>
        <nav id="access">
          <ul id="menu">
            <li><a href="#">Home<\/a><\/li>
          <\/ul>
        <\/nav>
      <\/header>

      <div id="main">
        <div id="content">
          {{#each items}}<article class="post">
            <h2 class="entry-title">{{title}}<\/h2>
            <div class="entry-meta">Category: services<\/div>
            <p>{{text}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
        <aside id="sidebar">
          <div class="widget"><h3>Search<\/h3><p>A search box for the site<\/p><\/div>
          <div class="widget"><h3>Categories<\/h3><ul>{{#each sections}}<li>{{.}}<\/li>{{/each}}<\/ul><\/div>
          <div class="widget"><h3>Contact<\/h3><p>{{phone}}<br>{{email}}<\/p><\/div>
        <\/aside>
      <\/div>

      <footer id="colophon"><p>{{name}}, {{city}}. Powered by WordPress.<\/p><\/footer>
    <\/div>

    <section data-scaffold id="wp-plan">
      <h2>The WordPress site plan<\/h2>

      <h3>What becomes a page and what a category<\/h3>
      <table id="map">
        <tr><th>Section<\/th><th>Page or category<\/th><th>In the menu?<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="kind">…<\/td><td class="menu">…<\/td><\/tr>
        {{/each}}
      <\/table>

      <h3>Plugins: five at most, each with a reason<\/h3>
      <ul id="plugins">
        <li class="plugin"><span class="name">…<\/span>: <span class="why">…<\/span><\/li>
        <li class="plugin"><span class="name">…<\/span>: <span class="why">…<\/span><\/li>
      <\/ul>

      <p id="action">The main action “{{mainAction.label}}” is served by: <span id="action-by">…<\/span>. It is shown on: <span id="action-where">…<\/span><\/p>
      <p>How the project’s tone shows in the name and the tagline: <span id="tone-note">…<\/span><\/p>
    <\/section>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: a theme in the spirit of WordPress in 2010 */

body {
  margin: 0;
  padding: 1rem 0;
  font: 1rem/1.6 Georgia, "Times New Roman", serif;
  color: #333333;
  background-color: #e4e4e4;
}

#page {
  width: 90%;
  max-width: 58rem;
  margin: 0 auto;
  background-color: #ffffff;
  border: 1px solid #cccccc;
}

#branding {
  padding: 1rem 1.5rem 0;
  border-bottom: 4px solid #21759b;
}

#site-title {
  margin: 0;
  font-size: 1.75rem;
}

#site-title a {
  color: #21759b;
  text-decoration: none;
}

#site-description {
  margin: 0 0 0.75rem;
  color: #777777;
  font-style: italic;
}

#access {
  background-color: #f2f2f2;
  border-top: 1px solid #dddddd;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
}

#access ul {
  margin: 0;
  padding: 0;
  list-style: none;
  overflow: hidden;
}

#access li {
  float: left;
}

#access a {
  display: block;
  padding: 0.6rem 1rem;
  color: #333333;
  text-decoration: none;
  font: 0.95rem Arial, Helvetica, sans-serif;
}

#main {
  overflow: hidden;
  padding: 1.5rem;
}

#content {
  float: left;
  width: 66%;
}

#sidebar {
  float: right;
  width: 28%;
  font: 0.9rem/1.5 Arial, Helvetica, sans-serif;
}

.post {
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px dotted #cccccc;
}

.entry-title {
  margin: 0 0 0.25rem;
  font-size: 1.35rem;
}

.entry-meta {
  margin-bottom: 0.5rem;
  color: #888888;
  font: 0.8rem Arial, Helvetica, sans-serif;
}

.widget {
  margin-bottom: 1.25rem;
  padding: 0.75rem;
  background-color: #f6f6f6;
}

.widget h3 {
  margin: 0 0 0.5rem;
  font-size: 1rem;
}

.widget ul {
  margin: 0;
  padding-left: 1.1rem;
}

a {
  color: #21759b;
}

.button {
  display: inline-block;
  padding: 0.5rem 1rem;
  color: #ffffff;
  background-color: #21759b;
  text-decoration: none;
  font: 0.95rem Arial, Helvetica, sans-serif;
}

#colophon {
  clear: both;
  padding: 1rem 1.5rem;
  border-top: 1px solid #cccccc;
  color: #777777;
  font: 0.85rem Arial, Helvetica, sans-serif;
}

/* Styling of the exercise (the data-scaffold blocks). It does not reach the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <div id="page">
      <header id="branding">
        <h1 id="site-title"><a href="#">{{name}}<\/a><\/h1>
        <p id="site-description">{{who}}<\/p>
        <nav id="access">
          <ul id="menu">
            <li><a href="#">Home<\/a><\/li>
            {{#each sections}}<li><a href="#">{{.}}<\/a><\/li>
            {{/each}}
          <\/ul>
        <\/nav>
      <\/header>

      <div id="main">
        <div id="content">
          <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>
          {{#each items}}<article class="post">
            <h2 class="entry-title">{{title}}<\/h2>
            <div class="entry-meta">Category: services<\/div>
            <p>{{text}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
        <aside id="sidebar">
          <div class="widget"><h3>Search<\/h3><p>A search box for the site<\/p><\/div>
          <div class="widget"><h3>Categories<\/h3><ul>{{#each sections}}<li>{{.}}<\/li>{{/each}}<\/ul><\/div>
          <div class="widget"><h3>Contact<\/h3><p>{{phone}}<br>{{email}}<\/p><\/div>
        <\/aside>
      <\/div>

      <footer id="colophon"><p>{{name}}, {{city}}. Powered by WordPress.<\/p><\/footer>
    <\/div>

    <section data-scaffold id="wp-plan">
      <h2>The WordPress site plan<\/h2>

      <h3>What becomes a page and what a category<\/h3>
      <table id="map">
        <tr><th>Section<\/th><th>Page or category<\/th><th>In the menu?<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="kind">page<\/td><td class="menu">yes<\/td><\/tr>
        {{/each}}
      <\/table>

      <h3>Plugins: five at most, each with a reason<\/h3>
      <ul id="plugins">
        <li class="plugin"><span class="name">Contact form<\/span>: <span class="why">takes enquiries from the home page and sends them to the owner’s email<\/span><\/li>
        <li class="plugin"><span class="name">SEO plugin<\/span>: <span class="why">sets titles and descriptions of pages for search engines<\/span><\/li>
        <li class="plugin"><span class="name">Caching<\/span>: <span class="why">serves ready-made pages so the site opens fast<\/span><\/li>
        <li class="plugin"><span class="name">Backups<\/span>: <span class="why">saves the site and the database every night, away from the server<\/span><\/li>
      <\/ul>

      <p id="action">The main action “{{mainAction.label}}” is served by: <span id="action-by">the contact form plugin<\/span>. It is shown on: <span id="action-where">the home page, as a button above the list of posts<\/span><\/p>
      <p>How the project’s tone shows in the name and the tagline: <span id="tone-note">the name and tagline are short and calm, with no loud words, in the same tone as the project itself<\/span><\/p>
    <\/section>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: a theme in the spirit of WordPress in 2010 */

