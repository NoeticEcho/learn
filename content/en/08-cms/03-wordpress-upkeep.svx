	export const metadata = {
		id: '08-cms/03-wordpress-upkeep',
		part: 8,
		order: 3,
		title: 'What breaks in WordPress, and what it really costs',
		definition: 'The cost of owning a CMS is everything a site costs after installation: hosting, paid themes and plugins, updates, backups, protection from attacks and repairs.',
		summary:
			'You’ll learn to count the cost of owning a CMS honestly (updates, break-ins, reliance on plugins, hosting) and to say when WordPress fits and when it becomes a burden. This is the “what was wrong” page for era 3, and you’ll write an upkeep plan for your own site.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'server',
					label: 'update 6.x',
					caption: 'Friday evening',
					say: [
						{ text: 'I’ll just click “update all”.' },
						{ who: 'Site', text: 'White screen. Have a good weekend.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'cards',
					label: 'copy + restore test',
					caption: 'A backup',
					say: 'A backup nobody has ever restored is not a backup. It is a hope.'
				},
				{
					mood: 'cheer',
					prop: 'sheet',
					label: 'owner: ___',
					caption: 'The plan',
					say: 'Who updates, how often, what gets copied: write it down while the site still works.'
				}
			]
		},
		minutes: 15,
		teaches: ['cms-wordpress-maintenance', 'cms-cms-history'],
		requires: ['cms-wordpress-themes-plugins'],
		practice: {
			id: 'cms-upkeep-plan',
			title: 'An upkeep plan and a comparison of systems',
			task: 'Write an upkeep plan for your project’s site on a CMS. 1) In the table, for each of the four tasks write who does it (a specific person or role), how often, and how many hours a month it takes (a number). 2) Write the total hours a month. 3) Describe the backup: what is copied, where it is kept and how it is tested. 4) Name at least two risks of the plugin that serves your project’s main action (a form, a booking, a payment). 5) In the comparison table, for WordPress, Drupal and Joomla write how their updates are and whether they suit you. 6) In the verdict, say whether to keep WordPress, take something else or give up on a CMS. Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="upkeep">
      <h2>Upkeep plan for a CMS site<\/h2>
      <table id="tasks">
        <tr><th>Task<\/th><th>Who does it<\/th><th>How often<\/th><th>Hours a month<\/th><\/tr>
        <tr class="task"><td>Updating the CMS core<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Updating plugins and the theme<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Backup and a restore test<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
        <tr class="task"><td>Checking that the enquiry form works<\/td><td class="who">…<\/td><td class="freq">…<\/td><td class="hours">…<\/td><\/tr>
      <\/table>
      <p>Total hours a month: <span id="hours-total">…<\/span><\/p>
      <p>Backup: what is copied, where it is stored, how it is tested: <span id="backup">…<\/span><\/p>

      <h3>Plugin risks for the project’s main action, “{{mainAction.label}}”<\/h3>
      <ul id="risks">
        <li class="risk">…<\/li>
        <li class="risk">…<\/li>
      <\/ul>

      <h3>The comparison for my project<\/h3>
      <table id="compare">
        <tr><th>System<\/th><th>Updates and support<\/th><th>Does it fit me?<\/th><\/tr>
        <tr class="cms"><td>WordPress<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
        <tr class="cms"><td>Drupal<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
        <tr class="cms"><td>Joomla<\/td><td class="upd">…<\/td><td class="fit">…<\/td><\/tr>
      <\/table>
      <p>Verdict: <span id="verdict">…<\/span><\/p>
    <\/section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (data-scaffold blocks). It does not end up in the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="upkeep">
      <h2>Upkeep plan for a CMS site<\/h2>
      <table id="tasks">
        <tr><th>Task<\/th><th>Who does it<\/th><th>How often<\/th><th>Hours a month<\/th><\/tr>
        <tr class="task"><td>Updating the CMS core<\/td><td class="who">the owner, or a contractor under a retainer<\/td><td class="freq">once a month<\/td><td class="hours">0.5<\/td><\/tr>
        <tr class="task"><td>Updating plugins and the theme<\/td><td class="who">a contractor under a retainer<\/td><td class="freq">once a week<\/td><td class="hours">1<\/td><\/tr>
        <tr class="task"><td>Backup and a restore test<\/td><td class="who">the host makes the copy, a contractor tests it<\/td><td class="freq">a restore test once a quarter<\/td><td class="hours">0.5<\/td><\/tr>
        <tr class="task"><td>Checking that the enquiry form works<\/td><td class="who">the owner<\/td><td class="freq">once a week<\/td><td class="hours">0.25<\/td><\/tr>
      <\/table>
      <p>Total hours a month: <span id="hours-total">2.25<\/span><\/p>
      <p>Backup: what is copied, where it is stored, how it is tested: <span id="backup">the files and the database are copied every night, the copies are stored on another server, and once a quarter we try to restore the site at a test address<\/span><\/p>

      <h3>Plugin risks for the project’s main action, “{{mainAction.label}}”<\/h3>
      <ul id="risks">
        <li class="risk">the form plugin is vulnerable or out of date, and through it someone can plant malicious code or flood us with spam<\/li>
        <li class="risk">an update of the form plugin breaks sending, and enquiries are lost for days before we notice<\/li>
        <li class="risk">the plugin’s author stops maintaining it, and the form has to be replaced in a hurry<\/li>
      <\/ul>

      <h3>The comparison for my project<\/h3>
      <table id="compare">
        <tr><th>System<\/th><th>Updates and support<\/th><th>Does it fit me?<\/th><\/tr>
        <tr class="cms"><td>WordPress<\/td><td class="upd">frequent updates and many plugins; it needs discipline and one person in charge<\/td><td class="fit">fits: the form and the pages are simple, and the editor is familiar<\/td><\/tr>
        <tr class="cms"><td>Drupal<\/td><td class="upd">updates are stricter and weightier, and it needs an experienced developer<\/td><td class="fit">overkill: the project is small and has no complicated permissions<\/td><\/tr>
        <tr class="cms"><td>Joomla<\/td><td class="upd">updates exist, but the community is smaller<\/td><td class="fit">no clear advantage over WordPress<\/td><\/tr>
      <\/table>
      <p>Verdict: <span id="verdict">keep WordPress: the project is simple, a person in charge and a contractor are named, and upkeep will take about two hours a month<\/span><\/p>
    <\/section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

