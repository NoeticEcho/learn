`
			},
			checks: [
				{ id: 'headless-exists', kind: 'exists', selector: '#headless' },
				{ id: 'no-blanks', kind: 'text', selector: '#headless', matches: '^[^…]*$' },
				{ id: 'schema-type', kind: 'text', selector: '#schema', matches: '"type"\\s*:\\s*"\\w+"' },
				{
					id: 'schema-fields',
					kind: 'text',
					selector: '#schema',
					matches: '(?=[\\s\\S]*"title")(?=[\\s\\S]*"text")(?=[\\s\\S]*"price")'
				},
				{
					id: 'schema-languages',
					kind: 'text',
					selector: '#schema',
					matches: '_[a-z]{2}\\b|[lL][oO][cC][aA][lL][eE]|[tT][rR][aA][nN][sS][lL][aA][tT][iI][oO][nN][sS]',
					when: { brief: 'languages', contains: 'ru' }
				},
				{
					id: 'entries-names',
					kind: 'text',
					selector: '#entries',
					matches: '(?=[\\s\\S]*"title"\\s*:)(?=[\\s\\S]*"text"\\s*:)(?=[\\s\\S]*"price"\\s*:)'
				},
				{ id: 'entries-brief', kind: 'field', selector: '#entries', field: 'items[].title', min: 1, when: { brief: 'items[].title' } },
				{ id: 'entries-filled', kind: 'text', selector: '#entries', matches: '"title"\\s*:\\s*"[^"]{2,}"' },
				{ id: 'entries-new', kind: 'text', selector: '#entries', matches: '(?:"title"[\\s\\S]*){2,}', when: { brief: 'items[].title' } },
				{
					id: 'entries-languages',
					kind: 'text',
					selector: '#entries',
					matches: '"(title|text)_[a-z]{2}"',
					when: { brief: 'languages', contains: 'ru' }
				},
				{ id: 'code-fetch', kind: 'text', selector: '#headless-code', matches: 'fetch\\(\\s*[\'"`]/api/items[\'"`]' },
				{ id: 'code-json', kind: 'text', selector: '#headless-code', matches: '\\.json\\(\\)' },
				{ id: 'code-render', kind: 'text', selector: '#headless-code', matches: 'createElement|replaceChildren|append' },
				{
					id: 'hosting',
					kind: 'text',
					selector: '#hosting',
					matches: '[gG][iI][tT]|[dD][eE][cC][aA][pP]|[oO][wW][nN] [sS][eE][rR][vV][eE][rR]|[sS][eE][lL][fF]-[hH][oO][sS][tT][eE][dD]|[sS][tT][rR][aA][pP][iI]|[dD][iI][rR][eE][cC][tT][uU][sS]|[cC][lL][oO][uU][dD]|[sS][aA][nN][iI][tT][yY]|[cC][oO][nN][tT][eE][nN][tT][fF][uU][lL]'
				},
				{ id: 'hosting-why', kind: 'text', selector: '#hosting-why', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'What does a “headless” CMS mean?',
				options: [
					'It has no website of its own, the “head”: it keeps the content and serves it through an API, and the site is built separately',
					'It runs without an administrator',
					'It has no database'
				],
				answer: 0,
				why: [
					'Yes. The “head” is whatever shows the content to a visitor. It has been cut off, so a site and an app can both show the content.',
					'No: such a CMS has an admin, and that is its main part.',
					'No: there is storage, sometimes even plain files in Git.'
				]
			},
			{
				type: 'multiple',
				prompt: 'What does separating the content from the site give you?',
				options: [
					'A developer is free to choose what to build the site with',
					'The same content can be shown by a site and by an app',
					'The admin stays comfortable for the editor',
					'Nobody has to build the site'
				],
				answer: [0, 1, 2],
				why: [
					'Yes: the site can be written with any tool that can read an API.',
					'Yes: one source, many channels.',
					'Yes: that is the point. The editor works in a familiar form.',
					'No, quite the opposite: the site now has to be built, while a monolithic CMS already has one in the form of a theme.'
				]
			},
			{
				type: 'match',
				prompt: 'Match each system to where it keeps the content',
				pairs: [
					['Decap CMS', 'files in a Git repository, and an edit is a commit'],
					['Strapi', 'a database on your own server (or in Strapi’s cloud)'],
					['Directus', 'your own SQL database, with an admin and an API on top'],
					['Sanity', 'the provider’s cloud, with an editing studio built into your project'],
					['Contentful', 'a cloud service, with the content held by the provider']
				]
			},
			{
				type: 'single',
				prompt: 'What does a webhook do in the setup of a headless site?',
				options: [
