<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/08-cms/06-headless.svx. */
	export const metadata = {
		id: '08-cms/06-headless',
		part: 8,
		order: 6,
		title: 'Headless CMS: when content lives apart from the site',
		definition: 'A headless CMS is a content system with no website of its own: editors change entries in an admin, and sites and apps get them through an API.',
		summary: 'You’ll see why a “headless” CMS gives editors a comfortable admin and developers the freedom to choose the site, and compare Strapi, Directus, Sanity, Contentful and Decap by where they keep content (Git, your own server, the cloud) and by price. Afterwards you can describe a content type, add entries and fetch them with a request, as a real site does.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'browser',
					label: 'site + admin',
					caption: 'The monolith',
					say: [
						{ text: 'I want a new site on a different engine.' },
						{ who: 'CMS', text: 'Then the admin goes too. They are one piece.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'network',
					label: 'API',
					caption: 'Headless',
					say: 'Admin and content live in one place, the site in another. Between them only an API, read by a site and an app alike.'
				},
				{
					mood: 'cheer',
					prop: 'server',
					label: '/api/items',
					caption: 'A request',
					say: [
						{ text: 'GET /api/items' },
						{ who: 'CMS', text: 'Here is the JSON. Draw it however you like.' }
					]
				}
			]
		},
		minutes: 20,
		teaches: ['cms-headless', 'cms-headless-landscape'],
		requires: ['cms-content-model', 'cms-static-site-generator', 'server-rest', 'js-fetch'],
		practice: {
			id: 'cms-headless-api',
			title: 'A type, entries and a request to a headless CMS',
			task: 'The page now gets its services from a request to an “API”, not from HTML. The API is simulated, because the sandbox has no network. 1) In the “Content type” box, replace the “…” with a type for the price field. If your project has a second language, add text fields for it as well, with the language’s two letter code at the end (title_es, text_es). 2) The “Entries” box already holds your services from the brief. Add one more entry in place of the “…” (with title_es and text_es for a second language). 3) In the headless-code script, finish the function load: request the address /api/items with fetch, read the response as JSON, and make a card for each entry (an article with the class card, holding an h3 and a p), then put the cards into .cards. 4) Say where the CMS lives (Git, your own server or the cloud) and why, tying it to the project’s budget and data. The checks read the fields and the script’s text. Every “…” has to be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards"><\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="headless">
      <h2>Headless CMS: type, entries and request<\/h2>

      <h3>Content type (this is how the schema looks in the admin)<\/h3>
      <textarea aria-label="Content type (this is how the schema looks in the admin)" id="schema" rows="12">{
  "type": "items",
  "fields": {
    "title": "string",
    "text": "text",
    "price": …
  }
}<\/textarea>

      <h3>Entries: the API’s answer at /api/items<\/h3>
      <textarea aria-label="Entries: the API’s answer at /api/items" id="entries" rows="14">[
{{#each items}}  { "title": "{{title}}", "text": "{{text}}", "price": "{{price}}" },
{{/each}}  { "title": "…", "text": "…", "price": "…" }
]<\/textarea>

      <p>Where the CMS lives: <span id="hosting">…<\/span>, because <span id="hosting-why">…<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fake-api">
      // A stand-in for a headless CMS’s API (not a real server): a request for /api/items is answered with the entries from the “Entries” box.
      // The sandbox has no network, so a real request is impossible here. You don’t need to read this block.
      window.fetch = async (url) => {
        if (String(url) !== '/api/items') return new Response('Not Found', { status: 404 });
        await new Promise((r) => setTimeout(r, 250));
        try {
          const data = JSON.parse(document.getElementById('entries').value.replace(/,\\s*\\]/g, ']'));
          return new Response(JSON.stringify(data), { status: 200, headers: { 'Content-Type': 'application/json' } });
        } catch (e) {
          return new Response('Error in the entries JSON: ' + e.message, { status: 500 });
        }
      };
    <\/script>

    <script type="module" id="headless-code">
      // The page gets the services from the “API” and shows them as cards.
      async function load() {
        const cards = document.querySelector('.cards');
        // 1) request the entries: fetch('/api/items')
        // 2) read the response as JSON
        // 3) for each entry make a card (an article with class card, with an h3 and a p inside) and put it in cards
      }
      load();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (blocks with data-scaffold). It does not go into the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards"><\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="headless">
      <h2>Headless CMS: type, entries and request<\/h2>

      <h3>Content type (this is how the schema looks in the admin)<\/h3>
      <textarea aria-label="Content type (this is how the schema looks in the admin)" id="schema" rows="12">{
  "type": "items",
  "fields": {
    "title": "string",
    "title_es": "string",
    "text": "text",
    "text_es": "text",
    "price": "string"
  }
}<\/textarea>

      <h3>Entries: the API’s answer at /api/items<\/h3>
      <textarea aria-label="Entries: the API’s answer at /api/items" id="entries" rows="14">[
{{#each items}}  { "title": "{{title}}", "text": "{{text}}", "price": "{{price}}" },
{{/each}}  { "title": "New service", "title_es": "Servicio nuevo", "text": "A short description of the new service", "text_es": "Una descripción breve", "price": "on request" }
]<\/textarea>

      <p>Where the CMS lives: <span id="hosting">files in Git (Decap)<\/span>, because <span id="hosting-why">the budget is small, one person edits the content once a month, and the entries hold no personal data<\/span><\/p>
    <\/section>

    <script type="module" data-scaffold id="fake-api">
      // A stand-in for a headless CMS’s API (not a real server): a request for /api/items is answered with the entries from the “Entries” box.
      // The sandbox has no network, so a real request is impossible here. You don’t need to read this block.
      window.fetch = async (url) => {
        if (String(url) !== '/api/items') return new Response('Not Found', { status: 404 });
        await new Promise((r) => setTimeout(r, 250));
        try {
          const data = JSON.parse(document.getElementById('entries').value.replace(/,\\s*\\]/g, ']'));
          return new Response(JSON.stringify(data), { status: 200, headers: { 'Content-Type': 'application/json' } });
        } catch (e) {
          return new Response('Error in the entries JSON: ' + e.message, { status: 500 });
        }
      };
    <\/script>

    <script type="module" id="headless-code">
      // The page gets the services from the “API” and shows them as cards.
      async function load() {
        const cards = document.querySelector('.cards');
        const response = await fetch('/api/items');
        if (!response.ok) {
          cards.textContent = 'Could not load the list. Please try again later.';
          return;
        }
        const items = await response.json();
        cards.replaceChildren(
          ...items.map((item) => {
            const card = document.createElement('article');
            card.className = 'card';
            const title = document.createElement('h3');
            title.textContent = item.title;
            const text = document.createElement('p');
            text.textContent = item.text;
            const price = document.createElement('p');
            price.className = 'price';
            price.textContent = item.price || '';
            card.append(title, text, price);
            return card;
          })
        );
      }
      load();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

