	export const metadata = {
		id: '08-cms/07-jamstack-deploy',
		part: 8,
		order: 7,
		title: 'Jamstack: the build, the CDN and the webhook',
		definition: 'Jamstack is an approach where pages are built ahead and served from a CDN, while dynamic parts come from APIs and services. A webhook picks up CMS edits.',
		summary: 'You’ll sketch the path “edit in the CMS, webhook, build, deploy to a CDN” for your own site, and see what is fast and safe in such a setup and what needs separate services (forms, search, payments, accounts). This is the era of 2022. The CDN gets a short mention here and a full one in part 9.',
		comic: {
			panels: [
				{
					mood: 'explain',
					prop: 'flowchart',
					label: 'CMS|webhook|build|CDN',
					caption: 'The path of an edit',
					say: 'The editor pressed “Publish”, a webhook woke the build, and the finished site went out to the CDN.'
				},
				{
					mood: 'cheer',
					side: 'right',
					prop: 'server',
					label: 'v12 is live',
					caption: 'The build failed',
					say: [
						{ text: 'The build failed!' },
						{ who: 'Site', text: 'I didn’t notice. The last version is still up.' }
					]
				},
				{
					mood: 'hmm',
					prop: 'envelope',
					label: 'contact form',
					caption: 'What about dynamic parts?',
					say: 'An outside service or a function takes the enquiry. The site can’t send email itself: it is a set of files.'
				}
			]
		},
		minutes: 20,
		teaches: ['cms-jamstack', 'cms-build-webhook-rebuild'],
		requires: ['cms-headless', 'cms-static-site-generator'],
		practice: {
			id: 'cms-deploy-scheme',
			title: 'The deployment scheme of your site',
			task: 'Describe how an edit to the content reaches your project’s site. 1) In the table, for the four steps (content source, build, deploy, delivery), write what happens and where or by whom it is done. Mention the webhook where an edit starts the build. 2) Say which outside service or function handles the visitor’s main action (a form, a booking, a payment), given that the site has no server code of its own. 3) Say where visitors’ personal data will land, and what storing it requires under the GDPR and US state privacy laws. 4) Name a way to roll back a bad publish. Every “…” has to be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="scheme">
      <h2>The site’s deployment scheme<\/h2>
      <table id="steps">
        <tr><th>Step<\/th><th>What happens<\/th><th>Where and who<\/th><\/tr>
        <tr class="step source"><td class="name">Content source<\/td><td class="what">…<\/td><td class="where">…<\/td><\/tr>
        <tr class="step build"><td class="name">Build<\/td><td class="what">…<\/td><td class="where">…<\/td><\/tr>
        <tr class="step deploy"><td class="name">Deploy<\/td><td class="what">…<\/td><td class="where">…<\/td><\/tr>
        <tr class="step serve"><td class="name">Delivery to visitors<\/td><td class="what">…<\/td><td class="where">…<\/td><\/tr>
      <\/table>
      <p id="action">The visitor’s main action, “{{mainAction.label}}”, is handled by: <span id="action-by">…<\/span><\/p>
      <p>Where visitors’ personal data lands, and what storing it requires under the GDPR and US state privacy laws: <span id="action-pd">…<\/span><\/p>
      <p>How to roll back a bad publish: <span id="rollback">…<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (blocks with data-scaffold). It does not go into the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="enquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="scheme">
      <h2>The site’s deployment scheme<\/h2>
      <table id="steps">
        <tr><th>Step<\/th><th>What happens<\/th><th>Where and who<\/th><\/tr>
        <tr class="step source"><td class="name">Content source<\/td><td class="what">the editor changes entries in a headless CMS; after saving, the CMS sends a webhook to the builder<\/td><td class="where">the CMS, edited by the owner<\/td><\/tr>
        <tr class="step build"><td class="name">Build<\/td><td class="what">the generator, started by the webhook, asks the API for the content and rebuilds every page<\/td><td class="where">a build service (CI), which starts by itself<\/td><\/tr>
        <tr class="step deploy"><td class="name">Deploy<\/td><td class="what">the finished folder is uploaded to the host and switched on as a whole, in one step<\/td><td class="where">a static host such as Netlify, Vercel or Cloudflare Pages<\/td><\/tr>
        <tr class="step serve"><td class="name">Delivery to visitors<\/td><td class="what">pages are delivered from the nearest copy, and the cache is cleared after a deploy<\/td><td class="where">the host’s CDN<\/td><\/tr>
      <\/table>
      <p id="action">The visitor’s main action, “{{mainAction.label}}”, is handled by: <span id="action-by">an outside form service: the form sends the enquiry to it and it forwards the enquiry to my email, so the site needs no server code of its own<\/span><\/p>
      <p>Where visitors’ personal data lands, and what storing it requires under the GDPR and US state privacy laws: <span id="action-pd">the enquiries sit with the form service and in my email; under the GDPR and state privacy laws I need a provider that signs a data processing agreement and stores the data in a region I choose (the EU or the US), and consent and a privacy notice go next to the form<\/span><\/p>
      <p>How to roll back a bad publish: <span id="rollback">in the host’s dashboard I switch back to the previous built version, which takes seconds, and then I fix the entry and publish again<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

