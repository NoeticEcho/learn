`
			},
			checks: [
				{ id: 'scheme-exists', kind: 'exists', selector: '#scheme' },
				{ id: 'no-blanks', kind: 'text', selector: '#scheme', matches: '^[^…]*$' },
				{ id: 'four-steps', kind: 'count', selector: '#steps tr.step', min: 4 },
				{ id: 'steps-described', kind: 'text', selector: '#steps td.what', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' },
				{
					id: 'webhook',
					kind: 'text',
					selector: '#steps',
					matches: '[wW][eE][bB][hH][oO][oO][kK]|[tT][rR][iI][gG][gG][eE][rR]|[cC][oO][mM][mM][iI][tT]'
				},
				{
					id: 'serve-cdn',
					kind: 'text',
					selector: '#steps tr.serve td.where',
					matches: '[cC][dD][nN]|[dD][eE][lL][iI][vV][eE][rR]|[sS][eE][rR][vV][eE]|[pP][aA][gG][eE][sS]|[hH][oO][sS][tT]|[nN][eE][tT][lL][iI][fF][yY]|[vV][eE][rR][cC][eE][lL]|[cC][lL][oO][uU][dD][fF][lL][aA][rR][eE]|[sS][eE][rR][vV][eE][rR]'
				},
				{
					id: 'action-external',
					kind: 'text',
					selector: '#action-by',
					matches: '[sS][eE][rR][vV][iI][cC][eE]|[fF][uU][nN][cC][tT][iI][oO][nN]|[fF][oO][rR][mM][sS][pP][rR][eE][eE]|[nN][eE][tT][lL][iI][fF][yY]|[sS][tT][rR][iI][pP][eE]|[pP][aA][yY][pP][aA][lL]|[sS][hH][oO][pP][iI][fF][yY]|[cC][rR][mM]|[cC][lL][oO][uU][dD]|[eE][mM][aA][iI][lL]|[tT][eE][lL][eE][gG][rR][aA][mM]|[bB][oO][tT]|[oO][uU][tT][sS][iI][dD][eE]|[eE][xX][tT][eE][rR][nN][aA][lL]|[pP][lL][aA][tT][fF][oO][rR][mM]|[tT][hH][iI][rR][dD]'
				},
				{
					id: 'pd-where',
					kind: 'text',
					selector: '#action-pd',
					matches: '(?=[\\s\\S]*(?:[eE][uU]|[uU][sS]|[uU][nN][iI][tT][eE][dD] [sS][tT][aA][tT][eE][sS]|[eE][uU][rR][oO][pP][eE]|[gG][dD][pP][rR]|[rR][eE][gG][iI][oO][nN]|[sS][tT][aA][tT][eE]|[cC][oO][uU][nN][tT][rR][yY]|[pP][rR][iI][vV][aA][cC][yY]))(?=[\\s\\S]*(?:[sS][eE][rR][vV][eE][rR]|[sS][tT][oO][rR]|[sS][eE][rR][vV][iI][cC][eE]|[pP][lL][aA][tT][fF][oO][rR][mM]|[cC][rR][mM]|[eE][mM][aA][iI][lL]|[fF][uU][nN][cC][tT][iI][oO][nN]|[pP][rR][oO][vV][iI][dD][eE][rR]))'
				},
				{
					id: 'rollback-way',
					kind: 'text',
					selector: '#rollback',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:[rR][oO][lL][lL]|[pP][rR][eE][vV][iI][oO][uU][sS]|[eE][aA][rR][lL][iI][eE][rR]|[vV][eE][rR][sS][iI][oO][nN]|[rR][eE][vV][eE][rR][tT]|[sS][wW][iI][tT][cC][hH]))'
				}
			]
		},
		quiz: [
			{
				type: 'order',
				prompt: 'Put the path of an edit in order, from the editor to the visitor',
				items: [
					'The editor presses “Publish” in the CMS',
					'The CMS sends the builder a webhook',
					'The generator rebuilds the site from the content in the API',
					'The finished folder is deployed to the host',
					'The CDN refreshes its copies and clears the old cache'
				]
			},
			{
				type: 'single',
				prompt: 'The build of a new version of the site failed with an error. What does a visitor see?',
				options: [
					'The previous version: a new one goes live only after a successful build, and as a whole',
					'A blank screen',
					'Half the pages new and half old'
				],
				answer: 0,
				why: [
					'Yes. This kind of deploy is called atomic: the site switches from one complete version to another, so there is no “half broken” state.',
					'No: this is exactly what such a setup does not allow, unless you switch on a failed build by hand.',
					'No: versions are never mixed, the switch happens all at once.'
				]
			},
			{
				type: 'multiple',
				prompt: 'Which of these are added to a static site from outside services, because the site has no server code of its own?',
				options: ['Receiving form submissions', 'Site search', 'Payments', 'Laying out the pages'],
				answer: [0, 1, 2],
				why: [
					'Yes: a form service or a function receives the data and forwards it to an inbox.',
					'Yes: search is built on a service, or on a ready index that is built along with the site (lesson 6 of part 7).',
					'Yes: a payment service takes the payment, and the site only sends the visitor there.',
					'No: laying out the pages is exactly what the generator does itself.'
				]
			},
			{
				type: 'single',
				prompt: 'What is a rollback in this setup?',
				options: [
					'Switching the site to the previous version that is already built: nothing is rebuilt, and it takes seconds',
					'Rebuilding the whole site from scratch',
					'Deleting the entry in the CMS'
				],
				answer: 0,
				why: [
					'Yes. Hosts keep earlier builds, so a rollback is a switch. Afterwards you fix the entry and publish again.',
					'No: the build is usually the slowest part, and a rollback does not repeat it.',
					'No: the entry stays, and what changes is the version of the site the visitor sees.'
				]
			},
			{
				type: 'single',
				prompt: 'A site has ten thousand pages, and every edit rebuilds all of them. What is the weak spot?',
				options: [
					'Build time grows with the number of pages, so an edit takes a long time to reach visitors',
					'The site becomes unsafe',
					'It stops opening on phones'
				],
				answer: 0,
				why: [
