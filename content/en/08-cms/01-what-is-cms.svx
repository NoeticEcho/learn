<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/08-cms/01-what-is-cms.svx. */
	export const metadata = {
		id: '08-cms/01-what-is-cms',
		part: 8,
		order: 1,
		title: 'What a CMS is, and why a site needs one',
		definition: 'A CMS (content management system) is software for editing a site’s content without knowing HTML: an admin screen, storage, templates, roles and publishing.',
		summary:
			'You’ll explain how a site of HTML files differs from a site on a CMS, name the three layers (content, template, code) and describe your project’s content model: the kinds of “things” (a service, an article, a person, a review) and their fields. Afterwards you have a table of content types with their editors and how often each changes.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'browser-1996',
					label: 'price: $3,000',
					caption: 'A site of files',
					say: [
						{ text: 'The price changed. I’m fixing page seven of twelve.' },
						{ who: 'Site', text: 'The other five I haven’t touched.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'sheet',
					label: 'service: price',
					caption: 'A field',
					say: 'A service is a record with fields. The price sits in one field, and the card, the page and the list only show it.'
				},
				{
					mood: 'cheer',
					prop: 'editor',
					label: 'save',
					caption: 'A CMS',
					say: 'One field, one edit, and the price is updated everywhere. The editor does not need a developer.'
				}
			]
		},
		minutes: 15,
		teaches: ['cms-what-is-cms', 'cms-content-model'],
		requires: ['server-static-vs-dynamic', 'data-relational-model', 'start-project-brief'],
		practice: {
			id: 'cms-content-model-table',
			title: 'Your project’s content model',
			task: 'Fill in the table of content types. The first row (the services or products from items) is almost done: add who edits them and how often. In the other rows, write: people (people), proofs (proofs) and section pages. For each give the name of the type, its fields separated by commas, who edits it (the owner, an editor or a developer) and how often (for example, “once a month”). If your project has no people or proofs, replace the row with a type of your own (for example, “Review” or “Event”). In the second table, for each section of your site write which types it shows. If the site has several languages, make the text fields per language (for example, title_en and title_es). Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="cms-model">
      <h2>The project’s content model<\/h2>
      <p>The types of content: each has its own fields, its own editor and its own frequency of edits.<\/p>
      <table id="model">
        <tr><th>Type<\/th><th>Fields (separated by commas)<\/th><th>Who edits<\/th><th>How often<\/th><\/tr>
        <tr class="type items"><td class="name">Service or product (items)<\/td><td class="fields">title, text, price<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type people"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type proofs"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
        <tr class="type pages"><td class="name">…<\/td><td class="fields">…<\/td><td class="owner">…<\/td><td class="freq">…<\/td><\/tr>
      <\/table>

      <h3>Which types each section of the site shows<\/h3>
      <table id="sections-map">
        <tr><th>Section<\/th><th>The types of content it shows<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="types">…<\/td><\/tr>
        {{/each}}
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling of the exercise (the data-scaffold blocks). It does not reach the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="cms-model">
      <h2>The project’s content model<\/h2>
      <p>The types of content: each has its own fields, its own editor and its own frequency of edits.<\/p>
      <table id="model">
        <tr><th>Type<\/th><th>Fields (separated by commas)<\/th><th>Who edits<\/th><th>How often<\/th><\/tr>
        <tr class="type items"><td class="name">Service or product (items)<\/td><td class="fields">title_en, title_es, text_en, text_es, price, photo<\/td><td class="owner">owner<\/td><td class="freq">once a month<\/td><\/tr>
        <tr class="type people"><td class="name">Person<\/td><td class="fields">name, role, bio_en, bio_es, photo<\/td><td class="owner">owner<\/td><td class="freq">once every six months<\/td><\/tr>
        <tr class="type proofs"><td class="name">Proof<\/td><td class="fields">title_en, title_es, number, date, scan<\/td><td class="owner">editor<\/td><td class="freq">once a year<\/td><\/tr>
        <tr class="type pages"><td class="name">Section page<\/td><td class="fields">title_en, title_es, text_en, text_es<\/td><td class="owner">editor<\/td><td class="freq">once a week<\/td><\/tr>
      <\/table>

      <h3>Which types each section of the site shows<\/h3>
      <table id="sections-map">
        <tr><th>Section<\/th><th>The types of content it shows<\/th><\/tr>
        {{#each sections}}<tr class="sec"><td>{{.}}<\/td><td class="types">section page; services and proofs, if the section is about them<\/td><\/tr>
        {{/each}}
      <\/table>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

