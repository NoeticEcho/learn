	export const metadata = {
		id: '08-cms/04-tilda-bitrix',
		part: 8,
		order: 4,
		title: 'Website builders and store platforms, from Wix to Tilda',
		definition: 'A website builder is a service where pages are put together from ready-made blocks and the site lives on the platform. Shopify adds a store.',
		summary:
			'You’ll see why website builders such as Wix, Squarespace and Webflow, and store platforms such as Shopify, exist beside WordPress, and how Russia’s Tilda and 1C-Bitrix fit the same picture. You decide what suits your project in budget, upkeep and integrations. Afterwards you have a reasoned choice with a cost estimate and a way out.',
		comic: {
			panels: [
				{
					mood: 'cheer',
					prop: 'browser',
					label: 'blocks',
					caption: 'A builder',
					say: [
						{ text: 'A site in an evening, and I edit it myself.' },
						{ who: 'Builder', text: 'Take the code with you if you leave? That depends on your plan.' }
					]
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'server',
					label: 'orders + stock',
					caption: 'A store platform',
					say: 'The catalog, the checkout and the orders come in the box, for a monthly plan. In Russia, 1C-Bitrix adds a link to 1C.'
				},
				{
					mood: 'hmm',
					prop: 'cards',
					label: 'budget, store, who edits',
					caption: 'Choosing',
					say: 'Not “what is trendy” but three questions: how much money, do you need a store, and who will edit?'
				}
			]
		},
		minutes: 20,
		teaches: ['cms-tilda', 'cms-bitrix'],
		requires: ['cms-what-is-cms', 'cms-content-model', 'html-forms'],
		practice: {
			id: 'cms-tilda-bitrix-pick',
			title: 'Choosing a platform for the project',
			task: 'Fill in the decision table. 1) For each of the three platforms (a website builder such as Wix, Squarespace or Webflow, Shopify, and WordPress) write whether it fits your project (yes, no or maybe), and why. 2) Name your choice. 3) Justify it with two fields of the brief: in the reasoning write the name of the main action (in quotation marks, as in the brief) and, if the project has services or products, at least one of their names. 4) Say where inquiries and visitors’ data will be stored. 5) Say which page is needed next to the form because of personal data. 6) In the cost table write numbers in US dollars a year for the four items. 7) Describe how you could leave the platform and what you could take with you. Every “…” has to be replaced.',
			era: 3,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="pick">
      <h2>The decision for the project: a website builder, Shopify or WordPress<\/h2>
      <table id="options">
        <tr><th>Platform<\/th><th>Does it fit? (yes, no, maybe)<\/th><th>Why<\/th><\/tr>
        <tr class="opt"><td>A website builder (Wix, Squarespace, Webflow)<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
        <tr class="opt"><td>Shopify<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
        <tr class="opt"><td>WordPress<\/td><td class="fit">…<\/td><td class="why">…<\/td><\/tr>
      <\/table>
      <p>My choice: <span id="choice">…<\/span><\/p>
      <p>The choice rests on fields of the brief (the main action “{{mainAction.label}}”, the services or products, the languages): <span id="reason">…<\/span><\/p>
      <p>Where inquiries and visitors’ data will be stored: <span id="pd">…<\/span><\/p>
      <p>Which page is needed next to the form because of personal data: <span id="consent">…<\/span><\/p>

      <h3>What it costs a year (an estimate, in US dollars)<\/h3>
      <table id="cost">
        <tr><th>Item<\/th><th>Amount a year<\/th><th>Comment<\/th><\/tr>
        <tr class="line"><td>Platform or license<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Hosting<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Domain<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
        <tr class="line"><td>Support and changes<\/td><td class="sum">…<\/td><td class="note">…<\/td><\/tr>
      <\/table>
      <p>How I can leave the platform, and what I can take with me: <span id="exit">…<\/span><\/p>
    <\/section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (data-scaffold blocks). It does not end up in the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="pick">
      <h2>The decision for the project: a website builder, Shopify or WordPress<\/h2>
      <table id="options">
        <tr><th>Platform<\/th><th>Does it fit? (yes, no, maybe)<\/th><th>Why<\/th><\/tr>
        <tr class="opt"><td>A website builder (Wix, Squarespace, Webflow)<\/td><td class="fit">yes<\/td><td class="why">a small site that the owner edits alone, and the inquiry form needs no server of my own<\/td><\/tr>
        <tr class="opt"><td>Shopify<\/td><td class="fit">no<\/td><td class="why">overkill: there is no store or big catalog, and a plan plus apps costs more than it brings<\/td><\/tr>
        <tr class="opt"><td>WordPress<\/td><td class="fit">maybe<\/td><td class="why">it fits, but I would have to watch the updates and the protection myself<\/td><\/tr>
      <\/table>
      <p>My choice: <span id="choice">A website builder (Squarespace)<\/span><\/p>
      <p>The choice rests on fields of the brief (the main action “{{mainAction.label}}”, the services or products, the languages): <span id="reason">the main action, “{{mainAction.label}}”, is served by a form the platform provides, and the list of services is short (for example, “{{items.0.title}}”) and rarely changes, so a builder is faster and cheaper<\/span><\/p>
      <p>Where inquiries and visitors’ data will be stored: <span id="pd">inquiries are stored on the platform’s servers and sent on to my email and a spreadsheet; the platform’s help pages must say in which region its servers are and what its data processing terms are<\/span><\/p>
      <p>Which page is needed next to the form because of personal data: <span id="consent">a privacy notice about how the data is used, linked next to the form, and a consent checkbox where the law requires one<\/span><\/p>

      <h3>What it costs a year (an estimate, in US dollars)<\/h3>
      <table id="cost">
        <tr><th>Item<\/th><th>Amount a year<\/th><th>Comment<\/th><\/tr>
        <tr class="line"><td>Platform or license<\/td><td class="sum">240<\/td><td class="note">an annual plan that allows custom code and has no platform ads<\/td><\/tr>
        <tr class="line"><td>Hosting<\/td><td class="sum">0<\/td><td class="note">included in the plan<\/td><\/tr>
        <tr class="line"><td>Domain<\/td><td class="sum">15<\/td><td class="note">registration and renewal<\/td><\/tr>
        <tr class="line"><td>Support and changes<\/td><td class="sum">300<\/td><td class="note">a few hours of a specialist a year<\/td><\/tr>
      <\/table>
      <p>How I can leave the platform, and what I can take with me: <span id="exit">on a paid plan I can export my text and images, and some builders export the site’s code too; the forms and the store have to be connected again elsewhere; the text and photos stay with me<\/span><\/p>
    <\/section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
