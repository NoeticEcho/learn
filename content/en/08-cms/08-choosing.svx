`
			},
			checks: [
				{ id: 'card-exists', kind: 'exists', selector: '#card' },
				{ id: 'no-blanks', kind: 'text', selector: '#card', matches: '^[^…]*$' },
				{
					id: 'editor',
					kind: 'text',
					selector: '#editor',
					matches: '[oO][wW][nN][eE][rR]|[eE][dD][iI][tT][oO][rR]|[dD][eE][vV][eE][lL][oO][pP][eE][rR]|[tT][eE][aA][mM]|[mM][yY][sS][eE][lL][fF]|[iI] |[wW][eE] |[fF][oO][uU][nN][dD][eE][rR]|[cC][lL][iI][eE][nN][tT]'
				},
				{
					id: 'frequency',
					kind: 'text',
					selector: '#freq',
					matches: '[oO][nN][cC][eE]|[tT][wW][iI][cC][eE]|[wW][eE][eE][kK]|[mM][oO][nN][tT][hH]|[dD][aA][iI][lL][yY]|[eE][vV][eE][rR][yY]|[yY][eE][aA][rR]|[qQ][uU][aA][rR][tT][eE][rR]|[rR][aA][rR][eE]|[oO][fF][tT][eE][nN]|[dD][aA][yY]'
				},
				{ id: 'action-by', kind: 'text', selector: '#action-by', matches: '\\S+\\s+\\S+\\s+\\S+' },
				{
					id: 'languages-storage',
					kind: 'text',
					selector: '#langs',
					matches: '[fF][iI][eE][lL][dD]|[tT][rR][aA][nN][sS][lL][aA][tT][iI][oO][nN]|_[a-z]{2}|[cC][oO][pP]([yY]|[iI][eE][sS])|[pP][aA][gG][eE]|[lL][aA][nN][gG][uU][aA][gG][eE]|[oO][nN][eE]|[sS][iI][nN][gG][lL][eE]'
				},
				{
					id: 'languages-bilingual',
					kind: 'text',
					selector: '#langs',
					matches: '[fF][iI][eE][lL][dD]|[tT][rR][aA][nN][sS][lL][aA][tT][iI][oO][nN]|_[a-z]{2}|[cC][oO][pP]([yY]|[iI][eE][sS])|[pP][aA][gG][eE]',
					when: { brief: 'languages', contains: 'ru' }
				},
				{
					id: 'stack-named',
					kind: 'text',
					selector: '#stack',
					matches: '[bB][uU][iI][lL][dD][eE][rR]|[wW][iI][xX]|[sS][qQ][uU][aA][rR][eE][sS][pP][aA][cC][eE]|[wW][eE][bB][fF][lL][oO][wW]|[wW][oO][rR][dD][pP][rR][eE][sS][sS]|[sS][hH][oO][pP][iI][fF][yY]|[bB][iI][tT][rR][iI][xX]|[gG][eE][nN][eE][rR][aA][tT][oO][rR]|[hH][uU][gG][oO]|[jJ][eE][kK][yY][lL][lL]|[eE][lL][eE][vV][eE][nN][tT][yY]|[aA][sS][tT][rR][oO]|[sS][vV][eE][lL][tT][eE][kK][iI][tT]|[hH][eE][aA][dD][lL][eE][sS][sS]|[sS][tT][rR][aA][pP][iI]|[dD][iI][rR][eE][cC][tT][uU][sS]|[sS][aA][nN][iI][tT][yY]|[dD][eE][cC][aA][pP]|[aA][pP][pP]'
				},
				{
					id: 'stack-why',
					kind: 'text',
					selector: '#why',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:[eE][dD][iI][tT][oO][rR]|[oO][wW][nN][eE][rR]|[eE][dD][iI][tT]|[oO][fF][tT][eE][nN]|[oO][nN][cC][eE]|[wW][eE][eE][kK]|[mM][oO][nN][tT][hH]|[bB][uU][dD][gG][eE][tT]|[dD][aA][tT][aA]|[fF][oO][rR][mM]))'
				},
				{ id: 'rejected-two', kind: 'count', selector: '#rejected tr.rejected', min: 2 },
				{ id: 'rejected-reasons', kind: 'text', selector: '#rejected td.reason', matches: '\\S+\\s+\\S+\\s+\\S+\\s+\\S+' },
				{
					id: 'revisit',
					kind: 'text',
					selector: '#revisit',
					matches: '(?=[\\s\\S]*\\S+\\s+\\S+\\s+\\S+\\s+\\S+)(?=[\\s\\S]*(?:[iI][fF]|[wW][hH][eE][nN]|[oO][nN][cC][eE]|[aA][sS] [sS][oO][oO][nN] [aA][sS]))'
				}
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'What questions do you start with when choosing a CMS or a generator?',
				options: [
					'Who edits the content, how often, what is needed besides pages, what the budget is and how many languages there are',
					'Which system is the most popular',
					'Which one looks the nicest in a theme directory'
				],
				answer: 0,
				why: [
					'Yes. Everything depends on the answers: a comfortable admin is for people who edit often and don’t write code, while rare edits are fine with files.',
					'No: popularity tells you what many people need, not what you need.',
					'No: the look can be changed, but the structure of the content and its upkeep are hard to change.'
				]
			},
			{
				type: 'single',
				prompt: 'A landing page with one form, edited by the owner once a month, on a small budget. What is most likely to fit?',
				options: ['A website builder such as Squarespace or Wix', 'A headless CMS and a generator', 'A custom CMS built to order'],
				answer: 0,
				why: [
					'Yes. The task is simple, the owner edits, and there is nothing to maintain. The builder’s limits don’t get in this project’s way.',
					'No: two systems and a build for a landing page is extra work.',
					'No: this is the costliest answer to the simplest task.'
				]
			},
			{
				type: 'single',
