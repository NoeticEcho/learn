	export const metadata = {
		id: '08-cms/08-choosing',
		part: 8,
		order: 8,
		title: 'How to choose: a decision tree for your project',
		definition: 'Choosing a CMS or generator starts with five questions: who edits, how often, what else is needed, the budget and the languages. A custom CMS comes last.',
		summary: 'You’ll get a working method for choosing among a site builder, WordPress, an all-in-one commerce platform, a generator and a headless CMS by five questions about your brief, and for defending the choice to a client or to yourself. Afterwards you have a decision card: the choice, two options set aside with reasons, and the condition for reconsidering. You’ll also learn when not to build a CMS of your own.',
		comic: {
			panels: [
				{
					mood: 'hmm',
					prop: 'cards',
					label: 'WP? Wix? Hugo?',
					caption: 'Where to start',
					say: 'Not “what is trendy”, but five questions: who edits, how often, what else is needed, the budget, the languages.'
				},
				{
					mood: 'explain',
					side: 'right',
					prop: 'sheet',
					label: 'my own CMS',
					caption: 'The temptation',
					say: [
						{ text: 'I’ll write my own CMS, it’s easier for me.' },
						{ who: 'Experience', text: 'Roles, versions, backups, security… That is years, not a weekend.' }
					]
				},
				{
					mood: 'cheer',
					prop: 'certificate',
					label: 'reconsider: when…',
					caption: 'The card',
					say: 'The choice is written down with its reasons. And beside it: the condition under which we’ll reconsider.'
				}
			]
		},
		minutes: 15,
		teaches: ['cms-choosing-stack'],
		requires: ['cms-wordpress-maintenance', 'cms-tilda', 'cms-bitrix', 'cms-ssg-landscape', 'cms-jamstack'],
		practice: {
			id: 'cms-decision-card',
			title: 'A decision card for your project',
			task: 'Fill in the decision card. 1) Who edits the content, and how often. 2) What handles the project’s main action (a form, a payment, a booking): a service, a plugin or a function of your own. 3) How the texts are stored in the project’s languages (a field for each language, a translation of the entry, copies of pages). 4) The budget. 5) Choose a stack and explain how the choice follows from the answers above. 6) Name two options you set aside, with a reason for each: the reasons must not repeat each other. 7) Write the condition under which you would reconsider the decision. Every “…” has to be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="card">
      <h2>Decision card: what to build the project’s site with<\/h2>
      <dl>
        <dt>Project<\/dt><dd>{{name}}: {{who}}<\/dd>
        <dt>Who edits the content<\/dt><dd id="editor">…<\/dd>
        <dt>How often<\/dt><dd id="freq">…<\/dd>
        <dt>The main action, “{{mainAction.label}}”: what handles it<\/dt><dd id="action-by">…<\/dd>
        <dt>Languages ({{languages}}) and how the texts are stored<\/dt><dd id="langs">…<\/dd>
        <dt>Budget<\/dt><dd id="budget">…<\/dd>
        <dt>Chosen stack<\/dt><dd id="stack">…<\/dd>
        <dt>Why it fits<\/dt><dd id="why">…<\/dd>
      <\/dl>
      <table id="rejected">
        <tr><th>Option set aside<\/th><th>Why it was set aside<\/th><\/tr>
        <tr class="rejected"><td class="option">…<\/td><td class="reason">…<\/td><\/tr>
        <tr class="rejected"><td class="option">…<\/td><td class="reason">…<\/td><\/tr>
      <\/table>
      <p>When I will reconsider the decision: <span id="revisit">…<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (blocks with data-scaffold). It does not go into the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="card">
      <h2>Decision card: what to build the project’s site with<\/h2>
      <dl>
        <dt>Project<\/dt><dd>{{name}}: {{who}}<\/dd>
        <dt>Who edits the content<\/dt><dd id="editor">the owner, without technical knowledge<\/dd>
        <dt>How often<\/dt><dd id="freq">once a month<\/dd>
        <dt>The main action, “{{mainAction.label}}”: what handles it<\/dt><dd id="action-by">a contact form from the builder: inquiries arrive by email, and the site has no server code of its own<\/dd>
        <dt>Languages ({{languages}}) and how the texts are stored<\/dt><dd id="langs">a field for each language (title, title_es), and in a builder the pages in a second language are made as copies with the same layout<\/dd>
        <dt>Budget<\/dt><dd id="budget">small: a subscription and a domain, with no separate developer<\/dd>
        <dt>Chosen stack<\/dt><dd id="stack">website builder (Squarespace or Wix)<\/dd>
        <dt>Why it fits<\/dt><dd id="why">the owner edits it once a month, the main action is a simple form, and the budget is small: a builder is the quickest and cheapest, and there is nothing to maintain<\/dd>
      <\/dl>
      <table id="rejected">
        <tr><th>Option set aside<\/th><th>Why it was set aside<\/th><\/tr>
        <tr class="rejected"><td class="option">WordPress<\/td><td class="reason">updates, backups and security would fall on the owner, and the project does not need what plugins offer<\/td><\/tr>
        <tr class="rejected"><td class="option">static site generator and Markdown<\/td><td class="reason">an owner without Git would find editing files awkward, and the project has no developer<\/td><\/tr>
      <\/table>
      <p>When I will reconsider the decision: <span id="revisit">if the project needs user accounts or custom logic, or if the subscription starts to cost more than hosting plus a specialist’s time<\/span><\/p>
    <\/section>


    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abridged */

*,
*::before,
