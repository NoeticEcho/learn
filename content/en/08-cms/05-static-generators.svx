<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/08-cms/05-static-generators.svx. */
	export const metadata = {
		id: '08-cms/05-static-generators',
		part: 8,
		order: 5,
		title: 'Static site generators and Markdown',
		definition: 'A static site generator is a program that turns Markdown files, data and a shared template into ready HTML files. Only those files go to the server.',
		summary:
			'You’ll write pages in Markdown with front matter, watch a generator turn them and a template into plain HTML, and be able to choose between Jekyll, Hugo, Eleventy, Astro and SvelteKit for a job. This is era 5 (2019) of your site: pages by section, a collection made of your services and one shared template.',
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'browser-1996', label: 'header × 50 files', caption: 'Before', say: 'The phone number in the header changed. I open fifty files…' },
				{
					mood: 'explain',
					side: 'right',
					prop: 'flowchart',
					label: 'Markdown|template|HTML',
					caption: 'The build',
					say: 'The text is in Markdown, the look is in one template. The generator builds ready HTML files from them.'
				},
				{
					mood: 'cheer',
					prop: 'server',
					label: 'ready files',
					caption: 'On the server',
					say: [
						{ text: 'And what is on the server?' },
						{ who: 'Server', text: 'Only finished files. Nothing to break.' }
					]
				}
			]
		},
		minutes: 25,
		teaches: ['cms-markdown-frontmatter', 'cms-static-site-generator', 'cms-ssg-landscape'],
		requires: ['cms-what-is-cms', 'html-semantic-elements', 'css-responsive', 'net-http-request-response'],
		practice: {
			id: 'cms-ssg-project',
			title: 'A site on a generator: Markdown, a collection and a template',
			task: 'The page holds a small generator project: settings, a shared template, one Markdown page for each section of your brief, a catalog page and a collection of services. 1) In site.yml write the site’s language (lang: en) and its languages (languages: …, as in the brief). 2) In layout.html take lang from the settings ({{ site.lang | escape }}), add a header with a menu made from the list of pages ({% for p in pages %} … {% endfor %}) and a footer; keep {{ content | strip }}. 3) In each section’s file add a description to the front matter and write the text. 4) In catalog.md print the services with a loop over the collection: {% for item in items %}- **{{ item.title | escape }}**, {{ item.price | escape }} {% endfor %}. The checks read the project’s files, and below you see the built HTML. The double braces in the template carry filters because the course’s editor itself substitutes values into plain braces. Every “…” has to be replaced.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="ssg">
      <h2>A site project on a generator<\/h2>
      <p>These are the project’s files, as in a real generator. Edit them right here: the HTML of every page appears below, under “Build result”.<\/p>

      <h3>site.yml: the site’s settings<\/h3>
      <textarea aria-label="site.yml: the site’s settings" id="cfg" rows="4">title: {{name}}
lang: …
languages: …<\/textarea>

      <h3>layout.html: the shared template, one for all pages<\/h3>
      <textarea aria-label="layout.html: the shared template, one for all pages" id="layout" rows="16"><!doctype html>
<html lang="…">
<head>
<meta charset="utf-8">
<title>{{ page.title | escape }}<\/title>
<\/head>
<body>
<main>{{ content | strip }}<\/main>
<\/body>
<\/html><\/textarea>

      <h3>Pages: one Markdown file per section<\/h3>
      {{#each sections}}<textarea aria-label="File {{.}}.md" class="md-file" data-collection="pages" data-path="{{.}}.md" rows="7">---
title: {{.}}
description: …
---
# {{.}}

…<\/textarea>
      {{/each}}
      <h3>catalog.md: a catalog page that takes its data from the collection<\/h3>
      <textarea aria-label="catalog.md: a catalog page that takes its data from the collection" class="md-file" data-collection="pages" data-path="catalog.md" rows="8">---
title: Catalog
description: …
---
# Catalog

…<\/textarea>

      <h3>The items collection: one file per service or product (the data comes from your brief)<\/h3>
      {{#each items}}<textarea aria-label="File items/{{title}}.md" class="md-file" data-collection="items" data-path="items/{{title}}.md" rows="5">---
title: {{title}}
price: {{price}}
---
{{text}}<\/textarea>
      {{/each}}
      <h3>Build result<\/h3>
      <div id="built"><\/div>
    <\/section>

    <script type="module" data-scaffold id="ssg-build">
      // A teaching generator (not Jekyll or Hugo): it builds the pages from the fields above and shows the result.
      // You don’t need to read this block. It is not part of your site.
      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/<\/g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      /** “---\\nkey: value\\n---\\ntext” → { data, body }. Values stay strings. */
      function frontMatter(text) {
      const m = /^\\s*---\\s*\\n([\\s\\S]*?)\\n---\\s*(?:\\n([\\s\\S]*))?$/.exec(text);
      if (!m) return { data: {}, body: text, ok: false };
      const data = {};
      for (const line of m[1].split('\\n')) {
      const k = /^([A-Za-z_][\\w-]*):\\s*(.*)$/.exec(line.trim());
      if (k) data[k[1]] = k[2].replace(/^["']|["']$/g, '');
      }
      return { data, body: m[2] ?? '', ok: true };
      }
      /** Substitution: loops, {{ path | filter }}. */
      function liquid(tpl, ctx) {
      const out = tpl.replace(/\\{%\\s*for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*%\\}([\\s\\S]*?)\\{%\\s*endfor\\s*%\\}/g, (_, v, list, body) =>
      (Array.isArray(ctx[list]) ? ctx[list] : []).map((item) => liquid(body, { ...ctx, [v]: item })).join('')
      );
      return out.replace(/\\{\\{\\s*([\\w.]+)\\s*(?:\\|\\s*(\\w+))?[^}]*\\}\\}/g, (_, path, filter) => {
      let v = path.split('.').reduce((o, k) => (o == null ? o : o[k]), ctx);
      if (v == null) v = '';
      return filter === 'escape' ? esc(v) : String(v).trim();
      });
      }
      const inline = (s) =>
      s
      .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1<\/strong>')
      .replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, '<a href="$2">$1<\/a>');
      /** Markdown in miniature: # and ## headings, paragraphs, “- ” lists, **bold**, [link](address). */
      function markdown(src) {
      const html = [];
      let para = [];
      let list = false;
      const flush = () => {
      if (para.length) html.push('<p>' + inline(para.join(' ')) + '<\/p>');
      para = [];
      };
      const close = () => {
      if (list) html.push('<\/ul>');
      list = false;
      };
      for (const raw of src.split('\\n')) {
      const line = raw.trim();
      let m;
      if (!line) (flush(), close());
      else if ((m = /^(#{1,3})\\s+(.*)$/.exec(line))) (flush(), close(), html.push(\`<h\${m[1].length}>\${inline(m[2])}<\/h\${m[1].length}>\`));
      else if ((m = /^[-*]\\s+(.*)$/.exec(line))) (flush(), list || html.push('<ul>'), (list = true), html.push('<li>' + inline(m[1]) + '<\/li>'));
      else (close(), para.push(line));
      }
      flush();
      close();
      return html.join('\\n');
      }
      /**
      * Builds one page: front matter, data substituted into the text, Markdown, then the layout.
      * site: the settings (title, lang...), pages: all pages [{title, path}], collections: { items: [...] }.
      */
      function buildPage(layout, site, file, pages, collections) {
      const fm = frontMatter(file);
      const ctx = { site, pages, ...collections, page: fm.data };
      const content = markdown(liquid(fm.body, ctx));
      return liquid(layout, { ...ctx, content });
      }

      function config() {
        const out = {};
        for (const line of document.getElementById('cfg').value.split('\\n')) {
          const m = /^([A-Za-z_]\\w*):\\s*(.*)$/.exec(line.trim());
          if (m) out[m[1]] = m[2];
        }
        return out;
      }
      function build() {
        const box = document.getElementById('built');
        box.replaceChildren();
        const layout = document.getElementById('layout').value;
        const files = (kind) => [...document.querySelectorAll('textarea.md-file[data-collection="' + kind + '"]')];
        const items = files('items').map((t) => frontMatter(t.value).data);
        const list = files('pages').map((t) => ({ t, title: frontMatter(t.value).data.title || t.dataset.path, path: t.dataset.path.replace(/\\.md$/, '.html') }));
        for (const p of list) {
          const html = buildPage(layout, config(), p.t.value, list.map((x) => ({ title: x.title, path: x.path })), { items });
          const d = document.createElement('details');
          const s = document.createElement('summary');
          s.textContent = p.path + ' (' + html.length + ' characters of HTML)';
          const pre = document.createElement('pre');
          pre.textContent = html;
          d.append(s, pre);
          box.append(d);
        }
      }
      for (const t of document.querySelectorAll('#ssg textarea')) t.addEventListener('input', build);
      build();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, abbreviated */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* Styling for the exercise (data-scaffold blocks). It does not end up in the site. */
[data-scaffold] {
  margin: 1.5rem auto;
  max-width: 50rem;
  padding: 1rem;
  border: 2px dashed #7a8aa0;
  border-radius: 0.5rem;
  background-color: #fbfcfd;
}

[data-scaffold] table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

[data-scaffold] th,
[data-scaffold] td {
  padding: 0.35rem 0.5rem;
  border: 1px solid #c4ccd8;
  text-align: left;
  vertical-align: top;
}

[data-scaffold] textarea {
  display: block;
  width: 100%;
  min-height: 5.5rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] pre {
  margin: 0.25rem 0 0.5rem;
  padding: 0.5rem;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background-color: #eef1f5;
  font: 0.9rem/1.45 ui-monospace, Menlo, Consolas, monospace;
}

[data-scaffold] .out {
  margin: 0 0 1rem;
  overflow-x: auto;
}

[data-scaffold] .err {
  color: #8f1d1d;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}<\/title>
    <link rel="stylesheet" href="styles.css">
  <\/head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}<\/p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}<\/a><\/li>
          <li><a href="#sec-2">{{sections.1}}<\/a><\/li>
          <li><a href="#sec-3">{{sections.2}}<\/a><\/li>
        <\/ul>
      <\/nav>
    <\/header>

    <main id="main">
      <h1>{{name}}<\/h1>
      <p>{{who}}<\/p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}<\/a><\/p>

      <section id="sec-1">
        <h2>{{sections.0}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-2">
        <h2>{{sections.1}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="sec-3">
        <h2>{{sections.2}}<\/h2>
        <p>A couple of sentences about this section.<\/p>
      <\/section>

      <section id="offer">
        <h2>What we offer<\/h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}<\/h3>
            <p>{{text}}<\/p>
            <p class="price">{{price}}<\/p>
          <\/article>
          {{/each}}
        <\/div>
      <\/section>

      <section id="inquiry">
        <h2>{{mainAction.label}}<\/h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?<\/label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          <\/p>
          <p>
            <label for="f-phone">Phone<\/label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          <\/p>
          <p><button type="submit">{{mainAction.label}}<\/button><\/p>
        <\/form>
      <\/section>
    <\/main>

    <section data-scaffold id="ssg">
      <h2>A site project on a generator<\/h2>
      <p>These are the project’s files, as in a real generator. Edit them right here: the HTML of every page appears below, under “Build result”.<\/p>

      <h3>site.yml: the site’s settings<\/h3>
      <textarea aria-label="site.yml: the site’s settings" id="cfg" rows="4">title: {{name}}
lang: en
languages: {{languages}}<\/textarea>

      <h3>layout.html: the shared template, one for all pages<\/h3>
      <textarea aria-label="layout.html: the shared template, one for all pages" id="layout" rows="16"><!doctype html>
<html lang="{{ site.lang | escape }}">
<head>
<meta charset="utf-8">
<title>{{ page.title | escape }} | {{ site.title | escape }}<\/title>
<\/head>
<body>
<header><strong>{{ site.title | escape }}<\/strong>
<nav>{% for p in pages %}<a href="{{ p.path | escape }}">{{ p.title | escape }}<\/a> {% endfor %}<\/nav><\/header>
<main>{{ content | strip }}<\/main>
<footer>{{ site.title | escape }}, all rights reserved<\/footer>
<\/body>
<\/html><\/textarea>

      <h3>Pages: one Markdown file per section<\/h3>
      {{#each sections}}<textarea aria-label="File {{.}}.md" class="md-file" data-collection="pages" data-path="{{.}}.md" rows="7">---
title: {{.}}
description: A section of the site
---
# {{.}}

You write the section’s text here in plain words, and the header and footer are filled in from the template.<\/textarea>
      {{/each}}
      <h3>catalog.md: a catalog page that takes its data from the collection<\/h3>
      <textarea aria-label="catalog.md: a catalog page that takes its data from the collection" class="md-file" data-collection="pages" data-path="catalog.md" rows="8">---
title: Catalog
description: Every item from the collection
---
# Catalog

{% for item in items %}- **{{ item.title | escape }}**, {{ item.price | escape }}
{% endfor %}<\/textarea>

      <h3>The items collection: one file per service or product (the data comes from your brief)<\/h3>
      {{#each items}}<textarea aria-label="File items/{{title}}.md" class="md-file" data-collection="items" data-path="items/{{title}}.md" rows="5">---
title: {{title}}
price: {{price}}
---
{{text}}<\/textarea>
      {{/each}}
      <h3>Build result<\/h3>
      <div id="built"><\/div>
    <\/section>

    <script type="module" data-scaffold id="ssg-build">
      // A teaching generator (not Jekyll or Hugo): it builds the pages from the fields above and shows the result.
      // You don’t need to read this block. It is not part of your site.
      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/<\/g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      /** “---\\nkey: value\\n---\\ntext” → { data, body }. Values stay strings. */
      function frontMatter(text) {
      const m = /^\\s*---\\s*\\n([\\s\\S]*?)\\n---\\s*(?:\\n([\\s\\S]*))?$/.exec(text);
      if (!m) return { data: {}, body: text, ok: false };
      const data = {};
      for (const line of m[1].split('\\n')) {
      const k = /^([A-Za-z_][\\w-]*):\\s*(.*)$/.exec(line.trim());
      if (k) data[k[1]] = k[2].replace(/^["']|["']$/g, '');
      }
      return { data, body: m[2] ?? '', ok: true };
      }
      /** Substitution: loops, {{ path | filter }}. */
      function liquid(tpl, ctx) {
      const out = tpl.replace(/\\{%\\s*for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*%\\}([\\s\\S]*?)\\{%\\s*endfor\\s*%\\}/g, (_, v, list, body) =>
      (Array.isArray(ctx[list]) ? ctx[list] : []).map((item) => liquid(body, { ...ctx, [v]: item })).join('')
      );
      return out.replace(/\\{\\{\\s*([\\w.]+)\\s*(?:\\|\\s*(\\w+))?[^}]*\\}\\}/g, (_, path, filter) => {
      let v = path.split('.').reduce((o, k) => (o == null ? o : o[k]), ctx);
      if (v == null) v = '';
      return filter === 'escape' ? esc(v) : String(v).trim();
      });
      }
      const inline = (s) =>
      s
      .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1<\/strong>')
      .replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, '<a href="$2">$1<\/a>');
      /** Markdown in miniature: # and ## headings, paragraphs, “- ” lists, **bold**, [link](address). */
      function markdown(src) {
      const html = [];
      let para = [];
      let list = false;
      const flush = () => {
      if (para.length) html.push('<p>' + inline(para.join(' ')) + '<\/p>');
      para = [];
      };
      const close = () => {
      if (list) html.push('<\/ul>');
      list = false;
      };
      for (const raw of src.split('\\n')) {
      const line = raw.trim();
      let m;
      if (!line) (flush(), close());
      else if ((m = /^(#{1,3})\\s+(.*)$/.exec(line))) (flush(), close(), html.push(\`<h\${m[1].length}>\${inline(m[2])}<\/h\${m[1].length}>\`));
      else if ((m = /^[-*]\\s+(.*)$/.exec(line))) (flush(), list || html.push('<ul>'), (list = true), html.push('<li>' + inline(m[1]) + '<\/li>'));
      else (close(), para.push(line));
      }
      flush();
      close();
      return html.join('\\n');
      }
      /**
      * Builds one page: front matter, data substituted into the text, Markdown, then the layout.
      * site: the settings (title, lang...), pages: all pages [{title, path}], collections: { items: [...] }.
      */
      function buildPage(layout, site, file, pages, collections) {
      const fm = frontMatter(file);
      const ctx = { site, pages, ...collections, page: fm.data };
      const content = markdown(liquid(fm.body, ctx));
      return liquid(layout, { ...ctx, content });
      }

      function config() {
        const out = {};
        for (const line of document.getElementById('cfg').value.split('\\n')) {
          const m = /^([A-Za-z_]\\w*):\\s*(.*)$/.exec(line.trim());
          if (m) out[m[1]] = m[2];
        }
        return out;
      }
      function build() {
        const box = document.getElementById('built');
        box.replaceChildren();
        const layout = document.getElementById('layout').value;
        const files = (kind) => [...document.querySelectorAll('textarea.md-file[data-collection="' + kind + '"]')];
        const items = files('items').map((t) => frontMatter(t.value).data);
        const list = files('pages').map((t) => ({ t, title: frontMatter(t.value).data.title || t.dataset.path, path: t.dataset.path.replace(/\\.md$/, '.html') }));
        for (const p of list) {
          const html = buildPage(layout, config(), p.t.value, list.map((x) => ({ title: x.title, path: x.path })), { items });
          const d = document.createElement('details');
          const s = document.createElement('summary');
          s.textContent = p.path + ' (' + html.length + ' characters of HTML)';
          const pre = document.createElement('pre');
          pre.textContent = html;
          d.append(s, pre);
          box.append(d);
        }
      }
      for (const t of document.querySelectorAll('#ssg textarea')) t.addEventListener('input', build);
      build();
    <\/script>

    <footer class="site-footer">
      <p>{{name}}, {{city}}<\/p>
    <\/footer>
  <\/body>
<\/html>
`,
