				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <main>
      <section class="sb" id="sb-hero">
        <h1>{{title}}</h1>
        <p class="want">You get a clear answer and a plan of action without wasted trips.</p>
        <a class="cta" href="#sb-plan">{{mainAction.label}}</a>
      </section>

      <section class="sb" id="sb-problem">
        <h2>A question that hangs around</h2>
        <ul>
          <li class="external">The matter stands still while the deadlines go by.</li>
          <li class="internal">It’s worrying and awkward: it isn’t clear whom to ask.</li>
          <li class="philosophical">Sorting out your own affairs shouldn’t be this hard.</li>
        </ul>
      </section>

      <section class="sb" id="sb-guide">
        <h2>We know this</h2>
        <p class="empathy">We understand how unpleasant it is to put a question off, and we explain everything in plain words.</p>
        <p class="authority">We work from documents: {{proofs.0.title}}.</p>
      </section>

      <section class="sb" id="sb-plan">
        <h2>How it will go</h2>
        <ol>
          <li>You tell us about your situation.</li>
          <li>We name the time, the price and the order of work.</li>
          <li>You get the result and a clear next step.</li>
        </ol>
        <a class="cta" href="#sb-hero">{{mainAction.label}}</a>
      </section>

      <section class="sb" id="sb-stakes">
        <h2>If nothing is done</h2>
        <p>The question won’t go away by itself, and the time left to settle it will get shorter.</p>
      </section>

      <section class="sb" id="sb-success">
        <h2>How it will be afterwards</h2>
        <p>You know what to do next, and you stop thinking about it at night.</p>
      </section>
    </main>
  </body>
</html>
`
