				'styles.css': `/* Layers: the order is declared once, at the top. A later layer beats an earlier one,
   and anything outside the layers beats every layer. */
@layer reset, base, components, utilities;

/* Tokens: every design decision's value in one place. */
:root {
  --color-text: #1d2430;
  --color-bg: #ffffff;
  --color-surface: #f3f5f8;
  --color-accent: #1a4d8f;
  --color-on-accent: #ffffff;
  --space: 1rem;
  --radius: 0.5rem;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

/* Dark theme: only the tokens’ values change. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #e8ecf2;
    --color-bg: #11161d;
    --color-surface: #1b2330;
    --color-accent: #8fb8f0;
    --color-on-accent: #0b1a2e;
  }
}

@layer reset {
  html {
    box-sizing: border-box;
    font-size: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

@layer base {
  body {
    font: 1.0625rem/1.6 var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
  }
}

@layer components {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: var(--space);
    color: var(--color-on-accent);
    background-color: var(--color-accent);

    & a {
      color: inherit;
    }

    & .brand {
      margin: 0;
      font-size: 1.5rem;
    }

    & nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .layout {
    display: grid;
    grid-template-areas:
      "main"
      "aside";
    gap: 2rem;
    max-width: 62.5rem;
    margin: 0 auto;
    padding: 1.5rem var(--space);

    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
      grid-template-areas: "main aside";
    }

    & main {
      grid-area: main;
    }

    & aside {
      grid-area: aside;
    }
  }

  .cards {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space);
  }

  .card {
    padding: var(--space);
    background-color: var(--color-surface);
    border-radius: var(--radius);

    & h3 {
      margin-top: 0;
    }

    @container (min-width: 40rem) {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space);
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .site-footer {
    padding: var(--space);
    background-color: var(--color-surface);
  }
}

@layer utilities {
  .skip {
    position: absolute;
    left: -999px;

    &:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background-color: var(--color-bg);
    }
  }
}

/* :has(): styling by content. Outside the layers, so it beats any layer. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}

/* Motion: a short response on the button, and the cards appearing. */
.button {
  transition-property: transform, background-color;
  transition-duration: 0.2s;
  transition-timing-function: ease-out;
}

.button:hover {
  transform: translateY(-2px);
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(0.75rem);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.card {
  animation-name: rise;
  animation-duration: 0.5s;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

/* Reduce motion: no movement, but keep the gentle appearance. */
@media (prefers-reduced-motion: reduce) {
  .button:hover {
    transform: none;
  }

  .card {
    animation-name: appear;
  }
}
`
			},
			checks: [
				{ id: 'button-transition', kind: 'style', selector: 'a.button', prop: 'transition-property', matches: '^(?!all$).+' },
				{ id: 'button-cheap', kind: 'style', selector: 'a.button', prop: 'transition-property', matches: '^(?!.*(width|height|top|left|right|bottom|margin|padding)).+' },
				{ id: 'button-duration', kind: 'style', selector: 'a.button', prop: 'transition-duration', matches: '^(?!0s$).+' },
				{ id: 'card-animation', kind: 'style', selector: '.card', prop: 'animation-name', matches: '^(?!none$).+', when: { brief: 'items[].title' } },
				{ id: 'card-short', kind: 'style', selector: '.card', prop: 'animation-duration', matches: '^(0?\\.\\d+|1)s$', when: { brief: 'items[].title' } }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'What is prefers-reduced-motion: reduce?',
				options: [
