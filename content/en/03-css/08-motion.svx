	export const metadata = {
		id: '03-css/08-motion',
		part: 3,
		order: 8,
		title: 'Animation and motion, with respect for people',
		definition: 'CSS animation is change over time, made with transitions and @keyframes. The prefers-reduced-motion query tones it down for people it harms.',
		summary:
			'A little motion shows what happened, and too much gets in the way and can even harm people with vestibular disorders. Afterwards you’ll make smooth transitions and an entrance animation, and respect the “reduce motion” setting.',
		minutes: 20,
		teaches: ['css-transitions-animations', 'css-reduced-motion'],
		requires: ['css-custom-properties', 'html-a11y-basics'],
		comic: {
			panels: [
				{ mood: 'cheer', prop: 'browser', label: 'the button lifted', caption: '200 milliseconds', say: 'Good motion is a gesture: the button lifted a little, so you know you can press it.' },
				{ mood: 'hmm', side: 'right', prop: 'phone', label: 'reduce motion', say: 'Slides and parallax make some people dizzy. For them every system has a “reduce motion” setting.' },
				{ mood: 'hint', prop: 'editor', label: 'prefers-reduced-motion', say: 'The site reads the setting: drop the slides and zooms, keep the fades and color changes. Motion belongs to the reader.' }
			]
		},
		practice: {
			id: 'motion',
			title: 'Motion on your site: the cherry on top of the 2025 era',
			task: 'Add motion that helps. 1) Give the .button a smooth transition: transition-property made only of transform and a color (not all, and not any size), transition-duration about 0.2s, and on :hover let the button lift slightly (transform). 2) Give the .card elements an entrance animation: @keyframes rise (from transparent and a little lower to visible), animation-name, and an animation-duration no longer than a second. 3) Write an @media (prefers-reduced-motion: reduce) block: remove the movement (no transform on hover), and for the cards swap the animation for a gentle fade with no slide. Check that block yourself in the developer tools: the checks can’t see it.',
			era: 7,
			continues: 'modern-css',
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://riverbend.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://riverbend.example/og.png">
    <meta property="og:locale" content="en_GB">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://riverbend.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://riverbend.example/">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site language">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>A couple of sentences about this section.</p>
          <img src="photo.jpg" width="160" height="160" alt="Photo of {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="offer">
          <h2>What we offer</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Terms and prices</h2>
          <table>
            <caption>What is included and what it costs</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">What’s included</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="enquiry">
          <h2>{{mainAction.label}}</h2>
          <form action="/enquiry" method="post">
            <p>
              <label for="f-name">What should we call you?</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Phone</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">For example, +44 0000 000000. We’ll call during working hours.</small>
            </p>
            <fieldset>
              <legend>When is it best to call?</legend>
              <label><input type="radio" name="when" value="morning" checked> Morning</label>
              <label><input type="radio" name="when" value="day"> Afternoon</label>
              <label><input type="radio" name="when" value="evening"> Evening</label>
            </fieldset>
            <p>
              <label for="f-comment">Briefly, what do you need</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> I agree to my personal data being processed, as described in the <a href="privacy.html">privacy notice</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Credentials</h2>
          {{#each proofs}}<figure>
            <img src="scan.jpg" width="120" height="160" alt="Scan of a document">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Privacy notice</a> · <a href="#top">Back to top</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* Layers: the order is declared once, at the top. A later layer beats an earlier one,
   and anything outside the layers beats every layer. */
@layer reset, base, components, utilities;

/* Tokens: every design decision's value in one place. */
:root {
  --color-text: #1d2430;
  --color-bg: #ffffff;
  --color-surface: #f3f5f8;
  --color-accent: #1a4d8f;
  --color-on-accent: #ffffff;
  --space: 1rem;
  --radius: 0.5rem;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

/* Dark theme: only the tokens’ values change. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #e8ecf2;
    --color-bg: #11161d;
    --color-surface: #1b2330;
    --color-accent: #8fb8f0;
    --color-on-accent: #0b1a2e;
  }
}

@layer reset {
  html {
    box-sizing: border-box;
    font-size: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

@layer base {
  body {
    font: 1.0625rem/1.6 var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
  }
}

@layer components {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: var(--space);
    color: var(--color-on-accent);
    background-color: var(--color-accent);

    & a {
      color: inherit;
    }

    & .brand {
      margin: 0;
      font-size: 1.5rem;
    }

    & nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .layout {
    display: grid;
    grid-template-areas:
      "main"
      "aside";
    gap: 2rem;
    max-width: 62.5rem;
    margin: 0 auto;
    padding: 1.5rem var(--space);

    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
      grid-template-areas: "main aside";
    }

    & main {
      grid-area: main;
    }

    & aside {
      grid-area: aside;
    }
  }

  .cards {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space);
  }

  .card {
    padding: var(--space);
    background-color: var(--color-surface);
    border-radius: var(--radius);

    & h3 {
      margin-top: 0;
    }

    @container (min-width: 40rem) {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space);
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .site-footer {
    padding: var(--space);
    background-color: var(--color-surface);
  }
}

@layer utilities {
  .skip {
    position: absolute;
    left: -999px;

    &:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background-color: var(--color-bg);
    }
  }
}

/* :has(): styling by content. Outside the layers, so it beats any layer. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}
`
			},
