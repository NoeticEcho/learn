          <p>A couple of sentences about this section.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="offer">
          <h2>What we offer</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Terms and prices</h2>
          <table>
            <caption>What is included and what it costs</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">What’s included</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="enquiry">
          <h2>{{mainAction.label}}</h2>
          <form action="/enquiry" method="post">
            <p>
              <label for="f-name">What should we call you?</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Phone</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">For example, +44 0000 000000. We’ll call during working hours.</small>
            </p>
            <fieldset>
              <legend>When is it best to call?</legend>
              <label><input type="radio" name="when" value="morning" checked> Morning</label>
              <label><input type="radio" name="when" value="day"> Afternoon</label>
              <label><input type="radio" name="when" value="evening"> Evening</label>
            </fieldset>
            <p>
              <label for="f-comment">Briefly, what do you need</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> I agree to my personal data being processed, as described in the <a href="privacy.html">privacy notice</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Credentials</h2>
          {{#each proofs}}<figure>
            <img src="scan.jpg" width="120" height="160" alt="Scan of a document">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Privacy notice</a> · <a href="#top">Back to top</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* Layers: the order is declared once, at the top. A later layer beats an earlier one,
   and anything outside the layers beats every layer. */
@layer reset, base, components, utilities;

/* Tokens: every design decision's value in one place. */
:root {
  --color-text: #1d2430;
  --color-bg: #ffffff;
  --color-surface: #f3f5f8;
  --color-accent: #1a4d8f;
  --color-on-accent: #ffffff;
  --space: 1rem;
  --radius: 0.5rem;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

/* Dark theme: only the tokens’ values change. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #e8ecf2;
    --color-bg: #11161d;
    --color-surface: #1b2330;
    --color-accent: #8fb8f0;
    --color-on-accent: #0b1a2e;
  }
}

@layer reset {
  html {
    box-sizing: border-box;
    font-size: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
}

@layer base {
  body {
    font: 1.0625rem/1.6 var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  a {
    color: var(--color-accent);
  }
}

@layer components {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: var(--space);
    color: var(--color-on-accent);
    background-color: var(--color-accent);

    & a {
      color: inherit;
    }

    & .brand {
      margin: 0;
      font-size: 1.5rem;
    }

    & nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }

  .layout {
    display: grid;
    grid-template-areas:
      "main"
      "aside";
    gap: 2rem;
    max-width: 62.5rem;
    margin: 0 auto;
    padding: 1.5rem var(--space);

    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
      grid-template-areas: "main aside";
    }

    & main {
      grid-area: main;
    }

    & aside {
      grid-area: aside;
    }
  }

  .cards {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space);
  }

  .card {
    padding: var(--space);
    background-color: var(--color-surface);
    border-radius: var(--radius);

    & h3 {
      margin-top: 0;
    }

    @container (min-width: 40rem) {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space);
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .site-footer {
    padding: var(--space);
    background-color: var(--color-surface);
  }
}

@layer utilities {
  .skip {
    position: absolute;
    left: -999px;

    &:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background-color: var(--color-bg);
    }
  }
}

/* :has(): styling by content. Outside the layers, so it beats any layer. */
section:has(.cards) {
  padding-top: calc(var(--space) * 1.5);
  padding-bottom: calc(var(--space) * 1.5);
}

form:has(input:user-invalid) button[type="submit"] {
  opacity: 0.7;
}
`
			},
			checks: [
				{ id: 'var-text', kind: 'style', selector: ':root', prop: '--color-text', matches: '\\S' },
				{ id: 'var-bg', kind: 'style', selector: ':root', prop: '--color-bg', matches: '\\S' },
				{ id: 'var-surface', kind: 'style', selector: ':root', prop: '--color-surface', matches: '\\S' },
				{ id: 'var-accent', kind: 'style', selector: ':root', prop: '--color-accent', matches: '\\S' },
				{ id: 'var-space', kind: 'style', selector: ':root', prop: '--space', matches: '\\S' },
				{ id: 'color-scheme', kind: 'attr', selector: 'meta[name="color-scheme"]', name: 'content', matches: 'light dark' },
				{ id: 'has', kind: 'style', selector: 'section:has(.cards)', prop: 'padding-top', matches: '^(?!0px$|0$).+' }
			]
		},
		quiz: [
			{
				type: 'single',
				prompt: 'What does color: var(--color-accent) do?',
				options: [
					'It reads the value of the variable --color-accent: change the variable and the color changes everywhere it’s used',
					'It copies the color once, when the page loads',
					'It declares a new variable'
				],
				answer: 0,
				why: [
					'Yes. CSS variables are live: the browser works them out as it goes, and they inherit, so changing a few values can switch a whole theme.',
					'No: the value is read every time, and it can have different values in different parts of the page.',
					'No: you declare a variable like this: --color-accent: #1a4d8f; (with two hyphens). var() only reads.'
				]
			},
			{
				type: 'single',
				prompt: 'A rule outside any layer and a rule inside @layer components color the same element differently. The layered rule has the higher specificity. Which wins?',
				options: [
					'The rule outside the layers',
					'The rule in the layer, because its selector is more specific',
					'The order in the file decides'
				],
				answer: 0,
				why: [
					'Yes. Rules outside any layer beat every layer, and specificity isn’t compared between a layer and “no layer”. That’s why unlayered rules are the strongest.',
					'No: between layers and unlayered rules the layer is looked at first. Specificity only decides inside one layer.',
					'No: the order in the file decides last, when everything else is equal.'
				]
			},
			{
				type: 'multiple',
				prompt: 'What can CSS variables do that a preprocessor’s variables can’t?',
				options: [
					'Change in the browser: different blocks can have different values',
					'Be read and changed from JavaScript',
					'Inherit down the tree',
					'Disappear at build time: the browser gets only the finished values'
				],
				answer: [0, 1, 2],
				why: [
					'Yes: just redefine the variable on the block you want.',
					'Yes: that’s how a theme switcher works, for example.',
					'Yes: they inherit, like the text color does.',
					'No: that describes a preprocessor’s variables, such as Sass. CSS variables stay in the browser and stay live.'
				]
			},
			{
				type: 'order',
				prompt: 'Put the layers in order from weakest to strongest, if the order was declared as @layer reset, base, components, utilities;',
				items: ['reset', 'base', 'components', 'utilities']
			},
			{
				type: 'single',
				prompt: 'What does the selector section:has(.cards) select?',
				options: [
