	export const metadata = {
		id: '03-css/07-modern-css',
		part: 3,
		order: 7,
		title: 'Modern CSS: variables, nesting, :has() and layers',
		definition: 'Modern CSS is a set of newer features (variables, nesting, :has() and @layer) that replaced preprocessors and scripts.',
		summary:
			'Today’s CSS does things that once needed preprocessors and scripts. Afterwards you’ll gather values into variables, nest rules, style a block by what it contains with :has(), and put your styles in order with layers.',
		minutes: 30,
		teaches: ['css-custom-properties', 'css-nesting', 'css-has-selector', 'css-cascade-layers'],
		requires: ['css-specificity', 'css-color', 'css-container-queries'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'sheet', label: 'styles.css', caption: 'The accent in thirty places', say: 'I want a different accent color. Now I have to hunt for it all over the file.' },
				{ mood: 'explain', side: 'right', prop: 'editor', label: '--color-accent', say: 'Name the value by its role and put it in :root. Then one line changes the color, not thirty.' },
				{ mood: 'cheer', prop: 'browser', label: 'prefers-color-scheme: dark', say: 'A dark theme almost for free: only the variables’ values change. Card and button rules stay as they are.' }
			]
		},
		practice: {
			id: 'modern-css',
			title: 'Your site, rewritten in modern CSS',
			task: 'This is the same page you finished last time, but its styles have the values “hard-wired” in. Rewrite them the modern way. 1) On :root, declare the variables --color-text, --color-bg, --color-surface, --color-accent and --space, and use them through var() instead of the repeated values. 2) Dark theme: inside @media (prefers-color-scheme: dark), change only the variables’ values, and add a meta tag named color-scheme with the content light dark to the head. 3) Declare the order of the layers at the top of the file, @layer reset, base, components, utilities;, and sort your rules into them. 4) Nest the .site-header and .card rules with &. 5) Put the section:has(.cards) rule with its inner padding outside the layers, so that it beats any layer.',
			era: 7,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://riverbend.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://riverbend.example/og.png">
    <meta property="og:locale" content="en_GB">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://riverbend.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://riverbend.example/">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site language">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>A couple of sentences about this section.</p>
          <img src="photo.jpg" width="160" height="160" alt="Photo of {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="offer">
          <h2>What we offer</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Terms and prices</h2>
          <table>
            <caption>What is included and what it costs</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">What’s included</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="enquiry">
          <h2>{{mainAction.label}}</h2>
          <form action="/enquiry" method="post">
            <p>
              <label for="f-name">What should we call you?</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Phone</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">For example, +44 0000 000000. We’ll call during working hours.</small>
            </p>
            <fieldset>
              <legend>When is it best to call?</legend>
              <label><input type="radio" name="when" value="morning" checked> Morning</label>
              <label><input type="radio" name="when" value="day"> Afternoon</label>
              <label><input type="radio" name="when" value="evening"> Evening</label>
            </fieldset>
            <p>
              <label for="f-comment">Briefly, what do you need</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> I agree to my personal data being processed, as described in the <a href="privacy.html">privacy notice</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Credentials</h2>
          {{#each proofs}}<figure>
            <img src="scan.jpg" width="120" height="160" alt="Scan of a document">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Privacy notice</a> · <a href="#top">Back to top</a></p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the 2014 site’s base (reset and typography). You write the layout yourself. */

html {
  box-sizing: border-box;
  font-size: 100%;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

img {
  max-width: 100%;
  height: auto;
}

a {
  color: #1a4d8f;
}

nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.skip {
  position: absolute;
  left: -999px;
}

.skip:focus {
  left: 0.5rem;
  top: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: #ffffff;
  color: #1d2430;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* ===== Layout: your work starts here ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-areas:
    "main"
    "aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}


/* Wide screen: we add, we don’t take away (mobile first). */
@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    grid-template-areas: "main aside";
  }
}

/* The card looks at the width of its own space, not the window’s. */
@container (min-width: 40rem) {
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1rem;
  }
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
