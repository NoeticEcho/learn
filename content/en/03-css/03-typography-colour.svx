body {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  color: #1f2a33;
  background-color: #f6f4ee;
}

a {
  color: #1d5c63;
}

.site-header {
  padding: 1rem;
  color: #ffffff;
  background-color: #1d5c63;
  background-image: linear-gradient(#2b7a84, #1d5c63);
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

nav ul {
  margin: 0.5rem 0 0;
  padding: 0;
  list-style: none;
}

nav li {
  display: inline;
  margin-right: 1rem;
}

.button {
  display: inline-block;
  padding: 0.5rem 1rem;
  color: #ffffff;
  background-color: #1d5c63;
  background-image: linear-gradient(#2b7a84, #1d5c63);
  border: 1px solid #14464c;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  margin-bottom: 1rem;
  padding: 1rem;
  background-color: #ffffff;
  border: 1px solid #c9c4b6;
}

.site-footer {
  padding: 1rem;
  background-color: #e6e2d6;
}

/* Layout: two columns made with float, the way it was done in 2005. */

html {
  box-sizing: border-box;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

.layout {
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 0 1rem;
}

main {
  float: left;
  width: 68%;
}

aside {
  float: right;
  width: 28%;
  padding: 1rem;
  background-color: #ffffff;
  border: 1px solid #c9c4b6;
}

footer {
  clear: both;
}
`
