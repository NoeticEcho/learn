<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/05-javascript/05-modules-tooling.svx. */
	export const metadata = {
		id: '05-javascript/05-modules-tooling',
		part: 5,
		order: 5,
		title: 'Modules, npm and bundling',
		definition: 'An ES module is a JavaScript file that shares names with export and takes names with import. npm installs packages, and a bundler assembles modules.',
		summary:
			'One long script soon turns into a mess. Afterwards you’ll split code into files with ES modules, read a package.json, understand what a bundler does and see why dependencies are worth guarding.',
		minutes: 25,
		teaches: ['js-modules', 'js-tooling'],
		requires: ['js-fetch', 'net-url-anatomy'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'sheet', label: 'items', caption: 'Shared names', say: 'Two files called a variable items. One quietly overwrote the other, and nobody knew why.' },
				{ mood: 'explain', side: 'right', prop: 'flowchart', label: 'data.js|render.js|main.js', caption: 'Modules', say: 'A module says what it hands out (export) and what it takes from others (import). The rest is its own business.' },
				{ mood: 'hint', prop: 'editor', label: 'from ./data.js', say: 'The .js in the path is required. And open the page through a local server: over file:// modules won’t load.' }
			]
		},
		practice: {
			id: 'js-modules-plan',
			title: 'Split your site’s code into modules',
			task: 'The sandbox can’t load several files, so you’ll write the modules as text, in pre blocks, as if they lay in files. Fill in every “…” in the block “The page’s modules”. 1) data.js: export const items = […], with your items from the brief (title, text, price). 2) render.js: import items from ./data.js (the .js extension is required) and export a function renderCards(container) that builds the cards with createElement and textContent. 3) main.js: import items and renderCards and call them. 4) package.json: a name and the type set to module. 5) In the paragraph “External packages” write which outside packages you need and how much they weigh, or that you need none. Inside pre, the < sign is written as &lt;. You’ll have to test the modules on your own machine: save the files and start a local server (the lesson says how).',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="modules">
      <h2>The page’s modules</h2>
      <p>The <code>data.js</code> file: the data from the brief.</p>
      <pre data-file="data.js">…<\/pre>
      <p>The <code>render.js</code> file: draws the cards.</p>
      <pre data-file="render.js">…<\/pre>
      <p>The <code>main.js</code> file: puts it all together.</p>
      <pre data-file="main.js">…<\/pre>
      <p>The <code>package.json</code> file.</p>
      <pre data-file="package.json">…<\/pre>
      <p id="deps">External packages: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="modules">
      <h2>The page’s modules</h2>
      <p>The <code>data.js</code> file: the data from the brief.</p>
      <pre data-file="data.js">// data.js: the page’s data lives apart from the code that draws it.
export const items = [
        {{#each items}}{ title: '{{title}}', text: '{{text}}', price: '{{price}}' },
        {{/each}}
];<\/pre>
      <p>The <code>render.js</code> file: draws the cards.</p>
      <pre data-file="render.js">// render.js: takes the data and builds the cards. It knows nothing about where the page is run from.
import { items } from './data.js';

export function renderCards(container) {
  const cards = items.map((item) => {
    const card = document.createElement('article');
    card.className = 'card';
    const title = document.createElement('h3');
    title.textContent = item.title;
    const text = document.createElement('p');
    text.textContent = item.text;
    card.append(title, text);
    return card;
  });
  container.replaceChildren(...cards);
}<\/pre>
      <p>The <code>main.js</code> file: puts it all together.</p>
      <pre data-file="main.js">// main.js: the entry point. The page loads it with one line: a script tag with type="module" and src="main.js".
import { items } from './data.js';
import { renderCards } from './render.js';

const container = document.querySelector('#offer .cards');
renderCards(container);
document.querySelector('#offer-count').textContent = 'Offers: ' + items.length;<\/pre>
      <p>The <code>package.json</code> file.</p>
      <pre data-file="package.json">{
  "name": "my-site",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve ."
  }
}<\/pre>
      <p id="deps">External packages: none needed, everything is plain JavaScript.</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

