<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/05-javascript/06-why-frameworks.svx. */
	export const metadata = {
		id: '05-javascript/06-why-frameworks',
		part: 5,
		order: 6,
		title: 'Why frameworks exist',
		definition: 'A framework such as React, Vue, Svelte or Angular builds an interface from components and derives the view from state. This is called reactivity.',
		summary:
			'Hand-written DOM code works while the page has only a few places to keep in step. Afterwards you’ll see where it starts to crack, understand what React, Vue, Svelte and Angular solve and what that costs a visitor, and be able to answer calmly “do I need a framework at all?”',
		minutes: 25,
		teaches: ['js-why-frameworks', 'js-reactivity'],
		requires: ['js-dom', 'js-events', 'js-modules'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'browser', label: '3 items', caption: 'One place forgotten', say: 'The list updated, the counter was forgotten. The page says “3 items” and shows five cards.' },
				{ mood: 'explain', side: 'right', prop: 'editor', label: 'addItem(item)', say: 'By hand you must remember every place: list, counter, badge, links. Forget one and nothing warns you.' },
				{ mood: 'cheer', prop: 'flowchart', label: 'state|view', caption: 'Reactivity', say: 'One state, and the view is derived from it. The counter simply equals the list’s length.' },
				{ mood: 'hint', caption: 'When it is needed', say: 'Three or four places to keep in step? Plain JavaScript is enough. The tenth place? Then a framework pays off.' }
			]
		},
		practice: {
			id: 'js-framework-notes',
			title: 'Does your project need a framework? Review your own page',
			task: 'Find three places on the page where the view and the state have to be kept in step by hand (the scripts above have them: the counter, the quick links, the menu, the search), and fill in the table “Where the page is kept in step by hand”: what is kept in step with what, how it is done now, and how it would work in a reactive way. Each cell is a real sentence, not “…”. Then write a verdict for your project (the “Verdict” paragraph): whether it needs a framework or not, in view of the number of sections and items in your brief (write those numbers down). And in the last paragraph give the weight of your scripts in kilobytes (roughly, from the Network tab or the file size) and say how it affects the first load.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="framework-notes">
      <h2>Where the page is kept in step by hand</h2>
      <table>
        <tr><th>What must be kept in step with what</th><th>How it is done now</th><th>How it is simpler when reactive</th></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="sync"><td>…</td><td>…</td><td>…</td></tr>
      </table>
      <h3>Verdict for my project</h3>
      <p id="verdict">…</p>
      <p id="js-weight">…</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="framework-notes">
      <h2>Where the page is kept in step by hand</h2>
      <table>
        <tr><th>What must be kept in step with what</th><th>How it is done now</th><th>How it is simpler when reactive</th></tr>
        <tr class="sync"><td>The list of cards and the counter “Shown: N of M”</td><td>In the search handler I recalculate shown myself and write the counter’s text, and I write it again after loading from the server: two places that are easy to get out of step.</td><td>The counter is declared as a value computed from the list and the query, so it updates itself wherever the list changes.</td></tr>
        <tr class="sync"><td>The list of cards and the quick links</td><td>The quick links are built once when the page opens, so after the list loads from the server the new item is missing from them.</td><td>The cards and the links are drawn from one array, so they cannot drift apart.</td></tr>
        <tr class="sync"><td>The menu button and the list of sections</td><td>The aria-expanded attribute and the hidden property are changed by two commands in setMenu. If I forget one, the screen reader tells the visitor something untrue.</td><td>There is one state, open, and aria-expanded and hidden are derived from it and change together.</td></tr>
      </table>
      <h3>Verdict for my project</h3>
      <p id="verdict">For my project (5 sections and 4 items) a framework is not needed yet: only 3 places have to be kept in step by hand, and they fit in a hundred lines. I’ll think again if the items grow in number or an account area with shared state appears.</p>
      <p id="js-weight">My scripts weigh about 6 KB, so the first load is hardly slowed. A framework would add tens of kilobytes more, which a phone would have to download and parse before the first paint.</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
