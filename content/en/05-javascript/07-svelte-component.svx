<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/05-javascript/07-svelte-component.svx. */
	export const metadata = {
		id: '05-javascript/07-svelte-component',
		part: 5,
		order: 7,
		title: 'A Svelte component',
		definition: 'A Svelte component is a .svelte file with the code, markup and styles of one piece of interface. The runes $state, $derived and $props set its state and inputs.',
		summary:
			'A component is a piece of interface with its own data, markup and styling. Afterwards you’ll read a .svelte file, understand the runes $state, $derived and $props, and move a block of your page into components: a card and a list with search.',
		minutes: 30,
		teaches: ['js-svelte-component'],
		requires: ['js-reactivity', 'js-modules'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'editor', label: 'let open = $state(false)', say: 'A plain open = !open, and the screen changes. No “find the element”, no setOpen: the $state rune makes a value live.' },
				{ mood: 'hint', side: 'right', prop: 'flowchart', label: 'items|query|shown', caption: '$derived', say: 'shown is derived from items and query and recalculates itself. You can’t forget to update the list or the counter.' },
				{ mood: 'cheer', prop: 'sheet', label: 'plain JavaScript', caption: 'The build', say: 'The browser doesn’t know Svelte. The compiler writes plain JavaScript ahead: value changed, update that node.' }
			]
		},
		practice: {
			id: 'js-svelte-components',
			title: 'Your project’s card and list as components',
			task: 'The sandbox doesn’t build Svelte, so you write the components as text, in the fields of the block “The page’s components”, as if they lay in files. Fill in every “…”. 1) ItemCard.svelte: takes item with let { item } = $props(), keeps in $state whether the “More” block is open, shows {item.title} and {item.price}, and on a button with aria-expanded shows {item.text}. 2) ItemList.svelte: imports ItemCard, takes items through $props, keeps the query in $state and works out the shown list with $derived; the search field is tied with bind:value; the cards are shown with {#each … as item (item.title)}, and an empty list shows a message through {:else}. 3) App.svelte: an items array with your items from the brief, and the line <ItemList {items} />. 4) Count the lines of code: by hand (your scripts on the page) and in the components. 5) In the paragraph about JavaScript write what a visitor sees without the script. You can test the components in the Svelte playground at svelte.dev/playground.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="components">
      <h2>The page’s components</h2>
      <p>The <code>ItemCard.svelte</code> file: one card.</p>
      <textarea data-file="ItemCard.svelte" rows="14" cols="70" spellcheck="false">…<\/textarea>
      <p>The <code>ItemList.svelte</code> file: the list with search.</p>
      <textarea data-file="ItemList.svelte" rows="16" cols="70" spellcheck="false">…<\/textarea>
      <p>The <code>App.svelte</code> file: the data and the assembly of the page.</p>
      <textarea data-file="App.svelte" rows="10" cols="70" spellcheck="false">…<\/textarea>
      <p id="lines">Lines of code: by hand …, in components ….</p>
      <p id="nojs">Without JavaScript: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#enquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="enquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/enquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="components">
      <h2>The page’s components</h2>
      <p>The <code>ItemCard.svelte</code> file: one card.</p>
      <textarea data-file="ItemCard.svelte" rows="14" cols="70" spellcheck="false"><script>
  let { item } = $props();
  let open = $state(false);
<\/script>

<article class="card">
  <h3>{item.title}</h3>
  <p class="price">{item.price}</p>
  <button type="button" aria-expanded={open} onclick={() => (open = !open)}>More</button>
  {#if open}
    <p>{item.text}</p>
  {/if}
</article><\/textarea>
      <p>The <code>ItemList.svelte</code> file: the list with search.</p>
      <textarea data-file="ItemList.svelte" rows="16" cols="70" spellcheck="false"><script>
  import ItemCard from './ItemCard.svelte';

  let { items } = $props();
  let query = $state('');
  let shown = $derived(
    items.filter((item) => item.title.toLowerCase().includes(query.trim().toLowerCase()))
  );
<\/script>

<label>Search the list <input type="search" bind:value={query}></label>
<p role="status">Shown: {shown.length} of {items.length}</p>

<div class="cards">
  {#each shown as item (item.title)}
    <ItemCard {item} />
  {:else}
    <p>Nothing found.</p>
  {/each}
</div><\/textarea>
      <p>The <code>App.svelte</code> file: the data and the assembly of the page.</p>
      <textarea data-file="App.svelte" rows="10" cols="70" spellcheck="false"><script>
  import ItemList from './ItemList.svelte';

  const items = [
    {{#each items}}{ title: '{{title}}', text: '{{text}}', price: '{{price}}' },
    {{/each}}
  ];
<\/script>

<ItemList {items} /><\/textarea>
      <p id="lines">Lines of code: by hand 140, in components 45.</p>
      <p id="nojs">Without JavaScript: in a SvelteKit project the list is rendered on the server and is visible, minus the search; in a plain Vite project the page stays empty until the script loads.</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/enquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/enquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Enquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The enquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
