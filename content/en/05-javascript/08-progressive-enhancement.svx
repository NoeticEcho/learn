<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/05-javascript/08-progressive-enhancement.svx. */
	export const metadata = {
		id: '05-javascript/08-progressive-enhancement',
		part: 5,
		order: 8,
		title: 'Progressive enhancement',
		definition: 'Progressive enhancement is a way to build a page in layers: the essentials work in HTML without JavaScript, and a script adds conveniences on top.',
		summary:
			'A script doesn’t always reach the visitor: a weak network, a crash, a blocker, an old browser. Afterwards you’ll build a page whose essentials work without JavaScript while a script makes it better, and you’ll test that with the script switched off.',
		minutes: 20,
		teaches: ['js-progressive-enhancement'],
		requires: ['js-fetch', 'js-events', 'html-forms'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'phone', label: 'loading...', caption: 'On the train', say: 'The page is visible, but the script is still on its way. The menu button is there and does nothing: a dud.' },
				{ mood: 'explain', side: 'right', prop: 'flowchart', label: 'HTML|CSS|JavaScript', caption: 'Layers', say: 'HTML works everywhere. CSS decorates, JavaScript adds conveniences. Each layer only improves the one before.' },
				{ mood: 'cheer', prop: 'browser', label: 'JavaScript is off', say: 'The markup hides the menu button and the script shows it, so there are no duds. The form submits without a script too.' },
				{ mood: 'hint', side: 'right', caption: 'How to test', say: 'Switch JavaScript off in the developer tools, reload the page and see what is left.' }
			]
		},
		practice: {
			id: 'js-progressive-page',
			title: 'A page that works without the script too',
			task: 'Make the page resilient. 1) Fill in the table “What is essential and what is an enhancement”: at least five features, each marked with the word “essential” or “enhancement” and with what the visitor sees without JavaScript. 2) Make the essentials independent of the script: add an aside block with the id contacts, holding the address from the brief and tel: and mailto: links (the phone and email from the brief), and after the header put a <noscript> with a paragraph saying the page works without JavaScript too. The inquiry form keeps its action and method, and the main action is labeled with the words from the brief. 3) Search is useless without a script, so hide it in the markup (the hidden attribute on the form with the id search), and let the script show it. 4) Add a fifth script, a module script with the id enhance-code: it shows the search form (search.hidden = false) and checks the phone live: an input listener on the #f-phone field, aria-invalid and a message in a span with the id phone-hint and role status after the field. Both actions are wrapped in an “is the element there” check (if). Test without the script: on your own machine switch JavaScript off in the developer tools and reload the page. The automatic check sees the page after the scripts have run, when hidden is already removed, so that search is hidden without JavaScript can only be seen that way.',
			era: 5,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers">
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="enhancement-plan">
      <h2>What is essential and what is an enhancement</h2>
      <table>
        <tr><th>Feature</th><th>Essential or enhancement</th><th>What the visitor sees without JavaScript</th></tr>
        <tr class="feature"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="feature"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="feature"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="feature"><td>…</td><td>…</td><td>…</td></tr>
        <tr class="feature"><td>…</td><td>…</td><td>…</td></tr>
      </table>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/inquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/inquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Inquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The inquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

main {
  max-width: 50rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

a {
  color: #1a4d8f;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-block;
  min-height: 2.75rem;
  padding: 0.625rem 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.price {
  font-weight: 600;
}

input,
button {
  font: inherit;
}

input {
  min-height: 2.75rem;
  padding: 0 0.75rem;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

[hidden] {
  display: none !important;
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <button type="button" id="menu-button" aria-expanded="false" aria-controls="menu-list" hidden>Sections</button>
        <ul id="menu-list">
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>
    <noscript>
      <p>JavaScript is switched off in your browser. The page works anyway: the list, the sections, the contacts and the inquiry form are all available, and only search and the menu do not work.</p>
    </noscript>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <nav id="quick" aria-label="Quick links to the offers"></nav>
        <p id="offer-count"></p>
        <form id="search" role="search" aria-label="Search the offers" hidden>
          <label for="q">Search the list</label>
          <input id="q" type="search" autocomplete="off">
        </form>
        <p id="nothing" hidden>Nothing found. Try another word.</p>
        <p id="status" role="status"></p>
        <button type="button" id="retry" hidden>Try again</button>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form id="request-form" action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint">
            <span id="phone-hint" role="status"></span>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
          <p id="form-status" role="status"></p>
        </form>
      </section>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </main>


    <section data-scaffold id="enhancement-plan">
      <h2>What is essential and what is an enhancement</h2>
      <table>
        <tr><th>Feature</th><th>Essential or enhancement</th><th>What the visitor sees without JavaScript</th></tr>
        <tr class="feature"><td>The list of offers</td><td>essential</td><td>All the cards are in the markup and visible at once.</td></tr>
        <tr class="feature"><td>The main action: the inquiry form</td><td>essential</td><td>The form submits the ordinary way: the page reloads and the inquiry goes to the server.</td></tr>
        <tr class="feature"><td>Contacts</td><td>essential</td><td>The phone and email work as tel: and mailto: links.</td></tr>
        <tr class="feature"><td>The menu button</td><td>enhancement</td><td>The list of sections is always visible. There is no button: it appears only together with the script.</td></tr>
        <tr class="feature"><td>Search in the list</td><td>enhancement</td><td>There is no search field: it is useless without a script, so the script shows it.</td></tr>
        <tr class="feature"><td>Live phone check</td><td>enhancement</td><td>The browser checks the field itself on submit (required and type="tel").</td></tr>
      </table>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The brief’s data: the list items. For now they live here;
      // in the fetch lesson we moved them to a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Titles only. map makes a new array, and items stays as it was.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items are in the list.
      const countOf = (list) => list.length;

      const summary =
        'Items in all: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>

    <script type="module" id="events-code">
      const button = document.querySelector('#menu-button');
      const menu = document.querySelector('#menu-list');
      const search = document.querySelector('#search');
      const nothing = document.querySelector('#nothing');
      const count = document.querySelector('#offer-count');

      // The menu: without the script the list is always visible, with the script it hides behind a button.
      button.hidden = false;
      menu.hidden = true;

      function setMenu(open) {
        menu.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      }

      button.addEventListener('click', () => {
        setMenu(menu.hidden);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          setMenu(false);
          button.focus();
        }
      });

      // Search: one handler on the form catches input in its fields (bubbling).
      search.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      search.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        // Find the cards at the moment of the event: the list may have changed.
        const cards = document.querySelectorAll('#offer .card');
        let shown = 0;
        cards.forEach((card) => {
          const match = card.textContent.toLowerCase().includes(query);
          card.hidden = !match;
          if (match) shown += 1;
        });
        nothing.hidden = shown > 0;
        count.textContent = 'Shown: ' + shown + ' of ' + cards.length;
      });
    <\/script>
    <fieldset data-scaffold id="net-sim">
      <legend>Server mock: the state of the connection</legend>
      <label><input type="radio" name="net" value="ok" checked> all is well</label>
      <label><input type="radio" name="net" value="slow"> slow, three seconds</label>
      <label><input type="radio" name="net" value="offline"> connection lost</label>
      <label><input type="radio" name="net" value="error500"> the server broke (500)</label>
      <label><input type="radio" name="net" value="missing404"> no such file (404)</label>
    </fieldset>
    <script type="module" data-scaffold>
      // A MOCK SERVER. The sandbox lets no real requests through, so fetch
      // on this page is replaced: it answers as chosen above.
      // A real site has no such block, and the addresses lead to your server.
      const snapshot = [...document.querySelectorAll('#offer .card')].map((card) => ({
        title: card.querySelector('h3').textContent,
        text: card.querySelector('p').textContent,
        price: card.querySelector('.price')?.textContent ?? ''
      }));
      const reply = (data, status = 200) =>
        new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      window.fetch = async (url, options = {}) => {
        const mode = document.querySelector('input[name="net"]:checked').value;
        await pause(mode === 'slow' ? 3000 : 600);
        if (mode === 'offline') throw new TypeError('Failed to fetch');
        if (mode === 'error500') return reply({ error: 'The server broke' }, 500);
        if (mode === 'missing404') return reply({ error: 'Not found' }, 404);
        const path = new URL(url, 'https://site.example/').pathname;
        if (path === '/items.json') {
          return reply([...snapshot, { title: 'A new item from the server', text: 'It is not in the markup: it came from items.json.', price: '' }]);
        }
        if (path === '/inquiry' && options.method === 'POST') return reply({ id: 17 }, 201);
        return reply({ error: 'Not found' }, 404);
      };
    <\/script>

    <script type="module" id="fetch-code">
      const cardsBox = document.querySelector('#offer .cards');
      const status = document.querySelector('#status');
      const retry = document.querySelector('#retry');
      const count = document.querySelector('#offer-count');
      const form = document.querySelector('#request-form');
      const formStatus = document.querySelector('#form-status');
      const submit = form.querySelector('button[type="submit"]');

      // Build cards from the server’s data: text only through textContent.
      function showCards(items) {
        const cards = items.map((item, index) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.id = 'item-' + (index + 1);
          const title = document.createElement('h3');
          title.textContent = item.title;
          const text = document.createElement('p');
          text.textContent = item.text;
          const price = document.createElement('p');
          price.className = 'price';
          price.textContent = item.price;
          card.append(title, text, price);
          return card;
        });
        cardsBox.replaceChildren(...cards);
        count.textContent = 'Offers: ' + cards.length;
      }

      async function loadItems() {
        status.textContent = 'Loading the latest list…';
        retry.hidden = true;
        cardsBox.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/items.json');
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const items = await response.json();
          showCards(items);
          status.textContent = '';
        } catch (error) {
          console.error(error);
          status.textContent = 'Could not refresh the list, so the saved one is shown. Check your connection and try again.';
          retry.hidden = false;
        } finally {
          cardsBox.removeAttribute('aria-busy');
        }
      }

      retry.addEventListener('click', loadItems);
      loadItems();

      // The form: without the script it submits the ordinary way, with the script without a reload.
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        submit.disabled = true;
        formStatus.textContent = 'Sending…';
        try {
          const response = await fetch('/inquiry', { method: 'POST', body: new FormData(form) });
          if (!response.ok) {
            throw new Error('The server replied with code ' + response.status);
          }
          const result = await response.json();
          formStatus.textContent = 'Inquiry received, reference ' + result.id + '. We’ll be in touch.';
          form.reset();
        } catch (error) {
          console.error(error);
          formStatus.textContent = 'The inquiry was not sent. Your details are still in the form: try again or call us.';
        } finally {
          submit.disabled = false;
        }
      });
    <\/script>
    <script type="module" id="enhance-code">
      const search = document.querySelector('#search');
      const phone = document.querySelector('#f-phone');
      const hint = document.querySelector('#phone-hint');

      // Search is useless without a script, so the markup hides it and the script shows it.
      if (search) {
        search.hidden = false;
      }

      // Live phone check: an enhancement on top of the browser’s own check.
      if (phone && hint) {
        phone.addEventListener('input', () => {
          const digits = phone.value.replace(/\\D/g, '');
          const ok = phone.value === '' || digits.length >= 10;
          phone.setAttribute('aria-invalid', String(!ok));
          hint.textContent = ok ? '' : ' Phone: at least ten digits, for example +44 0000 000000.';
        });
      }
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

