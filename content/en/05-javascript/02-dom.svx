}

.skip {
  position: absolute;
  left: -999px;
}

.skip:focus {
  left: 0.5rem;
  top: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: #ffffff;
  color: #1d2430;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* ===== Layout: your work starts here ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-areas:
    "main"
    "aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}


/* Wide screens: we add rules, we do not take them away (mobile first). */
@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    grid-template-areas: "main aside";
  }
}

/* The card looks at the width of its own place, not the window. */
@container (min-width: 40rem) {
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1rem;
  }
}
`
			},
			checks: [
				{ id: 'quick-nav', kind: 'exists', selector: '#offer nav#quick' },
				{ id: 'quick-label', kind: 'attr', selector: 'nav#quick', name: 'aria-label', matches: '\\S' },
				{ id: 'count-element', kind: 'exists', selector: '#offer-count' },
				{ id: 'dom-code-exists', kind: 'exists', selector: 'script#dom-code' },
				{ id: 'is-module', kind: 'attr', selector: '#dom-code', name: 'type', matches: '^module$' },
				{ id: 'cards-kept', kind: 'count', selector: '#offer article.card', min: { brief: 'items' } },
				{ id: 'finds-cards', kind: 'text', selector: '#dom-code', matches: 'querySelectorAll\\(' },
				{ id: 'creates', kind: 'text', selector: '#dom-code', matches: 'createElement\\(' },
				{ id: 'inserts', kind: 'text', selector: '#dom-code', matches: '\\.(?:append|appendChild|prepend|replaceChildren)\\(' },
				{ id: 'text-content', kind: 'text', selector: '#dom-code', matches: 'textContent' },
				{ id: 'no-inner-html', kind: 'text', selector: '#dom-code', matches: '^(?![\\s\\S]*(?:\\.(?:innerHTML|outerHTML)\\s*\\+?=|insertAdjacentHTML|document\\.write))[\\s\\S]*\\S' },
				{ id: 'empty-state', kind: 'text', selector: '#dom-code', matches: '\\.length\\s*(?:===?|<=?)\\s*[01]\\b|!\\s*[\\w.]+\\.length' },
				{ id: 'semantic-list', kind: 'text', selector: '#dom-code', matches: '^(?=[\\s\\S]*createElement\\(\\s*[\'"](?:ul|ol)[\'"]\\s*\\))(?=[\\s\\S]*createElement\\(\\s*[\'"]li[\'"]\\s*\\))' },
