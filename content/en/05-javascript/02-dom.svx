  min-height: 2.75rem;
  padding: 0 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
