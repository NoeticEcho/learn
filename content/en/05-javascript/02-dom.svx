<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/05-javascript/02-dom.svx. */
	export const metadata = {
		id: '05-javascript/02-dom',
		part: 5,
		order: 2,
		title: 'The DOM: a page that can be changed',
		definition: 'The DOM is the document object model: the tree of nodes a browser builds from HTML. JavaScript finds elements in it, changes them and creates new ones.',
		summary:
			'A browser keeps the page as a tree, and JavaScript can search it, read it and change it. Afterwards you’ll find elements with selectors, create new ones from data, and understand why other people’s text must never go in through innerHTML.',
		minutes: 25,
		teaches: ['js-dom'],
		requires: ['js-arrays-and-objects', 'html-semantic-elements'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'browser', label: 'document', caption: 'Find, change, insert', say: 'The page is handed to the script as a tree called document. Whatever the script changes, the browser redraws at once.' },
				{ mood: 'hmm', side: 'right', prop: 'editor', label: 'box.innerHTML = name', caption: 'The name came from a visitor', say: 'What if the name is really markup with a handler? The browser can’t tell it from yours, and runs the stranger’s code.' },
				{ mood: 'cheer', prop: 'lock', label: 'textContent', say: 'textContent writes a string as text: angle brackets stay ordinary letters. Insert other people’s text only this way.' }
			]
		},
		practice: {
			id: 'js-dom-quick-nav',
			title: 'Quick links to your offers: a list built from the cards',
			task: 'Let the script build the navigation to the cards itself. 1) In the #offer section, after the heading, add an empty nav with the id quick and an aria-label (for example Jump to an offer), and an empty paragraph with the id offer-count. 2) Add a second script, a script tag with type set to module and id set to dom-code. In it, find all the cards (#offer .card) with querySelectorAll. 3) If there are no cards, show a clear message in #quick (with textContent). If there are, create a ul list: give every card an id such as item-1, item-2, and make an li for it with a link a whose href leads to that id and whose text is taken from the card’s heading. Do all of this with createElement, textContent and append. 4) In #offer-count write Offers: N. Using innerHTML to insert text is not allowed. The checks read the text of your script and the markup; you’ll see the list of links in the preview.',
			era: 4,
			continues: 'js-first-code',
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://riverbend.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://riverbend.example/og.png">
    <meta property="og:locale" content="en_GB">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://riverbend.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://riverbend.example/">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site language">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>A couple of sentences about this section.</p>
          <img src="photo.jpg" width="160" height="160" alt="Photo of {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="offer">
          <h2>What we offer</h2>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Terms and prices</h2>
          <table>
            <caption>What is included and what it costs</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">What is included</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="inquiry">
          <h2>{{mainAction.label}}</h2>
          <form action="/inquiry" method="post">
            <p>
              <label for="f-name">What should we call you?</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Phone</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">For example, +44 0000 000000. We call during working hours.</small>
            </p>
            <fieldset>
              <legend>When is it best to call?</legend>
              <label><input type="radio" name="when" value="morning" checked> Morning</label>
              <label><input type="radio" name="when" value="day"> Afternoon</label>
              <label><input type="radio" name="when" value="evening"> Evening</label>
            </fieldset>
            <p>
              <label for="f-comment">What do you need, briefly?</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> I agree to {{name}} using these details to reply to my inquiry. <a href="privacy.html">Privacy notice</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Credentials</h2>
          {{#each proofs}}<figure>
            <img src="scan.jpg" width="120" height="160" alt="Scan of the document">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Privacy notice</a> · <a href="#top">Back to top</a></p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The data of the brief: the items of the list. For now they sit here;
      // in the lesson on fetch we’ll move them into a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Only the titles. map makes a new array; items does not change.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items there are.
      const countOf = (list) => list.length;

      const summary =
        'Items in total: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the base of the 2014 site (reset and typography). You write the layout yourself. */

html {
  box-sizing: border-box;
  font-size: 100%;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
  background-color: #ffffff;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

img {
  max-width: 100%;
  height: auto;
}

a {
  color: #1a4d8f;
}

nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
  padding: 1rem;
  color: #ffffff;
  background-color: #1a4d8f;
}

.site-header a {
  color: #ffffff;
}

.brand {
  margin: 0;
  font-size: 1.5rem;
}

.button {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0 1.25rem;
  color: #ffffff;
  background-color: #1a4d8f;
  border-radius: 0.25rem;
  text-decoration: none;
}

.card {
  padding: 1rem;
  background-color: #f3f5f8;
  border-radius: 0.5rem;
}

.skip {
  position: absolute;
  left: -999px;
}

.skip:focus {
  left: 0.5rem;
  top: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: #ffffff;
  color: #1d2430;
}

.site-footer {
  padding: 1rem;
  background-color: #f3f5f8;
}

/* ===== Layout: your work starts here ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-areas:
    "main"
    "aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}


/* Wide screens: we add rules, we do not take them away (mobile first). */
@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    grid-template-areas: "main aside";
  }
}

/* The card looks at the width of its own place, not the window. */
@container (min-width: 40rem) {
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1rem;
  }
}
`
			},
			solution: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
    <meta name="description" content="{{who}}. {{forWhom}}.">
    <link rel="canonical" href="https://riverbend.example/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a4d8f'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='sans-serif' font-size='20' fill='%23fff'%3E{{name.0}}%3C/text%3E%3C/svg%3E">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{who}}">
    <meta property="og:image" content="https://riverbend.example/og.png">
    <meta property="og:locale" content="en_GB">
    {{#each languages}}<link rel="alternate" hreflang="{{.}}" href="https://riverbend.example/{{.}}/">
    {{/each}}<link rel="alternate" hreflang="x-default" href="https://riverbend.example/">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site language">
        <ul>
          {{#each languages}}<li><a href="/{{.}}/" hreflang="{{.}}" lang="{{.}}">{{.}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <div class="layout">
      <main id="main">
        <h1>{{name}}</h1>
        <p>{{who}}</p>
        <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

        <section id="sec-1">
          <h2>{{sections.0}}</h2>
          <p>A couple of sentences about this section.</p>
          <img src="photo.jpg" width="160" height="160" alt="Photo of {{name}}">
        </section>

        <section id="sec-2">
          <h2>{{sections.1}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="sec-3">
          <h2>{{sections.2}}</h2>
          <p>A couple of sentences about this section.</p>
        </section>

        <section id="offer">
          <h2>What we offer</h2>
          <nav id="quick" aria-label="Jump to an offer"></nav>
          <p id="offer-count"></p>
          <div class="cards">
            {{#each items}}<article class="card">
              <h3>{{title}}</h3>
              <p>{{text}}</p>
              <p class="price">{{price}}</p>
            </article>
            {{/each}}
          </div>
        </section>

        <section id="prices">
          <h2>Terms and prices</h2>
          <table>
            <caption>What is included and what it costs</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">What is included</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}<tr>
                <th scope="row">{{title}}</th>
                <td>{{text}}</td>
                <td>{{price}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section id="inquiry">
          <h2>{{mainAction.label}}</h2>
          <form action="/inquiry" method="post">
            <p>
              <label for="f-name">What should we call you?</label><br>
              <input id="f-name" name="name" type="text" autocomplete="name" required>
            </p>
            <p>
              <label for="f-phone">Phone</label><br>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-hint"><br>
              <small id="phone-hint">For example, +44 0000 000000. We call during working hours.</small>
            </p>
            <fieldset>
              <legend>When is it best to call?</legend>
              <label><input type="radio" name="when" value="morning" checked> Morning</label>
              <label><input type="radio" name="when" value="day"> Afternoon</label>
              <label><input type="radio" name="when" value="evening"> Evening</label>
            </fieldset>
            <p>
              <label for="f-comment">What do you need, briefly?</label><br>
              <textarea id="f-comment" name="comment" rows="4"></textarea>
            </p>
            <p>
              <label><input type="checkbox" name="consent" required> I agree to {{name}} using these details to reply to my inquiry. <a href="privacy.html">Privacy notice</a></label>
            </p>
            <p><button type="submit">{{mainAction.label}}</button></p>
          </form>
        </section>

        <section id="proofs">
          <h2>Credentials</h2>
          {{#each proofs}}<figure>
            <img src="scan.jpg" width="120" height="160" alt="Scan of the document">
            <figcaption>{{title}}</figcaption>
          </figure>
          {{/each}}
        </section>
      </main>

      <aside id="contacts">
        <h2>Get in touch</h2>
        <p>{{contacts.address}}</p>
        <p><a href="tel:{{phone}}">{{phone}}</a><br><a href="mailto:{{email}}">{{email}}</a></p>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
      <p><a href="privacy.html">Privacy notice</a> · <a href="#top">Back to top</a></p>
      <p id="summary"></p>
    </footer>

    <script type="module" id="my-code">
      // The data of the brief: the items of the list. For now they sit here;
      // in the lesson on fetch we’ll move them into a file of their own.
      const items = [
        {{#each items}}{ title: '{{title}}', price: '{{price}}' },
        {{/each}}
      ];

      // Only the titles. map makes a new array; items does not change.
      const titlesOf = (list) => list.map((item) => item.title);

      // Only the items that have a price.
      const withPrice = (list) => list.filter((item) => item.price !== '');

      // How many items there are.
      const countOf = (list) => list.length;

      const summary =
        'Items in total: ' + countOf(items) +
        ', with a price: ' + countOf(withPrice(items)) +
        '. ' + titlesOf(items).join(', ') + '.';

      console.log(summary);
      document.querySelector('#summary').textContent = summary;
    <\/script>

    <script type="module" id="dom-code">
      // The page is already parsed: a module runs after it.
      const cards = document.querySelectorAll('#offer .card');
      const quick = document.querySelector('#quick');
      const count = document.querySelector('#offer-count');

      if (cards.length === 0) {
        quick.textContent = 'There are no offers in the list yet.';
      } else {
        const list = document.createElement('ul');
        cards.forEach((card, index) => {
          card.id = 'item-' + (index + 1);
          const link = document.createElement('a');
          link.href = '#' + card.id;
          link.textContent = card.querySelector('h3').textContent;
          const row = document.createElement('li');
          row.append(link);
          list.append(row);
        });
        quick.append(list);
      }

      count.textContent = 'Offers: ' + cards.length;
    <\/script>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the base of the 2014 site (reset and typography). You write the layout yourself. */

html {
  box-sizing: border-box;
  font-size: 100%;
}

*,
