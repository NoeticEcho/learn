  background-color: #f3f5f8;
}

/* ===== Layout: your work starts here ===== */

header nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.layout {
  display: grid;
  grid-template-areas:
    "main"
    "aside";
  gap: 2rem;
  max-width: 62.5rem;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.layout main {
  grid-area: main;
}

.layout aside {
  grid-area: aside;
}

.cards {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
}


/* Wide screens: we add rules, we do not take them away (mobile first). */
@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    grid-template-areas: "main aside";
  }
}

/* The card looks at the width of its own place, not the window. */
@container (min-width: 40rem) {
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1rem;
  }
}

[hidden] {
  display: none !important;
}
