<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p>{{who}}</p>

    <aside class="note" data-scaffold id="benefit-work">
