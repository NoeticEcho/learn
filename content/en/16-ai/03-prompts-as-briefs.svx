	const brief = (v) => `<section data-scaffold id="prompt-brief">
      <h2>A structured prompt from the brief</h2>
      <textarea id="p-full" rows="20" aria-label="Prompt">${v.full}<\/textarea>
      <p>What not to do:</p>
      <ul id="p-donts">
        <li>${v.donts[0]}</li>
        <li>${v.donts[1]}</li>
        <li>${v.donts[2]}</li>
      </ul>
      <p>How to tell it is done:</p>
      <ul id="p-done">
        <li>${v.done[0]}</li>
        <li>${v.done[1]}</li>
        <li>${v.done[2]}</li>
      </ul>
      <p id="p-private">What from the brief I won’t send to the model: ${v.priv}</p>
      <p id="p-compare">Comparison with a short request: ${v.compare}</p>
    </section>`;

	const starter = `Context: …
Goal: …
Audience: …
The visitor’s main action: …
Sections: …
What we offer: …
People: …
Proof (only these, invent nothing): …
Languages (codes such as en, es): …
Tone, by example: …
Format of the result: …`;
	const solved = `Context: {{who}}
Goal: a site where a visitor does one thing and understands what we do
Audience: {{forWhom}}
The visitor’s main action: “{{mainAction.label}}”
Sections: {{#each sections}}{{.}}; {{/each}}
What we offer: {{#each items}}{{title}}; {{/each}}
People: {{#each people}}{{name}}; {{/each}}
Proof (only these, invent nothing): {{#each proofs}}{{title}}; {{/each}}
Languages (codes such as en, es): {{#each languages}}{{.}}, {{/each}}
Tone, by example: “First we’ll go through the documents, then decide what to do.” “We’ll answer your questions in order, without hurry.”
Format of the result: one HTML file and one CSS file, semantic markup, no external scripts, with a lang attribute`;

