          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="language-choice">
      <h2>Choosing a server language</h2>
      <table>
        <tr><th>Language</th><th>Start-up speed</th><th>Run speed</th><th>Concurrency</th><th>Ecosystem</th><th>Hiring</th><th>Entry barrier</th><th>Total</th></tr>
        <tr class="lang"><td class="name">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="total">…</td></tr>
        <tr class="lang"><td class="name">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="total">…</td></tr>
        <tr class="lang"><td class="name">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="score">…</td><td class="total">…</td></tr>
      </table>
      <p id="choice">Choice: …</p>
      <p id="hiring">Specialists: …</p>
      <p id="revisit">I’ll revisit the choice if: …</p>
    </section>

    <footer class="site-footer">
