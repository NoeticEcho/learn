          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="stack">
      <h2>My project’s server side</h2>
      <p id="goal">Main action: …</p>
      <ol id="flow">
        <li class="hop">…</li>
        <li class="hop">…</li>
        <li class="hop">…</li>
        <li class="hop">…</li>
      </ol>
      <table>
        <tr><th>Block</th><th>Choice</th><th>Why</th></tr>
        <tr class="block"><td>Pages</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Language and application</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>API</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Sign-in</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Inquiries</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Data</td><td class="pick">…</td><td class="why">…</td></tr>
        <tr class="block"><td>Hosting and server</td><td class="pick">…</td><td class="why">…</td></tr>
      </table>
      <p id="pd-location">Where personal data is kept: …</p>
      <ol id="risks">
        <li class="risk">…</li>
        <li class="risk">…</li>
        <li class="risk">…</li>
      </ol>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
