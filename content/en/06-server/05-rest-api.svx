<script module>
	/** License of this lesson's text: CC BY-SA 4.0. The English edition of content/ru/06-server/05-rest-api.svx. */
	export const metadata = {
		id: '06-server/05-rest-api',
		part: 6,
		order: 5,
		title: 'APIs and REST: how programs talk to each other',
		definition: 'An API is a set of rules for how programs exchange data. REST is an HTTP API style: the address names a resource, the method the action, the code the result.',
		summary:
			'A page talks to a server, and often two programs from different companies talk to each other, by the rules of an API. Afterwards you’ll read and design a simple HTTP API: resources, the GET, POST, PUT and DELETE methods, status codes, errors and versions, and you’ll describe it in an OpenAPI file.',
		minutes: 30,
		teaches: ['server-rest', 'server-openapi'],
		requires: ['net-http-request-response', 'js-fetch', 'js-json'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'browser', label: 'GET /items/7', caption: 'A noun', say: 'The address names a thing: /items/7, offering number seven. No verb in the address. The method says the action.' },
				{ mood: 'hint', side: 'right', prop: 'server', label: 'DELETE /items/7', caption: 'Twice', say: 'DELETE is idempotent: two identical requests leave the server as one would. If no answer came back, it’s safe to retry.' },
				{ mood: 'hmm', prop: 'browser', label: 'GET /deleteItem?id=1', caption: 'Not like this', say: 'GET must be safe. A robot or a prefetch can open an address that deletes, and the item is gone.' },
				{ mood: 'cheer', side: 'right', prop: 'server', label: '201 Created', say: 'The status code answers: 201 created, 404 no such thing, 401 sign in, 403 signing in isn’t enough, 500 we broke it.' }
			]
		},
		practice: {
			id: 'server-openapi',
			title: 'An OpenAPI description of your project’s API',
			task: 'The sandbox does not check YAML, so write the description as text in the pre block with the id openapi (in place of the “…”), like an openapi.yaml file, and compare it with the example in the lesson. Describe the API for your offerings and inquiries. 1) The version: openapi: 3.1.0, info, and servers with the address https://…/api/v1. 2) Paths are plural nouns: /items for the list of offerings (get) and /items/{id} for one, and /requests (post) for an inquiry from the form. There must be no verbs in the paths. 3) GET has no side effects; an inquiry is created with POST and answers 201 (or 202). 4) Describe the 200, 400 and 404 answers and a shared error format in components.schemas.Error (the fields code and message). 5) List the required fields of the inquiry with required, and say that personal data is accepted only over HTTPS.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="api-spec">
      <h2>My project’s API description</h2>
      <pre id="openapi">…<\/pre>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: #1d2430;
