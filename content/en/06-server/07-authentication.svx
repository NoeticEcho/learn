	export const metadata = {
		id: '06-server/07-authentication',
		part: 6,
		order: 7,
		title: 'Authentication in plain words',
		definition: 'Authentication checks who a user is, and authorization decides what that user may do. A person is recognized by a session cookie, a JWT, OAuth or a passkey.',
		summary:
			'“Who are you?” and “what may you do?” are two different questions. Afterwards you’ll explain how sessions and cookies, JWT tokens, signing in through another service (OAuth) and passkeys work, you’ll choose a safe way to sign in for a project, and you won’t store passwords as plain text.',
		minutes: 30,
		teaches: [
			'server-sessions-and-cookies',
			'server-authentication',
			'server-authorization',
			'server-oauth',
			'server-passkeys'
		],
		requires: ['server-rest', 'net-tls'],
		comic: {
			panels: [
				{ mood: 'explain', prop: 'sheet', label: 'pass: editor', say: 'Authentication: who you are, a passport at the gate. Authorization: what you may do, a pass for certain doors.' },
				{ mood: 'hmm', side: 'right', prop: 'lock', label: 'hash and salt', say: 'A password is stored as a slow hash with a salt. That’s why an honest site can’t remind you of it: it doesn’t know it.' },
				{ mood: 'hint', prop: 'postcard', label: 'role: editor + signature', caption: 'JWT', say: 'A token is a postcard with a seal: anyone can read it, nobody can forge it. Never put a password in it.' },
				{ mood: 'cheer', side: 'right', prop: 'browser', label: 'button “Delete”', say: 'Hiding the button is not enough: the request can be sent without it. The server checks rights on every request.' }
			]
		},
		practice: {
			id: 'server-auth-plan',
			title: 'Does your site need sign-in, and how does it work',
			task: 'Decide whether your project needs sign-in, and describe it. 1) In the “Is sign-in needed” paragraph, answer “needed” or “not needed” and give a reason tied to the project’s main action: name that action in the words of your brief (for example, in quotation marks). 2) In the “Way to sign in” paragraph, name the way: a password, a link sent by email, sign in with Google, a passkey, or “no sign-in”. 3) In the table, give three roles (the class role): visitor, owner and one more (editor, or your own), and what each may do (the class can). 4) In the paragraph about passwords, name the storage scheme (an argon2id or bcrypt hash with a salt) or say that sign-in is passwordless. 5) In the last paragraph, say that signing in through a third-party provider or by SMS is processing of personal data under the GDPR, and that it needs a lawful basis such as consent, and a privacy notice. Every “…” must be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="auth-plan">
      <h2>Does my site need sign-in</h2>
      <p id="need">Is sign-in needed: …</p>
      <p id="method">Way to sign in: …</p>
      <table>
        <tr><th>Role</th><th>What they can do</th></tr>
        <tr class="role"><td>Visitor</td><td class="can">…</td></tr>
        <tr class="role"><td>Owner</td><td class="can">…</td></tr>
        <tr class="role"><td>…</td><td class="can">…</td></tr>
      </table>
      <p id="passwords">Passwords: …</p>
      <p id="pd">Personal data at sign-in: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

*,
*::before,
*::after {
  box-sizing: border-box;
}

