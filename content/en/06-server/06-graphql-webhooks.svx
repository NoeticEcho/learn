	export const metadata = {
		id: '06-server/06-graphql-webhooks',
		part: 6,
		order: 6,
		title: 'GraphQL and webhooks',
		definition: 'A webhook is an HTTP request a service sends by itself to a set address when an event happens. GraphQL is an API with one address where the client picks fields.',
		summary:
			'GraphQL returns exactly the fields the client asked for, and a webhook lets a service tell you about an event itself. Afterwards you’ll know how GraphQL differs from REST, and you’ll set up a notification for an inquiry with a signature check and protection against repeats.',
		minutes: 25,
		teaches: ['server-graphql', 'server-webhooks'],
		requires: ['server-rest'],
		comic: {
			panels: [
				{ mood: 'hmm', prop: 'phone', label: 'POST /hooks/request', say: [{ text: 'Polling is “are we there yet?” from the back seat. A webhook: the service calls you when an inquiry arrives.' }, { who: 'Service', text: 'An inquiry came in, calling.' }] },
				{ mood: 'explain', side: 'right', prop: 'lock', label: 'HMAC', caption: 'The signature', say: 'The handler’s address is no secret. A signature from the body and a shared secret proves the real service is calling.' },
				{ mood: 'hint', prop: 'packets', label: '7 7', caption: 'Event 7, twice', say: 'The reply got lost, so the service tried again. We’ve seen number 7: answer 200 and do nothing a second time.' },
				{ mood: 'cheer', side: 'right', prop: 'browser', label: 'items { title price }', caption: 'GraphQL', say: 'GraphQL: one address, and the client picks the fields. Ask for the title and price, and only those arrive.' }
			]
		},
		practice: {
			id: 'server-webhook',
			title: 'An inquiry reaches the owner: a webhook and its protection',
			task: 'A real receiver cannot run in the sandbox, so write the handler’s code as text in the pre block with the id handler, and try signatures on the diagram above. 1) In the Channel paragraph, name where the inquiry will arrive: Slack, email or another channel. 2) In the pre, write the handler (in Node.js, following the example in the lesson): the secret from process.env, an HMAC SHA-256 signature over the raw body (crypto.createHmac with sha256), a safe comparison (timingSafeEqual), a 401 answer when it does not match, a repeat of an event with the same id ignored, and a quick 200 on success. 3) In the paragraph “If the receiver is down”, describe what happens on a failure and why the inquiry is neither lost nor delivered twice. 4) In the GraphQL paragraph, compare it with REST for your data: name one item from your brief and a case where GraphQL is handier. Do not write the value of the secret into the code. Every “…” must be replaced.',
			era: 6,
			files: {
				'index.html': `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="site-header" id="top">
      <p class="brand">{{name}}</p>
      <nav aria-label="Site sections">
        <ul>
          <li><a href="#sec-1">{{sections.0}}</a></li>
          <li><a href="#sec-2">{{sections.1}}</a></li>
          <li><a href="#sec-3">{{sections.2}}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <h1>{{name}}</h1>
      <p>{{who}}</p>
      <p><a class="button" href="#inquiry">{{mainAction.label}}</a></p>

      <section id="sec-1">
        <h2>{{sections.0}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-2">
        <h2>{{sections.1}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="sec-3">
        <h2>{{sections.2}}</h2>
        <p>A couple of sentences about this section.</p>
      </section>

      <section id="offer">
        <h2>What we offer</h2>
        <div class="cards">
          {{#each items}}<article class="card">
            <h3>{{title}}</h3>
            <p>{{text}}</p>
            <p class="price">{{price}}</p>
          </article>
          {{/each}}
        </div>
      </section>

      <section id="inquiry">
        <h2>{{mainAction.label}}</h2>
        <form action="/inquiry" method="post">
          <p>
            <label for="f-name">What should we call you?</label><br>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </p>
          <p>
            <label for="f-phone">Phone</label><br>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
          </p>
          <p><button type="submit">{{mainAction.label}}</button></p>
        </form>
      </section>
    </main>


    <section data-scaffold id="webhook-plan">
      <h2>Inquiry, webhook, owner</h2>
      <p id="channel">Channel: …</p>
      <pre id="handler">…<\/pre>
      <p id="retry">If the receiver is down: …</p>
      <p id="graphql">GraphQL or REST for my data: …</p>
    </section>

    <footer class="site-footer">
      <p>{{name}}, {{city}}</p>
    </footer>
  </body>
</html>
`,
				'styles.css': `/* styles.css: the page after the CSS part, in short */

