{
	"ci": {
		"collect": {
			"startServerCommand": "npx vite preview --port 4174 --strictPort",
			"startServerReadyPattern": "4174",
			"url": [
				"http://localhost:4174/learn/",
				"http://localhost:4174/learn/map/",
				"http://localhost:4174/learn/lesson/02-html/01-first-page/",
				"http://localhost:4174/learn/lesson/00-start/01-how-to-learn/",
				"http://localhost:4174/learn/en/",
				"http://localhost:4174/learn/en/lesson/00-start/01-how-to-learn/"
			],
			"numberOfRuns": 3,
			"settings": {
				"onlyCategories": [
					"performance",
					"accessibility",
					"seo"
				],
				"chromeFlags": "--no-sandbox --headless=new"
			}
		},
		"assert": {
			"assertions": {
				"largest-contentful-paint": [
					"warn",
					{
						"maxNumericValue": 2500,
						"aggregationMethod": "median"
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.95,
						"aggregationMethod": "median"
					}
				],
				"categories:performance": [
					"error",
					{
						"minScore": 0.9,
						"aggregationMethod": "median"
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 1,
						"aggregationMethod": "median"
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
